<%#
  @file members.ejs
  @layer admin/pages
  @route /members
  @role member-management
  @data GET /operator/:clientId/members (paginated, filterable), GET /operator/:clientId/locations
  @tab Members
  @features search, filter by status/location, detail drawer, CSV export
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Operator Dashboard: Members' }) %>
  <style>
    .dash-content { max-width: 1020px; }
    .page-header { flex-wrap: wrap; gap: 16px; }
    .page-header-left { }

    /* Role toggle */
    .role-toggle { display: flex; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 3px; gap: 2px; flex-shrink: 0; }
    .role-btn { padding: 3px 10px; border-radius: 20px; font-family: 'Sora', sans-serif; font-size: 10px; font-weight: 600; cursor: pointer; border: none; background: transparent; color: var(--muted); transition: all 0.15s; white-space: nowrap; }
    .role-btn.active { background: var(--brand); color: #fff; }

    /* Stats strip */
    .stats-strip { display: flex; gap: 12px; flex-wrap: wrap; }
    .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 18px; min-width: 130px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s; }
    .stat-card:hover { border-color: var(--border2); box-shadow: var(--shadow); }
    .stat-card.selected { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand-dim); }
    .stat-value { font-size: 22px; font-weight: 700; color: var(--text); }
    .stat-label { font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px; }
    .stat-card.alert .stat-value { color: var(--red); }
    .stat-card.alert.selected { border-color: var(--red); box-shadow: 0 0 0 2px var(--red-dim); }

    /* Filters */
    .filters-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .filter-select { padding: 8px 32px 8px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px; font-family: inherit; color: var(--text); background: var(--card); outline: none; cursor: pointer; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%238896A8' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 12px center; transition: border-color 0.15s; }
    .filter-select:focus { border-color: var(--brand); }
    .filter-search { padding: 8px 12px 8px 32px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px; font-family: inherit; color: var(--text); background: var(--card); outline: none; min-width: 220px; transition: border-color 0.15s; background-image: url("data:image/svg+xml,%3Csvg width='14' height='14' viewBox='0 0 14 14' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='6' cy='6' r='4.5' stroke='%238896A8' stroke-width='1.5'/%3E%3Cpath d='M9.5 9.5L12.5 12.5' stroke='%238896A8' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: 10px center; }
    .filter-search:focus { border-color: var(--brand); }
    .filter-clear { font-size: 12px; font-weight: 600; color: var(--brand); background: none; border: none; cursor: pointer; padding: 8px 6px; display: none; }
    .filter-clear.visible { display: inline; }
    .filter-clear:hover { text-decoration: underline; }
    .filter-count { font-size: 12px; color: var(--muted); margin-left: auto; }

    /* Active filter banner */
    .active-filter { display: none; align-items: center; gap: 8px; background: var(--brand-dim); border: 1px solid var(--brand-dim); border-radius: 8px; padding: 8px 14px; margin-bottom: 16px; font-size: 13px; color: var(--brand); }
    .active-filter.visible { display: flex; }
    .active-filter strong { font-weight: 700; }
    .active-filter-close { margin-left: auto; background: none; border: none; cursor: pointer; font-size: 16px; color: var(--brand); padding: 0 4px; line-height: 1; }
    .active-filter-close:hover { color: var(--brand-dark); }

    /* Members table */
    .members-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    .members-tbl { width: 100%; border-collapse: collapse; }
    .members-tbl th { text-align: left; font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; padding: 12px 16px; border-bottom: 1px solid var(--border); background: var(--surface); }
    .members-tbl td { padding: 12px 16px; font-size: 13px; color: var(--text); border-bottom: 1px solid var(--border); vertical-align: middle; }
    .members-tbl tbody tr { transition: background 0.12s; }
    .members-tbl tbody tr:hover { background: var(--surface); }
    .members-tbl tbody tr:last-child td { border-bottom: none; }
    .members-tbl tbody tr.is-holder { background: var(--surface); }
    .members-tbl tbody tr.is-holder:hover { background: var(--surface); }

    /* Member cell */
    .member-cell { display: flex; align-items: center; gap: 10px; }
    .member-avatar { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0; }
    .member-avatar.holder    { background: linear-gradient(135deg, #1B3A5C, #2E5D8A); }
    .member-avatar.active    { background: linear-gradient(135deg, var(--sage-dark), #22c55e); }
    .member-avatar.pending   { background: linear-gradient(135deg, #d97706, #f59e0b); }
    .member-avatar.failed    { background: linear-gradient(135deg, var(--red), #ef4444); }
    .member-avatar.suspended { background: linear-gradient(135deg, #6b7280, #9ca3af); }
    .member-name  { font-weight: 600; }
    .member-email { font-size: 12px; color: var(--muted); margin-top: 1px; }
    .member-tag { display: inline-block; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 6px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
    .member-tag.holder { color: var(--brand); background: var(--brand-dim); }
    .member-tag.sub    { color: var(--text2); background: var(--surface); }

    /* Status pill */
    .status-pill { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 6px; }
    .status-pill.active           { background: var(--sage-dim);  color: var(--sage-dark); }
    .status-pill.pending          { background: var(--amber-dim); color: var(--amber); }
    .status-pill.pending_hardware { background: var(--amber-dim); color: var(--amber); }
    .status-pill.partial          { background: var(--amber-dim); color: var(--amber); }
    .status-pill.failed           { background: var(--red-dim);   color: var(--red); }
    .status-pill.suspended        { background: var(--surface);   color: var(--muted); }
    .status-pill.in_flight        { background: var(--brand-dim); color: var(--brand); }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-pill.active .status-dot           { background: var(--sage-dark); }
    .status-pill.pending .status-dot          { background: var(--amber); animation: pulse 1.4s ease-in-out infinite; }
    .status-pill.pending_hardware .status-dot { background: var(--amber); animation: pulse 1.4s ease-in-out infinite; }
    .status-pill.partial .status-dot          { background: var(--amber); }
    .status-pill.failed .status-dot           { background: var(--red); }
    .status-pill.suspended .status-dot        { background: var(--muted); }
    .status-pill.in_flight .status-dot        { background: var(--brand); animation: pulse 1.4s ease-in-out infinite; }

    /* Extended color palette (additive — DR-014 indigo/sage locked) */
    --plan-accent: #7C3AED;
    --plan-accent-dim: #F3E8FF;
    --teal: #0D9488;
    --teal-dim: rgba(13,148,136,0.10);

    .plan-badge     { font-size: 11px; font-weight: 600; color: var(--text); }
    .plan-badge-sub { font-size: 11px; color: var(--muted); }

    /* Plan cell toggle button */
    .plan-cell-wrap { display: flex; flex-direction: column; gap: 4px; }
    .plan-detail-btn {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 10px; font-weight: 700; color: var(--brand);
      background: var(--brand-dim); border: none; border-radius: 5px;
      padding: 2px 7px; cursor: pointer; font-family: inherit;
      transition: background 0.12s; width: fit-content; margin-top: 2px;
    }
    .plan-detail-btn:hover { background: rgba(79,110,247,0.18); }
    .plan-detail-btn .pdb-chevron { font-size: 8px; transition: transform 0.15s; display: inline-block; }
    .plan-detail-btn.open .pdb-chevron { transform: rotate(180deg); }

    /* Child row that appears below parent member row */
    .plan-child-row td {
      background: var(--surface); padding: 0 16px 14px 48px;
      border-bottom: 1px solid var(--border);
    }
    .plan-child-row.hidden { display: none; }
    .plan-cards-wrap { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 10px; }

    /* Individual plan card */
    .plan-card {
      background: var(--plan-accent-dim); border: 1px solid rgba(124,58,237,0.18);
      border-radius: 10px; padding: 12px 14px; min-width: 200px; flex: 1; max-width: 280px;
    }
    .plan-card-title {
      font-size: 13px; font-weight: 700; color: var(--plan-accent);
      border-left: 3px solid var(--plan-accent); padding-left: 8px;
      margin-bottom: 8px; line-height: 1.3;
    }
    .plan-detail-row { display: flex; justify-content: space-between; gap: 8px; padding: 3px 0; border-bottom: 1px solid rgba(124,58,237,0.1); }
    .plan-detail-row:last-child { border-bottom: none; }
    .plan-detail-label { color: var(--muted); font-size: 11px; }
    .plan-detail-value { font-weight: 600; color: var(--text); font-size: 11px; text-align: right; }

    /* View additional members button */
    .view-members-btn {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 10px; font-weight: 700; color: #7C3AED;
      background: #F3E8FF; border: none; border-radius: 5px;
      padding: 2px 7px; cursor: pointer; font-family: inherit;
      transition: background 0.12s; white-space: nowrap;
    }
    .view-members-btn:hover { background: #EDE9FE; }
    .view-members-btn .vmb-chevron { font-size: 8px; transition: transform 0.15s; display: inline-block; }
    .view-members-btn.open .vmb-chevron { transform: rotate(180deg); }
    .submember-panel {
      display: none; margin-top: 6px;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; overflow: hidden;
    }
    .submember-panel.open { display: block; }
    .submember-row {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 12px; border-bottom: 1px solid var(--border);
      font-size: 12px;
    }
    .submember-row:last-child { border-bottom: none; }
    .submember-avatar {
      width: 24px; height: 24px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 9px; font-weight: 700; color: #fff; flex-shrink: 0;
    }
    .submember-avatar.active    { background: linear-gradient(135deg, var(--sage-dark), #22c55e); }
    .submember-avatar.pending,
    .submember-avatar.pending_hardware { background: linear-gradient(135deg, #d97706, #f59e0b); }
    .submember-avatar.failed    { background: linear-gradient(135deg, var(--red), #ef4444); }
    .submember-avatar.suspended { background: linear-gradient(135deg, #6b7280, #9ca3af); }
    .submember-name { font-weight: 600; color: var(--text); }
    .submember-email { font-size: 11px; color: var(--muted); }

    /* Action buttons */
    .tbl-action-btn { width: 28px; height: 28px; border-radius: 6px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.12s; margin-left: 4px; }
    .tbl-action-btn:hover       { border-color: var(--brand); color: var(--brand); background: var(--brand-dim); }
    .tbl-action-btn.danger:hover{ border-color: var(--red);   color: var(--red);   background: var(--red-dim); }
    .tbl-action-btn.retry:hover { border-color: var(--amber); color: var(--amber); background: var(--amber-dim); }

    /* Sub-member indent */
    .sub-indent { padding-left: 42px; }
    .sub-connector { display: inline-block; width: 16px; height: 16px; border-left: 2px solid var(--border); border-bottom: 2px solid var(--border); border-radius: 0 0 0 6px; margin-right: 8px; vertical-align: middle; position: relative; top: -2px; }
    .expand-btn { width: 22px; height: 22px; border-radius: 5px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; color: var(--muted); transition: all 0.12s; margin-right: 8px; flex-shrink: 0; }
    .expand-btn:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-dim); }
    .expand-btn.open { transform: rotate(90deg); }

    /* Empty state */
    .empty-row td { text-align: center; padding: 40px 16px; color: var(--muted); font-size: 14px; }

    /* Pagination */
    .pagination { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-top: 1px solid var(--border); background: var(--surface); }
    .page-info { font-size: 12px; color: var(--muted); }
    .page-btns { display: flex; gap: 4px; }
    .page-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: var(--card); font-size: 12px; font-weight: 600; color: var(--text2); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.12s; }
    .page-btn:hover  { border-color: var(--brand); color: var(--brand); }
    .page-btn.active { border-color: var(--brand); background: var(--brand); color: #fff; }
    .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Drawer */
    .drawer-overlay { display: none; position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.3); z-index: 500; }
    .drawer-overlay.visible { display: block; }
    .drawer { position: fixed; top: 0; right: -480px; bottom: 0; width: 460px; max-width: 100vw; background: var(--card); box-shadow: -8px 0 32px rgba(0,0,0,0.12); z-index: 600; transition: right 0.25s ease; display: flex; flex-direction: column; }
    .drawer.open { right: 0; }
    .drawer-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .drawer-title { font-size: 18px; font-weight: 700; color: var(--text); }
    .drawer-close { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: var(--card); cursor: pointer; font-size: 16px; color: var(--text2); display: flex; align-items: center; justify-content: center; transition: all 0.12s; }
    .drawer-close:hover { border-color: var(--red); color: var(--red); background: var(--red-dim); }
    .drawer-body { flex: 1; overflow-y: auto; padding: 20px 24px; }
    .drawer-section-label { font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; margin-top: 20px; }
    .drawer-section-label:first-child { margin-top: 0; }
    .drawer-info-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
    .drawer-info-label { color: var(--text2); }
    .drawer-info-value { color: var(--text); font-weight: 600; }
    .drawer-member-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin-bottom: 8px; display: flex; align-items: center; gap: 12px; }
    .drawer-member-card .member-avatar { width: 36px; height: 36px; font-size: 12px; }
    .drawer-member-info { flex: 1; }
    .drawer-member-name  { font-size: 14px; font-weight: 600; color: var(--text); }
    .drawer-member-email { font-size: 12px; color: var(--muted); }
    .drawer-member-actions { display: flex; gap: 4px; }
    .drawer-action-btn { width: 30px; height: 30px; border-radius: 7px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.12s; }
    .drawer-action-btn:hover        { border-color: var(--brand); color: var(--brand); background: var(--brand-dim); }
    .drawer-action-btn.danger:hover { border-color: var(--red);   color: var(--red);   background: var(--red-dim); }
    .drawer-action-btn.retry:hover  { border-color: var(--amber); color: var(--amber); background: var(--amber-dim); }
    .drawer-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; gap: 8px; }
    .drawer-btn { padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; border: none; transition: all 0.15s; }
    .drawer-btn.primary   { background: var(--brand); color: #fff; flex: 1; }
    .drawer-btn.primary:hover   { background: var(--brand-dark); }
    .drawer-btn.secondary { background: var(--surface); color: var(--text2); }
    .drawer-btn.secondary:hover { background: var(--border); }

    /* Drawer tabs */
    .drawer-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); padding: 0 24px; }
    .drawer-tab { padding: 12px 14px; font-size: 13px; font-weight: 600; color: var(--text2); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; transition: all 0.12s; }
    .drawer-tab:hover { color: var(--text); }
    .drawer-tab.active { color: var(--brand); border-bottom-color: var(--brand); }
    .drawer-tab-content { display: none; }
    .drawer-tab-content.active { display: block; }

    /* Verdict banner */
    .verdict-banner { border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; font-size: 13px; font-weight: 600; }
    .verdict-banner.healthy  { background: rgba(74,222,128,0.12); color: var(--sage-dark); border: 1px solid rgba(74,222,128,0.3); }
    .verdict-banner.degraded { background: rgba(245,158,11,0.12); color: var(--amber);    border: 1px solid rgba(245,158,11,0.3); }
    .verdict-banner.failed   { background: rgba(239,68,68,0.12);  color: var(--red);      border: 1px solid rgba(239,68,68,0.3); }
    .verdict-banner.mismatch { background: rgba(239,68,68,0.12);  color: var(--red);      border: 1px solid rgba(239,68,68,0.3); }

    /* Finding items */
    .finding-item { display: flex; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 12px; }
    .finding-item:last-child { border-bottom: none; }
    .finding-level { flex-shrink: 0; font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.04em; }
    .finding-level.error { background: rgba(239,68,68,0.12); color: var(--red); }
    .finding-level.warn  { background: rgba(245,158,11,0.12); color: var(--amber); }
    .finding-level.ok    { background: rgba(74,222,128,0.12); color: var(--sage-dark); }
    .finding-msg  { color: var(--text); line-height: 1.5; }
    .finding-code { font-weight: 700; color: var(--text2); margin-right: 4px; }

    /* Timeline items */
    .tl-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 12px; }
    .tl-item:last-child { border-bottom: none; }
    .tl-source { flex-shrink: 0; font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.04em; background: var(--surface); color: var(--text2); }
    .tl-source.access_log     { background: rgba(79,110,247,0.12); color: var(--brand); }
    .tl-source.error_queue    { background: rgba(239,68,68,0.12); color: var(--red); }
    .tl-source.adapter_log   { background: rgba(245,158,11,0.12); color: var(--amber); }
    .tl-source.diagnostic_log { background: rgba(100,100,100,0.1); color: var(--text2); }
    .tl-body { flex: 1; }
    .tl-event { font-weight: 600; color: var(--text); }
    .tl-detail { color: var(--muted); margin-top: 2px; }
    .tl-ts { font-size: 11px; color: var(--muted); flex-shrink: 0; text-align: right; }

    /* Toast override (members uses bottom: 24px) */
    .toast { bottom: 24px; transform: translateX(-50%) translateY(60px); font-family: 'Sora', sans-serif; }
    .toast.visible { transform: translateX(-50%) translateY(0); }

    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
    @keyframes skeleton-pulse { 0%,100% { opacity: 0.4; } 50% { opacity: 1; } }

    @media (max-width: 640px) {
      .topbar { padding: 0 16px; }
      .page-title { font-size: 20px; }
      .page-header { flex-direction: column; }
      .stats-strip { width: 100%; flex-direction: column; }
      .stat-card { flex: 1; min-width: unset; }
      .filters-bar { flex-direction: column; align-items: stretch; }
      .filter-select, .filter-search { width: 100%; min-width: unset; }
      .drawer { width: 100vw; }
      .sub-indent { padding-left: 24px; }
      .members-tbl th:nth-child(3), .members-tbl td:nth-child(3),
      .members-tbl th:nth-child(5), .members-tbl td:nth-child(5) { display: none; }
    }
    @media (min-width: 769px) {
      .dash-content { padding: 32px 24px; }
    }
  </style>
</head>
<body data-session-role="<%= sessionRole %>"<% if (loginUrl) { %> data-login-url="<%= loginUrl %>"<% } %>>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <div class="dash-content">
    <div class="page-header">
      <div class="page-header-left">
        <div class="page-title">Members</div>
        <div class="page-subtitle" id="pageSubtitle"></div>
      </div>
      <button class="btn btn-sm btn-ghost" onclick="downloadMembersCSV()" style="margin-left:auto;">&#11015; Export CSV</button>
      <div class="stats-strip" id="statsStrip"></div>
    </div>

    <div class="filters-bar" id="filtersBar">
      <select class="filter-select" id="filterPlan" onchange="applyFilters()">
        <option value="">All Plans</option>
      </select>
      <select class="filter-select" id="filterStatus" onchange="applyFilters()">
        <option value="">All Statuses</option>
        <option value="active">Active</option>
        <option value="pending">Pending</option>
        <option value="pending_hardware">Needs Setup</option>
        <option value="partial">Partial Access</option>
        <option value="failed">Action Needed</option>
        <option value="suspended">Paused</option>
      </select>
      <select class="filter-select" id="filterRole" onchange="applyFilters()">
        <option value="">All Roles</option>
        <option value="holder">Plan Holders</option>
        <option value="sub">Additional Members</option>
      </select>
      <input class="filter-search" id="filterSearch" type="text" placeholder="Search by name or email..." oninput="clearTimeout(window._searchDebounce); window._searchDebounce = setTimeout(applyFilters, 300)"/>
      <button class="filter-clear" id="filterClear" onclick="clearFilters()">Clear filters</button>
      <div class="filter-count" id="filterCount"></div>
    </div>

    <div class="active-filter" id="activeFilterBanner">
      <span id="activeFilterText"></span>
      <button class="active-filter-close" onclick="clearFilters()">&times;</button>
    </div>

    <div class="members-card">
      <table class="members-tbl">
        <thead>
          <tr>
            <th style="width:30%;">Member</th>
            <th>Plan</th>
            <th>Role</th>
            <th>Access Status</th>
            <th>Added</th>
            <th style="width:80px;"></th>
          </tr>
        </thead>
        <tbody id="membersBody"></tbody>
      </table>
      <div class="pagination" id="pagination"></div>
    </div>
  </div>

  <div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
  <div class="drawer" id="drawer">
    <div class="drawer-header">
      <div class="drawer-title" id="drawerTitle"></div>
      <button class="drawer-close" onclick="closeDrawer()">&times;</button>
    </div>
    <div class="drawer-body" id="drawerBody"></div>
    <div class="drawer-footer" id="drawerFooter"></div>
  </div>

  <div class="toast" id="toast"></div>

  <script src="/operator-nav.js"></script>
  <script>
    var plans = [];
    var allMembers = [];
    var wixPlanDetails = {}; // source_plan_id → { name, wixPrice, type, status }

    var expandedHolders = {};
    var urlParams = new URLSearchParams(window.location.search);
    var prefilterPlan   = urlParams.get('plan')   || '';
    var prefilterHolder = urlParams.get('holder') || '';

    function renderStats() {
      var total           = allMembers.length;
      var active          = allMembers.filter(function(m) { return m.status === 'active'; }).length;
      var pending         = allMembers.filter(function(m) { return m.status === 'pending'; }).length;
      var pendingHardware = allMembers.filter(function(m) { return m.status === 'pending_hardware'; }).length;
      var partial         = allMembers.filter(function(m) { return m.status === 'partial'; }).length;
      var failed          = allMembers.filter(function(m) { return m.status === 'failed'; }).length;
      var strip = document.getElementById('statsStrip');
      strip.innerHTML =
        '<div class="stat-card" data-filter="" onclick="filterByStatus(this)"><div class="stat-value">' + total + '</div><div class="stat-label">Total Members</div></div>' +
        '<div class="stat-card" data-filter="active" onclick="filterByStatus(this)"><div class="stat-value">' + active + '</div><div class="stat-label">Active</div></div>' +
        '<div class="stat-card" data-filter="pending" onclick="filterByStatus(this)"><div class="stat-value">' + pending + '</div><div class="stat-label">Pending</div></div>' +
        (pendingHardware > 0 ? '<div class="stat-card" data-filter="pending_hardware" onclick="filterByStatus(this)" style="border-left:3px solid var(--amber);"><div class="stat-value">' + pendingHardware + '</div><div class="stat-label">Needs Setup</div></div>' : '') +
        (partial > 0 ? '<div class="stat-card" data-filter="partial" onclick="filterByStatus(this)" style="border-left:3px solid var(--amber);"><div class="stat-value">' + partial + '</div><div class="stat-label">Partial Access</div></div>' : '') +
        (failed > 0 ? '<div class="stat-card alert" data-filter="failed" onclick="filterByStatus(this)"><div class="stat-value">' + failed + '</div><div class="stat-label">Action Needed</div></div>' : '');
      syncStatCards();
    }

    function filterByStatus(card) {
      var status = card.getAttribute('data-filter');
      var sel = document.getElementById('filterStatus');
      sel.value = (sel.value === status) ? '' : status;
      applyFilters();
      syncStatCards();
    }

    function syncStatCards() {
      var current = document.getElementById('filterStatus').value;
      document.querySelectorAll('.stat-card').forEach(function(c) {
        c.classList.toggle('selected', c.getAttribute('data-filter') === current);
      });
    }

    function buildPlanFilter() {
      var sel = document.getElementById('filterPlan');
      sel.innerHTML = '<option value="">All Plans</option>';
      plans.forEach(function(p) {
        var count = allMembers.filter(function(m) { return m.planId === p.id; }).length;
        sel.innerHTML += '<option value="' + p.id + '">' + p.name + ' (' + count + ')</option>';
      });
    }

    var STATUS_TOOLTIPS = {
      active:           'Member has door access.',
      pending:          'Access is being set up right now.',
      in_flight:        'Access is being set up right now.',
      pending_hardware: 'Plan purchased but door system not connected. Add your API key in Locations.',
      partial:          'Some plans provisioned successfully — one or more plans had an issue. Check the error queue.',
      failed:           'Something went wrong — check the error queue for details and next steps.',
      suspended:        'Access paused — plan cancelled or payment lapsed.',
      revoked:          'Access has been revoked.',
      pending_identity: 'Member identity not yet resolved — access will provision once confirmed.'
    };
    function statusLabel(s) {
      var labels = {
        active:           'Active',
        holder_only:      'Plan Holder',
        pending:          'Setting Up',
        in_flight:        'Setting Up',
        pending_hardware: 'Needs Setup',
        partial:          'Partial Access',
        failed:           'Action Needed',
        suspended:        'Paused',
        revoked:          'Revoked',
        pending_identity: 'Pending Identity'
      };
      return labels[s] || (s ? s.charAt(0).toUpperCase() + s.slice(1).replace(/_/g, ' ') : 'Unknown');
    }
    function statusTooltip(s) { return STATUS_TOOLTIPS[s] || ''; }

    function getFiltered() {
      var planVal   = document.getElementById('filterPlan').value;
      var statusVal = document.getElementById('filterStatus').value;
      var roleVal   = document.getElementById('filterRole').value;
      var searchVal = document.getElementById('filterSearch').value.toLowerCase().trim();
      return allMembers.filter(function(m) {
        if (planVal   && m.planId !== planVal)  return false;
        if (statusVal && m.status !== statusVal) return false;
        if (roleVal   && m.role   !== roleVal)   return false;
        if (searchVal) {
          if ((m.firstName + ' ' + m.lastName + ' ' + m.email).toLowerCase().indexOf(searchVal) === -1) return false;
        }
        return true;
      });
    }

    function applyFilters() {
      var filtered  = getFiltered();
      var anyFilter = document.getElementById('filterPlan').value || document.getElementById('filterStatus').value ||
                      document.getElementById('filterRole').value || document.getElementById('filterSearch').value.trim();
      document.getElementById('filterClear').classList.toggle('visible', !!anyFilter);
      document.getElementById('filterCount').textContent = 'Showing ' + filtered.length + ' of ' + allMembers.length;
      var banner = document.getElementById('activeFilterBanner');
      if (prefilterHolder) {
        var holder = allMembers.find(function(m) { return m.id === prefilterHolder; });
        if (holder) {
          document.getElementById('activeFilterText').innerHTML = 'Filtered to <strong>' + holder.firstName + ' ' + holder.lastName + '\'s</strong> plan group';
          banner.classList.add('visible');
        }
      } else {
        banner.classList.remove('visible');
      }
      renderTable(filtered);
      syncStatCards();
    }

    function clearFilters() {
      document.getElementById('filterPlan').value   = '';
      document.getElementById('filterStatus').value = '';
      document.getElementById('filterRole').value   = '';
      document.getElementById('filterSearch').value = '';
      prefilterHolder = '';
      prefilterPlan   = '';
      expandedHolders = {};
      applyFilters();
    }

    function downloadMembersCSV() {
      var rows = getFiltered();
      var headers = ['First Name', 'Last Name', 'Email', 'Status', 'Plan', 'Role', 'Provisioned At'];
      var csvRows = [headers.join(',')];
      rows.forEach(function(m) {
        csvRows.push([
          csvEsc(m.firstName), csvEsc(m.lastName), csvEsc(m.email),
          csvEsc(m.status), csvEsc(m.planName || ''), csvEsc(m.role || ''),
          csvEsc(m.provisionedAt || ''),
        ].join(','));
      });
      var blob = new Blob([csvRows.join('\r\n')], { type: 'text/csv' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'members-' + new Date().toISOString().slice(0, 10) + '.csv';
      a.click();
      URL.revokeObjectURL(a.href);
    }

    function csvEsc(val) {
      var s = String(val == null ? '' : val);
      if (s.indexOf(',') !== -1 || s.indexOf('"') !== -1 || s.indexOf('\n') !== -1) {
        return '"' + s.replace(/"/g, '""') + '"';
      }
      return s;
    }

    function renderTable(filtered) {
      var tbody = document.getElementById('membersBody');
      tbody.innerHTML = '';
      if (filtered.length === 0) {
        var searchVal = document.getElementById('filterSearch').value.trim();
        var emptyMsg = searchVal
          ? 'No members found for \u201c' + searchVal + '\u201d. Try searching by email address instead.'
          : 'No members match those filters. Try adjusting or clearing them.';
        tbody.innerHTML = '<tr class="empty-row"><td colspan="6">' + emptyMsg + '</td></tr>';
        return;
      }
      var hasActiveFilter = document.getElementById('filterSearch').value.trim() ||
                            document.getElementById('filterStatus').value || document.getElementById('filterRole').value;
      if (hasActiveFilter) {
        filtered.forEach(function(m) {
          if (m.holderId) expandedHolders[m.holderId] = true;
          if (m.role === 'holder') expandedHolders[m.id] = true;
        });
      }
      var rendered = {};
      var sorted   = [];
      var holders  = filtered.filter(function(m) { return m.role === 'holder'; });
      holders.forEach(function(h) {
        sorted.push(h);
        var plan = plans.find(function(p) { return p.id === h.planId; });
        if (plan && plan.isMultiMember) {
          var subs = filtered.filter(function(m) { return m.holderId === h.id; });
          subs.forEach(function(s) { sorted.push(s); rendered[s.id] = true; });
        }
      });
      filtered.forEach(function(m) { if (!rendered[m.id] && sorted.indexOf(m) === -1) sorted.push(m); });

      sorted.forEach(function(m) {
        var plan       = plans.find(function(p) { return p.id === m.planId; });
        var isHolder   = m.role === 'holder';
        var isSub      = m.role === 'sub';
        var isMulti    = plan && plan.isMultiMember;
        var initials   = m.firstName[0] + m.lastName[0];
        var avatarClass = isHolder ? 'holder' : m.status;
        var subCount   = allMembers.filter(function(s) { return s.holderId === m.id; }).length;
        var isExpanded = expandedHolders[m.id] === true;

        var tr = document.createElement('tr');
        if (isHolder) tr.className = 'is-holder';
        // Sub-members are shown inline in the holder's panel, not as table rows
        if (isSub && m.holderId) {
          tr.style.display = 'none';
          tr.setAttribute('data-holder', m.holderId);
        }

        var memberCell =
          '<td><div class="member-cell">' +
          (isSub ? '<span class="sub-indent"><span class="sub-connector"></span></span>' : '') +
          '<div class="member-avatar ' + avatarClass + '">' + initials + '</div>' +
          '<div><div class="member-name" style="cursor:pointer;" onclick="openMemberDetail(\'' + m.id + '\')">' + esc(m.firstName) + ' ' + esc(m.lastName) +
            (isHolder && isMulti ? '<span class="member-tag holder">Holder</span>' : '') +
            (isSub ? '<span class="member-tag sub">Additional</span>' : '') +
          '</div><div class="member-email">' + esc(m.email) + '</div></div>' +
          '</div></td>';

        // Plan cell: name + "View plan details" dropdown + "View additional members" for multi-member holders
        var livePlanLabel = m.planDisplay || (plan ? plan.name : null);
        var planDetailBtnId = 'pdb-' + m.id;
        var planDetailPanelId = 'pdp-' + m.id;
        var viewMembersBtnId = 'vmb-' + m.id;
        var subMemberPanelId = 'smp-' + m.id;

        var planCell = '<td><div class="plan-cell-wrap">';
        if (isHolder) {
          planCell += '<div class="plan-badge">' + esc(livePlanLabel || '—') + '</div>';
          if (livePlanLabel && livePlanLabel !== '—') {
            planCell += '<button class="plan-detail-btn" id="' + planDetailBtnId + '" onclick="togglePlanDetail(\'' + m.id + '\')">' +
              'View plan details <span class="pdb-chevron">&#9660;</span></button>';
          }
          if (isMulti && subCount > 0) {
            planCell += '<button class="view-members-btn" id="' + viewMembersBtnId + '" onclick="toggleSubMembers(\'' + m.id + '\')">' +
              '&#128101; View additional members <span class="vmb-chevron">&#9660;</span></button>' +
              '<div class="submember-panel" id="' + subMemberPanelId + '"></div>';
          }
        } else {
          planCell += '<div class="plan-badge" style="color:var(--muted);">Additional member</div>';
        }
        planCell += '</div></td>';

        var roleCell   = '<td>' + (isHolder ? 'Plan Holder' : 'Additional Member') + '</td>';
        var statusCell = '<td><span class="status-pill ' + m.status + '" title="' + esc(statusTooltip(m.status)) + '"><span class="status-dot"></span>' + statusLabel(m.status) + '</span></td>';
        var dateCell   = '<td style="font-size:12px;color:#9aa5b4;">' + m.addedDate + '</td>';
        var actionsCell = '<td style="text-align:right;">' +
          (m.status === 'failed'    ? '<button class="tbl-action-btn retry"  onclick="retryMember(\''  + m.id + '\')" title="Retry">&#8635;</button>' : '') +
          (m.status === 'in_flight' ? '<button class="tbl-action-btn retry"  onclick="unlockMember(\'' + m.id + '\')" title="Clear stuck lock" style="font-size:11px;">&#128275;</button>' : '') +
          '</td>';

        tr.innerHTML = memberCell + planCell + roleCell + statusCell + dateCell + actionsCell;
        tbody.appendChild(tr);

        // Child plan row — hidden by default, revealed by togglePlanDetail()
        if (isHolder && livePlanLabel && livePlanLabel !== '—') {
          var childTr = document.createElement('tr');
          childTr.className = 'plan-child-row hidden';
          childTr.id = 'pcr-' + m.id;
          childTr.innerHTML = '<td colspan="6"><div class="plan-cards-wrap"></div></td>';
          tbody.appendChild(childTr);
        }
      });
    }

    function toggleHolderExpand(holderId, event) {
      event.stopPropagation();
      var current = expandedHolders[holderId] === true;
      expandedHolders[holderId] = !current;
      document.querySelectorAll('tr[data-holder="' + holderId + '"]').forEach(function(row) {
        row.style.display = current ? 'none' : '';
      });
      var btn = event.target.closest('.expand-btn');
      if (btn) btn.classList.toggle('open');
    }

    function buildPlanCardsHtml(m) {
      var planNames = m.planNames && m.planNames.length > 0 ? m.planNames : (m.planName ? [m.planName] : []);
      var planIds   = m.planIds || [];
      var validUntils = m.planValidUntils || [];
      if (planNames.length === 0) return '<div style="color:var(--muted);font-size:12px;padding:8px 0;">No plan data available.</div>';

      return planNames.map(function(pName, idx) {
        var pid     = planIds[idx] || null;
        var detail  = pid ? wixPlanDetails[pid] : null;
        var vu      = validUntils[idx] || null;

        // Section header = Wix plan name (what member bought); fallback to mapping name
        var displayTitle = (detail && detail.name) ? detail.name : pName;

        var rows = '';
        if (detail && detail.wixPrice) {
          rows += '<div class="plan-detail-row"><span class="plan-detail-label">Price</span><span class="plan-detail-value" style="color:#16A34A;">' + esc(detail.wixPrice) + '</span></div>';
        }
        rows += '<div class="plan-detail-row"><span class="plan-detail-label">Type</span><span class="plan-detail-value">' + (detail && detail.type === 'booking_service' ? 'Booking Service' : 'Pricing Plan') + '</span></div>';
        rows += '<div class="plan-detail-row"><span class="plan-detail-label">Plan status</span><span class="plan-detail-value">' + esc((detail && detail.status) || 'active') + '</span></div>';

        var expiryVal, expiryStyle;
        if (vu) {
          expiryVal = new Date(vu).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
          expiryStyle = 'color:var(--teal);';
        } else {
          expiryVal = 'No expiry';
          expiryStyle = 'color:var(--muted);font-weight:400;';
        }
        rows += '<div class="plan-detail-row"><span class="plan-detail-label">Access ends</span><span class="plan-detail-value" style="' + expiryStyle + '">' + expiryVal + '</span></div>';
        rows += '<div class="plan-detail-row"><span class="plan-detail-label">Member since</span><span class="plan-detail-value">' + esc(m.addedDate) + '</span></div>';

        return '<div class="plan-card"><div class="plan-card-title">' + esc(displayTitle) + '</div>' + rows + '</div>';
      }).join('');
    }

    function togglePlanDetail(memberId) {
      var btn      = document.getElementById('pdb-' + memberId);
      var childRow = document.getElementById('pcr-' + memberId);
      if (!btn || !childRow) return;
      var isOpen = !childRow.classList.contains('hidden');
      btn.classList.toggle('open', !isOpen);
      childRow.classList.toggle('hidden', isOpen);

      if (!isOpen) {
        var wrap = childRow.querySelector('.plan-cards-wrap');
        if (wrap && wrap.innerHTML === '') {
          var m = allMembers.find(function(x) { return x.id === memberId; });
          wrap.innerHTML = m ? buildPlanCardsHtml(m) : '<div style="color:var(--muted);font-size:12px;">No plan data available.</div>';
        }
      }
    }

    function toggleSubMembers(holderId) {
      var btn = document.getElementById('vmb-' + holderId);
      var panel = document.getElementById('smp-' + holderId);
      if (!btn || !panel) return;
      var isOpen = btn.classList.contains('open');
      btn.classList.toggle('open');
      panel.classList.toggle('open');

      if (!isOpen && panel.innerHTML === '') {
        var subs = allMembers.filter(function(m) { return m.holderId === holderId; });
        if (subs.length === 0) {
          panel.innerHTML = '<div class="submember-row" style="color:var(--muted);font-size:12px;">No additional members added yet.</div>';
          return;
        }
        var html = '';
        subs.forEach(function(s) {
          var initials = (s.firstName[0] || '?') + (s.lastName[0] || '');
          html += '<div class="submember-row">' +
            '<div class="submember-avatar ' + s.status + '">' + initials + '</div>' +
            '<div style="flex:1;min-width:0;">' +
              '<div class="submember-name">' + esc(s.firstName) + ' ' + esc(s.lastName) + '</div>' +
              '<div class="submember-email">' + esc(s.email) + '</div>' +
            '</div>' +
            '<span class="status-pill ' + s.status + '" style="font-size:10px;padding:2px 6px;"><span class="status-dot"></span>' + statusLabel(s.status) + '</span>' +
          '</div>';
        });
        panel.innerHTML = html;
      }
    }

    function openDrawer(holderId) {
      var holder = allMembers.find(function(m) { return m.id === holderId; });
      if (!holder) return;
      var plan = plans.find(function(p) { return p.id === holder.planId; });
      var subs = allMembers.filter(function(m) { return m.holderId === holderId; });
      document.getElementById('drawerTitle').textContent = holder.firstName + ' ' + holder.lastName + '\'s Plan Group';
      var body = '<div class="drawer-section-label">Plan Holder</div>' +
        '<div class="drawer-member-card"><div class="member-avatar holder">' + holder.firstName[0] + holder.lastName[0] + '</div>' +
        '<div class="drawer-member-info"><div class="drawer-member-name">' + holder.firstName + ' ' + holder.lastName + '</div><div class="drawer-member-email">' + holder.email + '</div></div>' +
        '<span class="status-pill ' + holder.status + '"><span class="status-dot"></span>' + statusLabel(holder.status) + '</span></div>' +
        '<div class="drawer-section-label">Plan Details</div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Plan</span><span class="drawer-info-value">' + (plan ? plan.name : '—') + '</span></div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Members</span><span class="drawer-info-value">' + (subs.length + 1) + ' / ' + (plan ? plan.maxMembers : '—') + '</span></div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Member since</span><span class="drawer-info-value">' + holder.addedDate + '</span></div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Phone</span><span class="drawer-info-value">' + holder.phone + '</span></div>' +
        '<div class="drawer-section-label">Additional Members (' + subs.length + ' of ' + (plan ? plan.maxMembers - 1 : '—') + ')</div>';
      if (subs.length === 0) {
        body += '<div style="text-align:center;padding:20px;color:#9aa5b4;font-size:13px;">No additional members added yet.</div>';
      } else {
        subs.forEach(function(s) {
          body += '<div class="drawer-member-card"><div class="member-avatar ' + s.status + '">' + s.firstName[0] + s.lastName[0] + '</div>' +
            '<div class="drawer-member-info"><div class="drawer-member-name">' + s.firstName + ' ' + s.lastName + '</div><div class="drawer-member-email">' + s.email + ' · ' + s.phone + '</div></div>' +
            '<div class="drawer-member-actions"><span class="status-pill ' + s.status + '" style="margin-right:4px;"><span class="status-dot"></span>' + statusLabel(s.status) + '</span>' +
            (s.status === 'failed' ? '<button class="drawer-action-btn retry" onclick="retryMember(\'' + s.id + '\')" title="Retry">&#8635;</button>' : '') + '</div></div>';
        });
      }
      document.getElementById('drawerBody').innerHTML = body;
      document.getElementById('drawerFooter').innerHTML =
        '<button class="drawer-btn secondary" onclick="closeDrawer()">Close</button>' +
        '<button class="drawer-btn primary" onclick="showToast(\'info\', \'Opening editor...\')">Edit Members</button>';
      document.getElementById('drawerOverlay').classList.add('visible');
      document.getElementById('drawer').classList.add('open');
    }

    function closeDrawer() {
      document.getElementById('drawer').classList.remove('open');
      setTimeout(function() { document.getElementById('drawerOverlay').classList.remove('visible'); }, 250);
    }

    var _drawerMemberId = null;
    var _drawerClientId = null;
    var _diagLoaded     = false;
    var _timelineLoaded = false;

    function openMemberDetail(memberId) {
      var m = allMembers.find(function(x) { return x.id === memberId; });
      if (!m) return;
      _drawerMemberId = memberId;
      _drawerClientId = urlParams.get('clientId') || null;
      _diagLoaded     = false;
      _timelineLoaded = false;

      document.getElementById('drawerTitle').textContent = m.firstName + ' ' + m.lastName;

      function fmtSec(s) {
        if (s == null) return null;
        if (s < 60)   return s + 's';
        return Math.round(s / 60) + 'm ' + (s % 60) + 's';
      }
      function latColor(s) {
        if (s == null) return 'var(--text)';
        if (s <= 10)  return 'var(--sage-dark)';
        if (s <= 30)  return 'var(--brand)';
        return 'var(--red)';
      }

      var planNamesArr = Array.isArray(m.planNames) && m.planNames.length > 0 ? m.planNames : (m.planName ? [m.planName] : []);
      var planValue = planNamesArr.length > 1
        ? planNamesArr.map(function(p) { return esc(p); }).join('<br>')
        : esc(planNamesArr[0] || '—');

      var detailsHtml =
        '<div class="drawer-section-label">Member Details</div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Email</span><span class="drawer-info-value">' + esc(m.email) + '</span></div>' +
        '<div class="drawer-info-row" style="align-items:flex-start;"><span class="drawer-info-label">Plan' + (planNamesArr.length > 1 ? 's' : '') + '</span><span class="drawer-info-value" style="text-align:right;">' + planValue + '</span></div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Status</span><span class="drawer-info-value"><span class="status-pill ' + m.status + '"><span class="status-dot"></span>' + statusLabel(m.status) + '</span></span></div>' +
        (m.status === 'partial' ? '<div style="font-size:12px;color:var(--amber);padding:6px 0 2px;">One or more plans had a provisioning issue. Check the error queue for details.</div>' : '') +
        '<div class="drawer-info-row"><span class="drawer-info-label">Added</span><span class="drawer-info-value">' + esc(m.addedDate) + '</span></div>';

      if (m.total_s != null) {
        detailsHtml +=
          '<div class="drawer-section-label" style="margin-top:18px;">Provisioning Speed</div>' +
          '<div class="drawer-info-row"><span class="drawer-info-label">Purchase → Door Open</span>' +
            '<span class="drawer-info-value" style="color:' + latColor(m.total_s) + ';">' + fmtSec(m.total_s) + '</span></div>' +
          '<div class="drawer-info-row"><span class="drawer-info-label">Ingest lag</span>' +
            '<span class="drawer-info-value">' + (fmtSec(m.ingest_s) || '—') + '</span></div>' +
          '<div class="drawer-info-row"><span class="drawer-info-label">Processing time</span>' +
            '<span class="drawer-info-value">' + (fmtSec(m.processing_s) || '—') + '</span></div>';
        if (m.webhook_received_at) {
          detailsHtml += '<div class="drawer-info-row"><span class="drawer-info-label">Purchase received</span>' +
            '<span class="drawer-info-value" style="font-size:11px;">' + new Date(m.webhook_received_at).toLocaleString() + '</span></div>';
        }
        if (m.kisi_confirmed_at) {
          detailsHtml += '<div class="drawer-info-row"><span class="drawer-info-label">Access confirmed</span>' +
            '<span class="drawer-info-value" style="font-size:11px;">' + new Date(m.kisi_confirmed_at).toLocaleString() + '</span></div>';
        }
      } else if (_drawerClientId) {
        detailsHtml += '<div class="drawer-section-label" style="margin-top:18px;">Provisioning Speed</div>' +
          '<div style="font-size:12px;color:var(--muted);padding:8px 0;">No timing data — webhook log and provisioning records must both exist for latency to be calculated.</div>';
      }

      var tabsHtml = _drawerClientId
        ? '<div class="drawer-tabs">' +
            '<div class="drawer-tab active" onclick="switchMemberTab(\'details\')">Details</div>' +
            '<div class="drawer-tab" onclick="switchMemberTab(\'diagnose\')">Diagnose</div>' +
            '<div class="drawer-tab" onclick="switchMemberTab(\'timeline\')">Timeline</div>' +
          '</div>'
        : '';

      document.getElementById('drawerBody').innerHTML =
        tabsHtml +
        '<div id="drawerTabDetails" class="drawer-tab-content active">' + detailsHtml + '</div>' +
        '<div id="drawerTabDiagnose" class="drawer-tab-content"><div style="color:var(--muted);font-size:13px;padding:16px 0;">Click Diagnose to run checks.</div></div>' +
        '<div id="drawerTabTimeline" class="drawer-tab-content"><div style="color:var(--muted);font-size:13px;padding:16px 0;">Click Timeline to load events.</div></div>';

      // Members API returns plan holders only (sub-members deferred — family plan post-HOG).
      // reconcileMember server-side guards against sub-members anyway, so this is belt-and-suspenders.
      var canReconcile = !!_drawerClientId;
      document.getElementById('drawerFooter').innerHTML =
        '<button class="drawer-btn secondary" onclick="closeDrawer()">Close</button>' +
        (canReconcile ? '<button class="drawer-btn secondary" id="reconcileBtn" onclick="reconcileMember(\'' + m.id + '\')" title="Re-check Wix and the hardware system, repair any database drift">Reconcile Member</button>' : '') +
        (m.status === 'failed'    ? '<button class="drawer-btn primary" onclick="retryMember(\''  + m.id + '\');closeDrawer()">Retry</button>' : '') +
        (m.status === 'in_flight' ? '<button class="drawer-btn primary" onclick="unlockMember(\'' + m.id + '\');closeDrawer()">Clear Stuck Lock</button>' : '');

      document.getElementById('drawerOverlay').classList.add('visible');
      document.getElementById('drawer').classList.add('open');
    }

    function switchMemberTab(tab) {
      document.querySelectorAll('.drawer-tab').forEach(function(el) { el.classList.remove('active'); });
      document.querySelectorAll('.drawer-tab-content').forEach(function(el) { el.classList.remove('active'); });

      var tabMap = { details: 'drawerTabDetails', diagnose: 'drawerTabDiagnose', timeline: 'drawerTabTimeline' };
      document.getElementById(tabMap[tab]).classList.add('active');
      document.querySelectorAll('.drawer-tab')[['details','diagnose','timeline'].indexOf(tab)].classList.add('active');

      if (tab === 'diagnose' && !_diagLoaded) {
        _diagLoaded = true;
        var el = document.getElementById('drawerTabDiagnose');
        el.innerHTML = '<div style="color:var(--muted);font-size:13px;padding:16px 0;">Running checks…</div>';
        var url = '/operator/' + _drawerClientId + '/members/' + _drawerMemberId + '/diagnose';
        apiFetch(url).then(function(res) { return res.json(); }).then(function(data) {
          var verdictLabel = { healthy: '✓ Healthy', degraded: '⚠ Degraded', failed: '✗ Failed', mismatch: '⚠ Mismatch' };
          var html = '<div class="verdict-banner ' + esc(data.verdict) + '">' + esc(verdictLabel[data.verdict] || data.verdict) + '</div>';
          html += '<div>';
          (data.findings || []).forEach(function(f) {
            html += '<div class="finding-item"><span class="finding-level ' + esc(f.level) + '">' + esc(f.level) + '</span>' +
              '<span class="finding-msg"><span class="finding-code">' + esc(f.code) + '</span>' + esc(f.message) + '</span></div>';
          });
          html += '</div>';
          if (data.member) {
            html += '<div class="drawer-section-label" style="margin-top:16px;">State Summary</div>' +
              '<div class="drawer-info-row"><span class="drawer-info-label">Access status</span><span class="drawer-info-value">' + esc(data.member.access_status || '—') + '</span></div>' +
              '<div class="drawer-info-row"><span class="drawer-info-label">Role assignments</span><span class="drawer-info-value">' + (data.roles ? data.roles.length : 0) + '</span></div>' +
              '<div class="drawer-info-row"><span class="drawer-info-label">Access sources</span><span class="drawer-info-value">' + (data.sources ? data.sources.length : 0) + '</span></div>';
          }
          el.innerHTML = html;
        }).catch(function(err) {
          el.innerHTML = '<div style="color:var(--red);font-size:13px;padding:16px 0;">Failed to load diagnostic data.</div>';
        });
      }

      if (tab === 'timeline' && !_timelineLoaded) {
        _timelineLoaded = true;
        var el2 = document.getElementById('drawerTabTimeline');
        el2.innerHTML = '<div style="color:var(--muted);font-size:13px;padding:16px 0;">Loading events…</div>';
        var url2 = '/operator/' + _drawerClientId + '/members/' + _drawerMemberId + '/timeline';
        apiFetch(url2).then(function(res) { return res.json(); }).then(function(data) {
          if (!data.timeline || data.timeline.length === 0) {
            el2.innerHTML = '<div style="color:var(--muted);font-size:13px;padding:16px 0;">No timeline events found.</div>';
            return;
          }
          var html = '<div>';
          data.timeline.forEach(function(ev) {
            var srcClass = esc(ev.source || 'unknown');
            var ts = ev.created_at ? new Date(ev.created_at).toLocaleString() : '—';
            html += '<div class="tl-item">' +
              '<span class="tl-source ' + srcClass + '">' + esc(ev.source) + '</span>' +
              '<div class="tl-body">' +
                '<div class="tl-event">' + esc(ev.event_type || ev.error_code || '—') + '</div>' +
                (ev.detail ? '<div class="tl-detail">' + esc(ev.detail) + '</div>' : '') +
              '</div>' +
              '<div class="tl-ts">' + esc(ts) + '</div>' +
            '</div>';
          });
          html += '</div>';
          el2.innerHTML = html;
        }).catch(function(err) {
          el2.innerHTML = '<div style="color:var(--red);font-size:13px;padding:16px 0;">Failed to load timeline.</div>';
        });
      }
    }

    function retryMember(memberId) {
      var m = allMembers.find(function(x) { return x.id === memberId; });
      if (!m || m.status !== 'failed') return;
      m.status = 'pending';
      renderStats(); applyFilters();
      showToast('info', 'Retrying access for ' + m.firstName + '...');
      setTimeout(function() {
        m.status = 'active';
        renderStats(); applyFilters();
        showToast('success', m.firstName + ' now has access');
      }, 2500);
    }

    // Build the humanized result panel from /members/:id/sync response
    function renderReconcileResult(data) {
      var actionMap = {
        ok: {
          tone: 'healthy',
          title: 'All clear',
          body: 'Everything checks out. This member’s access matches what they’re paying for, and the database is in sync with the hardware.',
        },
        repaired: {
          tone: 'healthy',
          title: 'Repaired ' + (data.repaired || 0) + ' issue' + ((data.repaired || 0) === 1 ? '' : 's'),
          body: 'Found and fixed missing database entries for this member. Hardware access wasn’t affected — we just rebuilt the tracking records. The repair runs in the background and should finish within a minute.',
        },
        access_restored: {
          tone: 'healthy',
          title: 'Access restored',
          body: 'We restored door access for this member. They had an active plan but weren’t provisioned in the hardware. They should have access within a minute or two.',
        },
        access_removed: {
          tone: 'degraded',
          title: 'Access removed',
          body: 'We removed door access for this member. Their plan is no longer active, but they were still in the hardware system.',
        },
        needs_attention: {
          tone: 'degraded',
          title: 'Needs your attention',
          body: 'We found something that needs a human decision before we change anything. See the details below.',
        },
        wix_unavailable: {
          tone: 'failed',
          title: 'Couldn’t reach Wix',
          body: 'We couldn’t pull this member’s plan information from Wix right now. No changes were made. Try again in a few minutes.',
        },
        no_identity: {
          tone: 'degraded',
          title: 'Member not provisioned',
          body: 'No record of this member in AccessSync yet. They may not have purchased a plan, or onboarding may not be complete.',
        },
        sub_member_skipped: {
          tone: 'degraded',
          title: 'Reconcile the plan holder instead',
          body: 'This is a sub-member on a multi-member plan. Their access is managed through the plan holder — reconcile the holder to fix this member’s access.',
        },
      };
      var spec = actionMap[data.action] || {
        tone: 'failed',
        title: 'Unexpected response',
        body: 'AccessSync returned a result it didn’t recognize. Refresh and try again, or contact support.',
      };

      var html = '<div class="verdict-banner ' + spec.tone + '" style="margin-top:8px;">' + esc(spec.title) + '</div>';
      html += '<div style="font-size:12.5px;color:var(--text);line-height:1.55;margin-bottom:14px;">' + esc(spec.body) + '</div>';

      // Action counts (only for grant/revoke/repair actions)
      var counts = [];
      if (data.granted)  counts.push(data.granted  + ' grant'  + (data.granted  === 1 ? '' : 's')  + ' queued');
      if (data.revoked)  counts.push(data.revoked  + ' revoke' + (data.revoked  === 1 ? '' : 's') + ' queued');
      if (data.repaired) counts.push(data.repaired + ' repair' + (data.repaired === 1 ? '' : 's') + ' queued');
      if (counts.length) {
        html += '<div style="font-size:11.5px;color:var(--muted);margin-bottom:14px;">' + esc(counts.join(' · ')) + '</div>';
      }

      // Alerts list
      if (data.alerts && data.alerts.length) {
        html += '<div class="drawer-section-label" style="margin-top:8px;">What we found</div>';
        data.alerts.forEach(function(a) {
          var level = (data.action === 'wix_unavailable') ? 'error' : 'warn';
          html += '<div class="finding-item">' +
            '<span class="finding-level ' + level + '">' + (level === 'error' ? 'Issue' : 'Review') + '</span>' +
            '<span class="finding-msg">' + esc(a.detail || a.code) + '</span>' +
          '</div>';
        });

        // Add a contextual link for known integrity codes
        var hasMappingIssue = data.alerts.some(function(a) {
          return a.code === 'no_mapping_for_plan' ||
                 a.code === 'mapping_missing_group' ||
                 a.code === 'duplicate_mappings_for_plan';
        });
        if (hasMappingIssue && _drawerClientId) {
          html += '<div style="margin-top:12px;">' +
            '<a href="/plan-mapping?clientId=' + esc(_drawerClientId) + '" ' +
            'style="font-size:12px;color:var(--brand);text-decoration:none;font-weight:600;">' +
            'Open Plan Mappings →</a></div>';
        }
      }

      return html;
    }

    function reconcileMember(memberId) {
      if (!_drawerClientId) { showToast('error', 'No client context — refresh and try again.'); return; }
      var btn = document.getElementById('reconcileBtn');
      if (btn) { btn.disabled = true; btn.textContent = 'Reconciling…'; }

      // Insert result panel above the tabs so it's the first thing the operator sees
      var body = document.getElementById('drawerBody');
      var existing = document.getElementById('reconcileResultPanel');
      if (existing) existing.remove();
      var panel = document.createElement('div');
      panel.id = 'reconcileResultPanel';
      panel.style.padding = '0 24px 12px';
      panel.innerHTML = '<div style="color:var(--muted);font-size:12.5px;padding:14px 0;">Re-checking Wix and the hardware system…</div>';
      body.insertBefore(panel, body.firstChild);

      var url = '/operator/' + _drawerClientId + '/members/' + memberId + '/sync';
      apiFetch(url, { method: 'POST' })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data || !data.ok) {
            panel.innerHTML = '<div class="verdict-banner failed" style="margin-top:8px;">Reconcile failed</div>' +
              '<div style="font-size:12.5px;color:var(--text);line-height:1.55;">' +
              esc((data && data.error) || 'AccessSync couldn’t complete the reconcile. Try again, or check the error queue.') +
              '</div>';
            return;
          }
          panel.innerHTML = renderReconcileResult(data);
        })
        .catch(function() {
          panel.innerHTML = '<div class="verdict-banner failed" style="margin-top:8px;">Request failed</div>' +
            '<div style="font-size:12.5px;color:var(--text);line-height:1.55;">' +
            'We couldn’t reach AccessSync to run the reconcile. Check your connection and try again.' +
            '</div>';
        })
        .then(function() {
          if (btn) { btn.disabled = false; btn.textContent = 'Reconcile Member'; }
        });
    }

    function unlockMember(memberId) {
      var m = allMembers.find(function(x) { return x.id === memberId; });
      if (!m || m.status !== 'in_flight') return;
      var clientId = urlParams.get('clientId');
      showToast('info', 'Clearing stuck lock for ' + m.firstName + '...');
      apiFetch('/operator/' + clientId + '/members/' + memberId + '/unlock', { method: 'POST' })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            m.status = 'pending';
            renderStats(); applyFilters();
            showToast('success', 'Lock cleared — ' + m.firstName + ' will retry on next sync');
          } else {
            showToast('error', data.error || 'Could not clear lock');
          }
        })
        .catch(function() { showToast('error', 'Request failed — try again'); });
    }

    renderStats();
    buildPlanFilter();
    document.getElementById('pageSubtitle').textContent = 'All members across your plans. View access status, manage additional members, and resolve provisioning issues.';
    if (prefilterPlan)   document.getElementById('filterPlan').value = prefilterPlan;
    if (prefilterHolder) {
      var h = allMembers.find(function(m) { return m.id === prefilterHolder; });
      if (h) { document.getElementById('filterPlan').value = h.planId; expandedHolders[prefilterHolder] = true; }
    }

    // Show loading skeleton when clientId is present; empty state when not
    (function initLoadState() {
      var clientId = urlParams.get('clientId');
      var tbody = document.getElementById('membersBody');
      if (!tbody) return;
      if (!clientId) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:48px 20px;color:var(--muted);font-size:13px;">' +
          '<strong style="display:block;color:var(--text2);margin-bottom:6px;">No session active</strong>' +
          'Navigate here from the Dashboard to load your members.</td></tr>';
        return;
      }
      var skeletonRow = '<tr>' + Array(6).fill('<td><div style="height:14px;border-radius:4px;background:var(--border);animation:skeleton-pulse 1.2s ease-in-out infinite;"></div></td>').join('') + '</tr>';
      tbody.innerHTML = Array(5).fill(skeletonRow).join('');
    })();

    applyFilters();
    if (prefilterHolder) setTimeout(function() { openDrawer(prefilterHolder); }, 400);

    // ══ OB-29: Live data loading ══════════════════════════════════
    (function loadLiveMembers() {
      var clientId = urlParams.get('clientId');
      if (!clientId) return;

      // Pre-fetch Wix plan details for plan detail dropdowns
      apiFetch('/operator/' + clientId + '/wix-plans')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          (d.plans || []).forEach(function(p) {
            wixPlanDetails[p.id] = p;
          });
        }).catch(function() {});

      apiFetch('/operator/' + clientId + '/members?limit=100')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.members || !d.members.length) {
            allMembers = [];
            plans = [];
            renderStats();
            buildPlanFilter();
            applyFilters();
            return;
          }
          allMembers = d.members.map(function(m) {
            // Use real name/email fields when present. If Wix hasn't yet populated
            // them (member created by reconciliation synthetic grant, or pending
            // Gate 2 identity recovery), show a truncated memberId as a readable
            // placeholder rather than the raw UUID or a fabricated @member address.
            var shortId = (m.platform_member_id || '').slice(0, 8);
            var hasRealName = !!(m.first_name || m.last_name || m.display_name);
            var firstName = m.first_name || (m.display_name ? m.display_name.split(' ')[0] : null) || ('Member ' + shortId);
            var lastName  = m.last_name  || (m.display_name ? m.display_name.split(' ').slice(1).join(' ') : '') || '';

            // Plan(s) the member is on. API returns plan_name (first) + plan_names[] (all).
            // Multi-mapping members show "Plan A + N more" to fit the column; full list
            // available on the detail drawer.
            var planNames = Array.isArray(m.plan_names) ? m.plan_names.filter(Boolean) : [];
            var primaryPlan = m.plan_name || planNames[0] || null;
            var planDisplay = !primaryPlan
              ? '—'
              : (planNames.length > 1 ? primaryPlan + ' + ' + (planNames.length - 1) + ' more' : primaryPlan);

            return {
              id: m.id,
              firstName: firstName,
              lastName: lastName,
              email: m.email || '(pending identity)',
              phone: '',
              planId: '',
              planName: primaryPlan,    // for filter grouping
              planDisplay: planDisplay, // for row rendering
              planNames: planNames,     // full list for drawer/modal
              planIds: Array.isArray(m.plan_ids) ? m.plan_ids.filter(Boolean) : [],
              planValidUntils: Array.isArray(m.plan_valid_untils) ? m.plan_valid_untils : [],
              role: m.role || 'holder',
              status: m.effective_status || m.access_status || 'pending',
              addedDate: m.provisioned_at ? new Date(m.provisioned_at).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : '—',
              holderId: m.holder_id || null,
              pendingIdentity: !hasRealName,
              // Latency fields — null when webhook_log / processed_event_ids correlation unavailable
              webhook_received_at: m.webhook_received_at || null,
              enqueued_at:         m.enqueued_at         || null,
              kisi_confirmed_at:   m.kisi_confirmed_at   || null,
              ingest_s:            m.ingest_s     != null ? m.ingest_s     : null,
              processing_s:        m.processing_s != null ? m.processing_s : null,
              total_s:             m.total_s      != null ? m.total_s      : null,
            };
          });
          plans = [];
          renderStats();
          buildPlanFilter();
          applyFilters();
        }).catch(function(e) { console.error('Members load error:', e); });
    })();
  </script>
</body>
</html>
