<%#
  @file members.ejs
  @layer admin/pages
  @route /members
  @role member-management
  @data GET /operator/:clientId/members?limit=200, GET /operator/:clientId/error-summary, GET /admin/clients/:clientId
  @tab Members
  @features search, filter by status, plan-detail expand, sub-member nesting, error indicators, drawer, CSV export
  @stack React 18 + Babel-standalone (CDN) — Members page v2 (2026-04-27). Owner Dashboard remains Svelte. See OB: stack consolidation post-HOG.
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Members · AccessSync' }) %>
  <style>
    :root{
      /* Brand — locked (DR-014) */
      --brand:#4F6EF7;
      --brand-dark:#3D5BD4;
      --brand-dim:rgba(79,110,247,.11);
      --brand-glow:rgba(79,110,247,.22);
      /* Status */
      --sage:#4ADE80;
      --sage-dark:#22C55E;
      --sage-dim:rgba(74,222,128,.11);
      --red:#FF4D6A;
      --red-dim:rgba(255,77,106,.10);
      --amber:#F5A623;
      --amber-dim:rgba(245,166,35,.10);
      /* Light surfaces */
      --bg:#F2F4F7;
      --surface:#F9FAFB;
      --card:#FFFFFF;
      --border:#E2E5EA;
      --border2:#D0D5DD;
      --text:#1A2130;
      --text2:#4A5568;
      --muted:#8896A8;
      /* Shadows */
      --shadow:0 1px 4px rgba(0,0,0,.07), 0 1px 2px rgba(0,0,0,.04);
      --shadow-md:0 4px 16px rgba(0,0,0,.09);
      --shadow-lg:0 24px 60px -20px rgba(0,0,0,.25), 0 8px 24px -10px rgba(0,0,0,.18);
      /* Radii */
      --r-card:14px;
      --r-btn:8px;
      --r-pill:6px;
      --r-tag:4px;
      --row-py:14px;
    }
    [data-mode="dark"]{
      --bg:#0D0F12;
      --surface:#13161B;
      --card:#1A1E25;
      --border:#252B35;
      --border2:#2E3644;
      --text:#E8ECF2;
      --text2:#8B96A8;
      --muted:#4A5568;
      --shadow:0 1px 4px rgba(0,0,0,.4), 0 1px 2px rgba(0,0,0,.25);
      --shadow-md:0 4px 16px rgba(0,0,0,.5);
      --shadow-lg:0 24px 60px -20px rgba(0,0,0,.7), 0 8px 24px -10px rgba(0,0,0,.5);
    }
    *,*::before,*::after{box-sizing:border-box}
    html,body{margin:0;padding:0;background:var(--bg);color:var(--text)}
    body{
      font-family:'Sora',ui-sans-serif,system-ui,-apple-system,sans-serif;
      font-size:14px;line-height:1.45;
      -webkit-font-smoothing:antialiased;
      min-height:100vh;
    }
    .tabular{font-variant-numeric:tabular-nums}
    button{font-family:inherit}
    [data-density="compact"]{--row-py:9px}
    [data-density="regular"]{--row-py:14px}
    [data-density="comfy"]{--row-py:18px}

    /* ---- Page shell ---- */
    .page{max-width:1240px;margin:0 auto;padding:36px 28px 80px}
    .page-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:28px}
    .crumbs{font-size:12px;color:var(--muted);letter-spacing:.01em;display:flex;gap:8px;align-items:center;margin-bottom:10px}
    .crumbs a{color:var(--muted);text-decoration:none}
    .crumbs a:hover{color:var(--text2)}
    .crumbs .sep{color:var(--border2)}
    h1.title{
      font-family:'Sora',sans-serif;font-weight:600;
      font-size:30px;line-height:1.15;letter-spacing:-.02em;
      color:var(--text);margin:0;
    }
    .subtitle{color:var(--muted);font-size:13.5px;margin-top:6px;font-weight:400}
    .head-actions{display:flex;gap:8px;align-items:center}

    /* ---- Stat strip ---- */
    .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:22px}
    .stat{
      background:var(--card);padding:16px 18px;
      border:1px solid var(--border);border-radius:var(--r-card);
      display:flex;flex-direction:column;gap:6px;
      box-shadow:var(--shadow);
    }
    .stat-label{font-size:11px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);font-weight:500}
    .stat-value{font-size:28px;line-height:1.1;color:var(--text);font-weight:600;letter-spacing:-.01em}
    .stat-meta{font-size:12px;color:var(--muted);display:flex;align-items:center;gap:6px;font-weight:400}
    .stat-meta .delta-up{color:var(--sage-dark);font-weight:500}
    .stat-meta .delta-down{color:var(--red);font-weight:500}

    /* ---- Toolbar ---- */
    .toolbar{
      display:flex;align-items:center;gap:10px;
      padding:10px 12px;background:var(--card);
      border:1px solid var(--border);border-radius:var(--r-card) var(--r-card) 0 0;
      border-bottom:none;
    }
    .search{
      flex:1;display:flex;align-items:center;gap:8px;
      padding:8px 10px;border-radius:var(--r-btn);
      background:var(--surface);border:1px solid var(--border);
      transition:border-color .15s, box-shadow .15s, background .15s;
    }
    .search:focus-within{border-color:var(--brand);background:var(--card);box-shadow:0 0 0 3px var(--brand-glow)}
    .search input{
      flex:1;border:0;outline:0;background:transparent;color:var(--text);
      font:inherit;font-size:13.5px;
    }
    .search input::placeholder{color:var(--muted)}
    .search kbd{
      font-family:inherit;font-size:10px;color:var(--muted);
      background:var(--card);border:1px solid var(--border);
      border-radius:var(--r-tag);padding:1px 5px;letter-spacing:.04em;font-weight:500;
    }

    .filter-chip{
      display:inline-flex;align-items:center;gap:6px;
      padding:6px 10px;border-radius:var(--r-pill);
      border:1px solid var(--border);background:var(--card);
      color:var(--text2);font-size:12.5px;font-weight:500;
      cursor:default;transition:all .12s;
    }
    .filter-chip:hover{border-color:var(--border2);color:var(--text)}
    .filter-chip.active{
      border-color:var(--brand);background:var(--brand-dim);
      color:var(--brand);
    }
    .filter-chip .count{
      background:var(--surface);color:inherit;font-size:11px;
      padding:0 5px;border-radius:var(--r-tag);font-weight:600;
      border:1px solid var(--border);
    }
    [data-mode="dark"] .filter-chip .count{background:var(--surface)}
    .filter-chip.active .count{background:rgba(79,110,247,.16);border-color:transparent;color:var(--brand)}

    .tb-divider{width:1px;align-self:stretch;background:var(--border);margin:2px 2px}

    .btn{
      display:inline-flex;align-items:center;gap:6px;
      padding:8px 12px;border-radius:var(--r-btn);font-size:13px;font-weight:500;
      border:1px solid transparent;cursor:default;transition:all .12s;
      white-space:nowrap;
    }
    .btn-primary{background:var(--brand);color:#fff;border-color:var(--brand)}
    .btn-primary:hover{background:var(--brand-dark);border-color:var(--brand-dark)}
    .btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px var(--brand-glow)}
    .btn-ghost{background:var(--card);color:var(--text2);border-color:var(--border)}
    .btn-ghost:hover{background:var(--surface);color:var(--text);border-color:var(--border2)}
    .btn-icon{
      width:30px;height:30px;padding:0;justify-content:center;
      background:var(--card);color:var(--muted);border-color:var(--border);
    }
    .btn-icon:hover{color:var(--text);background:var(--surface)}

    /* ---- Card / table ---- */
    .members-card{
      background:var(--card);border:1px solid var(--border);
      border-radius:0 0 var(--r-card) var(--r-card);
      overflow:hidden;box-shadow:var(--shadow);
    }
    .members-tbl{width:100%;border-collapse:collapse;font-size:13.5px}
    .members-tbl thead th{
      text-align:left;font-weight:500;font-size:11px;
      letter-spacing:.04em;text-transform:uppercase;color:var(--muted);
      padding:11px 18px;background:var(--surface);
      border-bottom:1px solid var(--border);
      position:sticky;top:0;z-index:1;
    }
    .members-tbl thead th .sort-btn{
      background:none;border:0;padding:0;color:inherit;font:inherit;
      letter-spacing:inherit;text-transform:inherit;
      display:inline-flex;align-items:center;gap:4px;cursor:default;
    }
    .members-tbl thead th .sort-btn:hover{color:var(--text2)}
    .members-tbl thead th.sorted{color:var(--text2)}
    .sort-arrow{font-size:9px;opacity:.7}

    .members-tbl tbody tr{
      border-bottom:1px solid var(--border);
      transition:background .12s;
    }
    .members-tbl tbody tr:last-child{border-bottom:0}
    .members-tbl tbody tr.row-main:hover{background:var(--surface)}
    .members-tbl tbody td{
      padding:var(--row-py) 18px;vertical-align:middle;
      color:var(--text2);
    }
    .members-tbl tr.row-sub td{
      padding-top:8px;padding-bottom:8px;
      background:rgba(79,110,247,.04);
      position:relative;
    }
    [data-mode="dark"] .members-tbl tr.row-sub td{background:rgba(79,110,247,.06)}
    .members-tbl tr.row-sub:first-of-type td{padding-top:10px}
    .members-tbl tr.row-sub:hover td{background:rgba(79,110,247,.07)}
    [data-mode="dark"] .members-tbl tr.row-sub:hover td{background:rgba(79,110,247,.09)}

    /* ---- Member cell ---- */
    .member-cell{display:flex;align-items:center;gap:12px;min-width:0}
    .avatar{
      width:36px;height:36px;flex:none;border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      font-size:12px;font-weight:600;letter-spacing:.01em;
      background:var(--brand-dim);color:var(--brand);
      border:1px solid var(--border);
    }
    .avatar.sm{width:28px;height:28px;font-size:10.5px}
    .avatar.holder{background:var(--brand-dim);color:var(--brand);border-color:rgba(79,110,247,.22)}
    .avatar.active{background:var(--sage-dim);color:var(--sage-dark);border-color:rgba(74,222,128,.25)}
    .avatar.suspended{background:var(--red-dim);color:var(--red);border-color:rgba(255,77,106,.25)}
    .avatar.pending{background:var(--amber-dim);color:var(--amber);border-color:rgba(245,166,35,.25)}
    .avatar.expired{background:var(--surface);color:var(--muted);border-color:var(--border2)}
    .member-name{
      font-weight:500;color:var(--text);font-size:14px;
      letter-spacing:-.005em;display:flex;align-items:center;gap:8px;
      cursor:default;
    }
    .member-name:hover .name-link{color:var(--brand)}
    .member-email{font-size:12px;color:var(--muted);margin-top:1px;font-weight:400}
    .member-tag{
      font-size:10px;font-weight:500;text-transform:uppercase;
      letter-spacing:.04em;padding:1px 6px;border-radius:var(--r-tag);
      background:var(--surface);color:var(--muted);
      border:1px solid var(--border);
    }
    .member-tag.sub{
      background:var(--brand-dim);color:var(--brand);
      border-color:rgba(79,110,247,.22);
    }

    .sub-indent{
      width:28px;display:inline-flex;justify-content:center;flex:none;
      position:relative;align-self:stretch;
    }
    .sub-indent::before{
      content:"";position:absolute;left:13px;top:-8px;bottom:50%;
      border-left:1.5px solid var(--brand);opacity:.55;
    }
    .sub-indent::after{
      content:"";position:absolute;left:13px;right:-2px;top:50%;
      border-top:1.5px solid var(--brand);opacity:.55;width:14px;
      border-bottom-left-radius:6px;
    }

    /* ---- Plan group header row ---- */
    .row-plan-group td{
      padding:10px 18px 6px;
      background:var(--surface);
      border-bottom:1px solid var(--border);
      border-top:2px solid var(--border);
    }
    .members-tbl tbody tr.row-plan-group:first-child td{border-top:0}
    .plan-group-head{
      display:flex;align-items:center;gap:10px;
    }
    .plan-group-toggle{
      background:none;border:0;padding:0;
      display:inline-flex;align-items:center;gap:8px;
      font:inherit;color:var(--text);font-size:13px;font-weight:600;
      letter-spacing:-.01em;cursor:default;
    }
    .plan-group-toggle:hover{color:var(--brand)}
    .plan-group-chev{
      display:inline-flex;align-items:center;justify-content:center;
      width:18px;height:18px;border-radius:5px;
      background:var(--card);border:1px solid var(--border);
      font-size:8px;color:var(--muted);
      transition:transform .18s;flex:none;
    }
    .plan-group-chev.open{transform:rotate(90deg)}
    .plan-group-count{
      font-size:11px;font-weight:500;color:var(--muted);
      background:var(--card);border:1px solid var(--border);
      padding:1px 7px;border-radius:99px;
    }
    .plan-group-details-btn{
      margin-left:auto;background:none;border:0;padding:2px 0;
      font:inherit;font-size:11.5px;color:var(--muted);font-weight:400;
      display:inline-flex;align-items:center;gap:4px;cursor:default;
    }
    .plan-group-details-btn:hover{color:var(--text2)}
    .plan-group-details-btn .chev{
      display:inline-block;font-size:8px;line-height:1;
      transition:transform .2s;
    }
    .plan-group-details-btn.open .chev{transform:rotate(180deg)}

    /* Row indentation when inside a plan group */
    .row-grouped td:first-child .member-cell{padding-left:12px}

    /* ---- Plan cell ---- */
    .plan-cell{display:flex;flex-direction:column;align-items:flex-start;gap:4px}
    .plan-badge{
      display:inline-flex;align-items:center;gap:6px;
      padding:3px 9px;border-radius:var(--r-pill);
      font-size:12px;font-weight:500;
      background:var(--brand-dim);color:var(--brand);
      border:1px solid rgba(79,110,247,.22);
    }
    .plan-badge.solo{background:var(--surface);color:var(--text2);border-color:var(--border)}
    .plan-badge.couples{}
    .plan-badge.family{background:rgba(79,110,247,.04);color:var(--brand-dark);border-color:rgba(79,110,247,.18)}
    [data-mode="dark"] .plan-badge.family{background:rgba(79,110,247,.06);color:#8FA4FA;border-color:rgba(79,110,247,.22)}
    .plan-badge.day-pass{background:var(--surface);color:var(--text2);border-color:var(--border);border-style:dashed}
    .plan-badge.muted{background:transparent;color:var(--muted);border-color:var(--border)}

    .plan-meta-btn{
      display:inline-flex;align-items:center;gap:5px;
      background:none;border:0;padding:2px 0;
      font:inherit;font-size:11.5px;color:var(--muted);font-weight:400;
      cursor:default;
    }
    .plan-meta-btn:hover{color:var(--text2)}
    .plan-meta-btn .chev{
      display:inline-block;font-size:8px;line-height:1;
      transition:transform .2s;color:var(--muted);
    }
    .plan-meta-btn.open .chev{transform:rotate(180deg)}

    /* ---- Plan detail panel ---- */
    .plan-detail-row-wrap{background:var(--surface)}
    .plan-detail-row-wrap td{padding:0 18px 14px}
    .plan-detail-card{
      display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
      background:var(--border);border:1px solid var(--border);
      border-radius:10px;overflow:hidden;margin-left:48px;margin-top:-2px;
      box-shadow:var(--shadow);
    }
    .pd-cell{background:var(--card);padding:10px 14px;display:flex;flex-direction:column;gap:3px}
    .pd-label{font-size:10.5px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);font-weight:500}
    .pd-value{font-size:13px;color:var(--text);font-weight:500}
    .pd-value.muted{color:var(--muted);font-weight:400}

    /* ---- Status pill ---- */
    .status-pill{
      display:inline-flex;align-items:center;gap:6px;
      padding:3px 8px 3px 7px;border-radius:99px;
      font-size:11.5px;font-weight:500;
      background:var(--sage-dim);color:var(--sage-dark);
      border:1px solid rgba(74,222,128,.25);
      white-space:nowrap;
    }
    .status-pill .dot{
      width:6px;height:6px;border-radius:50%;background:var(--sage-dark);
      box-shadow:0 0 0 2px rgba(74,222,128,.22);
    }
    .status-pill.active .dot{animation:pulse 2.4s ease-in-out infinite}
    @keyframes pulse{
      0%,100%{box-shadow:0 0 0 2px rgba(74,222,128,.22)}
      50%{box-shadow:0 0 0 4px rgba(74,222,128,.08)}
    }
    .status-pill.holder{
      background:var(--brand-dim);color:var(--brand);
      border-color:rgba(79,110,247,.25);
    }
    .status-pill.holder .dot{background:var(--brand);box-shadow:0 0 0 2px var(--brand-glow)}
    .status-pill.suspended{
      background:var(--red-dim);color:var(--red);
      border-color:rgba(255,77,106,.25);
    }
    .status-pill.suspended .dot{background:var(--red);box-shadow:0 0 0 2px rgba(255,77,106,.22)}
    .status-pill.pending{
      background:var(--amber-dim);color:var(--amber);
      border-color:rgba(245,166,35,.25);
    }
    .status-pill.pending .dot{background:var(--amber);box-shadow:0 0 0 2px rgba(245,166,35,.22)}
    .status-pill.expired{background:var(--surface);color:var(--muted);border-color:var(--border)}
    .status-pill.expired .dot{background:var(--muted);box-shadow:none}

    /* ---- Inline error indicator ---- */
    .err-link{
      display:inline-flex;align-items:center;gap:5px;
      font-size:11.5px;color:var(--red);font-weight:500;
      background:var(--red-dim);
      border:1px solid rgba(255,77,106,.25);
      padding:2px 7px 2px 6px;border-radius:var(--r-pill);
      cursor:default;margin-top:4px;
    }
    .err-link:hover{background:rgba(255,77,106,.16)}
    .err-link .ic{width:11px;height:11px}

    /* Error banner above table */
    .err-banner{
      display:flex;align-items:center;gap:10px;
      padding:10px 14px;background:var(--red-dim);
      border:1px solid rgba(255,77,106,.22);
      border-bottom:none;
      color:var(--red);font-size:13px;font-weight:500;
    }
    .err-banner .count-pill{
      background:var(--red);color:#fff;font-size:11px;font-weight:600;
      padding:1px 7px;border-radius:99px;
    }
    .err-banner .show-link{
      margin-left:auto;font-size:12px;color:var(--red);font-weight:500;
      background:transparent;border:0;cursor:default;text-decoration:underline;text-underline-offset:2px;
    }

    /* Highlighted error row */
    tr.row-main.has-error td{background:rgba(255,77,106,.04)}
    tr.row-main.has-error:hover td{background:rgba(255,77,106,.07)}

    /* Error popover */
    .err-pop{
      position:absolute;right:0;top:calc(100% + 4px);
      width:300px;z-index:31;
      background:var(--card);border:1px solid var(--border);
      border-left:3px solid var(--red);
      border-radius:10px;box-shadow:var(--shadow-lg);
      padding:14px;
    }
    .err-pop h4{
      margin:0 0 6px;font-size:12px;font-weight:600;color:var(--red);
      letter-spacing:.02em;text-transform:uppercase;
      display:flex;align-items:center;gap:6px;
    }
    .err-pop p{margin:0 0 10px;font-size:13px;color:var(--text);line-height:1.5;font-weight:400}
    .err-pop .meta{font-size:11px;color:var(--muted);font-weight:400}

    /* ---- Row actions ---- */
    .row-actions{display:flex;justify-content:flex-end;align-items:center;gap:2px;opacity:0;transition:opacity .12s}
    tr.row-main:hover .row-actions, tr.row-sub:hover .row-actions, .row-actions.open{opacity:1}
    .row-btn{
      width:28px;height:28px;border-radius:7px;
      background:transparent;border:0;color:var(--muted);
      cursor:default;display:inline-flex;align-items:center;justify-content:center;
    }
    .row-btn:hover{background:var(--card);color:var(--text);box-shadow:0 0 0 1px var(--border)}

    .menu-anchor{position:relative}
    .menu{
      position:absolute;right:0;top:calc(100% + 4px);
      min-width:180px;z-index:30;
      background:var(--card);border:1px solid var(--border);
      border-radius:10px;box-shadow:var(--shadow-lg);
      padding:4px;
    }
    .menu-item{
      display:flex;align-items:center;gap:8px;
      width:100%;padding:7px 9px;border-radius:6px;
      background:transparent;border:0;color:var(--text2);
      font:inherit;font-size:13px;font-weight:400;text-align:left;cursor:default;
    }
    .menu-item:hover{background:var(--surface);color:var(--text)}
    .menu-item.danger{color:var(--red)}
    .menu-item.danger:hover{background:var(--red-dim)}
    .menu-item.warn{color:var(--amber)}
    .menu-item.warn:hover{background:var(--amber-dim)}
    .menu-sep{height:1px;background:var(--border);margin:4px 2px}

    /* ---- Sub-members nested panel ---- */
    .submember-row{
      display:flex;align-items:center;gap:10px;
      padding:6px 10px;border-radius:var(--r-btn);
      background:var(--card);border:1px solid var(--border);
    }
    .submember-row .name{font-size:12.5px;font-weight:500;color:var(--text);min-width:0;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}
    .submember-row .email{font-size:11px;color:var(--muted);min-width:0;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;font-weight:400}

    /* ---- Pagination ---- */
    .pagination{
      display:flex;align-items:center;justify-content:space-between;
      padding:12px 18px;background:var(--surface);
      border-top:1px solid var(--border);font-size:12.5px;color:var(--muted);font-weight:400;
    }
    .pg-controls{display:flex;align-items:center;gap:4px}
    .pg-btn{
      width:28px;height:28px;border-radius:7px;
      background:var(--card);border:1px solid var(--border);color:var(--text2);
      cursor:default;display:inline-flex;align-items:center;justify-content:center;
      font-size:12px;font-weight:500;
    }
    .pg-btn:hover:not(:disabled){background:var(--surface);color:var(--text);border-color:var(--border2)}
    .pg-btn.active{background:var(--brand);color:#fff;border-color:var(--brand)}
    .pg-btn:disabled{opacity:.4}

    /* ---- Drawer ---- */
    .scrim{position:fixed;inset:0;background:rgba(13,15,18,.45);z-index:50;
      backdrop-filter:blur(2px);opacity:0;pointer-events:none;transition:opacity .2s}
    .scrim.open{opacity:1;pointer-events:auto}
    .drawer{
      position:fixed;top:0;right:0;bottom:0;width:min(520px,92vw);
      background:var(--card);border-left:1px solid var(--border);
      box-shadow:var(--shadow-lg);z-index:51;
      transform:translateX(100%);transition:transform .26s cubic-bezier(.32,.72,.24,1);
      display:flex;flex-direction:column;
    }
    .drawer.open{transform:translateX(0)}
    .drawer-head{
      padding:20px 24px;border-bottom:1px solid var(--border);
      display:flex;align-items:center;justify-content:space-between;gap:12px;
    }
    .drawer-body{padding:24px;overflow-y:auto;flex:1}
    .drawer-section{margin-bottom:24px}
    .drawer-section h3{
      font-size:11px;letter-spacing:.04em;text-transform:uppercase;
      color:var(--muted);margin:0 0 10px;font-weight:600;
    }
    .kv{display:grid;grid-template-columns:120px 1fr;gap:8px 16px;font-size:13px}
    .kv dt{color:var(--muted);font-weight:400}
    .kv dd{margin:0;color:var(--text);font-weight:500}
    .door-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
    .door-cell{
      aspect-ratio:1;border-radius:var(--r-tag);background:var(--surface);
      border:1px solid var(--border);
      display:flex;align-items:center;justify-content:center;
      font-size:9px;color:var(--muted);
    }
    .door-cell.hit{background:var(--sage-dim);border-color:rgba(74,222,128,.28);color:var(--sage-dark)}
    .door-cell.hit-strong{background:var(--sage-dark);border-color:var(--sage-dark);color:#fff}
    .activity{display:flex;flex-direction:column;gap:0}
    .activity-item{
      display:flex;gap:14px;padding:10px 0;
      border-bottom:1px solid var(--border);
    }
    .activity-item:last-child{border-bottom:0}
    .activity-time{font-size:11.5px;color:var(--muted);width:90px;flex:none;font-weight:400}
    .activity-text{font-size:13px;color:var(--text2);font-weight:400}
    .activity-text strong{font-weight:500;color:var(--text)}

    /* ---- Empty / loading shimmer ---- */
    .empty{padding:48px 24px;text-align:center;color:var(--muted)}

    /* ---- Footer hint ---- */
    .hint{margin-top:14px;font-size:11.5px;color:var(--muted);display:flex;align-items:center;gap:6px;font-weight:400}

    .ic{display:inline-block;width:14px;height:14px;flex:none;color:currentColor}
    .ic-12{width:12px;height:12px}
    .ic-16{width:16px;height:16px}

    [data-density="compact"] .avatar{width:30px;height:30px;font-size:11px}
    [data-density="compact"] .member-email{display:none}
    [data-density="compact"] .plan-detail-card{margin-top:-6px}
    [data-density="comfy"] .avatar{width:40px;height:40px;font-size:13px}

    /* ---- Brand mark ---- */
    .brand-mark{
      display:inline-flex;align-items:center;gap:8px;
      font-weight:600;font-size:13px;color:var(--text);letter-spacing:-.01em;
    }
    .brand-mark .glyph{
      width:22px;height:22px;border-radius:6px;background:var(--brand);
      display:inline-flex;align-items:center;justify-content:center;color:#fff;
      box-shadow:0 0 0 3px var(--brand-glow);
    }
  </style>
</head>
<body data-session-role="<%= sessionRole %>"<% if (loginUrl) { %> data-login-url="<%= loginUrl %>"<% } %> data-client-id="<%= clientId %>">
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <script>
    // Server-injected operator session context. Read by /members-bridge.js.
    window.__CLIENT_ID = "<%= clientId %>";
  </script>

  <div id="root"></div>

  <!-- React + Babel (CDN, no build step). Pinned per Members.html prototype. -->
  <script src="https://unpkg.com/react@18.3.1/umd/react.development.js" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" crossorigin="anonymous"></script>
  <script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" crossorigin="anonymous"></script>

  <!-- Bridge runs before JSX so window.MEMBERS / window.__MEMBERS_CONTEXT exist
       (initially empty). React app mounts, bridge fetch resolves async, fires
       'membersLoaded' which the App listens for and re-renders. -->
  <script src="/members-bridge.js"></script>

  <!-- JSX components — order matters (dependencies first). -->
  <script type="text/babel" src="/tweaks-panel.jsx"></script>
  <script type="text/babel" src="/members-data.jsx"></script>
  <script type="text/babel" src="/members-icons.jsx"></script>
  <script type="text/babel" src="/members-parts.jsx"></script>
  <script type="text/babel" src="/members-app.jsx"></script>

  <!-- Shared operator nav: subnav rendering, dark-mode toggle, logout. -->
  <script src="/operator-nav.js"></script>
</body>
</html>
