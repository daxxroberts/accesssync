<%#
  @file members.ejs
  @layer admin/pages
  @route /members
  @role member-management
  @data GET /operator/:clientId/members (paginated, filterable), GET /operator/:clientId/locations
  @tab Members
  @features search, filter by status/location, detail drawer, CSV export
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Operator Dashboard: Members' }) %>
  <style>
    .dash-content { max-width: 1020px; }
    .page-header { flex-wrap: wrap; gap: 16px; }
    .page-header-left { }

    /* Role toggle */
    .role-toggle { display: flex; background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 3px; gap: 2px; flex-shrink: 0; }
    .role-btn { padding: 3px 10px; border-radius: 20px; font-family: 'Sora', sans-serif; font-size: 10px; font-weight: 600; cursor: pointer; border: none; background: transparent; color: var(--muted); transition: all 0.15s; white-space: nowrap; }
    .role-btn.active { background: var(--brand); color: #fff; }

    /* Stats strip */
    .stats-strip { display: flex; gap: 12px; flex-wrap: wrap; }
    .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 18px; min-width: 130px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s; }
    .stat-card:hover { border-color: var(--border2); box-shadow: var(--shadow); }
    .stat-card.selected { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand-dim); }
    .stat-value { font-size: 22px; font-weight: 700; color: var(--text); }
    .stat-label { font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-top: 2px; }
    .stat-card.alert .stat-value { color: var(--red); }
    .stat-card.alert.selected { border-color: var(--red); box-shadow: 0 0 0 2px var(--red-dim); }

    /* Filters */
    .filters-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
    .filter-select { padding: 8px 32px 8px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px; font-family: inherit; color: var(--text); background: var(--card); outline: none; cursor: pointer; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%238896A8' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 12px center; transition: border-color 0.15s; }
    .filter-select:focus { border-color: var(--brand); }
    .filter-search { padding: 8px 12px 8px 32px; border: 1px solid var(--border); border-radius: 8px; font-size: 13px; font-family: inherit; color: var(--text); background: var(--card); outline: none; min-width: 220px; transition: border-color 0.15s; background-image: url("data:image/svg+xml,%3Csvg width='14' height='14' viewBox='0 0 14 14' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='6' cy='6' r='4.5' stroke='%238896A8' stroke-width='1.5'/%3E%3Cpath d='M9.5 9.5L12.5 12.5' stroke='%238896A8' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: 10px center; }
    .filter-search:focus { border-color: var(--brand); }
    .filter-clear { font-size: 12px; font-weight: 600; color: var(--brand); background: none; border: none; cursor: pointer; padding: 8px 6px; display: none; }
    .filter-clear.visible { display: inline; }
    .filter-clear:hover { text-decoration: underline; }
    .filter-count { font-size: 12px; color: var(--muted); margin-left: auto; }

    /* Active filter banner */
    .active-filter { display: none; align-items: center; gap: 8px; background: var(--brand-dim); border: 1px solid var(--brand-dim); border-radius: 8px; padding: 8px 14px; margin-bottom: 16px; font-size: 13px; color: var(--brand); }
    .active-filter.visible { display: flex; }
    .active-filter strong { font-weight: 700; }
    .active-filter-close { margin-left: auto; background: none; border: none; cursor: pointer; font-size: 16px; color: var(--brand); padding: 0 4px; line-height: 1; }
    .active-filter-close:hover { color: var(--brand-dark); }

    /* Members table */
    .members-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
    .members-tbl { width: 100%; border-collapse: collapse; }
    .members-tbl th { text-align: left; font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; padding: 12px 16px; border-bottom: 1px solid var(--border); background: var(--surface); }
    .members-tbl td { padding: 12px 16px; font-size: 13px; color: var(--text); border-bottom: 1px solid var(--border); vertical-align: middle; }
    .members-tbl tbody tr { transition: background 0.12s; }
    .members-tbl tbody tr:hover { background: var(--surface); }
    .members-tbl tbody tr:last-child td { border-bottom: none; }
    .members-tbl tbody tr.is-holder { background: var(--surface); }
    .members-tbl tbody tr.is-holder:hover { background: var(--surface); }

    /* Member cell */
    .member-cell { display: flex; align-items: center; gap: 10px; }
    .member-avatar { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: #fff; flex-shrink: 0; }
    .member-avatar.holder    { background: linear-gradient(135deg, #1B3A5C, #2E5D8A); }
    .member-avatar.active    { background: linear-gradient(135deg, var(--sage-dark), #22c55e); }
    .member-avatar.pending   { background: linear-gradient(135deg, #d97706, #f59e0b); }
    .member-avatar.failed    { background: linear-gradient(135deg, var(--red), #ef4444); }
    .member-avatar.suspended { background: linear-gradient(135deg, #6b7280, #9ca3af); }
    .member-name  { font-weight: 600; }
    .member-email { font-size: 12px; color: var(--muted); margin-top: 1px; }
    .member-tag { display: inline-block; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; padding: 2px 6px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
    .member-tag.holder { color: var(--brand); background: var(--brand-dim); }
    .member-tag.sub    { color: var(--text2); background: var(--surface); }

    /* Status pill */
    .status-pill { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 6px; }
    .status-pill.active           { background: var(--sage-dim);  color: var(--sage-dark); }
    .status-pill.pending          { background: var(--amber-dim); color: var(--amber); }
    .status-pill.pending_hardware { background: var(--amber-dim); color: var(--amber); }
    .status-pill.failed           { background: var(--red-dim);   color: var(--red); }
    .status-pill.suspended        { background: var(--surface);   color: var(--muted); }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }
    .status-pill.active .status-dot           { background: var(--sage-dark); }
    .status-pill.pending .status-dot          { background: var(--amber); animation: pulse 1.4s ease-in-out infinite; }
    .status-pill.pending_hardware .status-dot { background: var(--amber); animation: pulse 1.4s ease-in-out infinite; }
    .status-pill.failed .status-dot           { background: var(--red); }
    .status-pill.suspended .status-dot        { background: var(--muted); }

    .plan-badge     { font-size: 11px; font-weight: 600; color: var(--text); }
    .plan-badge-sub { font-size: 11px; color: var(--muted); }

    /* Action buttons */
    .tbl-action-btn { width: 28px; height: 28px; border-radius: 6px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.12s; margin-left: 4px; }
    .tbl-action-btn:hover       { border-color: var(--brand); color: var(--brand); background: var(--brand-dim); }
    .tbl-action-btn.danger:hover{ border-color: var(--red);   color: var(--red);   background: var(--red-dim); }
    .tbl-action-btn.retry:hover { border-color: var(--amber); color: var(--amber); background: var(--amber-dim); }

    /* Sub-member indent */
    .sub-indent { padding-left: 42px; }
    .sub-connector { display: inline-block; width: 16px; height: 16px; border-left: 2px solid var(--border); border-bottom: 2px solid var(--border); border-radius: 0 0 0 6px; margin-right: 8px; vertical-align: middle; position: relative; top: -2px; }
    .expand-btn { width: 22px; height: 22px; border-radius: 5px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; font-size: 10px; color: var(--muted); transition: all 0.12s; margin-right: 8px; flex-shrink: 0; }
    .expand-btn:hover { border-color: var(--brand); color: var(--brand); background: var(--brand-dim); }
    .expand-btn.open { transform: rotate(90deg); }

    /* Empty state */
    .empty-row td { text-align: center; padding: 40px 16px; color: var(--muted); font-size: 14px; }

    /* Pagination */
    .pagination { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-top: 1px solid var(--border); background: var(--surface); }
    .page-info { font-size: 12px; color: var(--muted); }
    .page-btns { display: flex; gap: 4px; }
    .page-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: var(--card); font-size: 12px; font-weight: 600; color: var(--text2); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.12s; }
    .page-btn:hover  { border-color: var(--brand); color: var(--brand); }
    .page-btn.active { border-color: var(--brand); background: var(--brand); color: #fff; }
    .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Drawer */
    .drawer-overlay { display: none; position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.3); z-index: 500; }
    .drawer-overlay.visible { display: block; }
    .drawer { position: fixed; top: 0; right: -480px; bottom: 0; width: 460px; max-width: 100vw; background: var(--card); box-shadow: -8px 0 32px rgba(0,0,0,0.12); z-index: 600; transition: right 0.25s ease; display: flex; flex-direction: column; }
    .drawer.open { right: 0; }
    .drawer-header { padding: 20px 24px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
    .drawer-title { font-size: 18px; font-weight: 700; color: var(--text); }
    .drawer-close { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: var(--card); cursor: pointer; font-size: 16px; color: var(--text2); display: flex; align-items: center; justify-content: center; transition: all 0.12s; }
    .drawer-close:hover { border-color: var(--red); color: var(--red); background: var(--red-dim); }
    .drawer-body { flex: 1; overflow-y: auto; padding: 20px 24px; }
    .drawer-section-label { font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 10px; margin-top: 20px; }
    .drawer-section-label:first-child { margin-top: 0; }
    .drawer-info-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
    .drawer-info-label { color: var(--text2); }
    .drawer-info-value { color: var(--text); font-weight: 600; }
    .drawer-member-card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin-bottom: 8px; display: flex; align-items: center; gap: 12px; }
    .drawer-member-card .member-avatar { width: 36px; height: 36px; font-size: 12px; }
    .drawer-member-info { flex: 1; }
    .drawer-member-name  { font-size: 14px; font-weight: 600; color: var(--text); }
    .drawer-member-email { font-size: 12px; color: var(--muted); }
    .drawer-member-actions { display: flex; gap: 4px; }
    .drawer-action-btn { width: 30px; height: 30px; border-radius: 7px; border: 1px solid var(--border); background: var(--card); color: var(--muted); font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.12s; }
    .drawer-action-btn:hover        { border-color: var(--brand); color: var(--brand); background: var(--brand-dim); }
    .drawer-action-btn.danger:hover { border-color: var(--red);   color: var(--red);   background: var(--red-dim); }
    .drawer-action-btn.retry:hover  { border-color: var(--amber); color: var(--amber); background: var(--amber-dim); }
    .drawer-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; gap: 8px; }
    .drawer-btn { padding: 10px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; border: none; transition: all 0.15s; }
    .drawer-btn.primary   { background: var(--brand); color: #fff; flex: 1; }
    .drawer-btn.primary:hover   { background: var(--brand-dark); }
    .drawer-btn.secondary { background: var(--surface); color: var(--text2); }
    .drawer-btn.secondary:hover { background: var(--border); }

    /* Toast override (members uses bottom: 24px) */
    .toast { bottom: 24px; transform: translateX(-50%) translateY(60px); font-family: 'Sora', sans-serif; }
    .toast.visible { transform: translateX(-50%) translateY(0); }

    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

    @media (max-width: 640px) {
      .topbar { padding: 0 16px; }
      .page-title { font-size: 20px; }
      .page-header { flex-direction: column; }
      .stats-strip { width: 100%; flex-direction: column; }
      .stat-card { flex: 1; min-width: unset; }
      .filters-bar { flex-direction: column; align-items: stretch; }
      .filter-select, .filter-search { width: 100%; min-width: unset; }
      .drawer { width: 100vw; }
      .sub-indent { padding-left: 24px; }
      .members-tbl th:nth-child(3), .members-tbl td:nth-child(3),
      .members-tbl th:nth-child(5), .members-tbl td:nth-child(5) { display: none; }
    }
    @media (min-width: 769px) {
      .dash-content { padding: 32px 24px; }
    }
  </style>
</head>
<body>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <div class="dash-content">
    <div class="page-header">
      <div class="page-header-left">
        <div class="page-title">Members</div>
        <div class="page-subtitle" id="pageSubtitle"></div>
      </div>
      <button class="btn btn-sm btn-ghost" onclick="downloadMembersCSV()" style="margin-left:auto;">&#11015; Export CSV</button>
      <div class="stats-strip" id="statsStrip"></div>
    </div>

    <div class="filters-bar" id="filtersBar">
      <select class="filter-select" id="filterPlan" onchange="applyFilters()">
        <option value="">All Plans</option>
      </select>
      <select class="filter-select" id="filterStatus" onchange="applyFilters()">
        <option value="">All Statuses</option>
        <option value="active">Active</option>
        <option value="pending">Pending</option>
        <option value="pending_hardware">Needs Setup</option>
        <option value="failed">Action Needed</option>
        <option value="suspended">Paused</option>
      </select>
      <select class="filter-select" id="filterRole" onchange="applyFilters()">
        <option value="">All Roles</option>
        <option value="holder">Plan Holders</option>
        <option value="sub">Additional Members</option>
      </select>
      <input class="filter-search" id="filterSearch" type="text" placeholder="Search by name or email..." oninput="clearTimeout(window._searchDebounce); window._searchDebounce = setTimeout(applyFilters, 300)"/>
      <button class="filter-clear" id="filterClear" onclick="clearFilters()">Clear filters</button>
      <div class="filter-count" id="filterCount"></div>
    </div>

    <div class="active-filter" id="activeFilterBanner">
      <span id="activeFilterText"></span>
      <button class="active-filter-close" onclick="clearFilters()">&times;</button>
    </div>

    <div class="members-card">
      <table class="members-tbl">
        <thead>
          <tr>
            <th style="width:30%;">Member</th>
            <th>Plan</th>
            <th>Role</th>
            <th>Access Status</th>
            <th>Added</th>
            <th style="width:80px;"></th>
          </tr>
        </thead>
        <tbody id="membersBody"></tbody>
      </table>
      <div class="pagination" id="pagination"></div>
    </div>
  </div>

  <div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
  <div class="drawer" id="drawer">
    <div class="drawer-header">
      <div class="drawer-title" id="drawerTitle"></div>
      <button class="drawer-close" onclick="closeDrawer()">&times;</button>
    </div>
    <div class="drawer-body" id="drawerBody"></div>
    <div class="drawer-footer" id="drawerFooter"></div>
  </div>

  <div class="toast" id="toast"></div>

  <script src="/operator-nav.js"></script>
  <script>
    var plans = [
      { id: 'plan-001', name: 'Individual Monthly',       isMultiMember: false },
      { id: 'plan-002', name: 'Family Monthly Membership', isMultiMember: true, maxMembers: 5 },
      { id: 'plan-003', name: 'Couples Premium',           isMultiMember: true, maxMembers: 2 },
      { id: 'plan-004', name: 'Premium Annual',            isMultiMember: false },
    ];

    var allMembers = [
      { id: 'm001', firstName: 'Daxx',   lastName: 'Roberts', email: 'daxx@example.com',   phone: '+1 (555) 100-0001', planId: 'plan-002', role: 'holder', status: 'active',    addedDate: 'Mar 15, 2026', holderId: null },
      { id: 'm002', firstName: 'Sarah',  lastName: 'Roberts', email: 'sarah@example.com',  phone: '+1 (555) 100-0002', planId: 'plan-002', role: 'sub',    status: 'active',    addedDate: 'Mar 16, 2026', holderId: 'm001' },
      { id: 'm003', firstName: 'Marcus', lastName: 'Roberts', email: 'marcus@example.com', phone: '+1 (555) 100-0003', planId: 'plan-002', role: 'sub',    status: 'pending',   addedDate: 'Mar 28, 2026', holderId: 'm001' },
      { id: 'm004', firstName: 'Kim',    lastName: 'Roberts', email: 'kim@example.com',    phone: '+1 (555) 100-0004', planId: 'plan-002', role: 'sub',    status: 'failed',    addedDate: 'Mar 28, 2026', holderId: 'm001' },
      { id: 'm005', firstName: 'Maria',  lastName: 'Chen',    email: 'maria@example.com',  phone: '+1 (555) 200-0001', planId: 'plan-002', role: 'holder', status: 'active',    addedDate: 'Mar 10, 2026', holderId: null },
      { id: 'm006', firstName: 'Leo',    lastName: 'Chen',    email: 'leo@example.com',    phone: '+1 (555) 200-0002', planId: 'plan-002', role: 'sub',    status: 'active',    addedDate: 'Mar 11, 2026', holderId: 'm005' },
      { id: 'm007', firstName: 'Nina',   lastName: 'Chen',    email: 'nina@example.com',   phone: '+1 (555) 200-0003', planId: 'plan-002', role: 'sub',    status: 'active',    addedDate: 'Mar 11, 2026', holderId: 'm005' },
      { id: 'm008', firstName: 'James',  lastName: 'Wilson',  email: 'james@example.com',  phone: '+1 (555) 300-0001', planId: 'plan-002', role: 'holder', status: 'active',    addedDate: 'Feb 20, 2026', holderId: null },
      { id: 'm009', firstName: 'Tanya',  lastName: 'Wilson',  email: 'tanya@example.com',  phone: '+1 (555) 300-0002', planId: 'plan-002', role: 'sub',    status: 'active',    addedDate: 'Feb 21, 2026', holderId: 'm008' },
      { id: 'm010', firstName: 'Jake',   lastName: 'Wilson',  email: 'jake@example.com',   phone: '+1 (555) 300-0003', planId: 'plan-002', role: 'sub',    status: 'active',    addedDate: 'Feb 21, 2026', holderId: 'm008' },
      { id: 'm011', firstName: 'Ella',   lastName: 'Wilson',  email: 'ella@example.com',   phone: '+1 (555) 300-0004', planId: 'plan-002', role: 'sub',    status: 'active',    addedDate: 'Mar 1, 2026',  holderId: 'm008' },
      { id: 'm012', firstName: 'Ryan',   lastName: 'Wilson',  email: 'ryan@example.com',   phone: '+1 (555) 300-0005', planId: 'plan-002', role: 'sub',    status: 'suspended', addedDate: 'Mar 5, 2026',  holderId: 'm008' },
      { id: 'm013', firstName: 'Tony',   lastName: 'Park',    email: 'tony@example.com',   phone: '+1 (555) 400-0001', planId: 'plan-003', role: 'holder', status: 'active',    addedDate: 'Mar 1, 2026',  holderId: null },
      { id: 'm014', firstName: 'Grace',  lastName: 'Park',    email: 'grace@example.com',  phone: '+1 (555) 400-0002', planId: 'plan-003', role: 'sub',    status: 'active',    addedDate: 'Mar 1, 2026',  holderId: 'm013' },
      { id: 'm015', firstName: 'Lisa',   lastName: 'Nguyen',  email: 'lisa@example.com',   phone: '+1 (555) 500-0001', planId: 'plan-003', role: 'holder', status: 'active',    addedDate: 'Mar 8, 2026',  holderId: null },
      { id: 'm016', firstName: 'David',  lastName: 'Tran',    email: 'david@example.com',  phone: '+1 (555) 500-0002', planId: 'plan-003', role: 'sub',    status: 'active',    addedDate: 'Mar 9, 2026',  holderId: 'm015' },
      { id: 'm017', firstName: 'Alex',   lastName: 'Morgan',  email: 'alex.m@example.com', phone: '+1 (555) 600-0001', planId: 'plan-001', role: 'holder', status: 'active',    addedDate: 'Jan 15, 2026', holderId: null },
      { id: 'm018', firstName: 'Jordan', lastName: 'Blake',   email: 'jordan@example.com', phone: '+1 (555) 600-0002', planId: 'plan-001', role: 'holder', status: 'active',    addedDate: 'Feb 1, 2026',  holderId: null },
      { id: 'm019', firstName: 'Amber',  lastName: 'Knox',    email: 'amber@example.com',  phone: '+1 (555) 600-0003', planId: 'plan-001', role: 'holder', status: 'failed',    addedDate: 'Mar 27, 2026', holderId: null },
      { id: 'm020', firstName: 'Chris',  lastName: 'Martin',  email: 'chris@example.com',  phone: '+1 (555) 700-0001', planId: 'plan-004', role: 'holder', status: 'active',    addedDate: 'Jan 5, 2026',  holderId: null },
    ];

    var expandedHolders = {};
    var urlParams = new URLSearchParams(window.location.search);
    var prefilterPlan   = urlParams.get('plan')   || '';
    var prefilterHolder = urlParams.get('holder') || '';

    function renderStats() {
      var total           = allMembers.length;
      var active          = allMembers.filter(function(m) { return m.status === 'active'; }).length;
      var pending         = allMembers.filter(function(m) { return m.status === 'pending'; }).length;
      var pendingHardware = allMembers.filter(function(m) { return m.status === 'pending_hardware'; }).length;
      var failed          = allMembers.filter(function(m) { return m.status === 'failed'; }).length;
      var strip = document.getElementById('statsStrip');
      strip.innerHTML =
        '<div class="stat-card" data-filter="" onclick="filterByStatus(this)"><div class="stat-value">' + total + '</div><div class="stat-label">Total Members</div></div>' +
        '<div class="stat-card" data-filter="active" onclick="filterByStatus(this)"><div class="stat-value">' + active + '</div><div class="stat-label">Active</div></div>' +
        '<div class="stat-card" data-filter="pending" onclick="filterByStatus(this)"><div class="stat-value">' + pending + '</div><div class="stat-label">Pending</div></div>' +
        (pendingHardware > 0 ? '<div class="stat-card" data-filter="pending_hardware" onclick="filterByStatus(this)" style="border-left:3px solid var(--amber);"><div class="stat-value">' + pendingHardware + '</div><div class="stat-label">Needs Setup</div></div>' : '') +
        (failed > 0 ? '<div class="stat-card alert" data-filter="failed" onclick="filterByStatus(this)"><div class="stat-value">' + failed + '</div><div class="stat-label">Action Needed</div></div>' : '');
      syncStatCards();
    }

    function filterByStatus(card) {
      var status = card.getAttribute('data-filter');
      var sel = document.getElementById('filterStatus');
      sel.value = (sel.value === status) ? '' : status;
      applyFilters();
      syncStatCards();
    }

    function syncStatCards() {
      var current = document.getElementById('filterStatus').value;
      document.querySelectorAll('.stat-card').forEach(function(c) {
        c.classList.toggle('selected', c.getAttribute('data-filter') === current);
      });
    }

    function buildPlanFilter() {
      var sel = document.getElementById('filterPlan');
      sel.innerHTML = '<option value="">All Plans</option>';
      plans.forEach(function(p) {
        var count = allMembers.filter(function(m) { return m.planId === p.id; }).length;
        sel.innerHTML += '<option value="' + p.id + '">' + p.name + ' (' + count + ')</option>';
      });
    }

    var STATUS_TOOLTIPS = {
      active: 'Member has door access.',
      pending: 'Access is being set up now.',
      pending_hardware: 'Plan purchased but door system not connected. Add your API key in Locations.',
      failed: 'Something went wrong — check the error queue for details and next steps.',
      suspended: 'Access paused — plan cancelled or payment lapsed.'
    };
    function statusLabel(s) {
      var labels = { active: 'Active', pending: 'Processing', pending_hardware: 'Needs Setup', failed: 'Action Needed', suspended: 'Paused' };
      return labels[s] || (s.charAt(0).toUpperCase() + s.slice(1));
    }
    function statusTooltip(s) { return STATUS_TOOLTIPS[s] || ''; }

    function getFiltered() {
      var planVal   = document.getElementById('filterPlan').value;
      var statusVal = document.getElementById('filterStatus').value;
      var roleVal   = document.getElementById('filterRole').value;
      var searchVal = document.getElementById('filterSearch').value.toLowerCase().trim();
      return allMembers.filter(function(m) {
        if (planVal   && m.planId !== planVal)  return false;
        if (statusVal && m.status !== statusVal) return false;
        if (roleVal   && m.role   !== roleVal)   return false;
        if (searchVal) {
          if ((m.firstName + ' ' + m.lastName + ' ' + m.email).toLowerCase().indexOf(searchVal) === -1) return false;
        }
        return true;
      });
    }

    function applyFilters() {
      var filtered  = getFiltered();
      var anyFilter = document.getElementById('filterPlan').value || document.getElementById('filterStatus').value ||
                      document.getElementById('filterRole').value || document.getElementById('filterSearch').value.trim();
      document.getElementById('filterClear').classList.toggle('visible', !!anyFilter);
      document.getElementById('filterCount').textContent = 'Showing ' + filtered.length + ' of ' + allMembers.length;
      var banner = document.getElementById('activeFilterBanner');
      if (prefilterHolder) {
        var holder = allMembers.find(function(m) { return m.id === prefilterHolder; });
        if (holder) {
          document.getElementById('activeFilterText').innerHTML = 'Filtered to <strong>' + holder.firstName + ' ' + holder.lastName + '\'s</strong> plan group';
          banner.classList.add('visible');
        }
      } else {
        banner.classList.remove('visible');
      }
      renderTable(filtered);
      syncStatCards();
    }

    function clearFilters() {
      document.getElementById('filterPlan').value   = '';
      document.getElementById('filterStatus').value = '';
      document.getElementById('filterRole').value   = '';
      document.getElementById('filterSearch').value = '';
      prefilterHolder = '';
      prefilterPlan   = '';
      expandedHolders = {};
      applyFilters();
    }

    function downloadMembersCSV() {
      var rows = getFiltered();
      var headers = ['First Name', 'Last Name', 'Email', 'Status', 'Plan', 'Role', 'Provisioned At'];
      var csvRows = [headers.join(',')];
      rows.forEach(function(m) {
        csvRows.push([
          csvEsc(m.firstName), csvEsc(m.lastName), csvEsc(m.email),
          csvEsc(m.status), csvEsc(m.planName || ''), csvEsc(m.role || ''),
          csvEsc(m.provisionedAt || ''),
        ].join(','));
      });
      var blob = new Blob([csvRows.join('\r\n')], { type: 'text/csv' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'members-' + new Date().toISOString().slice(0, 10) + '.csv';
      a.click();
      URL.revokeObjectURL(a.href);
    }

    function csvEsc(val) {
      var s = String(val == null ? '' : val);
      if (s.indexOf(',') !== -1 || s.indexOf('"') !== -1 || s.indexOf('\n') !== -1) {
        return '"' + s.replace(/"/g, '""') + '"';
      }
      return s;
    }

    function renderTable(filtered) {
      var tbody = document.getElementById('membersBody');
      tbody.innerHTML = '';
      if (filtered.length === 0) {
        tbody.innerHTML = '<tr class="empty-row"><td colspan="6">No members match your filters.</td></tr>';
        return;
      }
      var hasActiveFilter = document.getElementById('filterSearch').value.trim() ||
                            document.getElementById('filterStatus').value || document.getElementById('filterRole').value;
      if (hasActiveFilter) {
        filtered.forEach(function(m) {
          if (m.holderId) expandedHolders[m.holderId] = true;
          if (m.role === 'holder') expandedHolders[m.id] = true;
        });
      }
      var rendered = {};
      var sorted   = [];
      var holders  = filtered.filter(function(m) { return m.role === 'holder'; });
      holders.forEach(function(h) {
        sorted.push(h);
        var plan = plans.find(function(p) { return p.id === h.planId; });
        if (plan && plan.isMultiMember) {
          var subs = filtered.filter(function(m) { return m.holderId === h.id; });
          subs.forEach(function(s) { sorted.push(s); rendered[s.id] = true; });
        }
      });
      filtered.forEach(function(m) { if (!rendered[m.id] && sorted.indexOf(m) === -1) sorted.push(m); });

      sorted.forEach(function(m) {
        var plan       = plans.find(function(p) { return p.id === m.planId; });
        var isHolder   = m.role === 'holder';
        var isSub      = m.role === 'sub';
        var isMulti    = plan && plan.isMultiMember;
        var initials   = m.firstName[0] + m.lastName[0];
        var avatarClass = isHolder ? 'holder' : m.status;
        var subCount   = allMembers.filter(function(s) { return s.holderId === m.id; }).length;
        var isExpanded = expandedHolders[m.id] === true;

        var tr = document.createElement('tr');
        if (isHolder) tr.className = 'is-holder';
        if (isSub && m.holderId && !expandedHolders[m.holderId]) {
          tr.style.display = 'none';
          tr.setAttribute('data-holder', m.holderId);
        } else if (isSub && m.holderId) {
          tr.setAttribute('data-holder', m.holderId);
        }

        var memberCell =
          '<td><div class="member-cell">' +
          (isHolder && isMulti && subCount > 0
            ? '<button class="expand-btn' + (isExpanded ? ' open' : '') + '" onclick="toggleHolderExpand(\'' + m.id + '\', event)">&#9654;</button>'
            : isSub ? '<span class="sub-indent"><span class="sub-connector"></span></span>' : '') +
          '<div class="member-avatar ' + avatarClass + '">' + initials + '</div>' +
          '<div><div class="member-name">' + m.firstName + ' ' + m.lastName +
            (isHolder && isMulti ? '<span class="member-tag holder">Holder</span>' : '') +
            (isSub ? '<span class="member-tag sub">Additional</span>' : '') +
          '</div><div class="member-email">' + m.email + '</div></div>' +
          '</div></td>';

        var planCell = '<td>' +
          (isHolder ? '<div class="plan-badge">' + (plan ? plan.name : '—') + '</div>' +
            (isMulti ? '<div class="plan-badge-sub">' + subCount + ' of ' + (plan.maxMembers - 1) + ' members</div>' : '') : '') + '</td>';

        var roleCell   = '<td>' + (isHolder ? 'Plan Holder' : 'Additional Member') + '</td>';
        var statusCell = '<td><span class="status-pill ' + m.status + '" title="' + esc(statusTooltip(m.status)) + '"><span class="status-dot"></span>' + statusLabel(m.status) + '</span></td>';
        var dateCell   = '<td style="font-size:12px;color:#9aa5b4;">' + m.addedDate + '</td>';
        var actionsCell = '<td style="text-align:right;">' +
          (isHolder && isMulti ? '<button class="tbl-action-btn" onclick="openDrawer(\'' + m.id + '\')" title="Edit members">&#9998;</button>' : '') +
          (m.status === 'failed' ? '<button class="tbl-action-btn retry" onclick="retryMember(\'' + m.id + '\')" title="Retry">&#8635;</button>' : '') +
          '</td>';

        tr.innerHTML = memberCell + planCell + roleCell + statusCell + dateCell + actionsCell;
        tbody.appendChild(tr);
      });
    }

    function toggleHolderExpand(holderId, event) {
      event.stopPropagation();
      var current = expandedHolders[holderId] === true;
      expandedHolders[holderId] = !current;
      document.querySelectorAll('tr[data-holder="' + holderId + '"]').forEach(function(row) {
        row.style.display = current ? 'none' : '';
      });
      var btn = event.target.closest('.expand-btn');
      if (btn) btn.classList.toggle('open');
    }

    function openDrawer(holderId) {
      var holder = allMembers.find(function(m) { return m.id === holderId; });
      if (!holder) return;
      var plan = plans.find(function(p) { return p.id === holder.planId; });
      var subs = allMembers.filter(function(m) { return m.holderId === holderId; });
      document.getElementById('drawerTitle').textContent = holder.firstName + ' ' + holder.lastName + '\'s Plan Group';
      var body = '<div class="drawer-section-label">Plan Holder</div>' +
        '<div class="drawer-member-card"><div class="member-avatar holder">' + holder.firstName[0] + holder.lastName[0] + '</div>' +
        '<div class="drawer-member-info"><div class="drawer-member-name">' + holder.firstName + ' ' + holder.lastName + '</div><div class="drawer-member-email">' + holder.email + '</div></div>' +
        '<span class="status-pill ' + holder.status + '"><span class="status-dot"></span>' + statusLabel(holder.status) + '</span></div>' +
        '<div class="drawer-section-label">Plan Details</div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Plan</span><span class="drawer-info-value">' + (plan ? plan.name : '—') + '</span></div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Members</span><span class="drawer-info-value">' + (subs.length + 1) + ' / ' + (plan ? plan.maxMembers : '—') + '</span></div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Member since</span><span class="drawer-info-value">' + holder.addedDate + '</span></div>' +
        '<div class="drawer-info-row"><span class="drawer-info-label">Phone</span><span class="drawer-info-value">' + holder.phone + '</span></div>' +
        '<div class="drawer-section-label">Additional Members (' + subs.length + ' of ' + (plan ? plan.maxMembers - 1 : '—') + ')</div>';
      if (subs.length === 0) {
        body += '<div style="text-align:center;padding:20px;color:#9aa5b4;font-size:13px;">No additional members added yet.</div>';
      } else {
        subs.forEach(function(s) {
          body += '<div class="drawer-member-card"><div class="member-avatar ' + s.status + '">' + s.firstName[0] + s.lastName[0] + '</div>' +
            '<div class="drawer-member-info"><div class="drawer-member-name">' + s.firstName + ' ' + s.lastName + '</div><div class="drawer-member-email">' + s.email + ' · ' + s.phone + '</div></div>' +
            '<div class="drawer-member-actions"><span class="status-pill ' + s.status + '" style="margin-right:4px;"><span class="status-dot"></span>' + statusLabel(s.status) + '</span>' +
            (s.status === 'failed' ? '<button class="drawer-action-btn retry" onclick="retryMember(\'' + s.id + '\')" title="Retry">&#8635;</button>' : '') + '</div></div>';
        });
      }
      document.getElementById('drawerBody').innerHTML = body;
      document.getElementById('drawerFooter').innerHTML =
        '<button class="drawer-btn secondary" onclick="closeDrawer()">Close</button>' +
        '<button class="drawer-btn primary" onclick="showToast(\'info\', \'Opening editor...\')">Edit Members</button>';
      document.getElementById('drawerOverlay').classList.add('visible');
      document.getElementById('drawer').classList.add('open');
    }

    function closeDrawer() {
      document.getElementById('drawer').classList.remove('open');
      setTimeout(function() { document.getElementById('drawerOverlay').classList.remove('visible'); }, 250);
    }

    function retryMember(memberId) {
      var m = allMembers.find(function(x) { return x.id === memberId; });
      if (!m || m.status !== 'failed') return;
      m.status = 'pending';
      renderStats(); applyFilters();
      showToast('info', 'Retrying access for ' + m.firstName + '...');
      setTimeout(function() {
        m.status = 'active';
        renderStats(); applyFilters();
        showToast('success', m.firstName + ' now has access');
      }, 2500);
    }

    renderStats();
    buildPlanFilter();
    document.getElementById('pageSubtitle').textContent = 'All members across your plans. View access status, manage additional members, and resolve provisioning issues.';
    if (prefilterPlan)   document.getElementById('filterPlan').value = prefilterPlan;
    if (prefilterHolder) {
      var h = allMembers.find(function(m) { return m.id === prefilterHolder; });
      if (h) { document.getElementById('filterPlan').value = h.planId; expandedHolders[prefilterHolder] = true; }
    }
    applyFilters();
    if (prefilterHolder) setTimeout(function() { openDrawer(prefilterHolder); }, 400);

    // ══ OB-29: Live data loading ══════════════════════════════════
    (function loadLiveMembers() {
      var clientId = urlParams.get('clientId');
      if (!clientId) return;

      apiFetch('/operator/' + clientId + '/members?limit=100')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.members || !d.members.length) {
            var tbody = document.getElementById('membersBody');
            if (tbody) {
              tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:48px 20px;">' +
                '<div style="color:var(--muted);font-size:14px;">' +
                  '<svg width="40" height="40" viewBox="0 0 40 40" fill="none" style="margin-bottom:12px;opacity:.4"><circle cx="20" cy="16" r="6" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M8 34c0-6.6 5.4-12 12-12s12 5.4 12 12" stroke="currentColor" stroke-width="1.5" fill="none"/></svg><br>' +
                  '<strong>No members yet</strong><br>' +
                  '<span style="font-size:12px;">Members will appear here automatically when they purchase a plan on your Wix site.</span>' +
                '</div></td></tr>';
            }
            return;
          }
          allMembers = d.members.map(function(m) {
            var parts = (m.platform_member_id || '').split('_');
            return {
              id: m.id,
              firstName: parts[0] || m.platform_member_id || 'Member',
              lastName: parts[1] || '',
              email: m.platform_member_id + '@member',
              phone: '',
              planId: '',
              role: 'holder',
              status: m.access_status || 'pending',
              addedDate: m.provisioned_at ? new Date(m.provisioned_at).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) : '—',
              holderId: null
            };
          });
          plans = [];
          renderStats();
          buildPlanFilter();
          applyFilters();
        }).catch(function(e) { console.error('Members load error:', e); });
    })();
  </script>
</body>
</html>
