<%#
  @file admin-panel.ejs
  @layer admin/pages
  @route /admin-panel
  @role admin-management
  @tab Admin
  @status live (Wix admin tracking via /admin/wix-admins)
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Operator Dashboard: Administration' }) %>
  <style>
    .dash-content { max-width: 720px; }

    /* ── Admin table ── */
    .admin-list { list-style: none; padding: 0; margin: 0; }
    .admin-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid var(--border, #e2e8f0);
      gap: 12px;
    }
    .admin-item:last-child { border-bottom: none; }
    .admin-item-main { flex: 1; min-width: 0; }
    .admin-item-name { font-weight: 600; font-size: 14px; color: var(--text); }
    .admin-item-meta { font-size: 12px; color: var(--muted, #64748b); margin-top: 2px; word-break: break-all; }
    .admin-item-seen { text-align: right; font-size: 12px; flex-shrink: 0; }
    .admin-item-last-seen { color: var(--muted, #64748b); }
    .admin-item-count { color: var(--muted, #64748b); margin-top: 2px; font-size: 11px; }
    .admin-loading, .admin-empty, .admin-error {
      padding: 12px 0;
      font-size: 13px;
      color: var(--muted, #64748b);
      font-style: italic;
    }
    .admin-error { color: #991b1b; }

    /* ── Logged-in-as strip ── */
    .logged-in-strip {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 16px; background: var(--surface);
      border: 1px solid var(--border); border-radius: 10px; margin-bottom: 20px;
    }
    .logged-in-avatar {
      width: 32px; height: 32px; border-radius: 50%;
      background: linear-gradient(135deg, var(--brand), #3D5BD4);
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700; color: #fff;
    }
    .logged-in-info { flex: 1; }
    .logged-in-name   { font-size: 13px; font-weight: 600; color: var(--text); }
    .logged-in-detail { font-size: 11px; color: var(--muted); }
    .logged-in-badge  { font-size: 10px; font-weight: 600; padding: 3px 8px; border-radius: 5px; background: var(--brand-dim); color: var(--brand); }

    /* ── Info toggle section ── */
    .info-toggle-btn {
      display: flex; align-items: center; gap: 6px;
      background: none; border: 1px solid var(--border); border-radius: 8px;
      padding: 8px 14px; font-size: 12px; font-weight: 600; color: var(--muted);
      cursor: pointer; font-family: inherit; transition: all 0.15s;
    }
    .info-toggle-btn:hover { border-color: var(--border2); color: var(--text2); }
    .info-toggle-btn .chevron { font-size: 10px; transition: transform 0.2s; display: inline-block; }
    .info-toggle-btn.open .chevron { transform: rotate(180deg); }
    .info-body { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .info-body.open { max-height: 500px; }
    .info-content { padding-top: 16px; }
    .info-item {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 10px 0; border-bottom: 1px solid var(--border);
      font-size: 13px; color: var(--muted); line-height: 1.5;
    }
    .info-item:last-child { border-bottom: none; }
    .info-item-icon { font-size: 14px; flex-shrink: 0; margin-top: 1px; }

    /* ── System Health section ── */
    .system-health-aggregate { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; }
    .system-health-aggregate::before { content: ''; width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .system-health-aggregate.health-state-green::before { background: var(--sage, #4ADE80); }
    .system-health-aggregate.health-state-amber::before { background: #f59e0b; }
    .system-health-aggregate.health-state-red::before { background: #ef4444; }
    .system-health-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin: 12px 0; }
    .health-card { border: 1px solid var(--border, #e2e8f0); border-radius: 8px; padding: 12px; background: var(--card-bg, #fff); border-left-width: 4px; }
    .health-card.health-state-green { border-left-color: var(--sage, #4ADE80); }
    .health-card.health-state-amber { border-left-color: #f59e0b; }
    .health-card.health-state-red { border-left-color: #ef4444; }
    .health-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .health-card-title { font-weight: 600; font-size: 14px; }
    .health-card-state-pill { font-size: 10px; font-weight: 700; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.04em; }
    .health-card.health-state-green .health-card-state-pill { background: #d1fae5; color: #065f46; }
    .health-card.health-state-amber .health-card-state-pill { background: #fef3c7; color: #92400e; }
    .health-card.health-state-red .health-card-state-pill { background: #fee2e2; color: #991b1b; }
    .health-checks { display: grid; grid-template-columns: 1fr; gap: 4px; font-size: 12px; }
    .health-check { display: flex; justify-content: space-between; }
    .health-check-label { color: var(--muted, #64748b); }
    .health-check-state.health-state-green { color: #047857; }
    .health-check-state.health-state-amber { color: #92400e; }
    .health-check-state.health-state-red { color: #991b1b; font-weight: 600; }
    .health-db-row { display: flex; justify-content: space-between; padding: 10px 12px; border-radius: 6px; background: var(--card-bg, #f8fafc); border-left: 4px solid; font-size: 13px; }
    .health-db-row.health-state-green { border-left-color: var(--sage, #4ADE80); }
    .health-db-row.health-state-amber { border-left-color: #f59e0b; }
    .health-db-row.health-state-red { border-left-color: #ef4444; }
    .health-db-label { font-weight: 600; }
    .health-db-detail { color: var(--muted, #64748b); }
    .health-empty { color: var(--muted, #64748b); font-size: 13px; padding: 8px 0; }

    /* ── Clients section ── */
    .clients-filter-group { display: inline-flex; border: 1px solid var(--border, #e2e8f0); border-radius: 8px; overflow: hidden; }
    .clients-filter-btn {
      background: transparent; border: none; padding: 6px 12px;
      font-size: 12px; font-weight: 600; color: var(--muted, #64748b);
      cursor: pointer; font-family: inherit;
      border-right: 1px solid var(--border, #e2e8f0);
      transition: background 0.15s, color 0.15s;
    }
    .clients-filter-btn:last-child { border-right: none; }
    .clients-filter-btn:hover { background: var(--surface); color: var(--text2); }
    .clients-filter-btn.active { background: var(--brand-dim); color: var(--brand); }

    .clients-grid { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 12px; }
    .client-card {
      border: 1px solid var(--border, #e2e8f0);
      border-radius: 8px;
      padding: 14px;
      background: var(--card-bg, #fff);
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
    }
    .client-card-main { flex: 1; min-width: 0; }
    .client-card-name-row { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
    .client-card-name { font-weight: 700; font-size: 15px; color: var(--text); }
    .client-card-badge {
      font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px;
      letter-spacing: 0.04em; text-transform: uppercase;
    }
    .client-card-badge.status-active   { background: var(--sage-dim, #d1fae5); color: #065f46; }
    .client-card-badge.status-archived { background: #f1f5f9; color: #64748b; }
    .client-card-meta { font-size: 12px; color: var(--muted, #64748b); line-height: 1.5; }
    .client-card-meta span + span::before { content: ' · '; }
    .client-card-actions { display: flex; gap: 6px; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; }

    .clients-loading, .clients-empty, .clients-error {
      padding: 16px 0; font-size: 13px; color: var(--muted, #64748b); font-style: italic; text-align: center;
    }
    .clients-error { color: #991b1b; }

    /* ── Confirm-delete modal ── */
    .modal-backdrop {
      position: fixed; inset: 0; background: rgba(15,23,42,0.55);
      display: none; align-items: center; justify-content: center;
      z-index: 1000; padding: 16px;
    }
    .modal-backdrop.open { display: flex; }
    .modal-dialog {
      background: var(--card-bg, #fff);
      border-radius: 10px;
      max-width: 460px; width: 100%;
      padding: 22px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.25);
      border: 1px solid var(--border, #e2e8f0);
    }
    .modal-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
    .modal-warning {
      background: #fef2f2; border-left: 3px solid #ef4444;
      padding: 10px 12px; border-radius: 6px;
      font-size: 13px; color: #7f1d1d; line-height: 1.45;
      margin-bottom: 14px;
    }
    .modal-label { font-size: 12px; font-weight: 600; color: var(--text2, #4a5568); margin-bottom: 6px; display: block; }
    .modal-confirm-string {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px; background: var(--surface); padding: 2px 6px; border-radius: 4px;
      color: var(--text); border: 1px solid var(--border);
    }
    .modal-input {
      width: 100%; padding: 9px 12px; font-size: 13px;
      border: 1px solid var(--border, #e2e8f0); border-radius: 6px;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      color: var(--text); background: var(--card-bg, #fff);
      margin-bottom: 16px; box-sizing: border-box;
    }
    .modal-input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-dim); }
    .modal-actions { display: flex; gap: 8px; justify-content: flex-end; }

    @media (max-width: 640px) {
      .page-title { font-size: 20px; }
      .page-header { flex-direction: column; }
      .admin-item { flex-wrap: wrap; }
      .client-card { flex-direction: column; align-items: stretch; }
      .client-card-actions { justify-content: flex-start; }
    }
  </style>
</head>
<body data-session-role="<%= sessionRole %>"<% if (loginUrl) { %> data-login-url="<%= loginUrl %>"<% } %>>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <div class="dash-content">
    <div class="page-header">
      <div>
        <div class="page-title">Administration</div>
        <div class="page-subtitle" id="pageSubtitle"></div>
      </div>
    </div>

    <div class="logged-in-strip" id="loggedInStrip"></div>

    <div class="section-card">
      <div class="section-header">
        <div>
          <div class="section-title">Administrators</div>
          <div class="section-subtitle" id="adminCount"></div>
        </div>
      </div>
      <ul class="admin-list" id="adminList"></ul>
    </div>

    <div class="section-card">
      <div class="section-header">
        <div>
          <div class="section-title">System Health</div>
          <div class="section-subtitle" id="systemHealthSubtitle">Loading&hellip;</div>
        </div>
        <div class="system-health-aggregate" id="systemHealthAggregate"></div>
      </div>
      <div class="system-health-grid" id="systemHealthGrid">
        <!-- per-client cards inject here -->
      </div>
      <div class="system-health-db" id="systemHealthDb">
        <!-- DB health row injects here -->
      </div>
    </div>

    <div class="section-card">
      <div class="section-header">
        <div>
          <div class="section-title">Clients</div>
          <div class="section-subtitle" id="clientsSubtitle">Loading&hellip;</div>
        </div>
        <div class="clients-filter-group" role="tablist" aria-label="Filter clients by status">
          <button type="button" class="clients-filter-btn active" data-status="active"   onclick="setClientsFilter('active')">Active</button>
          <button type="button" class="clients-filter-btn"        data-status="archived" onclick="setClientsFilter('archived')">Archived</button>
          <button type="button" class="clients-filter-btn"        data-status="all"      onclick="setClientsFilter('all')">All</button>
        </div>
      </div>
      <div class="clients-grid" id="clientsGrid"></div>
    </div>

    <div class="section-card">
      <button class="info-toggle-btn" id="infoToggle" onclick="toggleInfo()">
        <span>&#9432;</span> How administrator access works <span class="chevron">&#9660;</span>
      </button>
      <div class="info-body" id="infoBody">
        <div class="info-content" id="infoContent"></div>
      </div>
    </div>
  </div>

  <div class="modal-backdrop" id="deleteClientModal" role="dialog" aria-modal="true" aria-labelledby="deleteClientModalTitle">
    <div class="modal-dialog">
      <div class="modal-title" id="deleteClientModalTitle">Delete client?</div>
      <div class="modal-warning">
        This permanently deletes this client AND all their data (members, locations, plan mappings, access logs).
        This cannot be undone.
      </div>
      <label class="modal-label" for="deleteClientInput">
        Type <span class="modal-confirm-string" id="deleteClientExpected"></span> to confirm:
      </label>
      <input type="text" class="modal-input" id="deleteClientInput" autocomplete="off" spellcheck="false" />
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeDeleteClientModal()">Cancel</button>
        <button type="button" class="btn btn-danger" id="deleteClientConfirmBtn" disabled onclick="confirmDeleteClient()">Delete forever</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script src="/operator-nav.js"></script>
  <script>
    var currentUser = { name: 'Daxx Roberts', email: 'daxxroberts@gmail.com', role: 'owner' };

    function renderLoggedIn() {
      var el = document.getElementById('loggedInStrip');
      var initials = currentUser.name.split(' ').map(function(n) { return n[0]; }).join('');
      el.innerHTML =
        '<div class="logged-in-avatar">' + initials + '</div>' +
        '<div class="logged-in-info">' +
          '<div class="logged-in-name">' + currentUser.name + '</div>' +
          '<div class="logged-in-detail">Signed in via Wix · ' + currentUser.email + '</div>' +
        '</div>' +
        '<div class="logged-in-badge">' + currentUser.role.charAt(0).toUpperCase() + currentUser.role.slice(1) + '</div>';
    }

    function renderAdmins() {
      var el = document.getElementById('adminList');
      var countEl = document.getElementById('adminCount');
      el.innerHTML = '<li class="admin-loading">Loading&hellip;</li>';
      countEl.textContent = '';

      fetch('/admin/wix-admins', { credentials: 'include' })
        .then(function(res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function(data) {
          var admins = data.admins || [];
          if (admins.length === 0) {
            el.innerHTML = '<li class="admin-empty">No Wix admins have logged into AccessSync yet. Anyone who opens the AccessSync dashboard from inside Wix will be listed here.</li>';
            countEl.textContent = 'No admins on record yet';
            return;
          }
          countEl.textContent = admins.length + ' Wix admin' + (admins.length === 1 ? '' : 's') + ' on record';
          el.innerHTML = admins.map(renderAdminRow).join('');
        })
        .catch(function(err) {
          el.innerHTML = '<li class="admin-error">Failed to load Wix admin list (' + escapeHtml(err.message) + ')</li>';
          countEl.textContent = '';
        });
    }

    function renderAdminRow(a) {
      var displayName = a.notification_email || ('Wix uid ' + (a.wix_uid || '').slice(0, 8) + '…');
      var clientLine  = a.client_name || '—';
      var perms       = a.permissions ? ' · ' + a.permissions : '';
      var lastSeen    = a.last_seen_at ? formatRelativeTime(a.last_seen_at) : 'never';
      var seenCount   = a.seen_count != null ? a.seen_count + ' session' + (a.seen_count === 1 ? '' : 's') : '';
      return '<li class="admin-item">' +
        '<div class="admin-item-main">' +
          '<div class="admin-item-name">' + escapeHtml(displayName) + '</div>' +
          '<div class="admin-item-meta">' + escapeHtml(clientLine) + escapeHtml(perms) + '</div>' +
        '</div>' +
        '<div class="admin-item-seen">' +
          '<div class="admin-item-last-seen">Last seen ' + escapeHtml(lastSeen) + '</div>' +
          '<div class="admin-item-count">' + escapeHtml(seenCount) + '</div>' +
        '</div>' +
      '</li>';
    }

    function formatRelativeTime(iso) {
      var then = new Date(iso).getTime();
      if (isNaN(then)) return 'unknown';
      var diff = Date.now() - then;
      var s = Math.floor(diff / 1000);
      if (s < 60) return s + 's ago';
      var m = Math.floor(s / 60);
      if (m < 60) return m + 'm ago';
      var h = Math.floor(m / 60);
      if (h < 24) return h + 'h ago';
      var d = Math.floor(h / 24);
      if (d < 30) return d + 'd ago';
      var months = Math.floor(d / 30);
      if (months < 12) return months + 'mo ago';
      var y = Math.floor(d / 365);
      return y + 'y ago';
    }

    function renderInfoSection() {
      var items = [
        { icon: '&#128274;', text: 'Administrator access is determined by your Wix site roles. Any member with an Owner or Admin role automatically has access to this dashboard.' },
        { icon: '&#128100;', text: 'When a Wix site member navigates to AccessSync, their session is validated automatically — no separate login required.' },
        { icon: '&#9881;',   text: 'To add or remove administrators, manage their roles directly in your Wix site dashboard under Site Members.' },
      ];
      document.getElementById('infoContent').innerHTML = items.map(function(item) {
        return '<div class="info-item"><span class="info-item-icon">' + item.icon + '</span><span>' + item.text + '</span></div>';
      }).join('');
    }

    function toggleInfo() {
      document.getElementById('infoToggle').classList.toggle('open');
      document.getElementById('infoBody').classList.toggle('open');
    }

    // ── System Health (OB-195) ──
    async function loadSystemHealth() {
      try {
        var res = await fetch('/admin/system-health', { credentials: 'include' });
        if (!res.ok) {
          document.getElementById('systemHealthSubtitle').textContent = 'Health check failed (HTTP ' + res.status + ')';
          return;
        }
        var data = await res.json();
        renderSystemHealth(data);
      } catch (err) {
        document.getElementById('systemHealthSubtitle').textContent = 'Health check failed (' + err.message + ')';
      }
    }

    function renderSystemHealth(data) {
      var stateOrder = { red: 0, amber: 1, green: 2 };
      var clients = (data.clients || []).slice().sort(function(a, b) {
        var av = stateOrder[a.worst_state]; if (av == null) av = 99;
        var bv = stateOrder[b.worst_state]; if (bv == null) bv = 99;
        return av - bv;
      });
      // Aggregate pill
      var agg = document.getElementById('systemHealthAggregate');
      var aggState = (data.aggregate && data.aggregate.worst_state) || 'green';
      agg.className = 'system-health-aggregate health-state-' + aggState;
      var issueCount = clients.filter(function(c) { return c.worst_state !== 'green'; }).length;
      var aggText;
      if (aggState === 'green') aggText = 'All systems green';
      else if (aggState === 'amber') aggText = 'Degraded · ' + issueCount + ' client(s) need attention';
      else aggText = 'Issues detected · ' + issueCount + ' client(s) need review';
      agg.textContent = aggText;
      // Subtitle
      var subtitle = document.getElementById('systemHealthSubtitle');
      var ageH = data.aggregate ? data.aggregate.latest_reconcile_age_hours : null;
      subtitle.textContent = ageH != null
        ? 'Latest reconcile ' + ageH + 'h ago across all clients'
        : 'No reconcile runs on record';
      // Per-client cards
      var grid = document.getElementById('systemHealthGrid');
      grid.innerHTML = clients.length
        ? clients.map(function(c) { return renderHealthCard(c); }).join('')
        : '<div class="health-empty">No active clients.</div>';
      // DB health
      var db = document.getElementById('systemHealthDb');
      var dbState = (data.db_health && data.db_health.state) || 'green';
      var dbProbe = (data.db_health && data.db_health.probe_latency_ms != null)
        ? data.db_health.probe_latency_ms + 'ms'
        : 'unreachable';
      var dbSlow = (data.db_health && data.db_health.slow_query_24h != null) ? data.db_health.slow_query_24h : 0;
      db.innerHTML = '<div class="health-db-row health-state-' + dbState + '">' +
        '<span class="health-db-label">Supabase DB</span>' +
        '<span class="health-db-detail">Probe ' + dbProbe + ' · ' + dbSlow + ' slow queries / 24h</span>' +
        '</div>';
    }

    function renderHealthCard(c) {
      var checks = c.checks || {};
      return '<div class="health-card health-state-' + c.worst_state + '">' +
        '<div class="health-card-header">' +
          '<span class="health-card-title">' + escapeHtml(c.client_name) + '</span>' +
          '<span class="health-card-state-pill">' + String(c.worst_state || '').toUpperCase() + '</span>' +
        '</div>' +
        '<div class="health-checks">' +
          renderCheck('Reconcile', checks.reconcile_freshness, formatReconcile) +
          renderCheck('Webhooks', checks.webhook_ingestion, formatWebhook) +
          renderCheck('Errors', checks.error_queue, formatErrors) +
          renderCheck('Diagnostics', checks.diagnostic_log, formatDiagnostics) +
        '</div>' +
      '</div>';
    }

    function renderCheck(label, check, formatFn) {
      if (!check) return '';
      return '<div class="health-check">' +
        '<span class="health-check-label">' + label + '</span>' +
        '<span class="health-check-state health-state-' + check.state + '">' + formatFn(check) + '</span>' +
      '</div>';
    }

    function formatReconcile(c) {
      if (c.age_hours == null) return 'Never run';
      if (c.state === 'green') return 'Fresh (' + c.age_hours + 'h ago)';
      if (c.state === 'amber') return 'Stale (' + c.age_hours + 'h ago)';
      return '>' + c.age_hours + 'h ago';
    }
    function formatWebhook(c) {
      if (c.state === 'green') return 'Active (' + (c.count_24h || 0) + ' today)';
      if (c.state === 'amber') return 'Slow (' + (c.count_24h || 0) + ' today)';
      return 'Silent';
    }
    function formatErrors(c) {
      if (c.state === 'green') return 'Clean';
      if (c.state === 'amber') return c.open_count + ' open';
      return c.open_count + ' open (review)';
    }
    function formatDiagnostics(c) {
      if (c.state === 'green') return 'Clean';
      if (c.state === 'amber') return (c.warn_count_24h || 0) + ' warn/24h';
      return (c.error_count_1h || 0) + ' errors in 1h';
    }

    function escapeHtml(s) {
      if (s == null) return '';
      return String(s).replace(/[&<>"']/g, function(ch) {
        return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
      });
    }

    // ── Clients Panel ──
    var _clientsFilter = 'active';
    var _pendingDeleteClient = null; // { id, name }

    function setClientsFilter(status) {
      if (status !== 'active' && status !== 'archived' && status !== 'all') return;
      _clientsFilter = status;
      var btns = document.querySelectorAll('.clients-filter-btn');
      for (var i = 0; i < btns.length; i++) {
        var b = btns[i];
        if (b.dataset.status === status) b.classList.add('active');
        else b.classList.remove('active');
      }
      loadClients();
    }

    function loadClients() {
      var grid = document.getElementById('clientsGrid');
      var subtitle = document.getElementById('clientsSubtitle');
      grid.innerHTML = '<div class="clients-loading">Loading clients&hellip;</div>';
      subtitle.textContent = 'Loading…';

      fetch('/admin/clients?status=' + encodeURIComponent(_clientsFilter), { credentials: 'include' })
        .then(function(res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function(payload) {
          var clients = (payload && payload.data) || [];
          renderClients(clients);
        })
        .catch(function(err) {
          grid.innerHTML = '<div class="clients-error">Failed to load clients (' + escapeHtml(err.message) + ')</div>';
          subtitle.textContent = '';
        });
    }

    function renderClients(clients) {
      var grid = document.getElementById('clientsGrid');
      var subtitle = document.getElementById('clientsSubtitle');
      if (!clients.length) {
        var emptyMsg = _clientsFilter === 'archived'
          ? 'No archived clients.'
          : (_clientsFilter === 'all' ? 'No clients on record.' : 'No active clients.');
        grid.innerHTML = '<div class="clients-empty">' + emptyMsg + '</div>';
        subtitle.textContent = '0 clients';
        return;
      }
      subtitle.textContent = clients.length + ' client' + (clients.length === 1 ? '' : 's') +
        ' (filter: ' + _clientsFilter + ')';
      grid.innerHTML = clients.map(renderClientCard).join('');
    }

    function renderClientCard(c) {
      var statusKey = (c.status === 'archived') ? 'archived' : 'active';
      var statusLabel = statusKey.toUpperCase();
      var created  = c.created_at  ? new Date(c.created_at).toLocaleDateString()  : '—';
      var lastSync = c.last_sync_at ? formatRelativeTime(c.last_sync_at)            : '—';
      var members  = (c.member_count != null) ? c.member_count : 0;
      var active   = (c.active_count != null) ? c.active_count : 0;
      var nameAttr = (c.name || '').replace(/"/g, '&quot;');
      var idAttr   = escapeHtml(c.id);

      var actionBtn = statusKey === 'archived'
        ? '<button type="button" class="btn btn-sm btn-secondary" onclick="restoreClient(\'' + idAttr + '\', \'' + nameAttr + '\')">Restore</button>'
        : '<button type="button" class="btn btn-sm btn-secondary" onclick="archiveClient(\'' + idAttr + '\', \'' + nameAttr + '\')">Archive</button>';

      return '<div class="client-card">' +
        '<div class="client-card-main">' +
          '<div class="client-card-name-row">' +
            '<span class="client-card-name">' + escapeHtml(c.name || '(unnamed)') + '</span>' +
            '<span class="client-card-badge status-' + statusKey + '">' + statusLabel + '</span>' +
          '</div>' +
          '<div class="client-card-meta">' +
            '<span>Created ' + escapeHtml(created) + '</span>' +
            '<span>Last sync ' + escapeHtml(lastSync) + '</span>' +
            '<span>' + members + ' member' + (members === 1 ? '' : 's') +
              (active ? ' (' + active + ' active)' : '') + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="client-card-actions">' +
          '<a class="btn btn-sm btn-outline" href="/dashboard?clientId=' + encodeURIComponent(c.id) + '">View Dashboard</a>' +
          actionBtn +
          '<button type="button" class="btn btn-sm btn-danger" onclick="openDeleteClientModal(\'' + idAttr + '\', \'' + nameAttr + '\')">Delete</button>' +
        '</div>' +
      '</div>';
    }

    function archiveClient(id, name) {
      if (!confirm('Archive "' + name + '"? They can be restored later.')) return;
      fetch('/admin/clients/' + encodeURIComponent(id) + '/archive', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(function(res) {
          return res.json().then(function(body) { return { res: res, body: body }; });
        })
        .then(function(r) {
          if (!r.res.ok) throw new Error(r.body.error || ('HTTP ' + r.res.status));
          if (typeof showToast === 'function') showToast('success', 'Archived "' + name + '"');
          loadClients();
        })
        .catch(function(err) {
          if (typeof showToast === 'function') showToast('error', 'Archive failed: ' + err.message);
        });
    }

    function restoreClient(id, name) {
      fetch('/admin/clients/' + encodeURIComponent(id) + '/restore', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(function(res) {
          return res.json().then(function(body) { return { res: res, body: body }; });
        })
        .then(function(r) {
          if (!r.res.ok) throw new Error(r.body.error || ('HTTP ' + r.res.status));
          if (typeof showToast === 'function') showToast('success', 'Restored "' + name + '"');
          loadClients();
        })
        .catch(function(err) {
          if (typeof showToast === 'function') showToast('error', 'Restore failed: ' + err.message);
        });
    }

    function openDeleteClientModal(id, name) {
      _pendingDeleteClient = { id: id, name: name };
      var expected = 'DELETE ' + name;
      document.getElementById('deleteClientModalTitle').textContent = 'Delete ' + name + '?';
      document.getElementById('deleteClientExpected').textContent = expected;
      var input = document.getElementById('deleteClientInput');
      input.value = '';
      input.placeholder = expected;
      document.getElementById('deleteClientConfirmBtn').disabled = true;
      document.getElementById('deleteClientModal').classList.add('open');
      setTimeout(function() { input.focus(); }, 50);
    }

    function closeDeleteClientModal() {
      document.getElementById('deleteClientModal').classList.remove('open');
      _pendingDeleteClient = null;
    }

    function onDeleteClientInputChange() {
      if (!_pendingDeleteClient) return;
      var expected = 'DELETE ' + _pendingDeleteClient.name;
      var val = document.getElementById('deleteClientInput').value;
      document.getElementById('deleteClientConfirmBtn').disabled = (val !== expected);
    }

    function confirmDeleteClient() {
      if (!_pendingDeleteClient) return;
      var pending = _pendingDeleteClient;
      var confirmStr = 'DELETE ' + pending.name;
      var btn = document.getElementById('deleteClientConfirmBtn');
      btn.disabled = true;
      fetch('/admin/clients/' + encodeURIComponent(pending.id), {
        method: 'DELETE', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ confirm: confirmStr }),
      })
        .then(function(res) {
          return res.json().then(function(body) { return { res: res, body: body }; });
        })
        .then(function(r) {
          if (!r.res.ok) throw new Error(r.body.error || ('HTTP ' + r.res.status));
          if (typeof showToast === 'function') showToast('success', 'Deleted "' + pending.name + '"');
          closeDeleteClientModal();
          loadClients();
        })
        .catch(function(err) {
          if (typeof showToast === 'function') showToast('error', 'Delete failed: ' + err.message);
          btn.disabled = false;
        });
    }

    // wire input listener + ESC-to-close
    document.addEventListener('DOMContentLoaded', function() {
      var inp = document.getElementById('deleteClientInput');
      if (inp) inp.addEventListener('input', onDeleteClientInputChange);
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && document.getElementById('deleteClientModal').classList.contains('open')) {
          closeDeleteClientModal();
        }
      });
      var backdrop = document.getElementById('deleteClientModal');
      if (backdrop) backdrop.addEventListener('click', function(e) {
        if (e.target === backdrop) closeDeleteClientModal();
      });
    });

    renderLoggedIn();
    renderAdmins();
    renderInfoSection();
    document.getElementById('pageSubtitle').textContent =
      'Wix users who have actually logged into AccessSync.';
    loadSystemHealth();
    loadClients();
  </script>
</body>
</html>
