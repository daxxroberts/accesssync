<%#
  @file admin-panel.ejs
  @layer admin/pages
  @route /admin-panel
  @role owner-hub
  @tab Admin
  @data GET /admin/system-health, GET /admin/queue/counts, GET /admin/wix-admins,
        GET /admin/clients, POST /admin/clients, PATCH /admin/clients/:id,
        POST /admin/clients/:id/invite, POST /admin/clients/:id/archive, /restore, DELETE /admin/clients/:id,
        GET /admin/clients/:id/api-key/status, GET /admin/clients/:id/api-key/test, POST /admin/clients/:id/api-key
  @status owner-only — no allowWixFrame, no operator access

  The owner's one page (2026-10-15 consolidation). Three sections, top to bottom:
    1. Status strip — verdict, reconcile age, webhook recency, database, queue depth.
    2. Needs action — hidden when empty. One row per thing a person must do, who, and where.
    3. Clients — one card per client with every client action: setup link, dashboard, edit,
       key (set / rotate / test), archive or restore, delete.
  Shared plumbing comes from operator-nav.js: apiFetch (401 → session-expired modal), showToast, esc.
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Owner Hub' }) %>
  <style>
    .dash-content { max-width: 760px; }
    #toast:not(.visible) { visibility: hidden; }

    /* ── Banner (a health query failed) ── */
    .check-banner {
      display: none; padding: 10px 14px; border-radius: 8px; margin-bottom: 16px;
      background: var(--amber-dim); border: 1px solid rgba(245,166,35,0.35); color: var(--text); font-size: 13px; line-height: 1.5;
    }
    .check-banner.show { display: block; }

    /* ── Status strip ── */
    .status-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 10px; }
    .status-item { padding: 10px 12px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); min-width: 0; }
    .status-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
    .status-value { font-size: 15px; font-weight: 700; color: var(--text); margin-top: 3px; overflow-wrap: anywhere; }
    .status-sub   { font-size: 11px; color: var(--text2); margin-top: 2px; }
    .status-item.state-green .status-value { color: #047857; }
    .status-item.state-amber .status-value { color: #92400e; }
    .status-item.state-red   .status-value { color: #991b1b; }
    [data-mode="dark"] .status-item.state-green .status-value { color: #4ade80; }
    [data-mode="dark"] .status-item.state-amber .status-value { color: #fbbf24; }
    [data-mode="dark"] .status-item.state-red   .status-value { color: #f87171; }
    .verdict-pill {
      display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 700;
      padding: 5px 12px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text);
    }
    .verdict-pill::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: var(--border2); }
    .verdict-pill.state-green::before { background: var(--sage); }
    .verdict-pill.state-amber::before { background: var(--amber); }
    .verdict-pill.state-red::before   { background: var(--red); }

    /* ── Needs action ── */
    #actionsCard { display: none; }
    #actionsCard.show { display: block; }
    .action-list { list-style: none; padding: 0; margin: 0; }
    .action-row {
      display: flex; align-items: center; gap: 12px; padding: 11px 0;
      border-bottom: 1px solid var(--border); font-size: 13px;
    }
    .action-row:last-child { border-bottom: none; }
    .action-main { flex: 1; min-width: 0; }
    .action-text { color: var(--text); font-weight: 600; overflow-wrap: anywhere; }
    .action-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
    .owner-tag {
      font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
      padding: 2px 7px; border-radius: 4px; white-space: nowrap;
    }
    .owner-tag.gym        { background: var(--amber-dim); color: #92400e; }
    .owner-tag.accesssync { background: var(--brand-dim); color: var(--brand); }
    [data-mode="dark"] .owner-tag.gym { color: #fbbf24; }
    .action-row .btn, .action-row .action-link { flex-shrink: 0; }
    .action-link { color: var(--brand); font-weight: 600; text-decoration: none; font-size: 13px; padding: 4px 2px; }
    .action-link:hover { text-decoration: underline; }

    /* ── Clients ── */
    .clients-header-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .clients-filter-group { display: inline-flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
    .clients-filter-btn {
      background: transparent; border: none; padding: 6px 12px; font-size: 12px; font-weight: 600; color: var(--muted);
      cursor: pointer; font-family: inherit; border-right: 1px solid var(--border); transition: background 0.15s, color 0.15s;
    }
    .clients-filter-btn:last-child { border-right: none; }
    .clients-filter-btn:hover { background: var(--surface); color: var(--text2); }
    .clients-filter-btn.active { background: var(--brand-dim); color: var(--brand); }
    .clients-grid { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 12px; }
    .client-card { border: 1px solid var(--border); border-radius: 8px; padding: 14px; background: var(--card); border-left-width: 4px; }
    .client-card.state-green { border-left-color: var(--sage); }
    .client-card.state-amber, .client-card.state-setup { border-left-color: var(--amber); }
    .client-card.state-red   { border-left-color: var(--red); }
    .client-card.state-inactive, .client-card.state-archived { border-left-color: var(--border2); }
    .client-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
    .client-card-name-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .client-card-name { font-weight: 700; font-size: 15px; color: var(--text); }
    .client-card-badge { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 4px; letter-spacing: 0.04em; text-transform: uppercase; }
    .client-card-badge.status-active   { background: var(--sage-dim); color: #065f46; }
    .client-card-badge.status-archived { background: var(--surface); color: var(--muted); border: 1px solid var(--border); }
    .client-card-badge.status-inactive { background: var(--amber-dim); color: #92400e; }
    [data-mode="dark"] .client-card-badge.status-active   { color: #4ADE80; }
    [data-mode="dark"] .client-card-badge.status-inactive { color: #F5A623; }
    .client-card-meta { font-size: 12px; color: var(--muted); line-height: 1.6; margin-top: 4px; }
    .client-card-meta span + span::before { content: ' · '; }
    .client-card-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
    .clients-loading, .clients-empty, .clients-error { padding: 16px 0; font-size: 13px; color: var(--muted); font-style: italic; text-align: center; }
    .clients-error { color: #991b1b; }

    /* ── Modals ── */
    .modal-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,0.55); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 16px; }
    .modal-backdrop.open { display: flex; }
    .modal-dialog { background: var(--card); border-radius: 10px; max-width: 460px; width: 100%; padding: 22px; box-shadow: 0 20px 50px rgba(0,0,0,0.25); border: 1px solid var(--border); max-height: 92vh; overflow-y: auto; }
    .modal-title { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
    .modal-sub { font-size: 13px; color: var(--text2); line-height: 1.5; margin-bottom: 14px; }
    .modal-warning { background: #fef2f2; border-left: 3px solid #ef4444; padding: 10px 12px; border-radius: 6px; font-size: 13px; color: #7f1d1d; line-height: 1.45; margin-bottom: 14px; }
    .modal-label { font-size: 12px; font-weight: 600; color: var(--text2); margin-bottom: 6px; display: block; }
    .modal-confirm-string { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; background: var(--surface); padding: 2px 6px; border-radius: 4px; color: var(--text); border: 1px solid var(--border); }
    .modal-input, .modal-select {
      width: 100%; padding: 9px 12px; font-size: 13px; border: 1px solid var(--border); border-radius: 6px;
      font-family: inherit; color: var(--text); background: var(--card); box-sizing: border-box;
    }
    .modal-input.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    .modal-input:focus, .modal-select:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-dim); }
    .modal-field { margin-bottom: 12px; }
    .modal-hint { font-size: 11px; color: var(--muted); line-height: 1.45; margin-top: 4px; }
    .modal-error { display: none; background: #fef2f2; border-left: 3px solid #ef4444; color: #7f1d1d; padding: 8px 10px; border-radius: 6px; font-size: 12px; margin-bottom: 12px; }
    .modal-error.show { display: block; }
    .modal-actions { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; margin-top: 16px; }
    .invite-link-row { display: flex; gap: 8px; margin-bottom: 12px; }
    .invite-link-row .modal-input { flex: 1; min-width: 0; text-overflow: ellipsis; }
    .invite-note { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; font-size: 12px; color: var(--text2); line-height: 1.55; }
    .invite-note strong { color: var(--text); }
    .key-status { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border-radius: 6px; background: var(--surface); border: 1px solid var(--border); font-size: 13px; margin-bottom: 14px; flex-wrap: wrap; }

    @media (max-width: 640px) {
      .page-title { font-size: 20px; }
      .page-header { flex-direction: column; }
      .action-row { flex-wrap: wrap; }
      .action-main { flex-basis: 100%; }
    }
  </style>
</head>
<body data-session-role="<%= sessionRole %>"<% if (loginUrl) { %> data-login-url="<%= loginUrl %>"<% } %>>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <div class="dash-content">
    <div class="page-header">
      <div>
        <div class="page-title">Owner Hub</div>
        <div class="page-subtitle" id="pageSubtitle">Loading&hellip;</div>
      </div>
      <span class="verdict-pill" id="verdictPill">Checking&hellip;</span>
    </div>

    <div class="check-banner" id="checkBanner" role="status"></div>

    <div class="section-card">
      <div class="status-strip" id="statusStrip">
        <div class="status-item" id="st-reconcile"><div class="status-label">Reconcile</div><div class="status-value">&hellip;</div><div class="status-sub"></div></div>
        <div class="status-item" id="st-webhooks"><div class="status-label">Webhooks</div><div class="status-value">&hellip;</div><div class="status-sub"></div></div>
        <div class="status-item" id="st-errors"><div class="status-label">Open errors</div><div class="status-value">&hellip;</div><div class="status-sub"></div></div>
        <div class="status-item" id="st-db"><div class="status-label">Database</div><div class="status-value">&hellip;</div><div class="status-sub"></div></div>
        <div class="status-item" id="st-queue"><div class="status-label">Queue</div><div class="status-value">&hellip;</div><div class="status-sub"></div></div>
      </div>
    </div>

    <div class="section-card" id="actionsCard">
      <div class="section-header">
        <div>
          <div class="section-title">Needs action</div>
          <div class="section-subtitle" id="actionsSubtitle"></div>
        </div>
      </div>
      <ul class="action-list" id="actionList"></ul>
    </div>

    <div class="section-card">
      <div class="section-header">
        <div>
          <div class="section-title">Clients</div>
          <div class="section-subtitle" id="clientsSubtitle">Loading&hellip;</div>
        </div>
        <div class="clients-header-actions">
          <button type="button" class="btn btn-sm btn-primary" onclick="openNewClientModal()">New client</button>
          <div class="clients-filter-group" role="tablist" aria-label="Filter clients by status">
            <button type="button" class="clients-filter-btn active" data-status="active"   onclick="setClientsFilter('active')">Active</button>
            <button type="button" class="clients-filter-btn"        data-status="archived" onclick="setClientsFilter('archived')">Archived</button>
            <button type="button" class="clients-filter-btn"        data-status="all"      onclick="setClientsFilter('all')">All</button>
          </div>
        </div>
      </div>
      <div class="clients-grid" id="clientsGrid"></div>
    </div>
  </div>

  <!-- Delete client: typed confirmation -->
  <div class="modal-backdrop" id="deleteClientModal" role="dialog" aria-modal="true" aria-labelledby="deleteClientModalTitle">
    <div class="modal-dialog">
      <div class="modal-title" id="deleteClientModalTitle">Delete client?</div>
      <div class="modal-warning">
        This permanently deletes this client AND all their data (members, locations, plan mappings, access logs).
        This cannot be undone.
      </div>
      <label class="modal-label" for="deleteClientInput">
        Type <span class="modal-confirm-string" id="deleteClientExpected"></span> to confirm:
      </label>
      <input type="text" class="modal-input mono" id="deleteClientInput" autocomplete="off" spellcheck="false" />
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeModal('deleteClientModal')">Cancel</button>
        <button type="button" class="btn btn-danger" id="deleteClientConfirmBtn" disabled onclick="confirmDeleteClient()">Delete forever</button>
      </div>
    </div>
  </div>

  <!-- New client: the OWNER creates the account shell; the gym finishes setup from a link. -->
  <div class="modal-backdrop" id="newClientModal" role="dialog" aria-modal="true" aria-labelledby="newClientTitle">
    <div class="modal-dialog">
      <div class="modal-title" id="newClientTitle">New client</div>
      <div class="modal-sub">Create the account, then send the gym a setup link. They add their own keys and doors.</div>
      <div class="modal-error" id="newClientError" role="alert"></div>
      <div class="modal-field">
        <label class="modal-label" for="ncName">Gym / business name *</label>
        <input type="text" class="modal-input" id="ncName" autocomplete="off" placeholder="e.g. House of Gains" />
      </div>
      <div class="modal-field">
        <label class="modal-label" for="ncEmail">Their email *</label>
        <input type="email" class="modal-input" id="ncEmail" autocomplete="off" placeholder="owner@theirgym.com" />
        <div class="modal-hint">Alerts for this gym go here. Also used to address the setup-link email draft.</div>
      </div>
      <div class="modal-field">
        <label class="modal-label" for="ncSite">Wix site ID (optional)</label>
        <input type="text" class="modal-input" id="ncSite" autocomplete="off" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
        <div class="modal-hint">Leave blank and they enter it during setup.</div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeModal('newClientModal')">Cancel</button>
        <button type="button" class="btn btn-primary" id="ncSubmit" onclick="submitNewClient()">Create and get setup link</button>
      </div>
    </div>
  </div>

  <!-- Setup link: copy it, or open an email draft. -->
  <div class="modal-backdrop" id="inviteModal" role="dialog" aria-modal="true" aria-labelledby="inviteTitle">
    <div class="modal-dialog">
      <div class="modal-title" id="inviteTitle">Setup link</div>
      <div class="modal-sub" id="inviteSub"></div>
      <div class="modal-error" id="inviteError" role="alert"></div>
      <div class="invite-link-row">
        <input type="text" class="modal-input" id="inviteUrl" readonly aria-label="Setup link" />
        <button type="button" class="btn btn-primary" id="inviteCopy" onclick="copyInviteLink()">Copy</button>
      </div>
      <div class="invite-note">
        <strong>Send it any way that reaches them</strong> — text, chat or email. If they don't get it, just make a new one.<br>
        Opening the link doesn't use it up, so it's safe if an email scanner clicks it first. It only ever opens <em>this</em> gym's setup. To cancel every link for a gym, archive it.
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="closeModal('inviteModal')">Done</button>
        <a class="btn btn-secondary" id="inviteMailto" href="#">Open email draft</a>
      </div>
    </div>
  </div>

  <!-- Edit client -->
  <div class="modal-backdrop" id="editClientModal" role="dialog" aria-modal="true" aria-labelledby="editClientTitle">
    <div class="modal-dialog">
      <div class="modal-title" id="editClientTitle">Edit client</div>
      <div class="modal-error" id="editClientError" role="alert"></div>
      <div class="modal-field"><label class="modal-label" for="ecName">Name</label><input type="text" class="modal-input" id="ecName" autocomplete="off" /></div>
      <div class="modal-field"><label class="modal-label" for="ecEmail">Notification email</label><input type="email" class="modal-input" id="ecEmail" autocomplete="off" /></div>
      <div class="modal-field"><label class="modal-label" for="ecSiteName">Wix site name</label><input type="text" class="modal-input" id="ecSiteName" autocomplete="off" /></div>
      <div class="modal-field"><label class="modal-label" for="ecSiteId">Wix site ID</label><input type="text" class="modal-input mono" id="ecSiteId" autocomplete="off" /></div>
      <div class="modal-field"><label class="modal-label" for="ecHardware">Hardware platform</label>
        <select class="modal-select" id="ecHardware"><option value="">— Not set —</option><option value="kisi">Kisi</option><option value="seam">Seam</option></select>
        <div class="modal-hint">Cannot be changed once members are provisioned.</div>
      </div>
      <div class="modal-field"><label class="modal-label" for="ecTier">Tier</label>
        <select class="modal-select" id="ecTier"><option value="">— Not set —</option><option value="Base">Base</option><option value="Pro">Pro</option><option value="Connect">Connect</option></select>
      </div>
      <div class="modal-field"><label class="modal-label" for="ecStatus">Status</label>
        <select class="modal-select" id="ecStatus"><option value="active">Active</option><option value="suspended">Suspended</option><option value="cancelled">Cancelled</option></select>
        <div class="modal-hint">Suspended and cancelled clients are not synced. Use Archive to hide a client.</div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeModal('editClientModal')">Cancel</button>
        <button type="button" class="btn btn-primary" id="ecSubmit" onclick="submitEditClient()">Save changes</button>
      </div>
    </div>
  </div>

  <!-- Hardware API key: set, rotate, test -->
  <div class="modal-backdrop" id="keyModal" role="dialog" aria-modal="true" aria-labelledby="keyTitle">
    <div class="modal-dialog">
      <div class="modal-title" id="keyTitle">Hardware API key</div>
      <div class="modal-sub">Write-only. Once saved, the key cannot be viewed, only replaced. Encrypted at rest (AES-256-GCM).</div>
      <div class="modal-error" id="keyError" role="alert"></div>
      <div class="key-status">
        <span id="keyStatusText">Checking&hellip;</span>
        <button type="button" class="btn btn-sm btn-secondary" id="keyTestBtn" onclick="testKey()" disabled>Test key</button>
      </div>
      <div class="modal-field">
        <label class="modal-label" for="keyInput" id="keyInputLabel">New key</label>
        <input type="password" class="modal-input mono" id="keyInput" autocomplete="off" placeholder="Paste the Kisi API key…" />
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-ghost" onclick="closeModal('keyModal')">Close</button>
        <button type="button" class="btn btn-primary" id="keySaveBtn" onclick="saveKey()">Save key</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script src="/operator-nav.js"></script>
  <script>
    // ── Shared state ───────────────────────────────────────────────
    var _clientsFilter = 'active';
    var _clients = [];                 // from /admin/clients
    var _healthByClient = {};          // client_id → system-health client row
    var _adminSeenByClient = {};       // client_id → latest Wix admin last_seen_at
    var _pendingDeleteClient = null;   // { id, name }
    var _editing = null;               // client being edited
    var _keyClient = null;             // { id, name }
    var _inviteState = null;

    function relTime(iso) {
      if (!iso) return null;
      var then = new Date(iso).getTime();
      if (isNaN(then)) return null;
      var s = Math.floor((Date.now() - then) / 1000);
      if (s < 60) return 'just now';
      var m = Math.floor(s / 60); if (m < 60) return m + 'm ago';
      var h = Math.floor(m / 60); if (h < 48) return h + 'h ago';
      var d = Math.floor(h / 24); if (d < 60) return d + 'd ago';
      return Math.floor(d / 30) + 'mo ago';
    }
    function hoursText(h) { return h == null ? '' : (h < 48 ? h + 'h' : Math.floor(h / 24) + 'd'); }
    function agoText(h) { return h == null ? '—' : (h === 0 ? 'Just now' : hoursText(h) + ' ago'); }
    function readJson(r) { return r.json().catch(function() { return {}; }).then(function(b) { return { ok: r.ok, status: r.status, body: b || {} }; }); }
    function showErr(id, msg) { var el = document.getElementById(id); el.textContent = msg || ''; el.classList.toggle('show', !!msg); }
    function openModal(id) { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); if (id === 'deleteClientModal') _pendingDeleteClient = null; if (id === 'inviteModal') _inviteState = null; }

    // ── Status strip + needs-action ────────────────────────────────
    function setStatus(id, state, value, sub) {
      var el = document.getElementById(id);
      el.className = 'status-item' + (state ? ' state-' + state : '');
      el.querySelector('.status-value').textContent = value;
      el.querySelector('.status-sub').textContent = sub || '';
    }

    function loadHealth() {
      return apiFetch('/admin/system-health').then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        renderHealth(r.body);
      }).catch(function(err) {
        var pill = document.getElementById('verdictPill');
        pill.className = 'verdict-pill state-amber';
        pill.textContent = 'Health check failed';
        document.getElementById('pageSubtitle').textContent = 'Could not load system health (' + err.message + ').';
        ['st-reconcile', 'st-webhooks', 'st-errors', 'st-db'].forEach(function(id) { setStatus(id, '', '—', 'unavailable'); });
      });
    }

    function renderHealth(h) {
      var pill = document.getElementById('verdictPill');
      pill.className = 'verdict-pill state-' + h.verdict;
      var n = (h.actions || []).length;
      pill.textContent = h.verdict === 'green' ? 'All clear' : (h.verdict === 'amber' ? 'Needs a look' : 'Needs action');
      document.getElementById('pageSubtitle').textContent = n
        ? (n === 1 ? '1 thing needs attention.' : n + ' things need attention.')
        : 'Nothing needs your attention.';

      var banner = document.getElementById('checkBanner');
      banner.textContent = h.check_failed || '';
      banner.classList.toggle('show', !!h.check_failed);

      var s = h.status || {};
      var rc = s.reconcile || {};
      setStatus('st-reconcile', rc.state === 'unknown' ? '' : (rc.state === 'idle' ? '' : rc.state),
        rc.state === 'unknown' ? '—' : (rc.last_run_at ? agoText(rc.age_hours) : 'Never'),
        rc.state === 'idle' ? 'nothing to sync yet' : (rc.last_run_at ? 'runs every 12h' : ''));
      var wh = s.webhooks || {};
      setStatus('st-webhooks', wh.state === 'unknown' || wh.state === 'idle' ? '' : wh.state,
        wh.state === 'unknown' ? '—' : (wh.last_received_at ? agoText(wh.age_hours) : 'None yet'),
        wh.last_received_at ? (wh.count_24h || 0) + ' in 24h' : 'waiting for first sale');
      var oe = s.open_errors;
      setStatus('st-errors', !oe ? '' : (oe.needs_gym + oe.needs_accesssync > 0 ? 'red' : (oe.self_clearing ? 'amber' : 'green')),
        oe ? String(oe.total) : '—',
        !oe ? 'unavailable' : (oe.total === 0 ? 'none open' : [
          oe.needs_gym ? oe.needs_gym + ' gym' : '',
          oe.needs_accesssync ? oe.needs_accesssync + ' AccessSync' : '',
          oe.self_clearing ? oe.self_clearing + ' self-clearing' : '',
        ].filter(Boolean).join(' · ')));
      var db = s.db || {};
      setStatus('st-db', db.ok ? (db.latency_ms >= 100 ? 'amber' : 'green') : 'red', db.ok ? 'OK' : 'Down', db.ok ? 'probe ' + db.latency_ms + 'ms' : 'not responding');

      _healthByClient = {};
      (h.clients || []).forEach(function(c) { _healthByClient[c.client_id] = c; });
      renderActions(h.actions || []);
      renderClients();
    }

    function renderActions(actions) {
      var card = document.getElementById('actionsCard');
      card.classList.toggle('show', actions.length > 0);
      if (!actions.length) return;
      var gym = actions.filter(function(a) { return a.owner === 'gym'; }).length;
      document.getElementById('actionsSubtitle').textContent =
        (gym ? gym + ' for a gym' : '') + (gym && actions.length - gym ? ' · ' : '') + (actions.length - gym ? (actions.length - gym) + ' for AccessSync' : '');
      document.getElementById('actionList').innerHTML = actions.map(function(a) {
        var right = a.action === 'invite'
          ? '<button type="button" class="btn btn-sm btn-primary" data-action="invite" data-id="' + esc(a.client_id) + '" data-name="' + esc(a.client_name || '') + '">Send setup link</button>'
          : (a.link ? '<a class="action-link" href="' + esc(a.link) + '">Open &rarr;</a>' : '');
        return '<li class="action-row">' +
          '<span class="owner-tag ' + (a.owner === 'gym' ? 'gym' : 'accesssync') + '">' + (a.owner === 'gym' ? 'Gym' : 'AccessSync') + '</span>' +
          '<div class="action-main"><div class="action-text">' + esc(a.text) + '</div>' +
            '<div class="action-meta">' + esc(a.client_name || 'No client') + '</div></div>' +
          right +
        '</li>';
      }).join('');
    }

    function loadQueue() {
      return apiFetch('/admin/queue/counts').then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        var q = r.body;
        var backlog = (q.waiting || 0) + (q.delayed || 0);
        setStatus('st-queue', q.failed > 0 ? 'amber' : 'green', String(backlog), (q.active || 0) + ' active · ' + (q.failed || 0) + ' failed');
      }).catch(function() { setStatus('st-queue', '', '—', 'unavailable'); });
    }

    function loadAdminsSeen() {
      return apiFetch('/admin/wix-admins').then(readJson).then(function(r) {
        if (!r.ok) return;
        _adminSeenByClient = {};
        (r.body.admins || []).forEach(function(a) {
          var cur = _adminSeenByClient[a.client_id];
          if (!cur || new Date(a.last_seen_at) > new Date(cur)) _adminSeenByClient[a.client_id] = a.last_seen_at;
        });
        renderClients();
      }).catch(function() {});
    }

    // ── Clients ────────────────────────────────────────────────────
    function setClientsFilter(status) {
      if (status !== 'active' && status !== 'archived' && status !== 'all') return;
      _clientsFilter = status;
      document.querySelectorAll('.clients-filter-btn').forEach(function(b) { b.classList.toggle('active', b.dataset.status === status); });
      loadClients();
    }

    function loadClients() {
      document.getElementById('clientsGrid').innerHTML = '<div class="clients-loading">Loading clients&hellip;</div>';
      document.getElementById('clientsSubtitle').textContent = 'Loading…';
      return apiFetch('/admin/clients?status=' + encodeURIComponent(_clientsFilter)).then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        _clients = (r.body && r.body.data) || [];
        renderClients();
      }).catch(function(err) {
        document.getElementById('clientsGrid').innerHTML = '<div class="clients-error">Failed to load clients (' + esc(err.message) + ')</div>';
        document.getElementById('clientsSubtitle').textContent = '';
      });
    }

    function renderClients() {
      var grid = document.getElementById('clientsGrid');
      var subtitle = document.getElementById('clientsSubtitle');
      if (!_clients.length) {
        if (grid.querySelector('.clients-loading')) return;   // still loading
        grid.innerHTML = '<div class="clients-empty">' + (_clientsFilter === 'archived' ? 'No archived clients.' : (_clientsFilter === 'all' ? 'No clients on record.' : 'No active clients.')) + '</div>';
        subtitle.textContent = '0 clients';
        return;
      }
      subtitle.textContent = _clients.length + ' client' + (_clients.length === 1 ? '' : 's') + (_clientsFilter === 'active' ? '' : ' (' + _clientsFilter + ')');
      grid.innerHTML = _clients.map(renderClientCard).join('');
    }

    function renderClientCard(c) {
      var h = _healthByClient[c.id];
      var statusKey = (c.status === 'archived') ? 'archived' : (!c.status || c.status === 'active') ? 'active' : 'inactive';
      var statusLabel = statusKey === 'inactive' ? String(c.status).toUpperCase() : statusKey.toUpperCase();
      var state = statusKey === 'archived' ? 'archived' : (h ? h.state : '');
      var members = c.member_count || 0, active = c.active_count || 0;
      var seen = _adminSeenByClient[c.id];
      // Client names are operator-editable: buttons carry data-* (HTML-escaped) and one delegated listener reads them.
      var dataAttrs = ' data-id="' + esc(c.id) + '" data-name="' + esc(c.name || '') + '"';
      var btn = function(action, cls, label) { return '<button type="button" class="btn btn-sm ' + cls + '" data-action="' + action + '"' + dataAttrs + '>' + label + '</button>'; };

      var meta = [
        '<span>' + active + ' active member' + (active === 1 ? '' : 's') + (members > active ? ' · ' + (members - active) + ' pending' : '') + '</span>',
        h && h.last_webhook_at ? '<span>Last sale ' + esc(relTime(h.last_webhook_at)) + '</span>' : (h && h.state !== 'inactive' ? '<span>No sales yet</span>' : ''),
        h && h.last_reconcile_at ? '<span>Synced ' + esc(relTime(h.last_reconcile_at)) + '</span>' : '',
        seen ? '<span>Owner seen ' + esc(relTime(seen)) + '</span>' : '',
        h && h.missing && h.missing.length ? '<span>Missing ' + esc(h.missing.join(', ')) + '</span>' : '',
        '<span>Created ' + esc(c.created_at ? new Date(c.created_at).toLocaleDateString() : '—') + '</span>',
      ].filter(Boolean).join('');

      var actions = statusKey === 'archived'
        ? btn('restore', 'btn-secondary', 'Restore') + btn('delete', 'btn-danger', 'Delete')
        : btn('invite', 'btn-primary', 'Setup link') +
          '<a class="btn btn-sm btn-outline" href="/dashboard?clientId=' + encodeURIComponent(c.id) + '">Dashboard</a>' +
          btn('edit', 'btn-secondary', 'Edit') +
          btn('key', 'btn-secondary', 'Key') +
          btn('archive', 'btn-ghost', 'Archive') +
          btn('delete', 'btn-danger', 'Delete');

      return '<div class="client-card state-' + esc(state) + '">' +
        '<div class="client-card-top"><div>' +
          '<div class="client-card-name-row">' +
            '<span class="client-card-name">' + esc(c.name || '(unnamed)') + '</span>' +
            '<span class="client-card-badge status-' + statusKey + '">' + esc(statusLabel) + '</span>' +
            (h && h.state === 'setup' ? '<span class="client-card-badge status-inactive">Setting up</span>' : '') +
          '</div>' +
          '<div class="client-card-meta">' + meta + '</div>' +
        '</div></div>' +
        '<div class="client-card-actions">' + actions + '</div>' +
      '</div>';
    }

    function findClient(id) { for (var i = 0; i < _clients.length; i++) if (_clients[i].id === id) return _clients[i]; return null; }

    function postAction(url, okMsg, failMsg) {
      return apiFetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' } }).then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        showToast('success', okMsg);
        refreshAll();
      }).catch(function(err) { showToast('error', failMsg + ': ' + err.message); });
    }
    function archiveClient(id, name) {
      if (!confirm('Archive "' + name + '"? They can be restored later.')) return;
      postAction('/admin/clients/' + encodeURIComponent(id) + '/archive', 'Archived "' + esc(name) + '"', 'Archive failed');
    }
    function restoreClient(id, name) {
      postAction('/admin/clients/' + encodeURIComponent(id) + '/restore', 'Restored "' + esc(name) + '"', 'Restore failed');
    }

    // ── Delete ─────────────────────────────────────────────────────
    function openDeleteClientModal(id, name) {
      _pendingDeleteClient = { id: id, name: name };
      var expected = 'DELETE ' + name;
      document.getElementById('deleteClientModalTitle').textContent = 'Delete ' + name + '?';
      document.getElementById('deleteClientExpected').textContent = expected;
      var input = document.getElementById('deleteClientInput');
      input.value = ''; input.placeholder = expected;
      document.getElementById('deleteClientConfirmBtn').disabled = true;
      openModal('deleteClientModal');
      setTimeout(function() { input.focus(); }, 50);
    }
    function onDeleteClientInputChange() {
      if (!_pendingDeleteClient) return;
      document.getElementById('deleteClientConfirmBtn').disabled = (document.getElementById('deleteClientInput').value !== 'DELETE ' + _pendingDeleteClient.name);
    }
    function confirmDeleteClient() {
      if (!_pendingDeleteClient) return;
      var pending = _pendingDeleteClient;
      var btn = document.getElementById('deleteClientConfirmBtn');
      btn.disabled = true;
      apiFetch('/admin/clients/' + encodeURIComponent(pending.id), {
        method: 'DELETE', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ confirm: 'DELETE ' + pending.name }),
      }).then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        showToast('success', 'Deleted "' + esc(pending.name) + '"');
        closeModal('deleteClientModal');
        refreshAll();
      }).catch(function(err) { showToast('error', 'Delete failed: ' + err.message); btn.disabled = false; });
    }

    // ── New client + setup link ────────────────────────────────────
    function openNewClientModal() {
      ['ncName', 'ncEmail', 'ncSite'].forEach(function(id) { document.getElementById(id).value = ''; });
      showErr('newClientError', '');
      document.getElementById('ncSubmit').disabled = false;
      openModal('newClientModal');
      setTimeout(function() { document.getElementById('ncName').focus(); }, 50);
    }
    function submitNewClient() {
      var name  = document.getElementById('ncName').value.trim();
      var email = document.getElementById('ncEmail').value.trim();
      var site  = document.getElementById('ncSite').value.trim();
      if (!name)  return showErr('newClientError', 'Enter the gym or business name.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showErr('newClientError', 'Enter a valid email address.');
      if (site && !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(site)) {
        return showErr('newClientError', 'That Wix site ID doesn’t look right — it should look like xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx, or leave it blank.');
      }
      showErr('newClientError', '');
      var btn = document.getElementById('ncSubmit');
      btn.disabled = true;
      apiFetch('/admin/clients', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, notification_email: email, source_site_id: site || null }),
      }).then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        closeModal('newClientModal');
        refreshAll();
        openInviteModal(r.body.client.id, r.body.client.name);
      }).catch(function(err) {
        btn.disabled = false;
        showErr('newClientError', err.message === 'Site ID already in use' ? 'That Wix site is already connected to another client.' : 'Could not create the client: ' + err.message);
      });
    }

    function openInviteModal(id, name) {
      _inviteState = null;
      showErr('inviteError', '');
      document.getElementById('inviteTitle').textContent = 'Setup link for ' + name;
      document.getElementById('inviteSub').textContent = 'Creating link…';
      document.getElementById('inviteUrl').value = '';
      document.getElementById('inviteCopy').disabled = true;
      document.getElementById('inviteMailto').setAttribute('href', '#');
      openModal('inviteModal');
      apiFetch('/admin/clients/' + encodeURIComponent(id) + '/invite', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(readJson).then(function(r) {
          if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
          var b = r.body;
          _inviteState = { url: b.url, clientName: b.clientName || name, email: b.notificationEmail || '', ttlHours: b.ttlHours };
          document.getElementById('inviteSub').textContent =
            'Send this to the gym. They open it, press Start setup, and finish onboarding themselves. Works for ' +
            b.ttlHours + ' hours (until ' + new Date(b.expiresAt).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) + ').';
          document.getElementById('inviteUrl').value = b.url;
          document.getElementById('inviteCopy').disabled = false;
          var subject = 'Set up AccessSync for ' + _inviteState.clientName;
          var body = 'Hi,\n\nHere is your AccessSync setup link. Open it and press “Start setup” — it takes about five minutes.\n\n' +
            b.url + '\n\nThe link works for ' + b.ttlHours + ' hours. If it expires, tell me and I’ll send a new one.';
          document.getElementById('inviteMailto').setAttribute('href',
            'mailto:' + encodeURIComponent(_inviteState.email) + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body));
        }).catch(function(err) {
          document.getElementById('inviteSub').textContent = '';
          showErr('inviteError', 'Could not create a setup link: ' + err.message);
        });
    }
    function copyInviteLink() {
      var input = document.getElementById('inviteUrl');
      if (!input.value) return;
      var done = function() { showToast('success', 'Setup link copied'); };
      var fallback = function() { input.select(); try { document.execCommand('copy'); done(); } catch (e) { showErr('inviteError', 'Copy failed — select the link and copy it manually.'); } };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(input.value).then(done, fallback);
      else fallback();
    }

    // ── Edit client ────────────────────────────────────────────────
    function openEditClientModal(id) {
      var c = findClient(id);
      if (!c) return;
      _editing = c;
      showErr('editClientError', '');
      document.getElementById('editClientTitle').textContent = 'Edit ' + (c.name || 'client');
      document.getElementById('ecName').value = c.name || '';
      document.getElementById('ecEmail').value = c.notification_email || '';
      document.getElementById('ecSiteName').value = c.source_site_name || '';
      document.getElementById('ecSiteId').value = c.source_site_id || '';
      document.getElementById('ecHardware').value = (c.connector && c.connector.platform) || '';
      document.getElementById('ecTier').value = (c.billing && c.billing.tier) || '';
      var st = document.getElementById('ecStatus');
      st.value = c.status || 'active';
      if (st.value !== (c.status || 'active')) { var o = document.createElement('option'); o.value = c.status; o.textContent = c.status; st.appendChild(o); st.value = c.status; }
      document.getElementById('ecSubmit').disabled = false;
      openModal('editClientModal');
      setTimeout(function() { document.getElementById('ecName').focus(); }, 50);
    }
    function submitEditClient() {
      if (!_editing) return;
      var c = _editing;
      var name = document.getElementById('ecName').value.trim();
      var email = document.getElementById('ecEmail').value.trim();
      var siteId = document.getElementById('ecSiteId').value.trim();
      if (!name) return showErr('editClientError', 'Name is required.');
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showErr('editClientError', 'Enter a valid email address.');
      if (siteId && !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(siteId)) return showErr('editClientError', 'That Wix site ID doesn’t look right.');
      showErr('editClientError', '');
      var body = {
        name: name,
        notification_email: email || null,
        source_site_name: document.getElementById('ecSiteName').value.trim() || null,
        source_site_id: siteId || null,
        status: document.getElementById('ecStatus').value,
      };
      var hw = document.getElementById('ecHardware').value;
      if (hw && hw !== ((c.connector && c.connector.platform) || '')) body.hardware_platform = hw;
      var tier = document.getElementById('ecTier').value;
      if (tier !== ((c.billing && c.billing.tier) || '')) body.tier = tier || null;
      var btn = document.getElementById('ecSubmit');
      btn.disabled = true;
      apiFetch('/admin/clients/' + encodeURIComponent(c.id), {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
      }).then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        showToast('success', 'Saved "' + esc(name) + '"');
        closeModal('editClientModal');
        refreshAll();
      }).catch(function(err) { btn.disabled = false; showErr('editClientError', 'Could not save: ' + err.message); });
    }

    // ── Hardware API key ───────────────────────────────────────────
    function openKeyModal(id, name) {
      _keyClient = { id: id, name: name };
      showErr('keyError', '');
      document.getElementById('keyTitle').textContent = 'Hardware API key · ' + name;
      document.getElementById('keyInput').value = '';
      document.getElementById('keySaveBtn').disabled = false;
      openModal('keyModal');
      loadKeyStatus();
    }
    function loadKeyStatus() {
      var txt = document.getElementById('keyStatusText'), test = document.getElementById('keyTestBtn'), label = document.getElementById('keyInputLabel');
      txt.textContent = 'Checking…'; test.disabled = true;
      apiFetch('/admin/clients/' + encodeURIComponent(_keyClient.id) + '/api-key/status').then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        var has = !!r.body.hasKey;
        txt.textContent = has ? 'A key is stored (••••••••)' : 'No key stored';
        test.disabled = !has;
        label.textContent = has ? 'Replace with a new key' : 'Key';
      }).catch(function(err) { txt.textContent = 'Could not read key status (' + err.message + ')'; });
    }
    function testKey() {
      var test = document.getElementById('keyTestBtn');
      test.disabled = true; test.textContent = 'Testing…';
      apiFetch('/admin/clients/' + encodeURIComponent(_keyClient.id) + '/api-key/test').then(readJson).then(function(r) {
        if (r.body.valid) showToast('success', 'Key valid — Kisi accepted it');
        else showToast('error', 'Key rejected: ' + (r.body.error || ('HTTP ' + r.status)));
      }).catch(function(err) { showToast('error', 'Test failed: ' + err.message); })
        .then(function() { test.disabled = false; test.textContent = 'Test key'; });
    }
    function saveKey() {
      var key = document.getElementById('keyInput').value.trim();
      if (!key) return showErr('keyError', 'Paste the key first.');
      if (key.length < 20) return showErr('keyError', 'That looks too short to be an API key (20 characters minimum).');
      showErr('keyError', '');
      var btn = document.getElementById('keySaveBtn');
      btn.disabled = true;
      apiFetch('/admin/clients/' + encodeURIComponent(_keyClient.id) + '/api-key', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ apiKey: key }),
      }).then(readJson).then(function(r) {
        if (!r.ok) throw new Error(r.body.error || ('HTTP ' + r.status));
        showToast('success', 'Key saved');
        document.getElementById('keyInput').value = '';
        btn.disabled = false;
        loadKeyStatus();
        loadHealth();
      }).catch(function(err) { btn.disabled = false; showErr('keyError', 'Could not save: ' + err.message); });
    }

    // ── Wiring ─────────────────────────────────────────────────────
    function refreshAll() { loadHealth(); loadClients(); }

    document.getElementById('actionList').addEventListener('click', function(e) {
      var b = e.target.closest('button[data-action="invite"]');
      if (b) openInviteModal(b.getAttribute('data-id'), b.getAttribute('data-name'));
    });
    document.getElementById('clientsGrid').addEventListener('click', function(e) {
      var b = e.target.closest('button[data-action]');
      if (!b) return;
      var id = b.getAttribute('data-id'), name = b.getAttribute('data-name');
      switch (b.dataset.action) {
        case 'archive': archiveClient(id, name); break;
        case 'restore': restoreClient(id, name); break;
        case 'delete':  openDeleteClientModal(id, name); break;
        case 'invite':  openInviteModal(id, name); break;
        case 'edit':    openEditClientModal(id); break;
        case 'key':     openKeyModal(id, name); break;
      }
    });

    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('deleteClientInput').addEventListener('input', onDeleteClientInputChange);
      document.querySelectorAll('.modal-backdrop').forEach(function(bd) {
        bd.addEventListener('click', function(e) { if (e.target === bd) closeModal(bd.id); });
      });
      document.addEventListener('keydown', function(e) {
        if (e.key !== 'Escape') return;
        document.querySelectorAll('.modal-backdrop.open').forEach(function(bd) { closeModal(bd.id); });
      });
    });

    loadHealth();
    loadQueue();
    loadAdminsSeen();
    loadClients();
  </script>
</body>
</html>
