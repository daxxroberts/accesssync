    function wireInteractiveSetupControls(container) {
      // 1. Copy chips (identifiers like accesssync_webhook_secret, events.js, btnMyAccess, etc.)
      container.querySelectorAll('[data-copy-chip]').forEach(function(chip) {
        chip.addEventListener('click', function() {
          var val = chip.getAttribute('data-copy-chip');
          if (!val) return;
          navigator.clipboard.writeText(val).then(function() {
            flashCopiedButton(chip, '✓ ' + val);
          }).catch(function() { toast('Copy failed — try manually selecting', 'error'); });
        });
      });

      // 2. Drawer toggles (Wix Setup Guide + View Code)
      container.querySelectorAll('[data-toggle-drawer]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var targetId = btn.getAttribute('data-toggle-drawer');
          var drawer = document.getElementById(targetId);
          if (!drawer) return;
          var isOpen = drawer.classList.toggle('open');
          btn.classList.toggle('open', isOpen);
        });
      });

      // 3. Full snippet copy buttons
      container.querySelectorAll('[data-copy-snippet]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var snippetId = btn.getAttribute('data-copy-snippet');
          copySnippet(snippetId, btn);
        });
      });

      // 4. Split snippet copy buttons (Step 5a Part 1 / Step 5b Part 2)
      container.querySelectorAll('[data-copy-snippet-part]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var partKey = btn.getAttribute('data-copy-snippet-part');
          var snippetId = btn.getAttribute('data-parent-snippet');
          if (!_setupState) return;
          var snippet = (_setupState.snippets || []).find(function(s) { return s.id === snippetId; });
          if (!snippet || !snippet.body) return;
          var parts = splitDayPassParts(snippet.body);
          var textToCopy = partKey === 'part1' ? parts.part1 : parts.part2;
          if (!textToCopy) return;
          copySnippetText(snippetId, textToCopy, btn);
        });
      });
    }

    function copySnippet(snippetId, btn) {
      if (!_setupState) return;
      var snippet = (_setupState.snippets || []).find(function(s) { return s.id === snippetId; });
      if (!snippet || !snippet.body) return;
      copySnippetText(snippetId, snippet.body, btn);
    }

    function copySnippetText(snippetId, text, btn) {
      navigator.clipboard.writeText(text).then(function() {
        flashCopiedButton(btn);
        // Record the copy action server-side (transitions state to installed_unverified)
        apiFetch('/operator/' + clientId + '/setup-state/copied', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ snippet_id: snippetId })
        }).catch(function() { /* non-blocking */ });
      }).catch(function() { toast('Copy failed — try manually selecting', 'error'); });
    }

    function fmtRelative(iso) {
      if (!iso) return '';
      var t = new Date(iso).getTime();
      var diff = Date.now() - t;
      if (diff < 60_000)    return 'just now';
      if (diff < 3_600_000) return Math.floor(diff / 60_000) + ' min ago';
      if (diff < 86_400_000) return Math.floor(diff / 3_600_000) + ' hr ago';
      return Math.floor(diff / 86_400_000) + ' day(s) ago';
    }
  </script>
</body>
</html>
