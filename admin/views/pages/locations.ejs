<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Operator Dashboard: Platform Config' }) %>
  <style>
    .page { max-width: 900px; margin: 0 auto; padding: 24px 16px 60px; }

    .page-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: 20px; gap: 12px; flex-wrap: wrap;
    }
    .page-title { font-size: 18px; font-weight: 700; letter-spacing: -0.3px; }
    .page-sub   { font-size: 12px; color: var(--muted); margin-top: 3px; }

    /* ── Org key card ── */
    .org-key-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; box-shadow: var(--shadow);
    }
    .org-key-header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .org-key-icon {
      width: 36px; height: 36px; border-radius: 9px; background: var(--brand-dim);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .org-key-title { font-size: 13px; font-weight: 700; }
    .org-key-desc  { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .org-key-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; background: var(--bg);
      border-radius: 8px; border: 1px solid var(--border);
    }
    .org-key-status     { font-size: 12px; color: var(--muted); flex: 1; }
    .org-key-status.set { color: var(--sage-dark); font-weight: 600; }

    /* ── Section label ── */
    .section-label {
      font-size: 10px; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 12px;
    }

    /* ── Location cards ── */
    .loc-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; margin-bottom: 12px; box-shadow: var(--shadow); overflow: hidden;
    }
    .loc-header { display: flex; align-items: center; padding: 14px 18px; gap: 12px; }
    .loc-icon {
      width: 38px; height: 38px; border-radius: 9px; background: var(--brand-dim);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 16px;
    }
    .loc-meta { flex: 1; min-width: 0; }
    .loc-name    { font-size: 13px; font-weight: 700; }
    .loc-address { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .loc-pills   { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    /* ── Pills ── */
    .pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 600; border: 1px solid transparent; }
    .pill-active   { background: var(--sage-dim);  color: var(--sage-dark); border-color: var(--sage-border); }
    .pill-inactive { background: var(--bg);         color: var(--muted);     border-color: var(--border); }
    .pill-lapsed   { background: var(--amber-dim);  color: var(--amber);     border-color: rgba(245,166,35,0.2); }
    .pill-info     { background: var(--brand-dim);  color: var(--brand);     border-color: var(--brand-glow); }

    /* ── Location body ── */
    .loc-body { border-top: 1px solid var(--border); padding: 16px 18px; }
    .loc-stats {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px;
    }
    .loc-stat { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
    .loc-stat-val { font-size: 18px; font-weight: 700; }
    .loc-stat-lbl { font-size: 10px; color: var(--muted); margin-top: 2px; }

    /* ── API key section ── */
    .key-section      { margin-top: 4px; }
    .key-section-title { font-size: 11px; font-weight: 700; color: var(--text2); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
    .key-row {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 14px; background: var(--bg);
      border-radius: 8px; border: 1px solid var(--border);
    }
    .key-label              { font-size: 11px; color: var(--muted); flex: 1; }
    .key-label.has-key      { color: var(--sage-dark); font-weight: 600; }
    .key-label.has-override { color: var(--brand); font-weight: 600; }
    .key-source-badge          { font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: var(--brand-dim); color: var(--brand); }
    .key-source-badge.inherited { background: var(--bg); color: var(--muted); border: 1px solid var(--border); }

    /* ── Key input form ── */
    .key-form { margin-top: 10px; display: none; }
    .key-form.open { display: block; }
    .key-form-inner { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 14px; }
    .key-input {
      width: 100%; padding: 9px 12px; font-family: inherit; font-size: 12px;
      background: var(--card); border: 1px solid var(--border2);
      border-radius: 7px; color: var(--text); outline: none; transition: border 0.15s; margin-bottom: 10px;
    }
    .key-input:focus { border-color: var(--brand); }
    .key-input-hint { font-size: 10px; color: var(--muted); margin-bottom: 10px; line-height: 1.5; }
    .key-form-actions { display: flex; gap: 8px; justify-content: flex-end; }

    /* ── Buttons ── */
    .btn { padding: 7px 14px; border-radius: 7px; font-family: inherit; font-size: 11px; font-weight: 600; cursor: pointer; border: none; transition: all 0.15s; }
    .btn-primary            { background: var(--brand); color: #fff; }
    .btn-primary:hover      { background: var(--brand-dark); }
    .btn-secondary          { background: transparent; color: var(--text2); border: 1px solid var(--border2); }
    .btn-secondary:hover    { background: var(--bg); }
    .btn-ghost              { background: transparent; color: var(--muted); border: 1px solid var(--border); }
    .btn-ghost:hover        { color: var(--text2); }
    .btn-sm                 { padding: 5px 10px; font-size: 10px; }
    .btn:disabled           { opacity: 0.5; cursor: not-allowed; }

    /* ── Test result ── */
    .test-result {
      margin-top: 8px; padding: 8px 12px; border-radius: 7px; font-size: 11px; font-weight: 600; display: none;
    }
    .test-result.pass { background: var(--sage-dim);  color: var(--sage-dark); border: 1px solid var(--sage-border); }
    .test-result.fail { background: var(--red-dim);   color: var(--red);        border: 1px solid rgba(255,77,106,0.2); }

    /* ── Empty / loading ── */
    .empty { text-align: center; padding: 48px 24px; color: var(--muted); font-size: 13px; }
    .empty-icon  { font-size: 32px; margin-bottom: 12px; }
    .empty-title { font-weight: 700; color: var(--text2); margin-bottom: 6px; }
    .loading { text-align: center; padding: 40px; color: var(--muted); font-size: 12px; }
    @keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
    .spinner { width: 20px; height: 20px; border: 2px solid var(--border); border-top-color: var(--brand); border-radius: 50%; animation: spin 0.7s linear infinite; margin: 0 auto 10px; }

    /* ── Toast (page variant — stacked bottom-right) ── */
    .toast-wrap { position: fixed; bottom: 20px; right: 20px; z-index: 999; display: flex; flex-direction: column; gap: 8px; }
    .toast-loc { padding: 10px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #fff; box-shadow: var(--shadow-md); animation: slideIn 0.2s ease; }
    @keyframes slideIn { from{transform:translateY(10px);opacity:0} to{transform:translateY(0);opacity:1} }
    .toast-loc.success { background: #22C55E; }
    .toast-loc.error   { background: var(--red); }
    .toast-loc.info    { background: var(--brand); }

    @media (max-width: 600px) {
      .loc-stats   { grid-template-columns: repeat(2, 1fr); }
      .page-header { flex-direction: column; }
    }
  </style>
</head>
<body>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <main class="page">
    <div class="page-header">
      <div>
        <div class="page-title">Platform Config</div>
        <div class="page-sub">Manage locations and hardware API keys</div>
      </div>
    </div>

    <!-- Org-level API key -->
    <div class="org-key-card" id="org-key-card">
      <div class="org-key-header">
        <div class="org-key-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M11.5 2.5a4 4 0 1 1 0 8 4 4 0 0 1 0-8zm0 0" stroke="var(--brand)" stroke-width="1.4" fill="none"/>
            <circle cx="11.5" cy="6.5" r="1" fill="var(--brand)"/>
            <path d="M7.5 10.5L2 16" stroke="var(--brand)" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M4 13.5H5.5V15" stroke="var(--brand)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div>
          <div class="org-key-title">Organization API Key</div>
          <div class="org-key-desc">Default key used for all locations unless overridden below</div>
        </div>
      </div>
      <div class="org-key-row">
        <span class="org-key-status" id="org-key-status">Checking…</span>
        <div style="display:flex;gap:6px;">
          <button class="btn btn-sm btn-ghost" id="org-test-btn" onclick="testOrgKey()" style="display:none;">Test</button>
          <button class="btn btn-sm btn-secondary" id="org-key-btn" onclick="toggleOrgKeyForm()">Set Key</button>
        </div>
      </div>
      <div class="key-form" id="org-key-form">
        <div class="key-form-inner" style="margin-top:10px;">
          <div class="key-input-hint">Write-only — once saved the key cannot be viewed, only rotated. Encrypted at rest (AES-256-GCM).</div>
          <input type="password" class="key-input" id="org-key-input" placeholder="Paste your Kisi API key…" autocomplete="off"/>
          <div class="key-form-actions">
            <button class="btn btn-ghost btn-sm" onclick="toggleOrgKeyForm()">Cancel</button>
            <button class="btn btn-primary btn-sm" onclick="saveOrgKey()">Save Key</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Notification email -->
    <div class="org-key-card" id="notif-card">
      <div class="org-key-header">
        <div class="org-key-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <rect x="2" y="4" width="14" height="10" rx="2" stroke="var(--brand)" stroke-width="1.4" fill="none"/>
            <path d="M2 6.5l7 4.5 7-4.5" stroke="var(--brand)" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </div>
        <div>
          <div class="org-key-title">Alert Email</div>
          <div class="org-key-desc">Receive provisioning errors, key failures, and grant confirmations</div>
        </div>
      </div>
      <div class="org-key-row">
        <span class="org-key-status" id="notif-email-display">Loading…</span>
        <button class="btn btn-sm btn-secondary" id="notif-edit-btn" onclick="toggleNotifForm()">Edit</button>
      </div>
      <div class="key-form" id="notif-form">
        <div class="key-form-inner" style="margin-top:10px;">
          <div class="key-input-hint">Email address for system alerts — errors, API key failures, and first-grant confirmation.</div>
          <input type="email" class="key-input" id="notif-email-input" placeholder="alerts@yourgym.com" autocomplete="off"/>
          <div class="key-form-actions">
            <button class="btn btn-ghost btn-sm" onclick="toggleNotifForm()">Cancel</button>
            <button class="btn btn-primary btn-sm" onclick="saveNotifEmail()">Save</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Locations -->
    <div class="section-label">Locations</div>
    <div id="loc-loading" class="loading"><div class="spinner"></div>Loading locations…</div>
    <div id="loc-empty" class="empty" style="display:none;">
      <div class="empty-icon">📍</div>
      <div class="empty-title">No locations yet</div>
      <div>Locations are added during onboarding.</div>
    </div>
    <div id="loc-list"></div>
  </main>

  <div class="toast-wrap" id="toastWrap"></div>

  <script src="/operator-nav.js"></script>
  <script>
    'use strict';

    var params   = new URLSearchParams(window.location.search);
    var clientId = params.get('clientId') || '';

    var state = {
      locations: [],
      orgHasKey: false,
    };

    document.addEventListener('DOMContentLoaded', function() {
      if (!clientId) {
        toast('No clientId in URL — add ?clientId=YOUR_ID', 'error');
        return;
      }
      loadOrgKeyStatus();
      loadNotifEmail();
      loadLocations();
    });

    // ── API helpers ────────────────────────────────────────────────────
    function apiFetch(url, options) {
      options = Object.assign({ credentials: 'include' }, options || {});
      return fetch(url, options).then(function(res) {
        if (!res.ok && res.status !== 400) {
          var err = new Error('API error');
          err.status = res.status;
          throw err;
        }
        return res;
      });
    }

    // ── Org-level key ──────────────────────────────────────────────────
    function loadOrgKeyStatus() {
      return apiFetch('/operator/' + clientId + '/api-key/status')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          state.orgHasKey = !!data.hasKey;
          renderOrgKeyStatus();
        })
        .catch(function() {
          document.getElementById('org-key-status').textContent = 'Unable to check';
        });
    }

    function renderOrgKeyStatus() {
      var statusEl = document.getElementById('org-key-status');
      var testBtn  = document.getElementById('org-test-btn');
      var keyBtn   = document.getElementById('org-key-btn');
      if (state.orgHasKey) {
        statusEl.textContent  = '•••••••••••••••• (set)';
        statusEl.className    = 'org-key-status set';
        testBtn.style.display = '';
        keyBtn.textContent    = 'Rotate Key';
      } else {
        statusEl.textContent  = 'Not set — provisioning will fail without a key';
        statusEl.className    = 'org-key-status';
        testBtn.style.display = 'none';
        keyBtn.textContent    = 'Set Key';
      }
    }

    // ── Notification email ─────────────────────────────────────────────
    function loadNotifEmail() {
      apiFetch('/operator/clients/' + clientId + '/notification-email')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var el = document.getElementById('notif-email-display');
          if (data.email) {
            el.textContent = data.email;
            el.className   = 'org-key-status set';
          } else {
            el.textContent = 'Not set — alerts will use the system default';
            el.className   = 'org-key-status';
          }
        })
        .catch(function() {
          document.getElementById('notif-email-display').textContent = 'Unable to load';
        });
    }

    function toggleNotifForm() {
      var form = document.getElementById('notif-form');
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('notif-email-input').focus(); }, 50);
      }
    }

    function saveNotifEmail() {
      var email = document.getElementById('notif-email-input').value.trim();
      if (!email) { toast('Email cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId + '/notification-email', {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email: email }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Alert email updated', 'success');
            var el = document.getElementById('notif-email-display');
            el.textContent = email;
            el.className   = 'org-key-status set';
            document.getElementById('notif-form').classList.remove('open');
            document.getElementById('notif-email-input').value = '';
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed — network error', 'error'); });
    }

    function toggleOrgKeyForm() {
      var form = document.getElementById('org-key-form');
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('org-key-input').focus(); }, 50);
      }
    }

    function saveOrgKey() {
      var key = document.getElementById('org-key-input').value.trim();
      if (!key) { toast('Key cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId + '/api-key', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ apiKey: key }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Organization API key saved', 'success');
            state.orgHasKey = true;
            renderOrgKeyStatus();
            document.getElementById('org-key-form').classList.remove('open');
            document.getElementById('org-key-input').value = '';
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    function testOrgKey() {
      var btn = document.getElementById('org-test-btn');
      btn.disabled = true; btn.textContent = 'Testing…';
      var loc = state.locations[0];
      if (!loc) { toast('No locations to test with', 'error'); btn.disabled = false; btn.textContent = 'Test'; return; }
      apiFetch('/operator/' + clientId + '/locations/' + loc.id + '/api-key/test')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.valid) {
            toast('✓ Key valid — Kisi connected', 'success');
          } else {
            toast('✗ ' + (data.error || 'Key invalid'), 'error');
          }
        })
        .catch(function() { toast('Test failed', 'error'); })
        .finally(function() { btn.disabled = false; btn.textContent = 'Test'; });
    }

    // ── Locations ──────────────────────────────────────────────────────
    function loadLocations() {
      apiFetch('/operator/' + clientId + '/locations')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          state.locations = data.locations || [];
          document.getElementById('loc-loading').style.display = 'none';
          if (!state.locations.length) {
            document.getElementById('loc-empty').style.display = '';
            return;
          }
          renderLocations();
        })
        .catch(function() {
          document.getElementById('loc-loading').style.display = 'none';
          toast('Failed to load locations', 'error');
        });
    }

    function renderLocations() {
      var list = document.getElementById('loc-list');
      list.innerHTML = state.locations.map(function(loc) { return locCard(loc); }).join('');
    }

    function locCard(loc) {
      var keyLabel = loc.has_location_key
        ? '<span class="key-label has-override">Location override set</span><span class="key-source-badge">Override</span>'
        : '<span class="key-label">Using organization key</span><span class="key-source-badge inherited">Inherited</span>';

      var addressHTML = loc.city
        ? '<div class="loc-address">' + esc(loc.city) + (loc.state ? ', ' + esc(loc.state) : '') + '</div>'
        : '';

      var tierHTML = loc.tier
        ? '<span class="pill pill-info">' + esc(loc.tier) + '</span>'
        : '';

      var errorColor = loc.error_count > 0 ? 'var(--red)' : 'inherit';

      return '<div class="loc-card" id="loc-' + loc.id + '">' +
        '<div class="loc-header">' +
          '<div class="loc-icon">📍</div>' +
          '<div class="loc-meta">' +
            '<div class="loc-name">' + esc(loc.name) + '</div>' +
            addressHTML +
          '</div>' +
          '<div class="loc-pills">' + subPill(loc.subscription_status) + tierHTML + '</div>' +
        '</div>' +
        '<div class="loc-body">' +
          '<div class="loc-stats">' +
            '<div class="loc-stat"><div class="loc-stat-val">' + loc.door_count + '</div><div class="loc-stat-lbl">Doors</div></div>' +
            '<div class="loc-stat"><div class="loc-stat-val">' + loc.plan_count + '</div><div class="loc-stat-lbl">Plan Mappings</div></div>' +
            '<div class="loc-stat"><div class="loc-stat-val" style="color:' + errorColor + '">' + loc.error_count + '</div><div class="loc-stat-lbl">Errors</div></div>' +
          '</div>' +
          '<div class="loc-actions">' +
            (loc.subscription_status === 'active'
              ? '<button class="btn btn-sm btn-danger" onclick="suspendLocation(\'' + loc.id + '\')">Suspend Location</button>'
              : '<button class="btn btn-sm btn-secondary" onclick="reactivateLocation(\'' + loc.id + '\')">Reactivate Location</button>'
            ) +
          '</div>' +
          '<div class="key-section">' +
            '<div class="key-section-title">' +
              '<svg width="12" height="12" viewBox="0 0 14 14" fill="none">' +
                '<path d="M9 1.5a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm0 0" stroke="currentColor" stroke-width="1.3" fill="none"/>' +
                '<circle cx="9" cy="4.5" r=".8" fill="currentColor"/>' +
                '<path d="M5.5 7.5L1 12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>' +
                '<path d="M3 10H4.2V11.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>' +
              '</svg>' +
              'Hardware API Key' +
            '</div>' +
            '<div class="key-row">' +
              keyLabel +
              '<div style="display:flex;gap:6px;">' +
                '<button class="btn btn-sm btn-ghost" id="test-' + loc.id + '" onclick="testLocKey(\'' + loc.id + '\')">Test</button>' +
                '<button class="btn btn-sm btn-secondary" onclick="toggleLocKeyForm(\'' + loc.id + '\')">' +
                  (loc.has_location_key ? 'Rotate Override' : 'Set Override') +
                '</button>' +
              '</div>' +
            '</div>' +
            '<div class="test-result" id="testres-' + loc.id + '"></div>' +
            '<div class="key-form" id="keyform-' + loc.id + '">' +
              '<div class="key-form-inner">' +
                '<div class="key-input-hint">Set a per-location key override (DR-028). Leave blank to use the organization key. Only needed if this location is in a <strong>different Kisi organization</strong>.</div>' +
                '<input type="password" class="key-input" id="keyinput-' + loc.id + '" placeholder="Paste location-specific Kisi API key…" autocomplete="off"/>' +
                '<div class="key-form-actions">' +
                  '<button class="btn btn-ghost btn-sm" onclick="toggleLocKeyForm(\'' + loc.id + '\')">Cancel</button>' +
                  '<button class="btn btn-primary btn-sm" onclick="saveLocKey(\'' + loc.id + '\')">Save Override</button>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';
    }

    function subPill(status) {
      if (status === 'active') return '<span class="pill pill-active">Active</span>';
      if (status === 'lapsed') return '<span class="pill pill-lapsed">Lapsed</span>';
      return '<span class="pill pill-inactive">Inactive</span>';
    }

    function toggleLocKeyForm(locationId) {
      var form = document.getElementById('keyform-' + locationId);
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('keyinput-' + locationId).focus(); }, 50);
      }
    }

    function saveLocKey(locationId) {
      var key = document.getElementById('keyinput-' + locationId).value.trim();
      if (!key) { toast('Key cannot be empty', 'error'); return; }
      apiFetch('/operator/' + clientId + '/locations/' + locationId + '/api-key', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ apiKey: key }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Location API key override saved', 'success');
            var loc = state.locations.find(function(l) { return l.id === locationId; });
            if (loc) { loc.has_location_key = true; }
            renderLocations();
            document.getElementById('keyinput-' + locationId).value = '';
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    function testLocKey(locationId) {
      var btn   = document.getElementById('test-' + locationId);
      var resEl = document.getElementById('testres-' + locationId);
      btn.disabled = true; btn.textContent = 'Testing…';
      resEl.style.display = 'none';
      apiFetch('/operator/' + clientId + '/locations/' + locationId + '/api-key/test')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          resEl.style.display = '';
          if (data.valid) {
            resEl.className   = 'test-result pass';
            resEl.textContent = '✓ Connected — using ' + (data.source === 'location' ? 'location override key' : 'organization key');
          } else {
            resEl.className   = 'test-result fail';
            resEl.textContent = '✗ ' + (data.error || 'Key invalid');
          }
        })
        .catch(function() {
          resEl.style.display = '';
          resEl.className   = 'test-result fail';
          resEl.textContent = '✗ Test failed — network error';
        })
        .finally(function() { btn.disabled = false; btn.textContent = 'Test'; });
    }

    function suspendLocation(locationId) {
      if (!confirm('Suspend this location? All provisioned members will lose access.')) return;
      apiFetch('/admin/clients/' + clientId + '/locations/' + locationId + '/suspend', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: 'suspended' }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Location suspended — ' + (data.suspended || 0) + ' member(s) affected', 'success');
            var loc = state.locations.find(function(l) { return l.id === locationId; });
            if (loc) { loc.subscription_status = 'lapsed'; }
            renderLocations();
          } else {
            toast(data.error || 'Suspend failed', 'error');
          }
        })
        .catch(function() { toast('Suspend failed — network error', 'error'); });
    }

    function reactivateLocation(locationId) {
      apiFetch('/admin/clients/' + clientId + '/locations/' + locationId + '/activate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Location reactivated', 'success');
            var loc = state.locations.find(function(l) { return l.id === locationId; });
            if (loc) { loc.subscription_status = 'active'; }
            renderLocations();
          } else {
            toast(data.error || 'Reactivate failed', 'error');
          }
        })
        .catch(function() { toast('Reactivate failed — network error', 'error'); });
    }

    function toast(msg, type, duration) {
      type     = type     || 'info';
      duration = duration || 3500;
      var wrap = document.getElementById('toastWrap');
      var el   = document.createElement('div');
      el.className   = 'toast-loc ' + type;
      el.textContent = msg;
      wrap.appendChild(el);
      setTimeout(function() { el.remove(); }, duration);
    }
  </script>
</body>
</html>
