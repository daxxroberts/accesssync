<%#
  @file locations.ejs
  @layer admin/pages
  @route /locations
  @role system-config
  @data GET /operator/:clientId, /operator/:clientId/locations, /operator/clients/:clientId/wix-api-key/status, /operator/clients/:clientId/notification-email, /operator/:clientId/setup-snippets
  @writes PATCH /operator/:clientId/locations/:locationId (tier, platform, name, city, state), POST /operator/:clientId/locations/:locationId/api-key, POST /operator/:clientId/locations/:locationId/suspend, POST /operator/:clientId/locations/:locationId/activate, PUT /operator/:clientId/locations/:locationId/notification-email
  @tab System Config
  @features per-location tier/platform/key/email, profile card (Wix key + rollup email), suspend/reactivate, wix-setup-guide (inner tab)
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Operator Dashboard: System Config' }) %>
  <style>
    .page { max-width: 900px; margin: 0 auto; padding: 24px 16px 60px; }

    .page-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: 20px; gap: 12px; flex-wrap: wrap;
    }
    .page-title { font-size: 18px; font-weight: 700; letter-spacing: -0.3px; }
    .page-sub   { font-size: 12px; color: var(--muted); margin-top: 3px; }

    /* ── Org key card ── */
    .org-key-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; box-shadow: var(--shadow);
    }
    .org-key-header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .org-key-icon {
      width: 36px; height: 36px; border-radius: 9px; background: var(--brand-dim);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .org-key-title { font-size: 13px; font-weight: 700; }
    .org-key-desc  { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .org-key-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; background: var(--bg);
      border-radius: 8px; border: 1px solid var(--border);
    }
    .org-key-status     { font-size: 12px; color: var(--muted); flex: 1; }
    .org-key-status.set { color: var(--sage-dark); font-weight: 600; }

    /* ── Section label ── */
    .section-label {
      font-size: 10px; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 12px;
    }

    /* ── Location cards ── */
    .loc-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; margin-bottom: 12px; box-shadow: var(--shadow); overflow: hidden;
    }
    .loc-header { display: flex; align-items: center; padding: 14px 18px; gap: 12px; }
    .loc-icon {
      width: 38px; height: 38px; border-radius: 9px; background: var(--brand-dim);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 16px;
    }
    .loc-meta { flex: 1; min-width: 0; }
    .loc-name    { font-size: 13px; font-weight: 700; }
    .loc-address { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .loc-pills   { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    /* ── Pills ── */
    .pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 600; border: 1px solid transparent; }
    .pill-active   { background: var(--sage-dim);  color: var(--sage-dark); border-color: var(--sage-border); }
    .pill-inactive { background: var(--bg);         color: var(--muted);     border-color: var(--border); }
    .pill-lapsed   { background: var(--amber-dim);  color: var(--amber);     border-color: rgba(245,166,35,0.2); }
    .pill-info     { background: var(--brand-dim);  color: var(--brand);     border-color: var(--brand-glow); }

    /* ── Location body ── */
    .loc-body { border-top: 1px solid var(--border); padding: 16px 18px; }
    .loc-stats {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px;
    }
    .loc-stat { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
    .loc-stat-val { font-size: 18px; font-weight: 700; }
    .loc-stat-lbl { font-size: 10px; color: var(--muted); margin-top: 2px; }

    /* ── API key section ── */
    .key-section      { margin-top: 4px; }
    .key-section-title { font-size: 11px; font-weight: 700; color: var(--text2); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
    .key-row {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 14px; background: var(--bg);
      border-radius: 8px; border: 1px solid var(--border);
    }
    .key-label              { font-size: 11px; color: var(--muted); flex: 1; }
    .key-label.has-key      { color: var(--sage-dark); font-weight: 600; }
    .key-label.has-override { color: var(--brand); font-weight: 600; }
    .key-source-badge          { font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: var(--brand-dim); color: var(--brand); }
    .key-source-badge.inherited { background: var(--bg); color: var(--muted); border: 1px solid var(--border); }

    /* ── Key input form ── */
    .key-form { margin-top: 10px; display: none; }
    .key-form.open { display: block; }
    .key-form-inner { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 14px; }
    .key-input {
      width: 100%; padding: 9px 12px; font-family: inherit; font-size: 12px;
      background: var(--card); border: 1px solid var(--border2);
      border-radius: 7px; color: var(--text); outline: none; transition: border 0.15s; margin-bottom: 10px;
    }
    .key-input:focus { border-color: var(--brand); }
    .key-input-hint { font-size: 10px; color: var(--muted); margin-bottom: 10px; line-height: 1.5; }
    .key-form-actions { display: flex; gap: 8px; justify-content: flex-end; }

    /* Buttons provided by operator-styles.css */

    /* ── Config rows (inside profile + location cards) ── */
    .config-section { border-top: 1px solid var(--border); margin-top: 14px; padding-top: 4px; }
    .config-row { padding: 10px 0; border-bottom: 1px solid var(--border); }
    .config-row:last-child { border-bottom: none; }
    .config-row-header { display: flex; align-items: center; gap: 10px; }
    .config-row-label { font-size: 12px; font-weight: 600; color: var(--text2); min-width: 120px; flex-shrink: 0; }
    .config-row-status { font-size: 12px; color: var(--muted); flex: 1; }
    .config-row-status.set { color: var(--sage-dark); font-weight: 600; }
    .config-row-status.warn { color: var(--red); font-weight: 600; }
    .config-select { padding: 5px 10px; font-family: inherit; font-size: 11px; background: var(--card); border: 1px solid var(--border2); border-radius: 6px; color: var(--text); cursor: pointer; }

    /* ── Test result ── */
    .test-result {
      margin-top: 8px; padding: 8px 12px; border-radius: 7px; font-size: 11px; font-weight: 600; display: none;
    }
    .test-result.pass { background: var(--sage-dim);  color: var(--sage-dark); border: 1px solid var(--sage-border); }
    .test-result.fail { background: var(--red-dim);   color: var(--red);        border: 1px solid rgba(255,77,106,0.2); }

    /* ── Empty / loading ── */
    .empty { text-align: center; padding: 48px 24px; color: var(--muted); font-size: 13px; }
    .empty-icon  { font-size: 32px; margin-bottom: 12px; }
    .empty-title { font-weight: 700; color: var(--text2); margin-bottom: 6px; }
    .loading { text-align: center; padding: 40px; color: var(--muted); font-size: 12px; }
    @keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
    .spinner { width: 20px; height: 20px; border: 2px solid var(--border); border-top-color: var(--brand); border-radius: 50%; animation: spin 0.7s linear infinite; margin: 0 auto 10px; }

    /* ── Toast (page variant — stacked bottom-right) ── */
    .toast-wrap { position: fixed; bottom: 20px; right: 20px; z-index: 999; display: flex; flex-direction: column; gap: 8px; }
    .toast-loc { padding: 10px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #fff; box-shadow: var(--shadow-md); animation: slideIn 0.2s ease; }
    @keyframes slideIn { from{transform:translateY(10px);opacity:0} to{transform:translateY(0);opacity:1} }
    .toast-loc.success { background: #22C55E; }
    .toast-loc.error   { background: var(--red); }
    .toast-loc.info    { background: var(--brand); }

    /* ── Inner tab nav (Locations / Wix Setup) ── */
    .inner-tabs { display: flex; gap: 2px; margin-bottom: 20px; border-bottom: 1px solid var(--border); }
    .inner-tab {
      padding: 8px 16px; font-size: 12px; font-weight: 600; color: var(--muted);
      background: none; border: none; border-bottom: 2px solid transparent;
      cursor: pointer; font-family: inherit; transition: color 0.12s;
      margin-bottom: -1px;
    }
    .inner-tab:hover { color: var(--text); }
    .inner-tab.active { color: var(--brand); border-bottom-color: var(--brand); }

    /* ── Setup Guide snippets ── */
    .setup-section { display: none; }
    .setup-section.active { display: block; }
    .snippet-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 20px; margin-bottom: 16px; box-shadow: var(--shadow);
    }
    .snippet-card-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px; gap: 10px; }
    .snippet-card-title  { font-size: 13px; font-weight: 700; }
    .snippet-card-badge  { font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 4px; background: var(--brand-dim); color: var(--brand); flex-shrink: 0; }
    .snippet-instructions {
      font-size: 11px; color: var(--muted); line-height: 1.7; margin-bottom: 14px;
    }
    .snippet-instructions ol { margin: 8px 0 0 18px; padding: 0; }
    .snippet-instructions li { margin-bottom: 4px; }
    .snippet-field-label { font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 6px; }
    .snippet-row {
      display: flex; align-items: center; gap: 8px;
      padding: 9px 13px; background: var(--bg);
      border: 1px solid var(--border); border-radius: 8px; margin-bottom: 10px;
    }
    .snippet-value {
      flex: 1; font-family: monospace; font-size: 11px; color: var(--text);
      word-break: break-all; white-space: pre-wrap;
    }
    .snippet-value.masked { filter: blur(4px); transition: filter 0.2s; cursor: pointer; }
    .snippet-value.masked:hover { filter: blur(2px); }
    .snippet-code-block {
      background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
      padding: 14px; margin-bottom: 10px; position: relative;
    }
    .snippet-code-block pre {
      font-family: monospace; font-size: 10.5px; color: var(--text2);
      white-space: pre-wrap; word-break: break-all; margin: 0; line-height: 1.6;
    }
    .snippet-copy-row { display: flex; gap: 8px; justify-content: flex-end; align-items: center; }
    .snippet-copy-btn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 5px 12px; font-size: 11px; font-weight: 600;
      background: var(--card); border: 1px solid var(--border2); border-radius: 6px;
      color: var(--text2); cursor: pointer; font-family: inherit; transition: all 0.12s;
    }
    .snippet-copy-btn:hover { background: var(--brand-dim); color: var(--brand); border-color: var(--brand-glow); }
    .snippet-copy-btn.copied { background: var(--sage-dim); color: var(--sage-dark); border-color: var(--sage-border); }
    .snippet-reveal-btn {
      padding: 4px 10px; font-size: 10px; font-weight: 600;
      background: none; border: 1px solid var(--border2); border-radius: 5px;
      color: var(--muted); cursor: pointer; font-family: inherit; flex-shrink: 0;
    }
    .snippet-reveal-btn:hover { border-color: var(--brand); color: var(--brand); }
    .snippet-loading { font-size: 12px; color: var(--muted); padding: 32px 0; text-align: center; }
    .snippet-divider { border: none; border-top: 1px solid var(--border); margin: 16px 0; }

    /* OB-237 Phase B — Setup Hub status badges + env-issue banner */
    .setup-aggregate {
      padding: 14px 18px; border-radius: 10px; margin-bottom: 18px;
      display: flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 600;
      border: 1px solid var(--border);
    }
    .setup-aggregate.green  { background: var(--sage-dim);  color: var(--sage-dark);  border-color: var(--sage-border); }
    .setup-aggregate.amber  { background: #FEF3C7;          color: #92400E;           border-color: #FCD34D; }
    .setup-aggregate.red    { background: #FEE2E2;          color: #991B1B;           border-color: #FCA5A5; }
    .setup-aggregate-icon { font-size: 18px; }
    .setup-aggregate-action { margin-left: auto; font-size: 11px; }

    .snippet-status-badge {
      font-size: 10px; font-weight: 700; padding: 3px 8px; border-radius: 12px;
      display: inline-flex; align-items: center; gap: 4px;
      text-transform: uppercase; letter-spacing: 0.4px;
    }
    .snippet-status-badge.verified            { background: var(--sage-dim);  color: var(--sage-dark); }
    .snippet-status-badge.installed_unverified{ background: #FEF3C7;          color: #92400E; }
    .snippet-status-badge.stale               { background: #FEF3C7;          color: #92400E; }
    .snippet-status-badge.broken              { background: #FEE2E2;          color: #991B1B; }
    .snippet-status-badge.not_installed       { background: var(--bg);        color: var(--muted); border: 1px solid var(--border); }
    .snippet-status-dot {
      width: 7px; height: 7px; border-radius: 50%; display: inline-block;
    }
    .verified .snippet-status-dot             { background: var(--sage-dark); }
    .installed_unverified .snippet-status-dot { background: #92400E; }
    .stale .snippet-status-dot                { background: #92400E; }
    .broken .snippet-status-dot               { background: #991B1B; }
    .not_installed .snippet-status-dot        { background: var(--muted); }

    .snippet-card.broken { border-color: #FCA5A5; }
    .snippet-render-error {
      background: #FEE2E2; color: #991B1B; padding: 10px 14px; border-radius: 8px;
      font-size: 11px; margin-bottom: 12px; border: 1px solid #FCA5A5;
    }
    .setup-env-banner {
      background: #FEE2E2; color: #991B1B; padding: 12px 16px; border-radius: 10px;
      font-size: 12px; margin-bottom: 18px; border: 1px solid #FCA5A5;
    }
    .setup-env-banner strong { font-weight: 700; }
    .snippet-meta {
      font-size: 10px; color: var(--muted); margin-top: 8px;
      display: flex; gap: 12px; flex-wrap: wrap;
    }
    .snippet-meta-item { display: inline-flex; align-items: center; gap: 4px; }
    .snippet-badge-row {
      display: flex; gap: 6px; align-items: center; flex-wrap: wrap;
    }
    .snippet-test-result {
      font-size: 11px; padding: 8px 12px; border-radius: 6px;
      margin: 8px 0; border: 1px solid var(--border);
    }
    .snippet-test-result[data-result="ok"] {
      background: var(--sage-dim); color: var(--sage-dark); border-color: var(--sage-border);
    }
    .snippet-test-result:not([data-result="ok"]) {
      background: #FEF3C7; color: #92400E; border-color: #FCD34D;
    }

    @media (max-width: 600px) {
      .loc-stats   { grid-template-columns: repeat(2, 1fr); }
      .page-header { flex-direction: column; }
    }
  </style>
</head>
<body data-session-role="<%= sessionRole %>"<% if (loginUrl) { %> data-login-url="<%= loginUrl %>"<% } %>>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <main class="page">
    <div class="page-header">
      <div>
        <div class="page-title">System Config</div>
        <div class="page-sub">Connect your integrations, manage API keys, and set up your locations</div>
      </div>
    </div>

    <!-- Inner tab nav -->
    <div class="inner-tabs">
      <button class="inner-tab active" id="tab-locations" onclick="switchTab('locations')">Locations</button>
      <button class="inner-tab" id="tab-setup" onclick="switchTab('setup')">Wix Setup Guide</button>
    </div>

    <!-- ══ Locations section ══════════════════════════════════════════ -->
    <div id="section-locations">

    <!-- Client profile (consolidated) -->
    <div class="org-key-card" id="profile-card">
      <div class="org-key-header">
        <div class="org-key-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <rect x="2" y="2" width="14" height="14" rx="3" stroke="var(--brand)" stroke-width="1.4" fill="none"/>
            <circle cx="9" cy="7" r="2.5" stroke="var(--brand)" stroke-width="1.3" fill="none"/>
            <path d="M4 15c0-3 2.2-5 5-5s5 2 5 5" stroke="var(--brand)" stroke-width="1.3" fill="none"/>
          </svg>
        </div>
        <div style="flex:1;">
          <div class="org-key-title" id="profile-name">Loading…</div>
          <div class="org-key-desc" id="profile-meta"></div>
        </div>
        <button class="btn btn-sm btn-ghost" onclick="toggleProfileEdit()">Edit Name</button>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;" id="profile-pills"></div>
      <div class="key-form" id="profile-form">
        <div class="key-form-inner" style="margin-top:10px;">
          <input type="text" class="key-input" id="profile-name-input" placeholder="Business name…"/>
          <div class="key-form-actions">
            <button class="btn btn-ghost btn-sm" onclick="toggleProfileEdit()">Cancel</button>
            <button class="btn btn-primary btn-sm" onclick="saveProfileName()">Save</button>
          </div>
        </div>
      </div>

      <!-- Config rows inside profile card -->
      <div class="config-section">
        <!-- Wix API Key -->
        <div class="config-row">
          <div class="config-row-header">
            <span class="config-row-label">Wix API Key</span>
            <span class="config-row-status" id="wix-key-status">Checking…</span>
            <div style="display:flex;gap:6px;">
              <button class="btn btn-sm btn-ghost" id="wix-test-btn" onclick="testWixKey()" style="display:none;">Test</button>
              <button class="btn btn-sm btn-secondary" id="wix-key-btn" onclick="toggleWixKeyForm()">Set Key</button>
            </div>
          </div>
          <div class="key-form" id="wix-key-form">
            <div class="key-form-inner" style="margin-top:10px;">
              <div class="key-input-hint">Stored securely — write-only. Required so AccessSync can look up your member plans.</div>
              <input type="password" class="key-input" id="wix-key-input" placeholder="Paste your Wix API key…" autocomplete="off"/>
              <div class="key-form-actions">
                <button class="btn btn-ghost btn-sm" onclick="toggleWixKeyForm()">Cancel</button>
                <button class="btn btn-primary btn-sm" onclick="saveWixKey()">Save Key</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Rollup Alert Email -->
        <div class="config-row">
          <div class="config-row-header">
            <span class="config-row-label">Rollup Email</span>
            <span class="config-row-status" id="notif-email-display">Loading…</span>
            <button class="btn btn-sm btn-secondary" id="notif-edit-btn" onclick="toggleNotifForm()">Edit</button>
          </div>
          <div class="key-form" id="notif-form">
            <div class="key-form-inner" style="margin-top:10px;">
              <div class="key-input-hint">Gets alerts for all locations — errors, key failures, and grant confirmations. Each location can use its own email instead.</div>
              <input type="email" class="key-input" id="notif-email-input" placeholder="alerts@yourgym.com" autocomplete="off"/>
              <div class="key-form-actions">
                <button class="btn btn-ghost btn-sm" onclick="toggleNotifForm()">Cancel</button>
                <button class="btn btn-primary btn-sm" onclick="saveNotifEmail()">Save</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Locations -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div class="section-label" style="margin-bottom:0;">Locations</div>
      <% if (sessionRole === 'owner') { %><button class="btn btn-sm btn-secondary" onclick="toggleAddLocationForm()">+ Add Location</button><% } %>
    </div>

    <!-- Add location form -->
    <div class="key-form" id="add-loc-form">
      <div class="org-key-card" style="margin-bottom:16px;border:1px dashed var(--brand);">
        <div class="org-key-title" style="margin-bottom:12px;">New Location</div>
        <input type="text" class="key-input" id="add-loc-name" placeholder="Location name *" />
        <div style="display:flex;gap:8px;">
          <input type="text" class="key-input" id="add-loc-city" placeholder="City" style="flex:1;margin-bottom:0;" />
          <input type="text" class="key-input" id="add-loc-state" placeholder="State" style="width:80px;margin-bottom:0;" />
        </div>
        <div style="margin-top:10px;">
          <select class="key-input" id="add-loc-tier" style="margin-bottom:0;">
            <option value="">Tier (optional)</option>
            <option value="Base">Base</option>
            <option value="Pro">Pro</option>
            <option value="Connect">Connect</option>
          </select>
        </div>
        <div class="key-form-actions" style="margin-top:12px;">
          <button class="btn btn-ghost btn-sm" onclick="toggleAddLocationForm()">Cancel</button>
          <button class="btn btn-primary btn-sm" id="add-loc-submit" onclick="addLocation()">Create Location</button>
        </div>
      </div>
    </div>

    <div id="loc-loading" class="loading"><div class="spinner"></div>Loading locations…</div>
    <div id="loc-empty" class="empty" style="display:none;">
      <div class="empty-icon">📍</div>
      <div class="empty-title">No locations yet</div>
      <div>Use the button above to add your first location.</div>
    </div>
    <div id="loc-list"></div>

    </div><!-- /section-locations -->

    <!-- ══ Wix Setup Hub section (OB-237 Phase B) ═════════════════════ -->
    <div id="section-setup" class="setup-section">
      <div id="setup-loading" class="snippet-loading">
        <div class="spinner"></div>Loading setup data…
      </div>
      <div id="setup-content" style="display:none;">
        <div id="setup-aggregate-pill"></div>
        <div id="setup-env-banner"></div>
        <div id="setup-webhook-card"></div>
        <div id="setup-snippets-list"></div>
      </div><!-- /setup-content -->
    </div><!-- /section-setup -->

  </main>

  <div class="toast-wrap" id="toastWrap"></div>

  <script src="/operator-nav.js"></script>
  <script>
    'use strict';

    var params   = new URLSearchParams(window.location.search);
    var clientId = params.get('clientId') || '';

    var state = {
      locations: [],
      wixHasKey: false,
      client: null,
    };

    document.addEventListener('DOMContentLoaded', function() {
      activateJumpTarget();
      if (!clientId) {
        toast('No clientId in URL — add ?clientId=YOUR_ID', 'error');
        return;
      }
      loadClientProfile();
      loadWixKeyStatus();
      loadNotifEmail();
      loadLocations();
      // OB-237 Phase D — deep link from Dashboard pill: #setup auto-opens the Setup Hub tab
      if (window.location.hash === '#setup') {
        switchTab('setup');
      }
    });

    // ── API helpers ────────────────────────────────────────────────────
    // apiFetch is provided by operator-nav.js (handles 401 → session expired modal)

    // ── Notification email (rollup — client-level) ──────────────────────
    function loadNotifEmail() {
      apiFetch('/operator/clients/' + clientId + '/notification-email')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var el = document.getElementById('notif-email-display');
          if (data.email) {
            el.textContent = data.email;
            el.className   = 'config-row-status set';
          } else {
            el.textContent = 'Not set — alerts will use the system default';
            el.className   = 'config-row-status';
          }
        })
        .catch(function() {
          document.getElementById('notif-email-display').textContent = 'Unable to load';
        });
    }

    function toggleNotifForm() {
      var form = document.getElementById('notif-form');
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('notif-email-input').focus(); }, 50);
      }
    }

    function saveNotifEmail() {
      var email = document.getElementById('notif-email-input').value.trim();
      if (!email) { toast('Email cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId + '/notification-email', {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email: email }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Alert email updated', 'success');
            var el = document.getElementById('notif-email-display');
            el.textContent = email;
            el.className   = 'config-row-status set';
            document.getElementById('notif-form').classList.remove('open');
            document.getElementById('notif-email-input').value = '';
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed — network error', 'error'); });
    }

    // ── Wix API key ───────────────────────────────────────────────────
    function loadWixKeyStatus() {
      apiFetch('/operator/clients/' + clientId + '/wix-api-key/status')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          state.wixHasKey = !!data.hasKey;
          renderWixKeyStatus();
        })
        .catch(function() {
          document.getElementById('wix-key-status').textContent = 'Unable to check';
        });
    }

    function renderWixKeyStatus() {
      var statusEl = document.getElementById('wix-key-status');
      var btnEl    = document.getElementById('wix-key-btn');
      var testBtn  = document.getElementById('wix-test-btn');
      if (state.wixHasKey) {
        statusEl.textContent = '✓ Key configured';
        statusEl.style.color = 'var(--sage-dark)';
        btnEl.textContent    = 'Rotate Key';
        testBtn.style.display = '';
      } else {
        statusEl.textContent = '✗ No key set';
        statusEl.style.color = 'var(--red)';
        btnEl.textContent    = 'Set Key';
        testBtn.style.display = 'none';
      }
    }

    function toggleWixKeyForm() {
      var form = document.getElementById('wix-key-form');
      form.classList.toggle('open');
    }

    function saveWixKey() {
      var key = document.getElementById('wix-key-input').value.trim();
      if (!key) { toast('Key cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId + '/wix-api-key', {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ apiKey: key }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Wix API key saved', 'success');
            state.wixHasKey = true;
            renderWixKeyStatus();
            document.getElementById('wix-key-form').classList.remove('open');
            document.getElementById('wix-key-input').value = '';
            setTimeout(testWixKey, 800);
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    function testWixKey() {
      var btn = document.getElementById('wix-test-btn');
      btn.disabled = true; btn.textContent = 'Testing…';
      apiFetch('/operator/clients/' + clientId + '/wix-api-key/test')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.valid) {
            toast('✓ Wix key valid — connected', 'success');
          } else {
            toast('✗ ' + (data.error || 'Key invalid'), 'error');
          }
        })
        .catch(function() { toast('Test failed', 'error'); })
        .finally(function() { btn.disabled = false; btn.textContent = 'Test'; });
    }

    // ── Client profile ────────────────────────────────────────────────
    function loadClientProfile() {
      apiFetch('/operator/' + clientId)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.client) return;
          state.client = data.client;
          renderClientProfile();
        })
        .catch(function() {});
    }

    function renderClientProfile() {
      var card = document.getElementById('profile-card');
      if (!card || !state.client) return;
      var c = state.client;
      document.getElementById('profile-name').textContent = c.name || 'Unnamed';
      var meta = [c.source_site_url ? c.source_site_url.replace(/^https?:\/\//, '') : ''].filter(Boolean).join(' · ');
      document.getElementById('profile-meta').textContent = meta;
      var pills = '';
      if (c.last_sync_at) {
        var ago = new Date(c.last_sync_at).toLocaleString([], {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});
        pills += '<span class="pill" style="background:var(--sage-dim);color:var(--sage-dark);">Last sync: ' + ago + '</span>';
      }
      document.getElementById('profile-pills').innerHTML = pills;
    }

    function toggleProfileEdit() {
      var form = document.getElementById('profile-form');
      form.classList.toggle('open');
      if (form.classList.contains('open') && state.client) {
        document.getElementById('profile-name-input').value = state.client.name || '';
      }
    }

    function saveProfileName() {
      var name = document.getElementById('profile-name-input').value.trim();
      if (!name) { toast('Name cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId, {
        method:  'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name: name }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            state.client.name = data.client.name;
            renderClientProfile();
            document.getElementById('profile-form').classList.remove('open');
            toast('Business name updated', 'success');
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    // ── Locations ──────────────────────────────────────────────────────
    function loadLocations() {
      apiFetch('/operator/' + clientId + '/locations')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          state.locations = data.locations || [];
          document.getElementById('loc-loading').style.display = 'none';
          if (!state.locations.length) {
            document.getElementById('loc-empty').style.display = '';
            return;
          }
          renderLocations();
        })
        .catch(function() {
          document.getElementById('loc-loading').style.display = 'none';
          toast('Failed to load locations', 'error');
        });
    }

    function renderLocations() {
      var list = document.getElementById('loc-list');
      list.innerHTML = state.locations.map(function(loc) { return locCard(loc); }).join('');
    }

    function locCard(loc) {
      var addressHTML = loc.city
        ? '<div class="loc-address">' + esc(loc.city) + (loc.state ? ', ' + esc(loc.state) : '') + '</div>'
        : '';

      var billingTier      = loc.billing && loc.billing.tier ? loc.billing.tier : null;
      var billingStatus    = loc.billing && loc.billing.status ? loc.billing.status : 'inactive';
      var connectorPlatform = loc.connector && loc.connector.platform ? loc.connector.platform : null;
      var hasKey           = !!(loc.connector && loc.connector.has_key);
      var keyLastVerified  = loc.connector && loc.connector.key_last_verified ? loc.connector.key_last_verified : null;
      var keyLastError     = loc.connector && loc.connector.key_last_error ? loc.connector.key_last_error : null;
      var keyStatusLabel;
      if (!hasKey) {
        keyStatusLabel = '<span class="config-row-status warn">✗ Not set</span>';
      } else if (keyLastError) {
        keyStatusLabel =
          '<span class="config-row-status set">✓ Key configured</span>' +
          '<span style="display:block;font-size:10px;color:var(--red);margin-top:2px;">Verification failed: ' + esc(keyLastError) + '</span>';
      } else if (keyLastVerified) {
        keyStatusLabel =
          '<span class="config-row-status set">✓ Key configured</span>' +
          '<span style="display:block;font-size:10px;color:var(--muted);margin-top:2px;">Last verified ' + esc(formatRelativeTime(keyLastVerified)) + '</span>';
      } else {
        keyStatusLabel =
          '<span class="config-row-status set">✓ Key configured</span>' +
          '<span style="display:block;font-size:10px;color:var(--amber);margin-top:2px;">● Never verified</span>';
      }
      var locEmail = loc.notification_email;
      var emailStatusLabel = locEmail
        ? '<span class="config-row-status set">' + esc(locEmail) + '</span>'
        : '<span class="config-row-status">(using rollup)</span>';

      var errorColor = loc.error_count > 0 ? 'var(--red)' : 'inherit';

      return '<div class="loc-card" id="loc-' + loc.id + '">' +
        // ── Header
        '<div class="loc-header">' +
          '<div class="loc-icon">📍</div>' +
          '<div class="loc-meta">' +
            '<div class="loc-name">' + esc(loc.name) + '</div>' +
            addressHTML +
          '</div>' +
          '<div class="loc-pills">' + subPill(billingStatus) + '</div>' +
          '<button class="btn btn-sm btn-ghost" onclick="toggleEditLocation(\'' + loc.id + '\')" title="Edit name/address">Edit</button>' +
        '</div>' +
        // ── Edit name/address form
        '<div class="key-form" id="editform-' + loc.id + '">' +
          '<div class="key-form-inner" style="margin:0 18px 8px;">' +
            '<input type="text" class="key-input" id="editname-' + loc.id + '" placeholder="Location name *"/>' +
            '<div style="display:flex;gap:8px;">' +
              '<input type="text" class="key-input" id="editcity-' + loc.id + '" placeholder="City" style="flex:1;margin-bottom:0;"/>' +
              '<input type="text" class="key-input" id="editstate-' + loc.id + '" placeholder="State" style="width:80px;margin-bottom:0;"/>' +
            '</div>' +
            '<div class="key-form-actions" style="margin-top:10px;">' +
              '<button class="btn btn-ghost btn-sm" onclick="toggleEditLocation(\'' + loc.id + '\')">Cancel</button>' +
              '<button class="btn btn-primary btn-sm" onclick="saveEditLocation(\'' + loc.id + '\')">Save</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        // ── Config rows
        '<div class="loc-body">' +
          '<div class="config-section" style="margin-top:0;border-top:1px solid var(--border);padding-top:0;">' +
            // Row: Tier (locked once set)
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">Tier</span>' +
                (billingTier
                  ? '<span class="config-row-status set">' + esc(billingTier) + '</span>'
                  : '<select class="config-select" id="tier-' + loc.id + '" onchange="saveLocTier(\'' + loc.id + '\')">' +
                      '<option value="" selected>Not set</option>' +
                      '<option value="Base">Base</option>' +
                      '<option value="Pro">Pro</option>' +
                      '<option value="Connect">Connect</option>' +
                    '</select>'
                ) +
              '</div>' +
            '</div>' +
            // Row: Platform (locked once set)
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">Platform</span>' +
                (connectorPlatform
                  ? '<span class="config-row-status set">' + esc(connectorPlatform.charAt(0).toUpperCase() + connectorPlatform.slice(1)) + '</span>'
                  : '<select class="config-select" id="platform-' + loc.id + '" onchange="saveLocPlatform(\'' + loc.id + '\')">' +
                      '<option value="kisi" selected>Kisi</option>' +
                    '</select>'
                ) +
              '</div>' +
            '</div>' +
            // Row: Hardware API Key
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">Hardware Key</span>' +
                keyStatusLabel +
                '<div style="display:flex;gap:6px;">' +
                  '<button class="btn btn-sm btn-ghost" id="test-' + loc.id + '" onclick="testLocKey(\'' + loc.id + '\')">Test</button>' +
                  '<button class="btn btn-sm btn-secondary" onclick="toggleLocKeyForm(\'' + loc.id + '\')">' +
                    (hasKey ? 'Rotate' : 'Set Key') +
                  '</button>' +
                '</div>' +
              '</div>' +
              '<div class="test-result" id="testres-' + loc.id + '"></div>' +
              '<div class="key-form" id="keyform-' + loc.id + '">' +
                '<div class="key-form-inner">' +
                  '<div class="key-input-hint">Write-only — encrypted at rest (AES-256-GCM).</div>' +
                  '<input type="password" class="key-input" id="keyinput-' + loc.id + '" placeholder="Paste your hardware API key…" autocomplete="off"/>' +
                  '<div class="key-form-actions">' +
                    '<button class="btn btn-ghost btn-sm" onclick="toggleLocKeyForm(\'' + loc.id + '\')">Cancel</button>' +
                    '<button class="btn btn-primary btn-sm" onclick="saveLocKey(\'' + loc.id + '\')">Save Key</button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>' +
            // Row: Alert Email
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">Alert Email</span>' +
                emailStatusLabel +
                '<button class="btn btn-sm btn-secondary" onclick="toggleLocEmailForm(\'' + loc.id + '\')">' +
                  (locEmail ? 'Edit' : 'Set') +
                '</button>' +
              '</div>' +
              '<div class="key-form" id="emailform-' + loc.id + '">' +
                '<div class="key-form-inner">' +
                  '<div class="key-input-hint">Alerts for this location go here instead of the rollup email. Leave blank to use the rollup.</div>' +
                  '<input type="email" class="key-input" id="emailinput-' + loc.id + '" placeholder="alerts@yourlocation.com" autocomplete="off" value="' + esc(locEmail || '') + '"/>' +
                  '<div class="key-form-actions">' +
                    '<button class="btn btn-ghost btn-sm" onclick="toggleLocEmailForm(\'' + loc.id + '\')">Cancel</button>' +
                    '<button class="btn btn-primary btn-sm" onclick="saveLocEmail(\'' + loc.id + '\')">Save</button>' +
                  '</div>' +
                '</div>' +
              '</div>' +
            '</div>' +
          '</div>' +
          // ── Stats
          '<div class="loc-stats" style="margin-top:14px;">' +
            '<div class="loc-stat"><div class="loc-stat-val">' + loc.door_count + '</div><div class="loc-stat-lbl">Doors</div></div>' +
            '<div class="loc-stat"><div class="loc-stat-val">' + loc.plan_count + '</div><div class="loc-stat-lbl">Plan Mappings</div></div>' +
            '<div class="loc-stat"><div class="loc-stat-val" style="color:' + errorColor + '">' + loc.error_count + '</div><div class="loc-stat-lbl">Errors</div></div>' +
          '</div>' +
          '<div class="loc-actions">' +
            (billingStatus === 'active'
              ? '<button class="btn btn-sm btn-danger" onclick="suspendLocation(\'' + loc.id + '\')">Suspend Location</button>'
              : '<button class="btn btn-sm btn-secondary" onclick="reactivateLocation(\'' + loc.id + '\')">Reactivate Location</button>'
            ) +
          '</div>' +
        '</div>' +
      '</div>';
    }

    // ── Add location ────────────────────────────────────────────────
    function toggleAddLocationForm() {
      var form = document.getElementById('add-loc-form');
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('add-loc-name').focus(); }, 50);
      }
    }

    function addLocation() {
      var name  = document.getElementById('add-loc-name').value.trim();
      var city  = document.getElementById('add-loc-city').value.trim();
      var st    = document.getElementById('add-loc-state').value.trim();
      var tier  = document.getElementById('add-loc-tier').value;
      if (!name) { toast('Location name is required', 'error'); return; }

      var btn = document.getElementById('add-loc-submit');
      btn.disabled = true; btn.textContent = 'Creating…';

      apiFetch('/admin/clients/' + clientId + '/locations', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name: name, city: city || null, state: st || null, tier: tier || null }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.ok) { toast(data.error || 'Create failed', 'error'); return; }
          var loc = data.location;
          // Auto-activate the new location
          return apiFetch('/admin/clients/' + clientId + '/locations/' + loc.id + '/activate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
          })
            .then(function(r) { return r.json(); })
            .then(function(actData) {
              // Newly-created location: build nested billing/connector shape from what we just wrote.
              var newBillingStatus = actData.ok ? 'active' : ((loc.billing && loc.billing.status) || 'inactive');
              loc.billing = (loc.billing && loc.billing.tier) || tier
                ? { tier: loc.billing && loc.billing.tier ? loc.billing.tier : (tier || null), status: newBillingStatus, subscribed_at: null }
                : { tier: null, status: newBillingStatus, subscribed_at: null };
              loc.connector = null;  // No connector_subscriptions row until key is set
              loc.notification_email = null;
              loc.door_count  = 0;
              loc.plan_count  = 0;
              loc.error_count = 0;
              state.locations.push(loc);
              document.getElementById('loc-empty').style.display = 'none';
              renderLocations();
              document.getElementById('add-loc-form').classList.remove('open');
              document.getElementById('add-loc-name').value  = '';
              document.getElementById('add-loc-city').value  = '';
              document.getElementById('add-loc-state').value = '';
              document.getElementById('add-loc-tier').value  = '';
              toast('Location "' + loc.name + '" created and activated', 'success');
            });
        })
        .catch(function() { toast('Create failed — network error', 'error'); })
        .finally(function() { btn.disabled = false; btn.textContent = 'Create Location'; });
    }

    // ── Edit location ─────────────────────────────────────────────────
    function toggleEditLocation(locationId) {
      var form = document.getElementById('editform-' + locationId);
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        var loc = state.locations.find(function(l) { return l.id === locationId; });
        if (loc) {
          document.getElementById('editname-' + locationId).value  = loc.name || '';
          document.getElementById('editcity-' + locationId).value  = loc.city || '';
          document.getElementById('editstate-' + locationId).value = loc.state || '';
        }
        setTimeout(function() { document.getElementById('editname-' + locationId).focus(); }, 50);
      }
    }

    function saveEditLocation(locationId) {
      var name  = document.getElementById('editname-' + locationId).value.trim();
      var city  = document.getElementById('editcity-' + locationId).value.trim();
      var st    = document.getElementById('editstate-' + locationId).value.trim();
      if (!name) { toast('Location name is required', 'error'); return; }

      apiFetch('/operator/' + clientId + '/locations/' + locationId, {
        method:  'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name: name, city: city || null, state: st || null }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.ok) { toast(data.error || 'Save failed', 'error'); return; }
          var loc = state.locations.find(function(l) { return l.id === locationId; });
          if (loc) {
            loc.name  = data.location.name;
            loc.city  = data.location.city;
            loc.state = data.location.state;
          }
          renderLocations();
          toast('Location updated', 'success');
        })
        .catch(function() { toast('Save failed — network error', 'error'); });
    }

    // ── Per-location tier ───────────────────────────────────────────
    function saveLocTier(locationId) {
      var tier = document.getElementById('tier-' + locationId).value || null;
      apiFetch('/operator/' + clientId + '/locations/' + locationId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tier: tier }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.ok) { toast(data.error || 'Save failed', 'error'); return; }
          var loc = state.locations.find(function(l) { return l.id === locationId; });
          if (loc) {
            loc.billing = data.location.billing || { tier: null, status: 'inactive' };
            renderLocations();
          }
          toast('Tier updated', 'success');
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    // ── Per-location platform ─────────────────────────────────────
    function saveLocPlatform(locationId) {
      var platform = document.getElementById('platform-' + locationId).value;
      apiFetch('/operator/' + clientId + '/locations/' + locationId, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hardware_platform: platform }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.ok) { toast(data.error || 'Save failed', 'error'); return; }
          var loc = state.locations.find(function(l) { return l.id === locationId; });
          if (loc) {
            loc.connector = data.location.connector || null;
            renderLocations();
          }
          toast('Platform updated', 'success');
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    // ── Per-location alert email ──────────────────────────────────
    function toggleLocEmailForm(locationId) {
      var form = document.getElementById('emailform-' + locationId);
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('emailinput-' + locationId).focus(); }, 50);
      }
    }

    function saveLocEmail(locationId) {
      var email = document.getElementById('emailinput-' + locationId).value.trim();
      if (!email) { toast('Email cannot be empty', 'error'); return; }
      apiFetch('/operator/' + clientId + '/locations/' + locationId + '/notification-email', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.ok) { toast(data.error || 'Save failed', 'error'); return; }
          var loc = state.locations.find(function(l) { return l.id === locationId; });
          if (loc) loc.notification_email = data.email;
          renderLocations();
          toast('Location alert email updated', 'success');
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    function subPill(status) {
      if (status === 'active') return '<span class="pill pill-active" title="This location is actively provisioning members.">Active</span>';
      if (status === 'lapsed') return '<span class="pill pill-lapsed" title="Subscription lapsed. Members at this location have been suspended.">Lapsed</span>';
      return '<span class="pill pill-inactive" title="Location not yet activated. Members won\'t be provisioned until active.">Inactive</span>';
    }

    function toggleLocKeyForm(locationId) {
      var form = document.getElementById('keyform-' + locationId);
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('keyinput-' + locationId).focus(); }, 50);
      }
    }

    function saveLocKey(locationId) {
      var key = document.getElementById('keyinput-' + locationId).value.trim();
      if (!key) { toast('Key cannot be empty', 'error'); return; }
      apiFetch('/operator/' + clientId + '/locations/' + locationId + '/api-key', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ apiKey: key }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Location API key override saved', 'success');
            var loc = state.locations.find(function(l) { return l.id === locationId; });
            if (loc) {
              loc.connector = loc.connector || { platform: 'kisi' };
              loc.connector.has_key = true;
              renderLocations();
            }
            renderLocations();
            document.getElementById('keyinput-' + locationId).value = '';
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    function testLocKey(locationId) {
      var btn   = document.getElementById('test-' + locationId);
      var resEl = document.getElementById('testres-' + locationId);
      btn.disabled = true; btn.textContent = 'Testing…';
      resEl.style.display = 'none';
      apiFetch('/operator/' + clientId + '/locations/' + locationId + '/api-key/test')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          resEl.style.display = '';
          if (data.valid) {
            resEl.className   = 'test-result pass';
            resEl.textContent = '✓ Connected — using ' + (data.source === 'location' ? 'location key' : 'client key');
          } else {
            resEl.className   = 'test-result fail';
            resEl.textContent = '✗ ' + (data.error || 'Key invalid');
          }
        })
        .catch(function() {
          resEl.style.display = '';
          resEl.className   = 'test-result fail';
          resEl.textContent = '✗ Test failed — network error';
        })
        .finally(function() { btn.disabled = false; btn.textContent = 'Test'; });
    }

    function suspendLocation(locationId) {
      if (!confirm('Suspend this location? All active members will lose door access immediately. This cannot be undone without reactivating the location.')) return;
      apiFetch('/operator/' + clientId + '/locations/' + locationId + '/suspend', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Location suspended — ' + (data.suspended || 0) + ' member(s) affected', 'success');
            var loc = state.locations.find(function(l) { return l.id === locationId; });
            if (loc) {
              loc.billing = loc.billing || {};
              loc.billing.status = 'lapsed';
              renderLocations();
            }
            renderLocations();
          } else {
            toast(data.error || 'Suspend failed', 'error');
          }
        })
        .catch(function() { toast('Suspend failed — network error', 'error'); });
    }

    function reactivateLocation(locationId) {
      apiFetch('/operator/' + clientId + '/locations/' + locationId + '/activate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Location reactivated', 'success');
            var loc = state.locations.find(function(l) { return l.id === locationId; });
            if (loc) {
              loc.billing = loc.billing || {};
              loc.billing.status = 'active';
              renderLocations();
            }
            renderLocations();
          } else {
            toast(data.error || 'Reactivate failed', 'error');
          }
        })
        .catch(function() { toast('Reactivate failed — network error', 'error'); });
    }

    function formatRelativeTime(iso) {
      if (!iso) return '';
      var t = new Date(iso).getTime();
      if (isNaN(t)) return '';
      var diff = Date.now() - t;
      if (diff < 0) diff = 0;
      var sec = Math.floor(diff / 1000);
      if (sec < 60)      return sec + ' second'  + (sec === 1 ? '' : 's') + ' ago';
      var min = Math.floor(sec / 60);
      if (min < 60)      return min + ' minute'  + (min === 1 ? '' : 's') + ' ago';
      var hr  = Math.floor(min / 60);
      if (hr < 24)       return hr  + ' hour'    + (hr  === 1 ? '' : 's') + ' ago';
      var day = Math.floor(hr / 24);
      if (day < 30)      return day + ' day'     + (day === 1 ? '' : 's') + ' ago';
      var mo = Math.floor(day / 30);
      if (mo < 12)       return mo  + ' month'   + (mo  === 1 ? '' : 's') + ' ago';
      var yr = Math.floor(day / 365);
      return yr + ' year' + (yr === 1 ? '' : 's') + ' ago';
    }

    function toast(msg, type, duration) {
      type     = type     || 'info';
      duration = duration || 3500;
      var wrap = document.getElementById('toastWrap');
      var el   = document.createElement('div');
      el.className   = 'toast-loc ' + type;
      el.textContent = msg;
      wrap.appendChild(el);
      setTimeout(function() { el.remove(); }, duration);
    }

    // ── Inner tab navigation ──────────────────────────────────────────
    var _snippetsLoaded = false;

    function switchTab(tab) {
      document.getElementById('tab-locations').classList.toggle('active', tab === 'locations');
      document.getElementById('tab-setup').classList.toggle('active', tab === 'setup');
      document.getElementById('section-locations').style.display = tab === 'locations' ? '' : 'none';
      var setupEl = document.getElementById('section-setup');
      setupEl.classList.toggle('active', tab === 'setup');
      if (tab === 'setup' && !_snippetsLoaded) loadSetupSnippets();
    }

    // ── Setup Hub (OB-237 Phase B — registry-driven) ──────────────────
    var _setupState = null;

    function loadSetupSnippets() {
      _snippetsLoaded = true;
      apiFetch('/operator/' + clientId + '/setup-state')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          _setupState = data;
          renderSetupHub(data);
        })
        .catch(function() {
          document.getElementById('setup-loading').innerHTML =
            '<div style="color:var(--red);font-size:12px;">Failed to load setup data — try refreshing.</div>';
        });
    }

    function renderSetupHub(d) {
      document.getElementById('setup-loading').style.display = 'none';
      document.getElementById('setup-content').style.display = '';

      renderAggregatePill(d.aggregate);
      renderEnvBanner(d.envIssues || []);
      renderWebhookCard(d);
      renderSnippetCards(d.snippets || []);
    }

    function renderAggregatePill(agg) {
      var el = document.getElementById('setup-aggregate-pill');
      var labels = {
        green: { icon: '🟢', text: 'All required snippets installed and verified', action: '' },
        amber: { icon: '🟡', text: 'Some snippets need attention',                  action: 'Review below' },
        red:   { icon: '🔴', text: 'Critical setup issue — door access may be broken', action: 'Fix below' }
      };
      var info = labels[agg] || labels.amber;
      el.className = 'setup-aggregate ' + agg;
      el.innerHTML =
        '<span class="setup-aggregate-icon">' + info.icon + '</span>' +
        '<span>' + esc(info.text) + '</span>' +
        (info.action ? '<span class="setup-aggregate-action">' + esc(info.action) + '</span>' : '');
    }

    function renderEnvBanner(envIssues) {
      var el = document.getElementById('setup-env-banner');
      if (!envIssues.length) { el.innerHTML = ''; return; }
      el.className = 'setup-env-banner';
      el.innerHTML =
        '<strong>Server configuration issue:</strong> the following environment variables are not set: <code>' +
        envIssues.map(esc).join('</code>, <code>') + '</code>. Snippets that depend on these cannot be generated. Contact AccessSync support.';
    }

    function renderWebhookCard(d) {
      var el = document.getElementById('setup-webhook-card');
      var webhookUrl = d.webhookUrl;
      var hmacSecret = d.hmacSecret;
      var hmacSource = d.hmacSource || 'none';

      // OB-238 + followup — secret-source badge + Rotate (server-gen new)
      // + Edit (operator pastes custom value). Both buttons always render —
      // neither depends on missing env vars.
      var secretSourceBadge = '';
      var rotateButtonLabel = 'Rotate secret';
      if (hmacSource === 'per_client') {
        secretSourceBadge =
          '<span class="snippet-status-badge verified" style="margin-left:8px;">' +
          '<span class="snippet-status-dot"></span>Per-client (isolated)</span>';
        rotateButtonLabel = 'Rotate secret';
      } else if (hmacSource === 'platform_env_fallback') {
        secretSourceBadge =
          '<span class="snippet-status-badge stale" style="margin-left:8px;">' +
          '<span class="snippet-status-dot"></span>Platform-shared (legacy)</span>';
        rotateButtonLabel = 'Generate per-client secret (recommended)';
      } else {
        secretSourceBadge =
          '<span class="snippet-status-badge broken" style="margin-left:8px;">' +
          '<span class="snippet-status-dot"></span>Not configured</span>';
        rotateButtonLabel = 'Generate per-client secret (recommended)';
      }
      var rotateButtonHtml =
        '<div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">' +
        '<button class="snippet-reveal-btn" id="rotate-webhook-secret-btn">' +
        rotateButtonLabel + '</button>' +
        '<button class="snippet-reveal-btn" id="edit-webhook-secret-btn">' +
        'Edit / Set custom value</button>' +
        '</div>';

      var html = '<div class="snippet-card"><div class="snippet-card-header"><div>' +
                 '<div class="snippet-badge-row">' +
                 '<div class="snippet-card-title">Webhook URL + HMAC Secret</div>' +
                 secretSourceBadge +
                 '</div>' +
                 '<div class="snippet-instructions" style="margin-top:6px;margin-bottom:0;">' +
                 'Used by the Velo backend snippet below to verify webhook authenticity. ' +
                 'Paste these into your Wix Secrets Manager (see events.js install instructions).' +
                 (hmacSource === 'platform_env_fallback'
                   ? ' <strong>Your account currently uses a shared platform secret.</strong> ' +
                     'Generating a per-client secret isolates your webhooks from other AccessSync operators.'
                   : '') +
                 '</div></div>' +
                 '<span class="snippet-card-badge">CONFIG</span></div>' +
                 '<hr class="snippet-divider">' +
                 '<div class="snippet-field-label">Webhook URL</div>' +
                 '<div class="snippet-row">' +
                 '<span class="snippet-value"' + (webhookUrl ? '' : ' style="color:var(--red)"') + '>' +
                 esc(webhookUrl || '(CORE_ENGINE_URL not configured — contact AccessSync support)') +
                 '</span>' +
                 (webhookUrl ? '<button class="snippet-copy-btn" data-copy-text="' + esc(webhookUrl) + '">Copy</button>' : '') +
                 '</div>' +
                 '<div class="snippet-field-label" style="margin-top:12px;">HMAC Secret</div>' +
                 '<div class="snippet-row">';
      if (hmacSecret) {
        html += '<span class="snippet-value masked" data-secret="' + esc(hmacSecret) + '">Click to reveal</span>' +
                '<button class="snippet-reveal-btn">Reveal</button>' +
                '<button class="snippet-copy-btn" data-copy-secret="1">Copy</button>';
      } else {
        html += '<span class="snippet-value" style="color:var(--red)">(WIX_WEBHOOK_SECRET not configured)</span>';
      }
      html += '</div>' + rotateButtonHtml + '</div>';
      el.innerHTML = html;

      // Wire up reveal + copy
      var revealBtn = el.querySelector('.snippet-reveal-btn');
      var maskedEl = el.querySelector('.snippet-value.masked');
      function reveal() {
        if (!maskedEl) return;
        maskedEl.classList.remove('masked');
        maskedEl.textContent = maskedEl.getAttribute('data-secret');
        if (revealBtn) revealBtn.style.display = 'none';
      }
      if (revealBtn) revealBtn.addEventListener('click', reveal);
      if (maskedEl)  maskedEl.addEventListener('click', reveal);

      el.querySelectorAll('.snippet-copy-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var text = btn.getAttribute('data-copy-secret')
            ? (maskedEl ? maskedEl.getAttribute('data-secret') : '')
            : btn.getAttribute('data-copy-text');
          if (!text) return;
          navigator.clipboard.writeText(text.trim()).then(function() {
            btn.classList.add('copied');
            var originalText = btn.textContent;
            btn.textContent = '✓ Copied';
            setTimeout(function() { btn.classList.remove('copied'); btn.textContent = originalText; }, 1800);
          }).catch(function() { toast('Copy failed — try manually selecting', 'error'); });
        });
      });

      // OB-238 — rotate + edit buttons
      var rotateBtn = document.getElementById('rotate-webhook-secret-btn');
      if (rotateBtn) rotateBtn.addEventListener('click', rotateWebhookSecret);
      var editBtn = document.getElementById('edit-webhook-secret-btn');
      if (editBtn) editBtn.addEventListener('click', editWebhookSecret);
    }

    function editWebhookSecret() {
      var entered = window.prompt(
        'Paste your custom HMAC secret value below.\n\n' +
        'This is the same value you would (or already do) have in your Wix Secrets Manager under the key "accesssync_webhook_secret".\n\n' +
        'Must be at least 32 characters. Can be longer (e.g., Wix-generated values are typically longer).'
      );
      if (entered === null) return; // canceled
      entered = (entered || '').trim();
      if (entered.length < 32) {
        toast('Secret must be at least 32 characters', 'error');
        return;
      }

      apiFetch('/operator/' + clientId + '/wix-webhook-secret/set', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ secret: entered })
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.ok) {
            toast(data.error || 'Save failed', 'error');
            return;
          }
          toast('Per-client secret saved — Wix Secrets Manager must match', 'success');
          _snippetsLoaded = false;
          loadSetupSnippets();
        })
        .catch(function() {
          toast('Save request failed — check your connection', 'error');
        });
    }

    function rotateWebhookSecret() {
      var confirmed = confirm(
        'Generate a new per-client webhook secret?\n\n' +
        'AccessSync will create a unique secret for this account. You MUST paste the new value into your Wix Secrets Manager under the key "accesssync_webhook_secret" — your webhooks will stop working until you do.\n\n' +
        'Continue?'
      );
      if (!confirmed) return;

      apiFetch('/operator/' + clientId + '/wix-webhook-secret/rotate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.ok) {
            toast(data.error || 'Rotate failed', 'error');
            return;
          }
          // Show the new secret ONCE via a modal-like confirm prompt the operator
          // must explicitly close, so they can paste before navigating away.
          window.prompt(
            'NEW per-client webhook secret — copy this NOW and paste into Wix Secrets Manager under the key "accesssync_webhook_secret".\n\n' +
            'This value will not be shown again — but you can re-reveal it from this page later.',
            data.secret
          );
          toast('Per-client secret saved — update Wix Secrets Manager now', 'success');
          _snippetsLoaded = false;
          loadSetupSnippets();
        })
        .catch(function() {
          toast('Rotate request failed — check your connection', 'error');
        });
    }

    function renderSnippetCards(snippets) {
      var el = document.getElementById('setup-snippets-list');

      // OB-238 followup — group snippets by display_group so paired snippets
      // (e.g. Sync Status + Thank-You Redirect, which depend on each other)
      // render inside one card.
      var groupTitles = {
        webhook: 'Webhook Forwarder',
        post_purchase_flow: 'Post-Purchase Flow (Sync Status + Redirect)',
        member_access: 'Member Access Page',
      };
      var groups = {};
      var groupOrder = [];
      snippets.forEach(function(s) {
        var g = s.display_group || s.id;
        if (!groups[g]) { groups[g] = []; groupOrder.push(g); }
        groups[g].push(s);
      });

      var html = groupOrder.map(function(gid) {
        var items = groups[gid];
        if (items.length === 1) {
          // Single-snippet group: render as before (one card per snippet)
          return buildSnippetCardHtml(items[0]);
        }
        // Multi-snippet group: group title + stacked snippet sections
        var title = groupTitles[gid] || items.map(function(i) { return i.name; }).join(' + ');
        return buildGroupedCardHtml(title, items);
      }).join('');

      el.innerHTML = html;

      // Wire up Copy + Test buttons across all groups
      el.querySelectorAll('[data-snippet-id]').forEach(function(node) {
        var snippetId = node.getAttribute('data-snippet-id');
        var copyBtn = node.querySelector('.snippet-copy-btn');
        if (copyBtn) copyBtn.addEventListener('click', function() { copySnippet(snippetId, copyBtn); });
        var testBtn = node.querySelector('[data-test-connection]');
        if (testBtn) testBtn.addEventListener('click', function() { testConnection(snippetId, testBtn); });
      });
    }

    function buildGroupedCardHtml(groupTitle, items) {
      // Worst-state badge for the group (broken > stale > installed_unverified > not_installed > verified)
      var stateRank = { broken: 4, stale: 3, installed_unverified: 2, not_installed: 1, verified: 0 };
      var worstState = items.reduce(function(acc, i) {
        return (stateRank[i.install_state] || 0) > (stateRank[acc] || 0) ? i.install_state : acc;
      }, 'verified');
      var stateLabels = {
        verified: 'Verified',
        installed_unverified: 'Installed — awaiting verification',
        stale: 'Out of date',
        broken: 'Broken',
        not_installed: 'Not detected yet'
      };

      var subSections = items.map(function(s) {
        return buildSubSnippetHtml(s);
      }).join('<hr class="snippet-divider" style="margin:24px 0;">');

      return '<div class="snippet-card ' + (worstState === 'broken' ? 'broken' : '') + '" data-display-group="' + esc(groupTitle) + '">' +
        '<div class="snippet-card-header">' +
        '<div style="flex:1;">' +
        '<div class="snippet-badge-row">' +
        '<div class="snippet-card-title">' + esc(groupTitle) + '</div>' +
        '<span class="snippet-status-badge ' + worstState + '">' +
        '<span class="snippet-status-dot"></span>' + esc(stateLabels[worstState] || worstState) + '</span>' +
        '</div>' +
        '<div class="snippet-instructions" style="margin-top:8px;margin-bottom:0;">' +
        'These snippets work together — install both for the post-purchase member experience.' +
        '</div>' +
        '</div>' +
        '<span class="snippet-card-badge">REQUIRED</span>' +
        '</div>' +
        '<hr class="snippet-divider">' +
        subSections +
        '</div>';
    }

    function buildSubSnippetHtml(s) {
      // Same content as buildSnippetCardHtml but without the outer card wrapper
      var stateLabels = {
        verified: 'Verified',
        installed_unverified: 'Installed — awaiting verification',
        stale: 'Out of date',
        broken: 'Broken',
        not_installed: 'Not detected yet'
      };
      var stateClass = s.install_state || 'not_installed';
      var stateLabel = stateLabels[stateClass] || stateClass;

      var instructionsHtml = (s.instructions || []).map(function(step) {
        return '<li>' + esc(step) + '</li>';
      }).join('');

      var renderErrorHtml = '';
      if (s.render_error === 'missing_env_vars') {
        renderErrorHtml = '<div class="snippet-render-error">' +
          '⚠ This snippet cannot be generated — missing server configuration: <strong>' +
          (s.render_missing_env || []).map(esc).join(', ') + '</strong>. Contact AccessSync support.' +
          '</div>';
      } else if (s.render_error) {
        renderErrorHtml = '<div class="snippet-render-error">⚠ Snippet render error: ' + esc(s.render_error) + '</div>';
      }

      var metaHtml = '<div class="snippet-meta">' +
        '<span class="snippet-meta-item"><strong>Version:</strong> ' + esc(s.current_version) + '</span>' +
        '<span class="snippet-meta-item"><strong>Install in:</strong> ' + esc(s.wix_install_path) + '</span>' +
        (s.version_installed ? '<span class="snippet-meta-item"><strong>You have:</strong> ' + esc(s.version_installed) + '</span>' : '') +
        (s.last_telemetry_at ? '<span class="snippet-meta-item"><strong>Last seen:</strong> ' + esc(fmtRelative(s.last_telemetry_at)) + '</span>' : '') +
        '</div>';

      var testBtnHtml = s.verify_via && s.verify_via !== 'none'
        ? '<button class="snippet-reveal-btn" data-test-connection="1">Test Connection</button>'
        : '';

      var lastTestHtml = s.last_test_result
        ? '<div class="snippet-test-result" data-result="' + esc(s.last_test_result) + '">' +
          (s.last_test_result === 'ok' ? '✓ Last test: verified' : '⚠ Last test: ' + esc(s.last_test_result)) +
          '</div>'
        : '';

      var bodyHtml = s.body
        ? '<div class="snippet-code-block"><pre>' + esc(s.body) + '</pre></div>' +
          lastTestHtml +
          '<div class="snippet-copy-row">' +
          testBtnHtml +
          '<button class="snippet-copy-btn">' +
          '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
          ' Copy snippet</button></div>'
        : '';

      var optionalBadge = s.category === 'optional'
        ? ' <span class="snippet-card-badge" style="background:var(--bg);color:var(--muted);font-size:9px;">OPTIONAL</span>'
        : '';

      return '<div data-snippet-id="' + esc(s.id) + '">' +
        '<div class="snippet-badge-row" style="margin-bottom:6px;">' +
        '<div class="snippet-card-title" style="font-size:12px;">' + esc(s.name) + '</div>' +
        '<span class="snippet-status-badge ' + stateClass + '">' +
        '<span class="snippet-status-dot"></span>' + esc(stateLabel) + '</span>' +
        optionalBadge +
        '</div>' +
        '<div class="snippet-instructions" style="margin-top:6px;margin-bottom:0;">' +
        esc(s.description) +
        (instructionsHtml ? '<ol>' + instructionsHtml + '</ol>' : '') +
        '</div>' +
        renderErrorHtml + metaHtml + bodyHtml +
        '</div>';
    }

    function buildSnippetCardHtml(s) {
      var stateClass = s.install_state || 'not_installed';
      var stateLabels = {
        verified: 'Verified',
        installed_unverified: 'Installed — awaiting verification',
        stale: 'Out of date',
        broken: 'Broken',
        not_installed: 'Not detected yet'
      };
      var stateLabel = stateLabels[stateClass] || stateClass;
      var categoryBadge = s.category === 'required'
        ? '<span class="snippet-card-badge">REQUIRED</span>'
        : (s.category === 'optional' ? '<span class="snippet-card-badge" style="background:var(--bg);color:var(--muted);">OPTIONAL</span>' : '');

      var instructionsHtml = (s.instructions || []).map(function(step) {
        return '<li>' + esc(step) + '</li>';
      }).join('');

      var renderErrorHtml = '';
      if (s.render_error === 'missing_env_vars') {
        renderErrorHtml = '<div class="snippet-render-error">' +
          '⚠ This snippet cannot be generated — missing server configuration: <strong>' +
          (s.render_missing_env || []).map(esc).join(', ') + '</strong>. Contact AccessSync support.' +
          '</div>';
      } else if (s.render_error) {
        renderErrorHtml = '<div class="snippet-render-error">⚠ Snippet render error: ' + esc(s.render_error) + '</div>';
      }

      var metaHtml = '<div class="snippet-meta">' +
        '<span class="snippet-meta-item"><strong>Version:</strong> ' + esc(s.current_version) + '</span>' +
        '<span class="snippet-meta-item"><strong>Install in:</strong> ' + esc(s.wix_install_path) + '</span>' +
        (s.version_installed ? '<span class="snippet-meta-item"><strong>You have:</strong> ' + esc(s.version_installed) + '</span>' : '') +
        (s.last_telemetry_at ? '<span class="snippet-meta-item"><strong>Last seen:</strong> ' + esc(fmtRelative(s.last_telemetry_at)) + '</span>' : '') +
        '</div>';

      var testBtnHtml = s.verify_via && s.verify_via !== 'none'
        ? '<button class="snippet-reveal-btn" data-test-connection="1">Test Connection</button>'
        : '';

      var lastTestHtml = s.last_test_result
        ? '<div class="snippet-test-result" data-result="' + esc(s.last_test_result) + '">' +
          (s.last_test_result === 'ok' ? '✓ Last test: verified' : '⚠ Last test: ' + esc(s.last_test_result)) +
          '</div>'
        : '';

      var bodyHtml = s.body
        ? '<div class="snippet-code-block"><pre>' + esc(s.body) + '</pre></div>' +
          lastTestHtml +
          '<div class="snippet-copy-row">' +
          testBtnHtml +
          '<button class="snippet-copy-btn">' +
          '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>' +
          ' Copy snippet</button></div>'
        : '';

      return '<div class="snippet-card ' + (stateClass === 'broken' ? 'broken' : '') + '" data-snippet-id="' + esc(s.id) + '">' +
        '<div class="snippet-card-header">' +
        '<div style="flex:1;">' +
        '<div class="snippet-badge-row">' +
        '<div class="snippet-card-title">' + esc(s.name) + '</div>' +
        '<span class="snippet-status-badge ' + stateClass + '">' +
        '<span class="snippet-status-dot"></span>' + esc(stateLabel) + '</span>' +
        '</div>' +
        '<div class="snippet-instructions" style="margin-top:8px;margin-bottom:0;">' +
        esc(s.description) +
        (instructionsHtml ? '<ol>' + instructionsHtml + '</ol>' : '') +
        '</div>' +
        '</div>' + categoryBadge + '</div>' +
        '<hr class="snippet-divider">' +
        renderErrorHtml + metaHtml + bodyHtml +
        '</div>';
    }

    function copySnippet(snippetId, btn) {
      if (!_setupState) return;
      var snippet = (_setupState.snippets || []).find(function(s) { return s.id === snippetId; });
      if (!snippet || !snippet.body) return;
      navigator.clipboard.writeText(snippet.body).then(function() {
        btn.classList.add('copied');
        var originalText = btn.textContent;
        btn.textContent = '✓ Copied';
        setTimeout(function() { btn.classList.remove('copied'); btn.textContent = originalText; }, 1800);
        // Record the copy action server-side (transitions state to installed_unverified)
        apiFetch('/operator/' + clientId + '/setup-state/copied', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ snippet_id: snippetId })
        }).catch(function() { /* non-blocking */ });
      }).catch(function() { toast('Copy failed — try manually selecting', 'error'); });
    }

    function testConnection(snippetId, btn) {
      var originalText = btn.textContent;
      btn.textContent = 'Testing…';
      btn.disabled = true;
      apiFetch('/operator/' + clientId + '/setup-state/test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ snippet_id: snippetId })
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          btn.textContent = originalText;
          btn.disabled = false;
          toast(data.message || (data.ok ? 'Verified' : 'Test failed'), data.ok ? 'success' : 'error');
          // Reload state so badges update
          loadSetupSnippets();
          _snippetsLoaded = false;
          loadSetupSnippets();
        })
        .catch(function() {
          btn.textContent = originalText;
          btn.disabled = false;
          toast('Test request failed — check your connection', 'error');
        });
    }

    function fmtRelative(iso) {
      if (!iso) return '';
      var t = new Date(iso).getTime();
      var diff = Date.now() - t;
      if (diff < 60_000)    return 'just now';
      if (diff < 3_600_000) return Math.floor(diff / 60_000) + ' min ago';
      if (diff < 86_400_000) return Math.floor(diff / 3_600_000) + ' hr ago';
      return Math.floor(diff / 86_400_000) + ' day(s) ago';
    }
  </script>
</body>
</html>
