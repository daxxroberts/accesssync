    function splitDayPassParts(body) {
      if (!body) return { part1: '', part2: '' };
      var marker = '// ===== PART 2';
      var idx = body.indexOf(marker);
      if (idx === -1) {
        return { part1: body.trim(), part2: '' };
      }
      var part1Slice = body.slice(0, idx).trim();
      if (part1Slice.indexOf('// ===== PART 1') === 0) {
        var nl1 = part1Slice.indexOf('\n');
        if (nl1 !== -1) part1Slice = part1Slice.slice(nl1 + 1).trim();
      }
      var part2Slice = body.slice(idx);
      var firstNewline = part2Slice.indexOf('\n');
      var part2Raw = (firstNewline !== -1 ? part2Slice.slice(firstNewline + 1) : part2Slice).trim();
      return { part1: part1Slice, part2: part2Raw };
    }

    function renderSnippetCards(snippets) {
      var el = document.getElementById('setup-snippets-list');
      var byId = {};
      snippets.forEach(function(s) { byId[s.id] = s; });

      var html = '';

      // ── Step 2: Backend Webhook Forwarder (events.js) ──
      if (byId.velo_events_backend) {
        html += buildStep2EventsCard(byId.velo_events_backend);
      }

      // ── Step 3: Member Hub Button (My Access Page) ──
      if (byId.my_access_page) {
        html += buildStep3MyAccessCard(byId.my_access_page);
      }

      // ── Optional Add-Ons Header ──
      if (byId.thank_you_button || byId.thank_you_redirect || byId.thank_you_day_pass) {
        html +=
          '<div class="setup-group-header">' +
            '<div class="setup-group-title">Optional Add-Ons (Steps 4–5)</div>' +
            '<div class="setup-group-sub">Install only if you want a post-purchase status button or sell QR day passes.</div>' +
          '</div>';
      }

      // ── Step 4: Post-Purchase Status Button (+ Optional Auto-Redirect) ──
      if (byId.thank_you_button || byId.thank_you_redirect) {
        html += buildStep4PostPurchaseCard(byId.thank_you_button, byId.thank_you_redirect);
      }

      // ── Step 5: Day-Pass QR Button (Backend .jsw + Thank You Page Button) ──
      if (byId.thank_you_day_pass) {
        html += buildStep5DayPassCard(byId.thank_you_day_pass);
      }

      // Render any unexpected future registry snippets gracefully so nothing is ever hidden
      snippets.forEach(function(s) {
        if (['velo_events_backend', 'my_access_page', 'thank_you_button', 'thank_you_redirect', 'thank_you_day_pass'].indexOf(s.id) === -1) {
          html += buildFallbackSnippetCard(s);
        }
      });

      el.innerHTML = html;
    }

