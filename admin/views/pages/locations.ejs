<%#
  @file locations.ejs
  @layer admin/pages
  @route /locations
  @role system-config
  @data GET /operator/:clientId, /operator/:clientId/locations, /operator/clients/:clientId/wix-api-key/status, /operator/clients/:clientId/notification-email, /operator/:clientId/setup-snippets
  @writes PATCH /operator/:clientId/locations/:locationId (tier, platform, name, city, state), POST /operator/:clientId/locations/:locationId/api-key, POST /operator/:clientId/locations/:locationId/suspend, POST /operator/:clientId/locations/:locationId/activate, PUT /operator/:clientId/locations/:locationId/notification-email
  @tab System Config
  @features per-location tier/platform/key/email, profile card (Wix key + rollup email), suspend/reactivate, wix-setup-guide (inner tab)
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Operator Dashboard: System Config' }) %>
  <style>
    .page { max-width: 900px; margin: 0 auto; padding: 24px 16px 60px; }

    .page-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      margin-bottom: 20px; gap: 12px; flex-wrap: wrap;
    }
    .page-title { font-size: 18px; font-weight: 700; letter-spacing: -0.3px; }
    .page-sub   { font-size: 12px; color: var(--muted); margin-top: 3px; }

    /* ── Org key card ── */
    .org-key-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 18px 20px; margin-bottom: 24px; box-shadow: var(--shadow);
    }
    .org-key-header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .org-key-icon {
      width: 36px; height: 36px; border-radius: 9px; background: var(--brand-dim);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .org-key-title { font-size: 13px; font-weight: 700; }
    .org-key-desc  { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .org-key-row {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; background: var(--bg);
      border-radius: 8px; border: 1px solid var(--border);
    }
    .org-key-status     { font-size: 12px; color: var(--muted); flex: 1; }
    .org-key-status.set { color: var(--sage-dark); font-weight: 600; }

    /* ── Section label ── */
    .section-label {
      font-size: 10px; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 12px;
    }

    /* ── Location cards ── */
    .loc-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; margin-bottom: 12px; box-shadow: var(--shadow); overflow: hidden;
    }
    .loc-header { display: flex; align-items: center; padding: 14px 18px; gap: 12px; }
    .loc-icon {
      width: 38px; height: 38px; border-radius: 9px; background: var(--brand-dim);
      display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 16px;
    }
    .loc-meta { flex: 1; min-width: 0; }
    .loc-name    { font-size: 13px; font-weight: 700; }
    .loc-address { font-size: 11px; color: var(--muted); margin-top: 2px; }
    .loc-pills   { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

    /* ── Pills ── */
    .pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 20px; font-size: 10px; font-weight: 600; border: 1px solid transparent; }
    .pill-active   { background: var(--sage-dim);  color: var(--sage-dark); border-color: var(--sage-border); }
    .pill-inactive { background: var(--bg);         color: var(--muted);     border-color: var(--border); }
    .pill-lapsed   { background: var(--amber-dim);  color: var(--amber);     border-color: rgba(245,166,35,0.2); }
    .pill-info     { background: var(--brand-dim);  color: var(--brand);     border-color: var(--brand-glow); }

    /* ── Location body ── */
    .loc-body { border-top: 1px solid var(--border); padding: 16px 18px; }
    .loc-stats {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px;
    }
    .loc-stat { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
    .loc-stat-val { font-size: 18px; font-weight: 700; }
    .loc-stat-lbl { font-size: 10px; color: var(--muted); margin-top: 2px; }

    /* ── API key section ── */
    .key-section      { margin-top: 4px; }
    .key-section-title { font-size: 11px; font-weight: 700; color: var(--text2); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
    .key-row {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 14px; background: var(--bg);
      border-radius: 8px; border: 1px solid var(--border);
    }
    .key-label              { font-size: 11px; color: var(--muted); flex: 1; }
    .key-label.has-key      { color: var(--sage-dark); font-weight: 600; }
    .key-label.has-override { color: var(--brand); font-weight: 600; }
    .key-source-badge          { font-size: 9px; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: var(--brand-dim); color: var(--brand); }
    .key-source-badge.inherited { background: var(--bg); color: var(--muted); border: 1px solid var(--border); }

    /* ── Key input form ── */
    .key-form { margin-top: 10px; display: none; }
    .key-form.open { display: block; }
    .key-form-inner { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 14px; }
    .key-input {
      width: 100%; padding: 9px 12px; font-family: inherit; font-size: 12px;
      background: var(--card); border: 1px solid var(--border2);
      border-radius: 7px; color: var(--text); outline: none; transition: border 0.15s; margin-bottom: 10px;
    }
    .key-input:focus { border-color: var(--brand); }
    .key-input-hint { font-size: 10px; color: var(--muted); margin-bottom: 10px; line-height: 1.5; }
    .key-form-actions { display: flex; gap: 8px; justify-content: flex-end; }

    /* Buttons provided by operator-styles.css */

    /* ── Config rows (inside profile + location cards) ── */
    .config-section { border-top: 1px solid var(--border); margin-top: 14px; padding-top: 4px; }
    .config-row { padding: 10px 0; border-bottom: 1px solid var(--border); }
    .config-row:last-child { border-bottom: none; }
    .config-row-header { display: flex; align-items: center; gap: 10px; }
    .config-row-label { font-size: 12px; font-weight: 600; color: var(--text2); min-width: 120px; flex-shrink: 0; }
    .config-row-status { font-size: 12px; color: var(--muted); flex: 1; }
    .config-row-status.set { color: var(--sage-dark); font-weight: 600; }
    .config-row-status.warn { color: var(--red); font-weight: 600; }
    .config-select { padding: 5px 10px; font-family: inherit; font-size: 11px; background: var(--card); border: 1px solid var(--border2); border-radius: 6px; color: var(--text); cursor: pointer; }

    /* ── Test result ── */
    .test-result {
      margin-top: 8px; padding: 8px 12px; border-radius: 7px; font-size: 11px; font-weight: 600; display: none;
    }
    .test-result.pass { background: var(--sage-dim);  color: var(--sage-dark); border: 1px solid var(--sage-border); }
    .test-result.fail { background: var(--red-dim);   color: var(--red);        border: 1px solid rgba(255,77,106,0.2); }

    /* ── Empty / loading ── */
    .empty { text-align: center; padding: 48px 24px; color: var(--muted); font-size: 13px; }
    .empty-icon  { font-size: 32px; margin-bottom: 12px; }
    .empty-title { font-weight: 700; color: var(--text2); margin-bottom: 6px; }
    .loading { text-align: center; padding: 40px; color: var(--muted); font-size: 12px; }
    @keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
    .spinner { width: 20px; height: 20px; border: 2px solid var(--border); border-top-color: var(--brand); border-radius: 50%; animation: spin 0.7s linear infinite; margin: 0 auto 10px; }

    /* ── Info button + modal (DR-052 "what emails go out" explainer) ── */
    .info-btn {
      width: 18px; height: 18px; border-radius: 50%; border: 1px solid var(--border2);
      background: var(--surface); color: var(--muted); font-size: 11px; font-weight: 700;
      font-family: inherit; line-height: 1; cursor: pointer; padding: 0;
      display: inline-flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: all 0.15s;
    }
    .info-btn:hover { background: var(--brand-dim); color: var(--brand); border-color: var(--brand); }
    .info-modal-overlay {
      display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(26,33,48,0.4); z-index: 1000;
      align-items: center; justify-content: center; padding: 16px;
    }
    .info-modal-overlay.visible { display: flex; }
    .info-modal {
      background: var(--card); border-radius: 16px; box-shadow: var(--shadow-md);
      max-width: 920px; width: 100%; max-height: 88vh; padding: 24px 28px;
      display: flex; flex-direction: column;
    }
    .info-modal-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 4px; flex-shrink: 0; }
    .info-modal-title { font-size: 16px; font-weight: 700; color: var(--text); }
    .info-modal-close {
      border: none; background: none; color: var(--muted); font-size: 20px; line-height: 1;
      cursor: pointer; padding: 2px 4px; flex-shrink: 0;
    }
    .info-modal-close:hover { color: var(--text); }
    .info-modal-intro { font-size: 12.5px; color: var(--text2); line-height: 1.5; margin: 6px 0 18px; flex-shrink: 0; }

    /* Split screen: scrollable list on the left, pinned live preview on the right. */
    .info-modal-body { display: flex; gap: 24px; min-height: 0; flex: 1; }
    .info-modal-list { flex: 1; min-width: 260px; max-width: 340px; overflow-y: auto; padding-right: 4px; }
    .info-modal-preview { flex: 1.3; min-width: 320px; display: flex; flex-direction: column; }

    .info-email-card {
      border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; margin-bottom: 12px;
      cursor: pointer; transition: border-color 0.15s, background 0.15s;
    }
    .info-email-card:hover   { border-color: var(--border2); }
    .info-email-card.active { border-color: var(--brand); background: var(--brand-dim); }
    .info-email-name { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 2px; }
    .info-email-what { font-size: 12px; color: var(--text2); line-height: 1.5; margin-bottom: 6px; }
    .info-email-subject { font-size: 11px; color: var(--muted); font-style: italic; margin-bottom: 10px; }
    .info-email-rule { font-size: 11.5px; line-height: 1.5; margin-bottom: 3px; }
    .info-email-rule b { color: var(--text2); font-weight: 600; }
    .info-email-rule.sent   b { color: var(--sage-dark); }
    .info-email-rule.notsent b { color: var(--red); }
    .info-preview-link {
      display: inline-flex; align-items: center; gap: 4px; margin-top: 10px;
      font-size: 12px; font-weight: 600; color: var(--brand); background: none; border: none;
      cursor: pointer; padding: 0; font-family: inherit;
    }
    .info-preview-link:hover { color: var(--brand-dark); text-decoration: underline; }
    .info-demo-label { font-size: 11.5px; color: var(--muted); margin-bottom: 8px; flex-shrink: 0; }
    .info-demo-label b { color: var(--text2); }
    #info-demo-frame { width: 100%; flex: 1; min-height: 320px; border: 1px solid var(--border); border-radius: 10px; background: #f4f4f4; }

    /* ── Toast (page variant — stacked bottom-right) ── */
    .toast-wrap { position: fixed; bottom: 20px; right: 20px; z-index: 999; display: flex; flex-direction: column; gap: 8px; }
    .toast-loc { padding: 10px 16px; border-radius: 8px; font-size: 12px; font-weight: 600; color: #fff; box-shadow: var(--shadow-md); animation: slideIn 0.2s ease; }
    @keyframes slideIn { from{transform:translateY(10px);opacity:0} to{transform:translateY(0);opacity:1} }
    .toast-loc.success { background: #22C55E; }
    .toast-loc.error   { background: var(--red); }
    .toast-loc.info    { background: var(--brand); }

    /* ── Inner tab nav (Locations / Wix Setup) ── */
    .inner-tabs { display: flex; gap: 2px; margin-bottom: 20px; border-bottom: 1px solid var(--border); }
    .inner-tab {
      padding: 8px 16px; font-size: 12px; font-weight: 600; color: var(--muted);
      background: none; border: none; border-bottom: 2px solid transparent;
      cursor: pointer; font-family: inherit; transition: color 0.12s;
      margin-bottom: -1px;
    }
    .inner-tab:hover { color: var(--text); }
    .inner-tab.active { color: var(--brand); border-bottom-color: var(--brand); }

    /* ── Setup Guide snippets (Installer Checklist UX) ── */
    .setup-section { display: none; }
    .setup-section.active { display: block; }

    .setup-group-header {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 10px; margin: 22px 0 10px; padding-bottom: 6px;
      border-bottom: 1px solid var(--border);
    }
    .setup-group-header:first-child { margin-top: 4px; }
    .setup-group-title {
      font-size: 11px; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.7px; color: var(--text);
    }
    .setup-group-sub { font-size: 11px; color: var(--muted); }

    .snippet-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px 18px; margin-bottom: 12px; box-shadow: var(--shadow);
    }
    .snippet-card-header {
      display: flex; align-items: flex-start; justify-content: space-between;
      gap: 12px; margin-bottom: 10px;
    }
    .snippet-step-head { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .snippet-step-num {
      width: 22px; height: 22px; border-radius: 6px;
      background: var(--brand-dim); color: var(--brand);
      font-size: 11px; font-weight: 800;
      display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .snippet-step-num.optional {
      background: var(--bg); color: var(--muted); border: 1px solid var(--border2);
    }
    .snippet-card-title { font-size: 13.5px; font-weight: 700; color: var(--text); }
    .snippet-version-tag {
      font-size: 10px; font-family: monospace; color: var(--muted);
      background: var(--bg); border: 1px solid var(--border);
      padding: 1px 6px; border-radius: 4px;
    }
    .snippet-card-badge {
      font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 4px;
      background: var(--brand-dim); color: var(--brand); flex-shrink: 0; letter-spacing: 0.4px;
    }
    .snippet-card-badge.optional {
      background: var(--bg); color: var(--muted); border: 1px solid var(--border);
    }

    /* Compact Create -> Paste checklist */
    .installer-steps {
      list-style: none; margin: 0 0 12px 0; padding: 0;
      display: flex; flex-direction: column; gap: 6px;
    }
    .installer-steps li {
      font-size: 12px; color: var(--text2); line-height: 1.55;
      display: flex; align-items: baseline; gap: 8px;
    }
    .installer-verb {
      font-size: 10px; font-weight: 800; text-transform: uppercase;
      letter-spacing: 0.4px; min-width: 54px; flex-shrink: 0;
      color: var(--muted);
    }
    .installer-verb.create { color: var(--brand); }
    .installer-verb.paste  { color: var(--sage-dark); }

    /* Inline copyable identifier chip */
    .copy-chip {
      display: inline-flex; align-items: center; gap: 4px;
      font-family: monospace; font-size: 11px; font-weight: 600;
      padding: 1px 7px; margin: 0 2px; border-radius: 5px;
      background: var(--bg); color: var(--text);
      border: 1px solid var(--border2); cursor: pointer;
      transition: all 0.12s; line-height: 1.4;
    }
    .copy-chip:hover {
      border-color: var(--brand); color: var(--brand); background: var(--brand-dim);
    }
    .copy-chip.copied {
      background: var(--sage-dim); color: var(--sage-dark); border-color: var(--sage-border);
    }
    .copy-chip-icon { font-size: 10px; opacity: 0.7; }

    .prop-pill {
      display: inline-block; font-size: 10.5px; font-weight: 700;
      padding: 1px 7px; border-radius: 4px;
      background: #FEF3C7; color: #92400E; border: 1px solid #FCD34D;
    }

    /* Prerequisite notice bar */
    .setup-prereq-bar {
      background: var(--bg); border: 1px solid var(--border);
      border-left: 3px solid var(--brand); border-radius: 7px;
      padding: 9px 12px; margin-bottom: 12px;
      font-size: 11.5px; color: var(--text2); line-height: 1.55;
      display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap;
    }

    /* Action bar: primary Copy button + secondary Guide / View Code toggles */
    .snippet-action-bar {
      display: flex; align-items: center; justify-content: space-between;
      gap: 8px; flex-wrap: wrap; margin-top: 8px;
    }
    .snippet-action-left, .snippet-action-right {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    }
    .snippet-copy-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 13px; font-size: 11.5px; font-weight: 700;
      background: var(--brand); border: 1px solid var(--brand); border-radius: 6px;
      color: #fff; cursor: pointer; font-family: inherit; transition: all 0.12s;
    }
    .snippet-copy-btn:hover { opacity: 0.92; }
    .snippet-copy-btn.secondary-copy {
      background: var(--card); color: var(--text2); border-color: var(--border2);
    }
    .snippet-copy-btn.secondary-copy:hover {
      background: var(--brand-dim); color: var(--brand); border-color: var(--brand-glow);
    }
    .snippet-copy-btn.copied {
      background: var(--sage-dim) !important; color: var(--sage-dark) !important;
      border-color: var(--sage-border) !important;
    }

    .snippet-toggle-btn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 5px 10px; font-size: 11px; font-weight: 600;
      background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
      color: var(--text2); cursor: pointer; font-family: inherit; transition: all 0.12s;
    }
    .snippet-toggle-btn:hover { border-color: var(--brand); color: var(--brand); }
    .snippet-toggle-btn.open {
      background: var(--brand-dim); color: var(--brand); border-color: var(--brand-glow);
    }

    /* Expandable Wix Setup Guide drawer */
    .wix-guide-drawer {
      display: none; margin-top: 10px; margin-bottom: 10px;
      padding: 13px 15px; border-radius: 8px;
      background: var(--bg); border: 1px solid var(--border);
      font-size: 11.5px; color: var(--text2); line-height: 1.65;
    }
    .wix-guide-drawer.open { display: block; }
    .wix-guide-grid {
      display: grid; grid-template-columns: 1fr; gap: 10px;
    }
    .wix-guide-box {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 7px; padding: 10px 12px;
    }
    .wix-guide-box-title {
      font-size: 11.5px; font-weight: 700; color: var(--text); margin-bottom: 4px;
      display: flex; align-items: center; gap: 6px;
    }
    .wix-guide-box ul, .wix-guide-box ol {
      margin: 4px 0 0 18px; padding: 0;
    }
    .wix-guide-box li { margin-bottom: 3px; }

    /* Collapsible code preview drawer (collapsed by default) */
    .snippet-code-drawer {
      display: none; margin-top: 10px;
      background: var(--bg); border: 1px solid var(--border); border-radius: 8px;
      padding: 12px 14px; position: relative; max-height: 340px; overflow-y: auto;
    }
    .snippet-code-drawer.open { display: block; }
    .snippet-code-drawer pre {
      font-family: monospace; font-size: 10.5px; color: var(--text2);
      white-space: pre-wrap; word-break: break-all; margin: 0; line-height: 1.55;
    }

    /* Sub-steps inside a card (e.g. 4a/4b or 5a/5b) */
    .snippet-substep {
      padding-top: 12px; margin-top: 12px; border-top: 1px solid var(--border);
    }
    .snippet-substep:first-of-type {
      padding-top: 0; margin-top: 0; border-top: none;
    }
    .snippet-substep-header {
      display: flex; align-items: center; justify-content: space-between;
      gap: 8px; flex-wrap: wrap; margin-bottom: 6px;
    }
    .snippet-substep-title {
      font-size: 12px; font-weight: 700; color: var(--text);
      display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
    }
    .snippet-substep-pill {
      font-size: 10px; font-weight: 800; padding: 1px 6px; border-radius: 4px;
      background: var(--brand-dim); color: var(--brand);
    }

    .snippet-field-label { font-size: 10px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 6px; }
    .snippet-row {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      padding: 8px 12px; background: var(--bg);
      border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px;
    }
    .snippet-value {
      flex: 1; font-family: monospace; font-size: 11px; color: var(--text);
      word-break: break-all; white-space: pre-wrap; min-width: 180px;
    }
    .snippet-value.masked { filter: blur(4px); transition: filter 0.2s; cursor: pointer; }
    .snippet-value.masked:hover { filter: blur(2px); }
    .snippet-reveal-btn {
      padding: 4px 10px; font-size: 10px; font-weight: 600;
      background: none; border: 1px solid var(--border2); border-radius: 5px;
      color: var(--muted); cursor: pointer; font-family: inherit; flex-shrink: 0;
    }
    .snippet-reveal-btn:hover { border-color: var(--brand); color: var(--brand); }
    .snippet-loading { font-size: 12px; color: var(--muted); padding: 32px 0; text-align: center; }
    .snippet-divider { border: none; border-top: 1px solid var(--border); margin: 14px 0; }
    .snippet-render-error {
      background: #FEE2E2; color: #991B1B; padding: 10px 14px; border-radius: 8px;
      font-size: 11px; margin-bottom: 10px; border: 1px solid #FCA5A5;
    }

    @media (max-width: 600px) {
      .loc-stats   { grid-template-columns: repeat(2, 1fr); }
      .page-header { flex-direction: column; }
    }
  </style>
</head>
<body data-session-role="<%= sessionRole %>"<% if (loginUrl) { %> data-login-url="<%= loginUrl %>"<% } %>>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <main class="page">
    <div class="page-header">
      <div>
        <div class="page-title">System Config</div>
        <div class="page-sub">Connect your integrations, manage API keys, and set up your locations</div>
      </div>
    </div>

    <!-- Inner tab nav -->
    <div class="inner-tabs">
      <button class="inner-tab active" id="tab-locations" onclick="switchTab('locations')">Locations</button>
      <button class="inner-tab" id="tab-setup" onclick="switchTab('setup')">Wix Setup Guide</button>
    </div>

    <!-- ══ Locations section ══════════════════════════════════════════ -->
    <div id="section-locations">

    <!-- Client profile (consolidated) -->
    <div class="org-key-card" id="profile-card">
      <div class="org-key-header">
        <div class="org-key-icon">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <rect x="2" y="2" width="14" height="14" rx="3" stroke="var(--brand)" stroke-width="1.4" fill="none"/>
            <circle cx="9" cy="7" r="2.5" stroke="var(--brand)" stroke-width="1.3" fill="none"/>
            <path d="M4 15c0-3 2.2-5 5-5s5 2 5 5" stroke="var(--brand)" stroke-width="1.3" fill="none"/>
          </svg>
        </div>
        <div style="flex:1;">
          <div class="org-key-title" id="profile-name">Loading…</div>
          <div class="org-key-desc" id="profile-meta"></div>
        </div>
        <button class="btn btn-sm btn-ghost" onclick="toggleProfileEdit()">Edit Name</button>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;" id="profile-pills"></div>
      <div class="key-form" id="profile-form">
        <div class="key-form-inner" style="margin-top:10px;">
          <input type="text" class="key-input" id="profile-name-input" placeholder="Business name…"/>
          <div class="key-form-actions">
            <button class="btn btn-ghost btn-sm" onclick="toggleProfileEdit()">Cancel</button>
            <button class="btn btn-primary btn-sm" onclick="saveProfileName()">Save</button>
          </div>
        </div>
      </div>

      <!-- Config rows inside profile card -->
      <div class="config-section">
        <!-- Wix API Key -->
        <div class="config-row">
          <div class="config-row-header">
            <span class="config-row-label">Wix API Key</span>
            <span class="config-row-status" id="wix-key-status">Checking…</span>
            <div style="display:flex;gap:6px;">
              <button class="btn btn-sm btn-ghost" id="wix-test-btn" onclick="testWixKey()" style="display:none;">Test</button>
              <button class="btn btn-sm btn-secondary" id="wix-key-btn" onclick="toggleWixKeyForm()">Set Key</button>
            </div>
          </div>
          <div class="key-form" id="wix-key-form">
            <div class="key-form-inner" style="margin-top:10px;">
              <div class="key-input-hint">Stored securely — write-only. Required so AccessSync can look up your member plans.</div>
              <input type="password" class="key-input" id="wix-key-input" placeholder="Paste your Wix API key…" autocomplete="off"/>
              <div class="key-form-actions">
                <button class="btn btn-ghost btn-sm" onclick="toggleWixKeyForm()">Cancel</button>
                <button class="btn btn-primary btn-sm" onclick="saveWixKey()">Save Key</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Door system API key — ONE per client (connector_subscriptions), used by every
             location. Label follows the connected platform ("Kisi API Key"). -->
        <div class="config-row" id="hw-key-row">
          <div class="config-row-header">
            <span class="config-row-label" id="hw-key-label">Door System API Key</span>
            <span class="config-row-status" id="hw-key-status">Checking…</span>
            <div style="display:flex;gap:6px;">
              <button class="btn btn-sm btn-ghost" id="hw-test-btn" onclick="testHwKey()" style="display:none;">Test</button>
              <button class="btn btn-sm btn-secondary" id="hw-key-btn" onclick="toggleHwKeyForm()">Set Key</button>
            </div>
          </div>
          <div class="test-result" id="hw-key-testres"></div>
          <div class="key-form" id="hw-key-form">
            <div class="key-form-inner" style="margin-top:10px;">
              <div class="key-input-hint" id="hw-key-hint">Stored securely — write-only. Used for every location.</div>
              <input type="password" class="key-input" id="hw-key-input" placeholder="Paste your API key…" autocomplete="off"/>
              <div class="key-form-actions">
                <button class="btn btn-ghost btn-sm" onclick="toggleHwKeyForm()">Cancel</button>
                <button class="btn btn-primary btn-sm" onclick="saveHwKey()">Save Key</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Rollup Alert Email -->
        <div class="config-row">
          <div class="config-row-header">
            <span class="config-row-label">Rollup Email</span>
            <span class="config-row-status" id="notif-email-display">Loading…</span>
            <button class="btn btn-sm btn-secondary" id="notif-edit-btn" onclick="toggleNotifForm()">Edit</button>
          </div>
          <div class="key-form" id="notif-form">
            <div class="key-form-inner" style="margin-top:10px;">
              <div class="key-input-hint">Gets alerts for all locations — errors, key failures, and grant confirmations. Each location can use its own email instead.</div>
              <input type="email" class="key-input" id="notif-email-input" placeholder="alerts@yourgym.com" autocomplete="off"/>
              <div class="key-form-actions">
                <button class="btn btn-ghost btn-sm" onclick="toggleNotifForm()">Cancel</button>
                <button class="btn btn-primary btn-sm" onclick="saveNotifEmail()">Save</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ══ Member Email Branding (DR-052) ═════════════════════════════ -->
    <div class="org-key-card" style="margin-bottom:16px;">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;">
        <div>
          <div class="org-key-title" style="margin-bottom:2px;display:flex;align-items:center;gap:6px;">
            Member Emails
            <button type="button" class="info-btn" onclick="ebOpenInfo()" title="What emails go out, and when" aria-label="What emails go out, and when">i</button>
          </div>
          <div style="font-size:12px;color:var(--muted);">Brand the emails your members receive — logo, two colors, done. Replies go to your rollup email.</div>
        </div>
        <span class="config-row-status" id="eb-enabled-status">Loading…</span>
      </div>

      <div style="display:flex;gap:20px;flex-wrap:wrap;margin-top:14px;">
        <div style="flex:1;min-width:240px;">
          <!-- Logo -->
          <div class="config-row" style="border-bottom:none;padding-top:0;">
            <div class="config-row-header">
              <span class="config-row-label">Logo</span>
              <img id="eb-logo-thumb" alt="" style="display:none;height:32px;max-width:140px;border-radius:6px;background:#f1f5f9;padding:2px 6px;"/>
              <span class="config-row-status" id="eb-logo-status">None uploaded</span>
              <button class="btn btn-sm btn-secondary" onclick="document.getElementById('eb-logo-file').click()">Upload</button>
              <input type="file" id="eb-logo-file" accept="image/png,image/jpeg" style="display:none;" onchange="ebUploadLogo(this)"/>
            </div>
            <div class="key-input-hint" style="margin-top:6px;">PNG or JPEG, up to 1&nbsp;MB. Shown in the email header.</div>
          </div>
          <!-- QR entry guide (OB-98) -->
          <div class="config-row" style="border-bottom:none;">
            <div class="config-row-header">
              <span class="config-row-label">QR entry guide</span>
              <a id="eb-guide-link" href="#" target="_blank" rel="noopener" style="display:none;font-size:12px;color:var(--brand);font-weight:600;">View PDF</a>
              <span class="config-row-status" id="eb-guide-status">None uploaded</span>
              <button class="btn btn-sm btn-secondary" onclick="document.getElementById('eb-guide-file').click()">Upload</button>
              <button class="btn btn-sm btn-secondary" id="eb-guide-remove" style="display:none;" onclick="ebRemoveGuide()">Remove</button>
              <input type="file" id="eb-guide-file" accept="application/pdf" style="display:none;" onchange="ebUploadGuide(this)"/>
            </div>
            <div class="key-input-hint" style="margin-top:6px;">PDF, up to 2&nbsp;MB. Attached to every email that carries a QR door code, so members can forward the code and the instructions together.</div>
          </div>
          <!-- Colors -->
          <div class="config-row" style="border-bottom:none;">
            <div class="config-row-header">
              <span class="config-row-label">Primary color</span>
              <input type="color" id="eb-primary" value="#333333" style="width:36px;height:28px;border:1px solid var(--border);border-radius:6px;padding:0;background:none;cursor:pointer;" oninput="ebColorChanged('primary')"/>
              <input type="text" class="key-input" id="eb-primary-hex" value="#333333" maxlength="7" style="width:96px;margin-bottom:0;" oninput="ebHexChanged('primary')"/>
            </div>
            <div class="key-input-hint" style="margin-top:4px;">The header band behind your logo.</div>
          </div>
          <div class="config-row" style="border-bottom:none;">
            <div class="config-row-header">
              <span class="config-row-label">Secondary color</span>
              <input type="color" id="eb-secondary" value="#333333" style="width:36px;height:28px;border:1px solid var(--border);border-radius:6px;padding:0;background:none;cursor:pointer;" oninput="ebColorChanged('secondary')"/>
              <input type="text" class="key-input" id="eb-secondary-hex" value="#333333" maxlength="7" style="width:96px;margin-bottom:0;" oninput="ebHexChanged('secondary')"/>
            </div>
            <div class="key-input-hint" style="margin-top:4px;">Buttons and links. Everything else stays white.</div>
          </div>
          <div class="key-form-actions" style="margin-top:12px;justify-content:flex-start;gap:8px;">
            <button class="btn btn-primary btn-sm" onclick="ebSave()">Save branding</button>
            <button class="btn btn-secondary btn-sm" onclick="ebSendTest()">Send test email</button>
            <button class="btn btn-ghost btn-sm" id="eb-toggle-btn" onclick="ebToggleEnabled()" style="display:none;">Enable member emails</button>
          </div>
        </div>
        <!-- Live preview — renders the REAL template server-side -->
        <div style="flex:1.2;min-width:280px;">
          <div class="key-input-hint" style="margin-bottom:2px;">Live preview — exactly what members receive:</div>
          <div class="key-input-hint" style="margin-bottom:6px;">Subject: <b id="eb-preview-subject" style="color:var(--text2);font-style:italic;">&mdash;</b></div>
          <iframe id="eb-preview" sandbox="" title="Email preview" style="width:100%;height:360px;border:1px solid var(--border);border-radius:10px;background:#f4f4f4;"></iframe>
        </div>
      </div>
    </div>

    <!-- Locations -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
      <div class="section-label" style="margin-bottom:0;">Locations</div>
      <% if (sessionRole === 'owner') { %><button class="btn btn-sm btn-secondary" onclick="toggleAddLocationForm()">+ Add Location</button><% } %>
    </div>

    <!-- Add location form -->
    <div class="key-form" id="add-loc-form">
      <div class="org-key-card" style="margin-bottom:16px;border:1px dashed var(--brand);">
        <div class="org-key-title" style="margin-bottom:12px;">New Location</div>
        <input type="text" class="key-input" id="add-loc-name" placeholder="Location name *" />
        <div style="display:flex;gap:8px;">
          <input type="text" class="key-input" id="add-loc-city" placeholder="City" style="flex:1;margin-bottom:0;" />
          <input type="text" class="key-input" id="add-loc-state" placeholder="State" style="width:80px;margin-bottom:0;" />
        </div>
        <div style="margin-top:10px;">
          <select class="key-input" id="add-loc-tier" style="margin-bottom:0;">
            <option value="">Tier (optional)</option>
            <option value="Base">Base</option>
            <option value="Pro">Pro</option>
            <option value="Connect">Connect</option>
          </select>
        </div>
        <div class="key-form-actions" style="margin-top:12px;">
          <button class="btn btn-ghost btn-sm" onclick="toggleAddLocationForm()">Cancel</button>
          <button class="btn btn-primary btn-sm" id="add-loc-submit" onclick="addLocation()">Create Location</button>
        </div>
      </div>
    </div>

    <div id="loc-loading" class="loading"><div class="spinner"></div>Loading locations…</div>
    <div id="loc-empty" class="empty" style="display:none;">
      <div class="empty-icon">📍</div>
      <div class="empty-title">No locations yet</div>
      <div>Use the button above to add your first location.</div>
    </div>
    <div id="loc-list"></div>

    </div><!-- /section-locations -->

    <!-- ══ Wix Setup Hub section (OB-237 Phase B) ═════════════════════ -->
    <div id="section-setup" class="setup-section">
      <div id="setup-loading" class="snippet-loading">
        <div class="spinner"></div>Loading setup data…
      </div>
      <div id="setup-content" style="display:none;">
        <!-- Aggregate pill + env banner removed 2026-05-30 (no synthetic status) -->
        <div id="setup-webhook-card"></div>
        <div id="setup-snippets-list"></div>
      </div><!-- /setup-content -->
    </div><!-- /section-setup -->

  </main>

  <!-- ══ Member Emails info modal (DR-052) ═══════════════════════════ -->
  <div class="info-modal-overlay" id="eb-info-overlay" onclick="if (event.target === this) ebCloseInfo();">
    <div class="info-modal">
      <div class="info-modal-header">
        <div class="info-modal-title">What members receive</div>
        <button type="button" class="info-modal-close" onclick="ebCloseInfo()" aria-label="Close">&times;</button>
      </div>
      <div class="info-modal-intro">
        Three emails go out to members today — pick one to see it on the right.
      </div>

      <div class="info-modal-body">
        <div class="info-modal-list">
          <div class="info-email-card" id="info-card-access_ready" onclick="ebPreviewDemo('access_ready', 'Access ready')">
            <div class="info-email-name">Access ready</div>
            <div class="info-email-what">Tells them their door access is live — plan and door included, with the iPhone and Android app links.</div>
            <div class="info-email-subject">Subject: "Your access at {gym} is ready"</div>
            <div class="info-email-rule sent"><b>Sent:</b> the moment access is granted — a new signup, a renewal, or someone claiming their own seat on a shared plan.</div>
            <div class="info-email-rule notsent"><b>Not sent:</b> background syncs that just re-confirm access you already have.</div>
            <button type="button" class="info-preview-link" onclick="event.stopPropagation(); ebPreviewDemo('access_ready', 'Access ready')">Preview this email &rarr;</button>
          </div>

          <div class="info-email-card" id="info-card-access_removed" onclick="ebPreviewDemo('access_removed', 'Access removed')">
            <div class="info-email-name">Access removed</div>
            <div class="info-email-what">Tells them a plan's access has ended.</div>
            <div class="info-email-subject">Subject: "Your {plan} access at {gym} has ended"</div>
            <div class="info-email-rule sent"><b>Sent:</b> a plan is genuinely cancelled — including when a holder removes someone else from a shared plan.</div>
            <div class="info-email-rule notsent"><b>Not sent:</b> someone leaves a plan themselves (they already know), or it's a background sync.</div>
            <button type="button" class="info-preview-link" onclick="event.stopPropagation(); ebPreviewDemo('access_removed', 'Access removed')">Preview this email &rarr;</button>
          </div>

          <div class="info-email-card" id="info-card-sub_member_invite" onclick="ebPreviewDemo('sub_member_invite', 'Added to a plan')">
            <div class="info-email-name">Added to a plan</div>
            <div class="info-email-what">Tells someone a plan holder just added them — say, to a Family or Couples plan — with the same app download links and setup steps as Access ready.</div>
            <div class="info-email-subject">Subject: "{holder} added you to {plan} at {gym}"</div>
            <div class="info-email-rule sent"><b>Sent:</b> the moment a holder adds a new person to their plan.</div>
            <div class="info-email-rule notsent"><b>Not sent:</b> the holder's own access — they get Access ready instead.</div>
            <button type="button" class="info-preview-link" onclick="event.stopPropagation(); ebPreviewDemo('sub_member_invite', 'Added to a plan')">Preview this email &rarr;</button>
          </div>

          <div class="info-email-card" id="info-card-access_suspended" onclick="ebPreviewDemo('access_suspended', 'Access paused')">
            <div class="info-email-name">Access paused</div>
            <div class="info-email-what">Tells them a failed payment paused their door access — expected to be temporary.</div>
            <div class="info-email-subject">Subject: "Your {plan} access at {gym} is paused"</div>
            <div class="info-email-rule sent"><b>Sent:</b> a payment fails and access is suspended.</div>
            <div class="info-email-rule notsent"><b>Not sent:</b> a genuine cancellation (they get Access removed instead).</div>
            <button type="button" class="info-preview-link" onclick="event.stopPropagation(); ebPreviewDemo('access_suspended', 'Access paused')">Preview this email &rarr;</button>
          </div>

          <div class="info-email-card" id="info-card-access_restored" onclick="ebPreviewDemo('access_restored', 'Access restored')">
            <div class="info-email-name">Access restored</div>
            <div class="info-email-what">Tells them a fixed payment turned their door access back on.</div>
            <div class="info-email-subject">Subject: "Your {plan} access at {gym} is back"</div>
            <div class="info-email-rule sent"><b>Sent:</b> payment recovers after a suspension.</div>
            <div class="info-email-rule notsent"><b>Not sent:</b> a first-time signup (they get Access ready instead).</div>
            <button type="button" class="info-preview-link" onclick="event.stopPropagation(); ebPreviewDemo('access_restored', 'Access restored')">Preview this email &rarr;</button>
          </div>
        </div>

        <div class="info-modal-preview">
          <div class="info-demo-label">
            Subject: <b id="info-demo-subject-text">&mdash;</b>
            <div style="margin-top:2px;">Now showing: <span id="info-demo-label-text">Access ready</span>, with your current logo and colors.</div>
          </div>
          <iframe id="info-demo-frame" sandbox="" title="Email demo"></iframe>
        </div>
      </div>
    </div>
  </div>

  <div class="toast-wrap" id="toastWrap"></div>

  <script src="/operator-nav.js"></script>
  <script>
    'use strict';

    var params   = new URLSearchParams(window.location.search);
    var clientId = params.get('clientId') || '';

    var state = {
      locations: [],
      wixHasKey: false,
      hwKey: null,   // { hasKey, platform, keyLastVerified, keyLastError }
      client: null,
    };

    document.addEventListener('DOMContentLoaded', function() {
      activateJumpTarget();
      if (!clientId) {
        toast('No clientId in URL — add ?clientId=YOUR_ID', 'error');
        return;
      }
      loadClientProfile();
      loadWixKeyStatus();
      loadHwKeyStatus();
      loadNotifEmail();
      ebLoad();
      loadLocations();
      // OB-237 Phase D — deep link from Dashboard pill: #setup auto-opens the Setup Hub tab
      if (window.location.hash === '#setup') {
        switchTab('setup');
      }
    });

    // ── API helpers ────────────────────────────────────────────────────
    // apiFetch is provided by operator-nav.js (handles 401 → session expired modal)

    // ── Notification email (rollup — client-level) ──────────────────────
    function loadNotifEmail() {
      apiFetch('/operator/clients/' + clientId + '/notification-email')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          var el = document.getElementById('notif-email-display');
          if (data.email) {
            el.textContent = data.email;
            el.className   = 'config-row-status set';
          } else {
            el.textContent = 'Not set — alerts will use the system default';
            el.className   = 'config-row-status';
          }
        })
        .catch(function() {
          document.getElementById('notif-email-display').textContent = 'Unable to load';
        });
    }

    function toggleNotifForm() {
      var form = document.getElementById('notif-form');
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('notif-email-input').focus(); }, 50);
      }
    }

    function saveNotifEmail() {
      var email = document.getElementById('notif-email-input').value.trim();
      if (!email) { toast('Email cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId + '/notification-email', {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ email: email }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Alert email updated', 'success');
            var el = document.getElementById('notif-email-display');
            el.textContent = email;
            el.className   = 'config-row-status set';
            document.getElementById('notif-form').classList.remove('open');
            document.getElementById('notif-email-input').value = '';
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed — network error', 'error'); });
    }

    // ── Member email branding (DR-052) ─────────────────────────────────
    var ebState = { enabled: false, logoUrl: null, qrGuideUrl: null };
    var ebPreviewTimer = null;

    function ebLoad() {
      apiFetch('/operator/clients/' + clientId + '/email-branding')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          ebState.enabled = !!data.enabled;
          ebState.logoUrl = data.logoUrl || null;
          ebState.qrGuideUrl = data.qrGuideUrl || null;
          ebRenderGuide();
          if (data.primaryColor)   { ebSetColor('primary', data.primaryColor); }
          if (data.secondaryColor) { ebSetColor('secondary', data.secondaryColor); }
          ebRenderLogo();
          ebRenderEnabled();
          ebRefreshPreview();
        })
        .catch(function() {
          document.getElementById('eb-enabled-status').textContent = 'Unable to load';
        });
    }

    function ebSetColor(which, hex) {
      document.getElementById('eb-' + which).value = hex;
      document.getElementById('eb-' + which + '-hex').value = hex;
    }
    function ebColorChanged(which) {
      document.getElementById('eb-' + which + '-hex').value = document.getElementById('eb-' + which).value;
      ebRefreshPreview();
    }
    function ebHexChanged(which) {
      var v = document.getElementById('eb-' + which + '-hex').value.trim();
      if (/^#[0-9a-fA-F]{6}$/.test(v)) {
        document.getElementById('eb-' + which).value = v;
        ebRefreshPreview();
      }
    }

    function ebRenderLogo() {
      var thumb  = document.getElementById('eb-logo-thumb');
      var status = document.getElementById('eb-logo-status');
      if (ebState.logoUrl) {
        thumb.src = ebState.logoUrl;
        thumb.style.display = '';
        status.textContent = '';
      } else {
        thumb.style.display = 'none';
        status.textContent = 'None uploaded';
      }
    }

    function ebRenderEnabled() {
      var el  = document.getElementById('eb-enabled-status');
      var btn = document.getElementById('eb-toggle-btn');
      if (ebState.enabled) {
        el.textContent = '✓ Sending to members';
        el.className   = 'config-row-status set';
        btn.textContent = 'Turn off member emails';
      } else {
        el.textContent = 'Off — members receive no emails yet';
        el.className   = 'config-row-status';
        btn.textContent = 'Turn on member emails';
      }
      btn.style.display = '';
    }

    // Live preview — server renders the REAL template; query params track unsaved edits.
    function ebRefreshPreview() {
      if (ebPreviewTimer) clearTimeout(ebPreviewTimer);
      ebPreviewTimer = setTimeout(function() {
        var p = document.getElementById('eb-primary').value;
        var s = document.getElementById('eb-secondary').value;
        var url = '/operator/clients/' + clientId + '/email-branding/preview' +
          '?primary=' + encodeURIComponent(p) + '&secondary=' + encodeURIComponent(s) + '&_t=' + Date.now();
        apiFetch(url)
          .then(function(res) {
            var subjHeader = res.headers.get('X-Preview-Subject');
            document.getElementById('eb-preview-subject').textContent =
              subjHeader ? decodeURIComponent(subjHeader) : '—';
            return res.text();
          })
          .then(function(html) { document.getElementById('eb-preview').srcdoc = html; })
          .catch(function() {});
      }, 250);
    }

    function ebSave() {
      var p = document.getElementById('eb-primary-hex').value.trim();
      var s = document.getElementById('eb-secondary-hex').value.trim();
      if (!/^#[0-9a-fA-F]{6}$/.test(p) || !/^#[0-9a-fA-F]{6}$/.test(s)) {
        toast('Colors must be #rrggbb hex values', 'error'); return;
      }
      apiFetch('/operator/clients/' + clientId + '/email-branding', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ primaryColor: p, secondaryColor: s }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) { toast('Email branding saved', 'success'); ebRefreshPreview(); }
          else toast(data.error || 'Save failed', 'error');
        })
        .catch(function() { toast('Save failed — network error', 'error'); });
    }

    function ebToggleEnabled() {
      var next = !ebState.enabled;
      apiFetch('/operator/clients/' + clientId + '/email-branding', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          primaryColor: document.getElementById('eb-primary-hex').value.trim(),
          secondaryColor: document.getElementById('eb-secondary-hex').value.trim(),
          enabled: next,
        }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            ebState.enabled = next;
            ebRenderEnabled();
            toast(next ? 'Member emails are ON' : 'Member emails are OFF', 'success');
          } else toast(data.error || 'Update failed', 'error');
        })
        .catch(function() { toast('Update failed — network error', 'error'); });
    }

    function ebRenderGuide() {
      var link   = document.getElementById('eb-guide-link');
      var status = document.getElementById('eb-guide-status');
      var remove = document.getElementById('eb-guide-remove');
      if (ebState.qrGuideUrl) {
        link.href = ebState.qrGuideUrl; link.style.display = '';
        remove.style.display = '';
        status.textContent = '';
      } else {
        link.style.display = 'none'; remove.style.display = 'none';
        status.textContent = 'None uploaded';
      }
    }

    function ebUploadGuide(input) {
      var file = input.files && input.files[0];
      input.value = '';
      if (!file) return;
      if (file.size > 2 * 1024 * 1024) { toast('The guide must be 2 MB or smaller', 'error'); return; }
      var fd = new FormData();
      fd.append('guide', file);
      document.getElementById('eb-guide-status').textContent = 'Uploading\u2026';
      apiFetch('/operator/clients/' + clientId + '/email-branding/qr-guide', { method: 'POST', body: fd })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) { ebState.qrGuideUrl = data.qrGuideUrl; toast('Guide uploaded', 'success'); }
          else toast(data.error || 'Upload failed', 'error');
          ebRenderGuide();
        })
        .catch(function() { ebRenderGuide(); toast('Upload failed \u2014 network error', 'error'); });
    }

    function ebRemoveGuide() {
      if (!confirm('Remove the QR entry guide? Emails will go out without it.')) return;
      apiFetch('/operator/clients/' + clientId + '/email-branding/qr-guide', { method: 'DELETE' })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) { ebState.qrGuideUrl = null; toast('Guide removed', 'success'); }
          else toast(data.error || 'Remove failed', 'error');
          ebRenderGuide();
        })
        .catch(function() { toast('Remove failed \u2014 network error', 'error'); });
    }

    function ebUploadLogo(input) {
      var file = input.files && input.files[0];
      input.value = '';
      if (!file) return;
      if (file.size > 1024 * 1024) { toast('Logo must be 1 MB or smaller', 'error'); return; }
      var fd = new FormData();
      fd.append('logo', file);
      document.getElementById('eb-logo-status').textContent = 'Uploading…';
      apiFetch('/operator/clients/' + clientId + '/email-branding/logo', { method: 'POST', body: fd })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            ebState.logoUrl = data.logoUrl;
            ebRenderLogo();
            ebRefreshPreview();
            toast('Logo uploaded', 'success');
          } else {
            ebRenderLogo();
            toast(data.error || 'Upload failed', 'error');
          }
        })
        .catch(function() { ebRenderLogo(); toast('Upload failed — network error', 'error'); });
    }

    function ebSendTest() {
      apiFetch('/operator/clients/' + clientId + '/email-branding/test-send', { method: 'POST' })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) toast(data.message || 'Test email sent', 'success');
          else toast(data.error || 'Test send failed', 'error');
        })
        .catch(function() { toast('Test send failed — network error', 'error'); });
    }

    // ── "What emails go out" info modal (DR-052) — split screen: list left, ───
    // live preview right. Opens with "Access ready" pre-loaded so the right
    // pane is never empty.
    function ebOpenInfo() {
      document.getElementById('eb-info-overlay').classList.add('visible');
      document.addEventListener('keydown', ebInfoEscapeHandler);
      ebPreviewDemo('access_ready', 'Access ready');
    }
    function ebCloseInfo() {
      document.getElementById('eb-info-overlay').classList.remove('visible');
      document.removeEventListener('keydown', ebInfoEscapeHandler);
    }
    function ebInfoEscapeHandler(e) { if (e.key === 'Escape') ebCloseInfo(); }

    // Demo uses whatever's currently in the color/logo inputs (saved or not) so the
    // preview always matches what the operator is looking at in the branding card —
    // same real-template render path as the live preview pane, just a different
    // sample email type. Highlights the selected card on the left so it's obvious
    // which email the right-hand preview belongs to.
    function ebPreviewDemo(type, label) {
      var p = document.getElementById('eb-primary').value;
      var s = document.getElementById('eb-secondary').value;
      var url = '/operator/clients/' + clientId + '/email-branding/preview' +
        '?type=' + encodeURIComponent(type) +
        '&primary=' + encodeURIComponent(p) + '&secondary=' + encodeURIComponent(s) +
        (ebState.logoUrl ? '&logo=' + encodeURIComponent(ebState.logoUrl) : '') +
        '&_t=' + Date.now();
      document.getElementById('info-demo-label-text').textContent = label;
      ['access_ready', 'access_removed', 'sub_member_invite', 'access_suspended', 'access_restored'].forEach(function(t) {
        document.getElementById('info-card-' + t).classList.toggle('active', t === type);
      });
      apiFetch(url)
        .then(function(res) {
          var subjHeader = res.headers.get('X-Preview-Subject');
          document.getElementById('info-demo-subject-text').textContent =
            subjHeader ? decodeURIComponent(subjHeader) : '—';
          return res.text();
        })
        .then(function(html) { document.getElementById('info-demo-frame').srcdoc = html; })
        .catch(function() { toast('Could not load the demo', 'error'); });
    }

    // ── Wix API key ───────────────────────────────────────────────────
    function loadWixKeyStatus() {
      apiFetch('/operator/clients/' + clientId + '/wix-api-key/status')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          state.wixHasKey = !!data.hasKey;
          renderWixKeyStatus();
        })
        .catch(function() {
          document.getElementById('wix-key-status').textContent = 'Unable to check';
        });
    }

    function renderWixKeyStatus() {
      var statusEl = document.getElementById('wix-key-status');
      var btnEl    = document.getElementById('wix-key-btn');
      var testBtn  = document.getElementById('wix-test-btn');
      if (state.wixHasKey) {
        statusEl.textContent = '✓ Key configured';
        statusEl.style.color = 'var(--sage-dark)';
        btnEl.textContent    = 'Rotate Key';
        testBtn.style.display = '';
      } else {
        statusEl.textContent = '✗ No key set';
        statusEl.style.color = 'var(--red)';
        btnEl.textContent    = 'Set Key';
        testBtn.style.display = 'none';
      }
    }

    function toggleWixKeyForm() {
      var form = document.getElementById('wix-key-form');
      form.classList.toggle('open');
    }

    function saveWixKey() {
      var key = document.getElementById('wix-key-input').value.trim();
      if (!key) { toast('Key cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId + '/wix-api-key', {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ apiKey: key }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast('Wix API key saved', 'success');
            state.wixHasKey = true;
            renderWixKeyStatus();
            document.getElementById('wix-key-form').classList.remove('open');
            document.getElementById('wix-key-input').value = '';
            setTimeout(testWixKey, 800);
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    function testWixKey() {
      var btn = document.getElementById('wix-test-btn');
      btn.disabled = true; btn.textContent = 'Testing…';
      apiFetch('/operator/clients/' + clientId + '/wix-api-key/test')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.valid) {
            toast('✓ Wix key valid — connected', 'success');
          } else {
            toast('✗ ' + (data.error || 'Key invalid'), 'error');
          }
        })
        .catch(function() { toast('Test failed', 'error'); })
        .finally(function() { btn.disabled = false; btn.textContent = 'Test'; });
    }

    // ── Door system API key (one per client, used by every location) ────
    var PLATFORM_KEY_INFO = {
      kisi: { name: 'Kisi', docs: 'https://docs.kisi.io/dashboard/account/generate_api_key/' },
      seam: { name: 'Seam', docs: null },
    };
    function platformInfo(platform) {
      return PLATFORM_KEY_INFO[platform] || { name: platform ? platform.charAt(0).toUpperCase() + platform.slice(1) : null, docs: null };
    }
    // "Kisi API Key" once the platform is known; generic until then.
    function hwKeyLabel() {
      var info = platformInfo(state.hwKey && state.hwKey.platform);
      return info.name ? info.name + ' API Key' : 'Door System API Key';
    }

    function loadHwKeyStatus() {
      apiFetch('/operator/clients/' + clientId + '/api-key/status')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          state.hwKey = data || {};
          // A client with no connector row yet is Kisi-by-default (the only live platform).
          if (!state.hwKey.platform) state.hwKey.platform = 'kisi';
          renderHwKeyStatus();
          renderLocations();
        })
        .catch(function() {
          document.getElementById('hw-key-status').textContent = 'Unable to check';
        });
    }

    function renderHwKeyStatus() {
      var k       = state.hwKey || {};
      var info    = platformInfo(k.platform);
      var label   = hwKeyLabel();
      var statusEl = document.getElementById('hw-key-status');
      document.getElementById('hw-key-label').textContent = label;
      document.getElementById('hw-key-input').placeholder = 'Paste your ' + label + '…';
      document.getElementById('hw-key-hint').innerHTML =
        'Stored securely — write-only. Every location uses this key.' +
        (info.docs ? ' <a href="' + info.docs + '" target="_blank" rel="noopener" style="color:var(--brand)">How to create a ' + esc(info.name) + ' API key</a>' : '');
      var btnEl   = document.getElementById('hw-key-btn');
      var testBtn = document.getElementById('hw-test-btn');
      if (k.hasKey) {
        var sub = k.keyLastError
          ? '<span style="display:block;font-size:10px;color:var(--red);margin-top:2px;">Verification failed: ' + esc(k.keyLastError) + '</span>'
          : k.keyLastVerified
            ? '<span style="display:block;font-size:10px;color:var(--muted);margin-top:2px;">Last verified ' + esc(formatRelativeTime(k.keyLastVerified)) + '</span>'
            : '<span style="display:block;font-size:10px;color:var(--amber);margin-top:2px;">● Never verified</span>';
        statusEl.innerHTML    = '<span style="color:var(--sage-dark)">✓ Key configured</span>' + sub;
        btnEl.textContent     = 'Rotate Key';
        testBtn.style.display = '';
      } else {
        statusEl.innerHTML    = '<span style="color:var(--red)">✗ No key set</span>';
        btnEl.textContent     = 'Set Key';
        testBtn.style.display = 'none';
      }
    }

    function toggleHwKeyForm() {
      var form = document.getElementById('hw-key-form');
      form.classList.toggle('open');
      if (form.classList.contains('open')) {
        setTimeout(function() { document.getElementById('hw-key-input').focus(); }, 50);
      }
    }

    function saveHwKey() {
      var key = document.getElementById('hw-key-input').value.trim();
      if (!key) { toast('Key cannot be empty', 'error'); return; }
      if (state.hwKey && state.hwKey.hasKey && state.locations.length > 1 &&
          !confirm('This replaces the ' + hwKeyLabel() + ' for all ' + state.locations.length + ' locations. Continue?')) return;
      apiFetch('/operator/clients/' + clientId + '/api-key', {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ apiKey: key }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            toast(hwKeyLabel() + ' saved — used for all locations', 'success');
            document.getElementById('hw-key-form').classList.remove('open');
            document.getElementById('hw-key-input').value = '';
            loadHwKeyStatus();
            setTimeout(testHwKey, 800);
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    function testHwKey() {
      var btn   = document.getElementById('hw-test-btn');
      var resEl = document.getElementById('hw-key-testres');
      btn.disabled = true; btn.textContent = 'Testing…';
      resEl.style.display = 'none';
      apiFetch('/operator/clients/' + clientId + '/api-key/test')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          resEl.style.display = '';
          if (data.valid) {
            resEl.className   = 'test-result pass';
            resEl.textContent = '✓ Connected to ' + (platformInfo(state.hwKey && state.hwKey.platform).name || 'your door system');
          } else {
            resEl.className   = 'test-result fail';
            resEl.textContent = '✗ ' + (data.error || 'Key invalid');
          }
        })
        .catch(function() {
          resEl.style.display = '';
          resEl.className   = 'test-result fail';
          resEl.textContent = '✗ Test failed — network error';
        })
        .finally(function() { btn.disabled = false; btn.textContent = 'Test'; });
    }

    // ── Client profile ────────────────────────────────────────────────
    function loadClientProfile() {
      apiFetch('/operator/' + clientId)
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (!data.client) return;
          state.client = data.client;
          renderClientProfile();
        })
        .catch(function() {});
    }

    function renderClientProfile() {
      var card = document.getElementById('profile-card');
      if (!card || !state.client) return;
      var c = state.client;
      document.getElementById('profile-name').textContent = c.name || 'Unnamed';
      var meta = [c.source_site_url ? c.source_site_url.replace(/^https?:\/\//, '') : ''].filter(Boolean).join(' · ');
      document.getElementById('profile-meta').textContent = meta;
      var pills = '';
      if (c.last_sync_at) {
        var ago = new Date(c.last_sync_at).toLocaleString([], {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'});
        pills += '<span class="pill" style="background:var(--sage-dim);color:var(--sage-dark);">Last sync: ' + ago + '</span>';
      }
      document.getElementById('profile-pills').innerHTML = pills;
    }

    function toggleProfileEdit() {
      var form = document.getElementById('profile-form');
      form.classList.toggle('open');
      if (form.classList.contains('open') && state.client) {
        document.getElementById('profile-name-input').value = state.client.name || '';
      }
    }

    function saveProfileName() {
      var name = document.getElementById('profile-name-input').value.trim();
      if (!name) { toast('Name cannot be empty', 'error'); return; }
      apiFetch('/operator/clients/' + clientId, {
        method:  'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ name: name }),
      })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (data.ok) {
            state.client.name = data.client.name;
            renderClientProfile();
            document.getElementById('profile-form').classList.remove('open');
            toast('Business name updated', 'success');
          } else {
            toast(data.error || 'Save failed', 'error');
          }
        })
        .catch(function() { toast('Save failed', 'error'); });
    }

    // ── Locations ──────────────────────────────────────────────────────
    function loadLocations() {
      apiFetch('/operator/' + clientId + '/locations')
        .then(function(res) { return res.json(); })
        .then(function(data) {
          state.locations = data.locations || [];
          document.getElementById('loc-loading').style.display = 'none';
          if (!state.locations.length) {
            document.getElementById('loc-empty').style.display = '';
            return;
          }
          renderLocations();
        })
        .catch(function() {
          document.getElementById('loc-loading').style.display = 'none';
          toast('Failed to load locations', 'error');
        });
    }

    function renderLocations() {
      var list = document.getElementById('loc-list');
      list.innerHTML = state.locations.map(function(loc) { return locCard(loc); }).join('');
    }

    function locCard(loc) {
      var addressHTML = loc.city
        ? '<div class="loc-address">' + esc(loc.city) + (loc.state ? ', ' + esc(loc.state) : '') + '</div>'
        : '';

      var billingTier      = loc.billing && loc.billing.tier ? loc.billing.tier : null;
      var billingStatus    = loc.billing && loc.billing.status ? loc.billing.status : 'inactive';
      var connectorPlatform = loc.connector && loc.connector.platform ? loc.connector.platform : null;
      var hasKey           = !!(loc.connector && loc.connector.has_key);
      var keyLastVerified  = loc.connector && loc.connector.key_last_verified ? loc.connector.key_last_verified : null;
      var keyLastError     = loc.connector && loc.connector.key_last_error ? loc.connector.key_last_error : null;
      var keyStatusLabel;
      if (!hasKey) {
        keyStatusLabel = '<span class="config-row-status warn">✗ Not set</span>';
      } else if (keyLastError) {
        keyStatusLabel =
          '<span class="config-row-status set">✓ Key configured</span>' +
          '<span style="display:block;font-size:10px;color:var(--red);margin-top:2px;">Verification failed: ' + esc(keyLastError) + '</span>';
      } else if (keyLastVerified) {
        keyStatusLabel =
          '<span class="config-row-status set">✓ Key configured</span>' +
          '<span style="display:block;font-size:10px;color:var(--muted);margin-top:2px;">Last verified ' + esc(formatRelativeTime(keyLastVerified)) + '</span>';
      } else {
        keyStatusLabel =
          '<span class="config-row-status set">✓ Key configured</span>' +
          '<span style="display:block;font-size:10px;color:var(--amber);margin-top:2px;">● Never verified</span>';
      }
      var locEmail = loc.notification_email;
      var emailStatusLabel = locEmail
        ? '<span class="config-row-status set">' + esc(locEmail) + '</span>'
        : '<span class="config-row-status">(using rollup)</span>';

      var errorColor = loc.error_count > 0 ? 'var(--red)' : 'inherit';

      return '<div class="loc-card" id="loc-' + loc.id + '">' +
        // ── Header
        '<div class="loc-header">' +
          '<div class="loc-icon">📍</div>' +
          '<div class="loc-meta">' +
            '<div class="loc-name">' + esc(loc.name) + '</div>' +
            addressHTML +
          '</div>' +
          '<div class="loc-pills">' + subPill(billingStatus) + '</div>' +
          '<button class="btn btn-sm btn-ghost" onclick="toggleEditLocation(\'' + loc.id + '\')" title="Edit name/address">Edit</button>' +
        '</div>' +
        // ── Edit name/address form
        '<div class="key-form" id="editform-' + loc.id + '">' +
          '<div class="key-form-inner" style="margin:0 18px 8px;">' +
            '<input type="text" class="key-input" id="editname-' + loc.id + '" placeholder="Location name *"/>' +
            '<div style="display:flex;gap:8px;">' +
              '<input type="text" class="key-input" id="editcity-' + loc.id + '" placeholder="City" style="flex:1;margin-bottom:0;"/>' +
              '<input type="text" class="key-input" id="editstate-' + loc.id + '" placeholder="State" style="width:80px;margin-bottom:0;"/>' +
            '</div>' +
            '<div class="key-form-actions" style="margin-top:10px;">' +
              '<button class="btn btn-ghost btn-sm" onclick="toggleEditLocation(\'' + loc.id + '\')">Cancel</button>' +
              '<button class="btn btn-primary btn-sm" onclick="saveEditLocation(\'' + loc.id + '\')">Save</button>' +
            '</div>' +
          '</div>' +
        '</div>' +
        // ── Config rows
        '<div class="loc-body">' +
          '<div class="config-section" style="margin-top:0;border-top:1px solid var(--border);padding-top:0;">' +
            // Row: Tier (locked once set)
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">Tier</span>' +
                (billingTier
                  ? '<span class="config-row-status set">' + esc(billingTier) + '</span>'
                  : '<select class="config-select" id="tier-' + loc.id + '" onchange="saveLocTier(\'' + loc.id + '\')">' +
                      '<option value="" selected>Not set</option>' +
                      '<option value="Base">Base</option>' +
                      '<option value="Pro">Pro</option>' +
                      '<option value="Connect">Connect</option>' +
                    '</select>'
                ) +
              '</div>' +
            '</div>' +
            // Row: Platform (locked once set)
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">Platform</span>' +
                (connectorPlatform
                  ? '<span class="config-row-status set">' + esc(connectorPlatform.charAt(0).toUpperCase() + connectorPlatform.slice(1)) + '</span>'
                  : '<select class="config-select" id="platform-' + loc.id + '" onchange="saveLocPlatform(\'' + loc.id + '\')">' +
                      '<option value="kisi" selected>Kisi</option>' +
                    '</select>'
                ) +
              '</div>' +
            '</div>' +
            // Row: door system key — read-only here. There is ONE key per client
            // (connector_subscriptions); it is managed in the profile card above.
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">' + esc(hwKeyLabel()) + '</span>' +
                keyStatusLabel +
                '<a href="#hw-key-row" class="btn btn-sm btn-ghost" onclick="document.getElementById(\'hw-key-row\').scrollIntoView({behavior:\'smooth\'});return false;">Manage</a>' +
              '</div>' +
              '<div style="font-size:11px;color:var(--muted);margin-top:4px;">Shared by all locations — set or rotate it in the business card above.</div>' +
            '</div>' +
            // Row: Alert Email
            '<div class="config-row">' +
              '<div class="config-row-header">' +
                '<span class="config-row-label">Alert Email</span>' +
                emailStatusLabel +
                '<button class="btn btn-sm btn-secondary" onclick="toggleLocEmailForm(\'' + loc.id + '\')">' +
                  (locEmail ? 'Edit' : 'Set') +
                '</button>' +
              '</div>' +
              '<div class="key-form" id="emailform-' + loc.id + '">' +
                '<div class="key-form-inner">' +
                  '<div class="key-input-hint">Alerts for this location go here instead of the rollup email. Leave blank to use the rollup.</div>' +
