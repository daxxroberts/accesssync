        '<span class="field-err hidden" id="ef-err-phone"></span></div>' +
    '</div>' +
    '<div class="btn-row">' +
      '<button class="btn-ghost" onclick="mmCancelEdit()">Cancel</button>' +
      '<button class="btn-primary" id="mm-btn-edit-save" onclick="mmSaveEdit(\'' + esc(m.id) + '\')">Save changes</button>' +
    '</div>' +
  '</div>';
}

// ── Sticky CTA visibility ────────────────────────────────────────────
function mmUpdateStickyVisibility() {
  const submitArea = document.getElementById('mm-submit-area');
  const stickyCta  = document.getElementById('mm-sticky-cta');
  const drafts = MM.subMembers.filter(m => m.status === 'draft');
  if (drafts.length === 0) { stickyCta.classList.add('hidden'); return; }
  const rect   = submitArea.getBoundingClientRect();
  const inView = rect.top < window.innerHeight && rect.bottom > 0;
  stickyCta.classList.toggle('hidden', inView);
}
window.addEventListener('scroll', mmUpdateStickyVisibility, { passive: true });

// ── Add form ─────────────────────────────────────────────────────────
// Per-plan: caller passes the plan.id the form should write against.
// Reuses a single shared form element; we move it into the right plan's slot.
function mmOpenAddForm(planId) {
  // Default to first plan when no id passed (defensive — eg. dev console call).
  if (!planId && MM.plans.length > 0) planId = MM.plans[0].id;
  MM.activeAddPlanId = planId || null;

  const addForm = document.getElementById('mm-add-form');
  if (!addForm) {
    console.warn('mm-add-form element missing — cannot open');
    return;
  }
  addForm.classList.remove('hidden');

  // mmSaveAdd disables the button on submit but only re-enables on failure.
  // On the success path closeAddForm() hides the form but the button stays
  // disabled in memory; reopening shows the form with a dead button. Reset here.
  const saveBtn = document.getElementById('mm-btn-add-save');
  if (saveBtn) saveBtn.disabled = false;
  mmClearAddForm();

  // Personalise the form subtitle with the plan name.
  const plan = MM.plans.find(p => p.id === planId);
  const subEl = document.getElementById('mm-add-form-sub');
  if (subEl) {
    subEl.textContent = plan && plan.planName
      ? 'Adding to ' + plan.planName + ' — saved as a draft until you grant access.'
      : "They'll be saved as a draft until you grant access.";
  }

  // mmRender does the heavy lifting: rebuilds groups, then re-attaches the
  // (now-visible) form into the active plan's slot and hides that plan's
  // add-trigger. Single source of truth for DOM state.
  mmRender();

  const firstInput = document.getElementById('f-first');
  if (firstInput) firstInput.focus();
  notifyHeight();
}

function mmCloseAddForm() {
  document.getElementById('mm-add-form').classList.add('hidden');
  MM.activeAddPlanId = null;
  mmClearAddForm();
  mmRender();
}

function mmClearAddForm() {
  ['f-first','f-last','f-email','f-phone'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.value = ''; el.classList.remove('invalid'); }
  });
  ['err-first','err-last','err-email','err-phone'].forEach(id => {
    const el = document.getElementById(id);
    if (el) { el.textContent = ''; el.classList.add('hidden'); }
  });
}

function mmValidateAddForm() {
  let valid = true;
  const first = document.getElementById('f-first').value.trim();
  const last  = document.getElementById('f-last').value.trim();
  const email = document.getElementById('f-email').value.trim();
  const phone = document.getElementById('f-phone').value.trim();
  function setErr(fld, errId, msg) {
    const inp = document.getElementById(fld);
    const err = document.getElementById(errId);
    if (msg) { inp.classList.add('invalid'); err.textContent = msg; err.classList.remove('hidden'); valid = false; }
    else      { inp.classList.remove('invalid'); err.textContent = ''; err.classList.add('hidden'); }
  }
  setErr('f-first','err-first', first ? '' : 'Required');
  setErr('f-last', 'err-last',  last  ? '' : 'Required');
  setErr('f-email','err-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : 'Invalid email');
  setErr('f-phone','err-phone', phone.length >= 7 ? '' : 'Phone too short');
  return valid;
}

// ── Confirm ──────────────────────────────────────────────────────────
function mmBeginConfirm(id) { MM.confirmingId = id; MM.editingId = null; mmRenderList(); notifyHeight(); }
function mmCancelConfirm()   { MM.confirmingId = null; mmRenderList(); notifyHeight(); }

// ── Edit ─────────────────────────────────────────────────────────────
function mmBeginEdit(id) {
  MM.editingId = id; MM.confirmingId = null;
  document.getElementById('mm-add-form').classList.add('hidden');
  mmRenderList(); notifyHeight();
}
function mmCancelEdit() { MM.editingId = null; mmRenderList(); mmRender(); }

function mmValidateEditForm() {
  let valid = true;
  const first = document.getElementById('ef-first').value.trim();
  const last  = document.getElementById('ef-last').value.trim();
  const email = document.getElementById('ef-email').value.trim();
  const phone = document.getElementById('ef-phone').value.trim();
  function setErr(fld, errId, msg) {
    const inp = document.getElementById(fld);
    const err = document.getElementById(errId);
    if (msg) { inp.classList.add('invalid'); err.textContent = msg; err.classList.remove('hidden'); valid = false; }
    else      { inp.classList.remove('invalid'); err.textContent = ''; err.classList.add('hidden'); }
  }
  setErr('ef-first','ef-err-first', first ? '' : 'Required');
  setErr('ef-last', 'ef-err-last',  last  ? '' : 'Required');
  setErr('ef-email','ef-err-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? '' : 'Invalid email');
  setErr('ef-phone','ef-err-phone', phone.length >= 7 ? '' : 'Phone too short');
  return valid;
}

// ── API: Add ─────────────────────────────────────────────────────────
async function mmSaveAdd() {
  if (!mmValidateAddForm()) return;
  const activePlanId = MM.activeAddPlanId || (MM.plans[0] && MM.plans[0].id);
  if (!activePlanId) { showToast('Plan not loaded. Refresh and try again.', 'error'); return; }

  // Per-plan client-side limit check (server still enforces).
  const activePlan = MM.plans.find(p => p.id === activePlanId);
  if (activePlan) {
    const usedOnPlan = MM.subMembers.filter(m => m.planMappingId === activePlanId).length;
    if (usedOnPlan >= activePlan.maxMembers) {
      showToast(activePlan.planName + ' is full — limit is ' + activePlan.maxMembers + ' additional members.', 'error');
      return;
    }
  }

  const btn = document.getElementById('mm-btn-add-save');
  btn.disabled = true;
  try {
    const res = await fetch(BASE + '/api/multi-member/members', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        holderId:     MM.holder.id,
        clientId,
        firstName:    document.getElementById('f-first').value.trim(),
        lastName:     document.getElementById('f-last').value.trim(),
        email:        document.getElementById('f-email').value.trim(),
        phone:        document.getElementById('f-phone').value.trim(),
        planMappingId: activePlanId,  // DR-040 — per-plan via activeAddPlanId
      }),
    });
    const data = await res.json();
    if (!res.ok) {
      const planMax = activePlan ? activePlan.maxMembers : MM.maxMembers;
      showToast(res.status === 409 ? 'Member limit reached — this plan allows up to ' + planMax + ' additional members.' : (data.error || 'Failed to add member.'), 'error');
      btn.disabled = false;
      return;
    }
    mmCloseAddForm();
    await mmLoadData();
    showToast(data.subMember.firstName + ' added as a draft', 'success');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    btn.disabled = false;
  }
}

// ── API: Edit ─────────────────────────────────────────────────────────
async function mmSaveEdit(subId) {
  if (!mmValidateEditForm()) return;
  const btn = document.getElementById('mm-btn-edit-save');
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(BASE + '/api/multi-member/members/' + encodeURIComponent(subId), {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        firstName: document.getElementById('ef-first').value.trim(),
        lastName:  document.getElementById('ef-last').value.trim(),
        email:     document.getElementById('ef-email').value.trim(),
        phone:     document.getElementById('ef-phone').value.trim(),
      }),
    });
    const data = await res.json();
    if (!res.ok) { showToast(data.error || 'Failed to update member.', 'error'); if (btn) btn.disabled = false; return; }
    MM.editingId = null;
    await mmLoadData();
    showToast('Draft updated', 'success');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    if (btn) btn.disabled = false;
  }
}

// ── API: Remove ───────────────────────────────────────────────────────
async function mmDoRemove(subId) {
  MM.confirmingId = null;
  try {
    const res  = await fetch(BASE + '/api/multi-member/members/' + encodeURIComponent(subId), { method: 'DELETE' });
    const data = await res.json();
    if (!res.ok) { showToast(data.error || 'Failed to remove member.', 'error'); return; }
    await mmLoadData();
    showToast(data.message || 'Member removed', 'info');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
  }
}

// ── API: Submit ───────────────────────────────────────────────────────
async function mmSubmitAll() {
  const drafts = MM.subMembers.filter(m => m.status === 'draft');
  if (!drafts.length) return;
  const btn = document.getElementById('mm-btn-submit');
  if (btn) btn.disabled = true;
  try {
    const res  = await fetch(BASE + '/api/multi-member/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ holderId: MM.holder.id, clientId }),
    });
    const data = await res.json();
    if (!res.ok) { showToast(data.error || 'Submit failed.', 'error'); if (btn) btn.disabled = false; return; }
    await mmLoadData();
    showToast('Granting access to ' + data.submitted + ' member' + (data.submitted === 1 ? '' : 's') + '…', 'info');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    if (btn) btn.disabled = false;
  }
}

// ═══════════════════════════════════════════════════════════════════
// BOOT
// ═══════════════════════════════════════════════════════════════════

let _booted = false;

async function boot() {
  if (_booted) return;
  _booted = true;

  // Gate: check which tabs to show, then render tab bar
  // We need widget-data to know if Manage Members tab should appear.
  // Do this first (before first render) to avoid tab flash (FAULT rule).
  let showMembersTab = false;

  if (platformMemberId && clientId) {
    try {
      const res = await fetch(BASE + '/member/' + encodeURIComponent(platformMemberId) + '/widget-data?clientId=' + encodeURIComponent(clientId) + '&_t=' + Date.now(), { cache: 'no-store' });
      if (res.ok) {
        const d = await res.json();
        MM.loaded       = true;
        MM.holder       = d.holder;
        MM.plans        = d.plans;
        MM.subMembers   = d.subMembers;
        MM.maxMembers   = MM.plans.length > 0 ? Math.min(...MM.plans.map(p => p.maxMembers)) : 0;
        MM.planMappingId = MM.plans.length > 0 ? MM.plans[0].id : null;
        showMembersTab  = MM.plans.some(p => p.allowMultiple);

        // Populate holder chip from widget-data if available
        if (MM.holder) {
          const holderName = [MM.holder.firstName, MM.holder.lastName].filter(Boolean).join(' ') || MM.holder.email || '';
          if (holderName) setMemberChip(holderName);
        }
      }
    } catch (e) {
      // Widget-data failure is non-fatal — still show My Access
    }
  }

  // Show tab bar now that we know which tabs to include
  const tabBar   = document.getElementById('tab-bar');
  const mmTabBtn = document.getElementById('tab-btn-members');
  if (showMembersTab) {
    mmTabBtn.classList.remove('hidden');
  }
  tabBar.classList.remove('hidden');

  // Trigger overlay if ?tab=status was passed (post-purchase redirect)
  if (tabParam === 'status') {
    showOverlay();
    setOvState('syncing');
    startPipeline();
    pollAccess();
  }

  // Load My Access tab data
  loadAccessData();

  // If Manage Members tab is active (switched before boot), load its data
  if (_activeTab === 'members' && MM.loaded) {
    document.getElementById('mm-loading').classList.add('hidden');
    document.getElementById('mm-content').classList.remove('hidden');
    mmRender();
  }
}

window.addEventListener('beforeunload', function() {
  clearStepTimers();
  clearPollTimer();
  if (_freshnessInterval) clearInterval(_freshnessInterval);
});

// Boot immediately if URL params are present; otherwise wait for postMessage
if (platformMemberId && clientId) {
  boot();
}
</script>
