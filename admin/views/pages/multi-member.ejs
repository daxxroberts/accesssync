// ── API: Add ─────────────────────────────────────────────────────
async function saveAdd() {
  if (!validateAddForm()) return;
  const btn = document.getElementById('btn-add-save');
  btn.disabled = true;
  try {
    const res = await fetch(BASE + '/api/multi-member/members', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        holderId:  S.holder.id,
        clientId,
        firstName: document.getElementById('f-first').value.trim(),
        lastName:  document.getElementById('f-last').value.trim(),
        email:     document.getElementById('f-email').value.trim(),
        phone:     document.getElementById('f-phone').value.trim(),
      }),
    });
    const data = await res.json();
    if (!res.ok) {
      if (res.status === 409) {
        showToast('Member limit reached — this plan allows up to ' + S.maxMembers + ' additional members.', 'error');
      } else {
        showToast(data.error || 'Failed to add member.', 'error');
      }
      btn.disabled = false;
      return;
    }
    closeAddForm();
    await loadData();
    showToast(data.subMember.firstName + ' added as a draft', 'success');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    btn.disabled = false;
  }
}

// ── API: Edit ────────────────────────────────────────────────────
async function saveEdit(subId) {
  if (!validateEditForm()) return;
  const btn = document.getElementById('btn-edit-save');
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(BASE + '/api/multi-member/members/' + encodeURIComponent(subId), {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        firstName: document.getElementById('ef-first').value.trim(),
        lastName:  document.getElementById('ef-last').value.trim(),
        email:     document.getElementById('ef-email').value.trim(),
        phone:     document.getElementById('ef-phone').value.trim(),
      }),
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Failed to update member.', 'error');
      if (btn) btn.disabled = false;
      return;
    }
    S.editingId = null;
    await loadData();
    showToast('Draft updated', 'success');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    if (btn) btn.disabled = false;
  }
}

// ── API: Remove ──────────────────────────────────────────────────
// DR-044: server marks 'removing' on submitted/active members + queues revoke
// job. processRevoke() finalizes to 'deleted' + NULL PII when Kisi confirms.
// loadData() re-fetches widget-data after — server filters 'removing' and
// 'deleted' from the listing so the UI reflects truth. No optimistic updates.
async function doRemove(subId) {
  S.confirmingId = null;
  try {
    const res = await fetch(BASE + '/api/multi-member/members/' + encodeURIComponent(subId), {
      method: 'DELETE',
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Failed to remove member.', 'error');
      return;
    }
    await loadData();
    showToast(data.message || 'Member will be removed', 'info');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
  }
}

// ── API: Holder claims a slot for themselves ───────────────────
async function claimHolderSlot() {
  const plan = S.plans[0] || {};
  if (!plan.id) return;
  const btn = document.getElementById('btn-holder-claim');
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(BASE + '/api/multi-member/holder-claim-slot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ holderId: S.holder.id, clientId, planMappingId: plan.id }),
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Could not add you to this plan.', 'error');
      if (btn) btn.disabled = false;
      return;
    }
    showToast(data.message || 'Adding you to this plan…', 'info');
    await loadData();
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    if (btn) btn.disabled = false;
  }
}

// ── API: Holder releases their own slot ────────────────────────
async function releaseHolderSlot() {
  const plan = S.plans[0] || {};
  if (!plan.id) return;
  if (!confirm('Remove yourself from this plan? You will lose door access.')) return;
  const btn = document.getElementById('btn-holder-release');
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(BASE + '/api/multi-member/holder-release-slot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ holderId: S.holder.id, clientId, planMappingId: plan.id }),
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Could not remove you from this plan.', 'error');
      if (btn) btn.disabled = false;
      return;
    }
    showToast(data.message || 'Removing your access…', 'info');
    await loadData();
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    if (btn) btn.disabled = false;
  }
}

// ── API: Submit ──────────────────────────────────────────────────
async function submitAll() {
  const drafts = S.subMembers.filter(m => m.status === 'draft');
  if (!drafts.length) return;
  const btn = document.getElementById('btn-submit');
  if (btn) btn.disabled = true;
  try {
    const res = await fetch(BASE + '/api/multi-member/submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ holderId: S.holder.id, clientId }),
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Submit failed.', 'error');
      if (btn) btn.disabled = false;
      return;
    }
    await loadData();
    showToast('Granting access to ' + data.submitted + ' member' + (data.submitted === 1 ? '' : 's') + '…', 'info');
  } catch (e) {
    showToast('Something went wrong. Try again.', 'error');
    if (btn) btn.disabled = false;
  }
}

// ── Inline sync pipeline ─────────────────────────────────────────
const SYNC_STEPS = [
  { label: 'Got it',     sub: '',          doneSub: 'Received' },
  { label: 'Setting up', sub: 'Account…',  doneSub: 'Account ready' },
  { label: 'Door',       sub: 'Matching…', doneSub: 'Door matched' },
  { label: 'Activating', sub: 'Almost…',   doneSub: 'Live' },
];
const STEP_DURATIONS = [1400, 2200, 2800, null]; // ms; null = waits for active status from API

// Per-member pipeline state keyed by member id
const pipelineState = {}; // { [memberId]: { step: 1-4, timers: [] } }

function getPipelineStep(memberId) {
  return pipelineState[memberId] ? pipelineState[memberId].step : 0;
}

function startPipeline(memberId) {
  if (pipelineState[memberId]) return; // already running
  pipelineState[memberId] = { step: 0, timers: [] };
  advancePipeline(memberId, 1);
}

function advancePipeline(memberId, toStep) {
  if (!pipelineState[memberId]) return;
  pipelineState[memberId].step = toStep;
  renderMemberList(); // re-render so the pipeline HTML reflects new step
  notifyHeight();

  const dur = STEP_DURATIONS[toStep - 1];
  if (dur !== null && toStep < 4) {
    const t = setTimeout(() => advancePipeline(memberId, toStep + 1), dur);
    pipelineState[memberId].timers.push(t);
  }
  // Step 4 stays active until poll confirms active status — no auto-advance
}

function completePipeline(memberId) {
  if (!pipelineState[memberId]) return;
  pipelineState[memberId].step = 5; // 5 = all done
  pipelineState[memberId].timers.forEach(t => clearTimeout(t));
}

function syncPipelineHtml(memberId) {
  const step = getPipelineStep(memberId);
  const steps = SYNC_STEPS.map((s, i) => {
    const idx  = i + 1;
    const done = idx < step;
    const active = idx === step;
    const bulletCls = done ? 'sync-bullet done' : active ? 'sync-bullet active-step' : 'sync-bullet';
    const labelCls  = done ? 'sync-label done' : active ? 'sync-label active-step' : 'sync-label';
    const bulletInner = done
      ? '<svg width="9" height="9" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'
      : idx;
    const subText = done ? s.doneSub : s.sub;
    const scanBar = active ? '<div class="sync-scan"><div class="sync-scan-bar"></div></div>' : '';
    return '<div class="sync-step">' +
      '<div class="' + bulletCls + '">' + bulletInner + '</div>' +
      '<div class="sync-text">' +
        '<div class="' + labelCls + '">' + esc(s.label) + '<span style="color:var(--muted);font-weight:400;margin-left:5px;font-size:10px">' + idx + '/4</span></div>' +
        '<div class="sync-sub">' + esc(subText) + '</div>' +
        scanBar +
      '</div>' +
    '</div>';
  }).join('');
  return '<div class="sync-pipeline">' + steps + '</div>';
}

// ── Polling — watch non-terminal members until all settle ────────
const POLL_INTERVAL_MS = 4000;
const POLL_MAX         = 75; // 5 minutes max

function isNonTerminal(m) {
  if (m.status === 'draft') return false;
  if (m.accessStatus === 'active') return false;
  if (m.accessStatus === 'failed' || m.accessStatus === 'error') return false;
  if (m.accessStatus === 'suspended' || m.accessStatus === 'revoked') return false;
  return true;
}

function stopPoll() {
  if (S.pollTimer) { clearInterval(S.pollTimer); S.pollTimer = null; }
  S.pollCount = 0;
}

function maybeStartPoll(prevMembers) {
  const pending = S.subMembers.filter(isNonTerminal);

  // Kick off pipelines for any newly-pending members
  pending.forEach(m => startPipeline(m.id));

  // Check if anyone just flipped from pending → active
  if (prevMembers && prevMembers.length > 0) {
    const prevPendingIds = new Set(prevMembers.filter(isNonTerminal).map(m => m.id));
    const newlyActive = S.subMembers.filter(m => prevPendingIds.has(m.id) && m.accessStatus === 'active');
    newlyActive.forEach(m => {
      completePipeline(m.id);
    });
    if (newlyActive.length > 0) {
      renderMemberList();
      showConfirmationBanner(newlyActive);
    }
  }

  if (pending.length === 0) { stopPoll(); return; }
  if (S.pollTimer) return; // already polling
  S.pollTimer = setInterval(async () => {
    S.pollCount++;
    if (S.pollCount > POLL_MAX) { stopPoll(); return; }
    const prev = S.subMembers.slice();
    await loadData(prev);
  }, POLL_INTERVAL_MS);
}

function showConfirmationBanner(activeMembers) {
  let el = document.getElementById('confirm-banner');
  if (!el) {
    el = document.createElement('div');
    el.id = 'confirm-banner';
    el.style.cssText = 'background:var(--green-dim);border:1px solid rgba(22,163,74,0.35);border-radius:12px;padding:14px 16px;margin-bottom:16px;display:flex;align-items:flex-start;gap:10px;animation:fade-up 0.3s ease;';
    const main = document.getElementById('main-content');
    main.insertBefore(el, main.firstChild);
  }
  const names = activeMembers.map(m => esc(m.firstName)).join(' and ');
  el.innerHTML =
    '<svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="var(--green)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><path d="M3 8.5l3 3 7-7.5"/></svg>' +
    '<div>' +
      '<div style="font-size:13px;font-weight:600;color:var(--green);margin-bottom:2px">' +
        names + (activeMembers.length === 1 ? ' is' : ' are') + ' good to go' +
      '</div>' +
      '<div style="font-size:12px;color:var(--text2);line-height:1.5">' +
        'Their door access is live. Kisi will send them an email so they know they\'re all set.' +
      '</div>' +
    '</div>';
}

// ── Init ─────────────────────────────────────────────────────────
loadData();
</script>
