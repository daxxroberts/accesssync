<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manage Additional Members — AccessSync</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --brand: #4F6EF7;
  --green: #22C55E;
  --green-dim: rgba(34,197,94,0.12);
  --amber: #F59E0B;
  --amber-dim: rgba(245,158,11,0.12);
  --red: #EF4444;
  --red-dim: rgba(239,68,68,0.10);
  --bg: #F1F5F9;
  --card: #FFFFFF;
  --border: #E2E8F0;
  --text: #0F172A;
  --text2: #475569;
  --muted: #94A3B8;
  --r: 12px;
}
html, body {
  height: 100%;
  font-family: 'Sora', sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
}
.page { min-height: 100vh; display: flex; align-items: flex-start; justify-content: center; padding: 24px; }
.container { max-width: 520px; width: 100%; }

/* Plan card */
.plan-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 24px;
  margin-bottom: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.plan-card h2 { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
.plan-card .plan-meta { font-size: 12px; color: var(--muted); }
.plan-card .status-pill {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  margin-top: 8px;
}
.pill-active { background: var(--green-dim); color: var(--green); }
.pill-pending { background: var(--amber-dim); color: var(--amber); }
.pill-error { background: var(--red-dim); color: var(--red); }

/* Section header */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.section-header h3 { font-size: 15px; font-weight: 600; }
.member-count { font-size: 12px; color: var(--muted); }

/* Member list */
.member-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
.member-card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 16px;
  box-shadow: 0 1px 6px rgba(0,0,0,0.04);
}
.member-card .member-name { font-weight: 600; font-size: 14px; margin-bottom: 2px; }
.member-card .member-detail { font-size: 12px; color: var(--text2); margin-bottom: 1px; }
.member-card .member-actions {
  display: flex; gap: 8px; margin-top: 10px;
}
.member-card .member-status {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 600;
  margin-top: 6px;
}

/* Buttons */
.btn {
  border: none;
  border-radius: 8px;
  padding: 8px 16px;
  font-family: 'Sora', sans-serif;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.15s;
}
.btn:hover { opacity: 0.85; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; }
.btn-primary { background: var(--brand); color: #fff; }
.btn-danger { background: var(--red); color: #fff; }
.btn-outline {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text2);
}
.btn-submit {
  background: var(--green);
  color: #fff;
  width: 100%;
  padding: 12px;
  font-size: 14px;
  margin-top: 8px;
}
.btn-add {
  background: var(--brand);
  color: #fff;
  width: 100%;
  padding: 12px;
  font-size: 13px;
}

/* Form */
.form-card {
  background: var(--card);
  border: 1px solid var(--brand);
  border-radius: var(--r);
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: 0 2px 12px rgba(79,110,247,0.08);
}
.form-card h4 { font-size: 14px; font-weight: 600; margin-bottom: 14px; }
.form-row { display: flex; gap: 10px; margin-bottom: 10px; }
.form-row.full { flex-direction: column; }
.form-field { flex: 1; display: flex; flex-direction: column; }
.form-field label {
  font-size: 11px;
  font-weight: 600;
  color: var(--text2);
  margin-bottom: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.form-field input {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 12px;
  font-family: 'Sora', sans-serif;
  font-size: 13px;
  color: var(--text);
  outline: none;
  transition: border-color 0.15s;
}
.form-field input:focus { border-color: var(--brand); }
.form-field input.invalid { border-color: var(--red); }
.form-actions { display: flex; gap: 8px; margin-top: 14px; }

/* Toast */
.toast {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  padding: 10px 20px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  color: #fff;
  z-index: 999;
  opacity: 0;
  transition: opacity 0.3s;
  pointer-events: none;
}
.toast.visible { opacity: 1; }
.toast.success { background: var(--green); }
.toast.error { background: var(--red); }

/* Loading */
.loading {
  text-align: center;
  padding: 60px 20px;
  color: var(--muted);
  font-size: 13px;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-spinner {
  width: 28px; height: 28px;
  border: 3px solid var(--border);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 12px;
}

/* Empty state */
.empty-state {
  text-align: center;
  padding: 32px 16px;
  color: var(--muted);
  font-size: 13px;
}
.empty-state svg { margin-bottom: 12px; opacity: 0.4; }

.hidden { display: none !important; }
</style>
</head>
<body>
<div class="page">
  <div class="container">
    <!-- Loading -->
    <div id="loading" class="loading">
      <div class="loading-spinner"></div>
      Loading your plan...
    </div>

    <!-- Error (no params or API failure) -->
    <div id="error-state" class="plan-card hidden" style="text-align:center;">
      <svg width="40" height="40" viewBox="0 0 32 32" fill="none" style="margin-bottom:12px;">
        <circle cx="16" cy="16" r="12" stroke="#EF4444" stroke-width="2.5"/>
        <path d="M16 11v6M16 20v1" stroke="#EF4444" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <h2 style="font-size:16px;">Unable to load</h2>
      <p id="error-msg" style="font-size:13px;color:var(--text2);margin-top:6px;">Something went wrong.</p>
    </div>

    <!-- Main content (populated by JS) -->
    <div id="main-content" class="hidden">
      <!-- Plan info card -->
      <div class="plan-card">
        <h2 id="plan-name">Your Plan</h2>
        <div class="plan-meta" id="plan-meta"></div>
        <div id="plan-status"></div>
      </div>

      <!-- Additional Members section -->
      <div class="section-header">
        <h3>Additional Members</h3>
        <span class="member-count" id="member-count"></span>
      </div>

      <!-- Member list -->
      <div id="member-list" class="member-list"></div>

      <!-- Empty state -->
      <div id="empty-state" class="empty-state hidden">
        <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
          <circle cx="18" cy="18" r="15" stroke="currentColor" stroke-width="1.5"/>
          <path d="M18 12v6M15 21h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <div>No additional members yet</div>
      </div>

      <!-- Add member form (hidden until triggered) -->
      <div id="add-form" class="form-card hidden">
        <h4 id="form-title">Add Additional Member</h4>
        <div class="form-row">
          <div class="form-field">
            <label for="f-first">First Name</label>
            <input id="f-first" type="text" placeholder="First name" autocomplete="given-name">
          </div>
          <div class="form-field">
            <label for="f-last">Last Name</label>
            <input id="f-last" type="text" placeholder="Last name" autocomplete="family-name">
          </div>
        </div>
        <div class="form-row full">
          <div class="form-field">
            <label for="f-email">Email</label>
            <input id="f-email" type="email" placeholder="member@email.com" autocomplete="email">
          </div>
        </div>
        <div class="form-row full">
          <div class="form-field">
            <label for="f-phone">Phone</label>
            <input id="f-phone" type="tel" placeholder="(555) 123-4567" autocomplete="tel">
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" id="form-save" onclick="saveForm()">Add Member</button>
          <button class="btn btn-outline" onclick="cancelForm()">Cancel</button>
        </div>
      </div>

      <!-- Add button -->
      <button class="btn btn-add" id="btn-add" onclick="showAddForm()">+ Add Additional Member</button>

      <!-- Submit all button (visible when drafts exist) -->
      <button class="btn btn-submit hidden" id="btn-submit" onclick="submitAll()">
        Submit All for Access
      </button>
    </div>
  </div>
</div>

<div id="toast" class="toast"></div>

<script>
'use strict';

const params = new URLSearchParams(window.location.search);
const platformMemberId = params.get('memberId');
const clientId = params.get('clientId');
const BASE = params.get('coreUrl') || '';

let state = {
  holder: null,
  plans: [],
  subMembers: [],
  editingId: null,  // sub-member ID being edited (null = adding new)
};

function esc(s) {
  return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function showToast(msg, type = 'success') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = `toast ${type} visible`;
  setTimeout(() => t.classList.remove('visible'), 3000);
}

function statusPill(status) {
  if (status === 'active') return '<span class="status-pill pill-active">Active</span>';
  if (status === 'failed' || status === 'error') return '<span class="status-pill pill-error">Error</span>';
  return '<span class="status-pill pill-pending">Pending</span>';
}

function memberStatusPill(subStatus, accessStatus) {
  if (subStatus === 'draft') return '<span class="member-status" style="background:var(--amber-dim);color:var(--amber);">Draft</span>';
  if (accessStatus === 'active') return '<span class="member-status" style="background:var(--green-dim);color:var(--green);">Active</span>';
  if (accessStatus === 'failed') return '<span class="member-status" style="background:var(--red-dim);color:var(--red);">Failed</span>';
  return '<span class="member-status" style="background:var(--amber-dim);color:var(--amber);">Pending</span>';
}

// ── Load widget data ─────────────────────────────────────────────
async function loadData() {
  if (!platformMemberId || !clientId) {
    showError('Missing memberId or clientId in URL.');
    return;
  }

  try {
    const res = await fetch(`${BASE}/member/${encodeURIComponent(platformMemberId)}/widget-data?clientId=${encodeURIComponent(clientId)}`);
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      showError(err.error || 'Unable to load member data.');
      return;
    }

    const data = await res.json();
    state.holder = data.holder;
    state.plans = data.plans;
    state.subMembers = data.subMembers;

    render();
  } catch (err) {
    console.error('Load error:', err);
    showError('Unable to connect to AccessSync.');
  }
}

function showError(msg) {
  document.getElementById('loading').classList.add('hidden');
  document.getElementById('error-state').classList.remove('hidden');
  document.getElementById('error-msg').textContent = msg;
}

// ── Render ───────────────────────────────────────────────────────
function render() {
  document.getElementById('loading').classList.add('hidden');
  document.getElementById('main-content').classList.remove('hidden');

  // Plan card
  const plan = state.plans[0]; // primary multi-member plan
  if (plan) {
    document.getElementById('plan-name').textContent = plan.planName;
    document.getElementById('plan-meta').textContent = plan.doorName ? `Access: ${plan.doorName}` : '';
  } else {
    document.getElementById('plan-name').textContent = 'Your Plan';
    document.getElementById('plan-meta').textContent = 'No multi-member plans configured';
  }
  document.getElementById('plan-status').innerHTML = statusPill(state.holder?.accessStatus);

  // Max members
  const maxMembers = plan ? plan.maxMembers : 0;
  const currentCount = state.subMembers.length;
  document.getElementById('member-count').textContent = `${currentCount} / ${maxMembers}`;

  // Member list
  const listEl = document.getElementById('member-list');
  const emptyEl = document.getElementById('empty-state');

  if (state.subMembers.length === 0) {
    listEl.innerHTML = '';
    emptyEl.classList.remove('hidden');
  } else {
    emptyEl.classList.add('hidden');
    listEl.innerHTML = state.subMembers.map(m => `
      <div class="member-card">
        <div class="member-name">${esc(m.firstName)} ${esc(m.lastName)}</div>
        <div class="member-detail">${esc(m.email)}</div>
        <div class="member-detail">${esc(m.phone)}</div>
        ${memberStatusPill(m.status, m.accessStatus)}
        <div class="member-actions">
          ${m.status === 'draft' ? `<button class="btn btn-outline" onclick="editMember('${m.id}')">Edit</button>` : ''}
          <button class="btn btn-danger" onclick="removeMember('${m.id}', '${esc(m.firstName)}')">Remove</button>
        </div>
      </div>
    `).join('');
  }

  // Add button — hide if at max
  const addBtn = document.getElementById('btn-add');
  if (!plan || currentCount >= maxMembers) {
    addBtn.classList.add('hidden');
  } else {
    addBtn.classList.remove('hidden');
  }

  // Submit button — show if there are any drafts
  const hasDrafts = state.subMembers.some(m => m.status === 'draft');
  document.getElementById('btn-submit').classList.toggle('hidden', !hasDrafts);
}

// ── Add / Edit form ──────────────────────────────────────────────
function showAddForm() {
  state.editingId = null;
  document.getElementById('form-title').textContent = 'Add Additional Member';
  document.getElementById('form-save').textContent = 'Add Member';
  clearForm();
  document.getElementById('add-form').classList.remove('hidden');
  document.getElementById('btn-add').classList.add('hidden');
  document.getElementById('f-first').focus();
}

function editMember(subId) {
  const m = state.subMembers.find(s => s.id === subId);
  if (!m) return;
  state.editingId = subId;
  document.getElementById('form-title').textContent = 'Edit Additional Member';
  document.getElementById('form-save').textContent = 'Save Changes';
  document.getElementById('f-first').value = m.firstName || '';
  document.getElementById('f-last').value = m.lastName || '';
  document.getElementById('f-email').value = m.email || '';
  document.getElementById('f-phone').value = m.phone || '';
  document.getElementById('add-form').classList.remove('hidden');
  document.getElementById('btn-add').classList.add('hidden');
  document.getElementById('f-first').focus();
}

function cancelForm() {
  document.getElementById('add-form').classList.add('hidden');
  state.editingId = null;
  clearForm();
  render(); // re-show add button if applicable
}

function clearForm() {
  ['f-first','f-last','f-email','f-phone'].forEach(id => {
    const el = document.getElementById(id);
    el.value = '';
    el.classList.remove('invalid');
  });
}

function validateForm() {
  let valid = true;
  const fields = [
    { id: 'f-first', test: v => v.trim().length > 0 },
    { id: 'f-last', test: v => v.trim().length > 0 },
    { id: 'f-email', test: v => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) },
    { id: 'f-phone', test: v => v.trim().length >= 7 },
  ];
  fields.forEach(f => {
    const el = document.getElementById(f.id);
    if (!f.test(el.value)) { el.classList.add('invalid'); valid = false; }
    else { el.classList.remove('invalid'); }
  });
  return valid;
}

// ── Save (add or edit) ──────────────────────────────────────────
async function saveForm() {
  if (!validateForm()) return;

  const body = {
    firstName: document.getElementById('f-first').value.trim(),
    lastName: document.getElementById('f-last').value.trim(),
    email: document.getElementById('f-email').value.trim(),
    phone: document.getElementById('f-phone').value.trim(),
  };

  const btn = document.getElementById('form-save');
  btn.disabled = true;

  try {
    let res;
    if (state.editingId) {
      // Edit existing
      res = await fetch(`${BASE}/api/multi-member/members/${state.editingId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
    } else {
      // Add new
      res = await fetch(`${BASE}/api/multi-member/members`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          ...body,
          holderId: state.holder.id,
          clientId: clientId,
        }),
      });
    }

    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Failed to save', 'error');
      btn.disabled = false;
      return;
    }

    showToast(state.editingId ? 'Member updated' : 'Member added');
    cancelForm();
    await loadData(); // refresh
  } catch (err) {
    console.error('Save error:', err);
    showToast('Connection error', 'error');
  }
  btn.disabled = false;
}

// ── Remove ──────────────────────────────────────────────────────
async function removeMember(subId, name) {
  if (!confirm(`Remove ${name}? This will revoke their access.`)) return;

  try {
    const res = await fetch(`${BASE}/api/multi-member/members/${subId}`, { method: 'DELETE' });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Failed to remove', 'error');
      return;
    }
    showToast('Member removed');
    await loadData();
  } catch (err) {
    console.error('Remove error:', err);
    showToast('Connection error', 'error');
  }
}

// ── Submit all drafts ───────────────────────────────────────────
async function submitAll() {
  const drafts = state.subMembers.filter(m => m.status === 'draft');
  if (!drafts.length) return;

  if (!confirm(`Submit ${drafts.length} member(s) for access? They will be provisioned in the door system.`)) return;

  const btn = document.getElementById('btn-submit');
  btn.disabled = true;
  btn.textContent = 'Submitting...';

  try {
    const res = await fetch(`${BASE}/api/multi-member/submit`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ holderId: state.holder.id, clientId }),
    });
    const data = await res.json();
    if (!res.ok) {
      showToast(data.error || 'Submit failed', 'error');
      btn.disabled = false;
      btn.textContent = 'Submit All for Access';
      return;
    }

    showToast(`${data.submitted} member(s) submitted for access`);
    await loadData();
  } catch (err) {
    console.error('Submit error:', err);
    showToast('Connection error', 'error');
  }
  btn.disabled = false;
  btn.textContent = 'Submit All for Access';
}

// ── Init ────────────────────────────────────────────────────────
loadData();
</script>
</body>
</html>
