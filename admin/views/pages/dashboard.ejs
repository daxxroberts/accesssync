                Plan Mapping <span class="loc-sub-count">2</span>
              </div>
              <div class="loc-sub-right">
                <button class="link-btn" onclick="event.stopPropagation(); window.location.href='/plan-mapping'">Edit →</button>
              </div>
            </div>
            <div class="loc-sub-body" id="sub-mapping-ro">
              <div class="map-row">
                <div><div class="map-plan">Monthly Member</div><div class="map-detail">Ongoing · $49/mo</div></div>
                <div class="map-right"><span class="map-arrow">→</span><span class="map-door">3 doors</span><span class="mbadge active">Active</span></div>
              </div>
              <div class="map-row">
                <div><div class="map-plan">Annual Member</div><div class="map-detail">Ongoing · $399/yr</div></div>
                <div class="map-right"><span class="map-arrow">→</span><span class="map-door">3 doors</span><span class="mbadge active">Active</span></div>
              </div>
              <div class="map-row" style="opacity:0.5;">
                <div><div class="map-plan">Day Pass</div><div class="map-detail">Single use · $15</div></div>
                <div class="map-right"><span class="mbadge excl">Not managed</span></div>
              </div>
              <div class="configured-by">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="4" r="2.5" stroke="currentColor" stroke-width="1.2"/><path d="M1 10c0-2 2.2-3.5 5-3.5s5 1.5 5 3.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                Configured by <span>Daxx Roberts</span> · March 2026
              </div>
            </div>

            <!-- Recent Access -->
            <div class="loc-sub-header" onclick="toggleLocSub('ro', 'access')">
              <div class="loc-sub-title">
                <svg class="loc-sub-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Recent Access
              </div>
              <div class="loc-sub-right">
                <button class="link-btn" onclick="event.stopPropagation(); window.location.href='/access?location=roland'">See Details →</button>
              </div>
            </div>
            <div class="loc-sub-body" id="sub-access-ro">
              <div class="access-today-bar"><svg width="12" height="12" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.2"/><path d="M7 3v4l2.5 1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Today: 68 events</span></div>
              <div class="log-row"><div class="log-av grant">CM</div><div class="log-info"><div class="log-name">Chris Martin</div><div class="log-detail">Monthly Member · QR scan · Front Door</div></div><div class="log-right"><span class="log-badge grant">Granted</span><span class="log-time">8 min ago</span></div></div>
              <div class="log-row"><div class="log-av grant">LT</div><div class="log-info"><div class="log-name">Lisa Torres</div><div class="log-detail">Annual Member · NFC tap · Weight Room</div></div><div class="log-right"><span class="log-badge grant">Granted</span><span class="log-time">22 min ago</span></div></div>
              <div class="log-row"><div class="log-av prov">RN</div><div class="log-info"><div class="log-name">Ryan Nash</div><div class="log-detail">Annual Member · 3 doors provisioned</div></div><div class="log-right"><span class="log-badge prov">Provisioned</span><span class="log-time">1 hr ago</span></div></div>
              <div class="log-row"><div class="log-av grant">EC</div><div class="log-info"><div class="log-name">Emily Chen</div><div class="log-detail">Monthly Member · QR scan · Weight Room</div></div><div class="log-right"><span class="log-badge grant">Granted</span><span class="log-time">1 hr ago</span></div></div>
              <div class="log-row"><div class="log-av grant">MS</div><div class="log-info"><div class="log-name">Michael Simpson</div><div class="log-detail">Annual Member · NFC tap · Cardio Floor</div></div><div class="log-right"><span class="log-badge grant">Granted</span><span class="log-time">2 hrs ago</span></div></div>
              <div class="log-row"><div class="log-av prov">NK</div><div class="log-info"><div class="log-name">Natasha Kim</div><div class="log-detail">Monthly Member · New member provisioned</div></div><div class="log-right"><span class="log-badge prov">Provisioned</span><span class="log-time">3 hrs ago</span></div></div>
              <div class="log-row"><div class="log-av revoke">BP</div><div class="log-info"><div class="log-name">Brandon Pierce</div><div class="log-detail">Payment failed · Plan cancelled</div></div><div class="log-right"><span class="log-badge revoke">Revoked</span><span class="log-time">4 hrs ago</span></div></div>
              <div class="log-row"><div class="log-av grant">SD</div><div class="log-info"><div class="log-name">Sophia Davis</div><div class="log-detail">Annual Member · NFC tap · Front Door</div></div><div class="log-right"><span class="log-badge grant">Granted</span><span class="log-time">5 hrs ago</span></div></div>
            </div>

            <!-- Errors -->
            <div class="loc-sub-header" onclick="toggleLocSub('ro', 'errors')">
              <div class="loc-sub-title">
                <svg class="loc-sub-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Errors <span class="count sage">0</span>
              </div>
            </div>
            <div class="loc-sub-body" id="sub-errors-ro">
              <div class="no-err"><span class="no-err-badge"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="var(--sage-dark)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>No errors — all clear</span></div>
            </div>

            <div class="loc-footer">
              <div class="loc-footer-text">
                <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M10 6A4 4 0 112 6" stroke="var(--sage-dark)" stroke-width="1.2" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="var(--sage-dark)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Synced 6 min ago · Auto-sync 3:00 AM
              </div>
              <button class="sync-btn" id="sync-ro" onclick="syncNow('sync-ro','sync-ro-label')">
                <span id="sync-ro-label">Sync now</span>
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>

  <script src="/operator-nav.js"></script>
  <script>
    // ── Location accordion ──
    function toggleLoc(id) {
      var body = document.getElementById('body-' + id);
      var chev = document.getElementById('chev-' + id);
      var trig = document.getElementById('trig-' + id);
      var isOpen = body.classList.contains('open');
      body.classList.toggle('open', !isOpen);
      chev.classList.toggle('open', !isOpen);
      trig.classList.toggle('open', !isOpen);
      try { localStorage.setItem('loc-' + id, !isOpen ? '1' : '0'); } catch(e) {}
    }

    // ── Location sub-section toggle ──
    function toggleLocSub(locId, section) {
      var body   = document.getElementById('sub-' + section + '-' + locId);
      var header = body.previousElementSibling;
      var isOpen = body.classList.contains('open');
      body.classList.toggle('open', !isOpen);
      header.classList.toggle('open', !isOpen);
    }

    // Restore accordion state on load
    document.addEventListener('DOMContentLoaded', function() {
      ['fs','ro'].forEach(function(id) {
        try {
          if (localStorage.getItem('loc-' + id) === '1') {
            document.getElementById('body-' + id).classList.add('open');
            document.getElementById('chev-' + id).classList.add('open');
            document.getElementById('trig-' + id).classList.add('open');
          }
        } catch(e) {}
      });
    });

    // ── Error view toggle ──
    function setErrView(view) {
      var plain = document.getElementById('fs-err-plain');
      var tech  = document.getElementById('fs-err-tech');
      var sb    = document.getElementById('ev-simple');
      var tb    = document.getElementById('ev-tech');
      if (view === 'simple') {
        plain.classList.remove('hide'); tech.classList.remove('show');
        sb.classList.add('active');     tb.classList.remove('active');
      } else {
        plain.classList.add('hide');    tech.classList.add('show');
        tb.classList.add('active');     sb.classList.remove('active');
      }
    }

    // ── Retry / dismiss error ──
    function retryErr() {
      var btn = document.querySelector('#fs-err-row .btn-retry');
      btn.innerHTML = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" style="animation:spin 0.8s linear infinite"><path d="M10 6A4 4 0 112 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg> Retrying…';
      btn.disabled = true;
      setTimeout(function() { clearErr(); }, 2000);
    }
    function dismissErr() { clearErr(); }

    function clearErr() {
      var row = document.getElementById('fs-err-row');
      row.style.transition = 'opacity 0.3s, transform 0.3s';
      row.style.opacity = '0'; row.style.transform = 'translateX(8px)';
      setTimeout(function() {
        document.getElementById('fs-err-list').innerHTML = '<div class="no-err"><span class="no-err-badge"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="var(--sage-dark)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>No errors — all clear</span></div>';
        document.getElementById('fs-err-count').textContent = '0';
        document.getElementById('fs-err-count').className = 'count sage';
        var card = document.getElementById('loc-fs');
        card.classList.remove('err');
        var pill = document.querySelector('#trig-fs .pill.red');
        if (pill) { pill.className = 'pill sage'; pill.innerHTML = '<span class="pdot pulse"></span>All clear'; }
        var icon = document.querySelector('#trig-fs .loc-icon');
        if (icon) {
          icon.style.background = 'var(--sage-dim)';
          icon.style.borderColor = 'var(--sage-border)';
          icon.innerHTML = '<svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M9 1.5C6.5 1.5 4.5 3.5 4.5 6c0 3.75 4.5 10.5 4.5 10.5S13.5 9.75 13.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="var(--sage-dark)" stroke-width="1.3" fill="none"/><circle cx="9" cy="6" r="1.5" fill="var(--sage-dark)"/></svg>';
          card.style.borderLeftColor = 'var(--sage-dark)';
        }
        var topErr = document.getElementById('top-err-n');
        topErr.textContent = '0';
        topErr.className = 'stat-n sage';
      }, 300);
    }

    // ── Sync now ──
    function syncNow(btnId, labelId) {
      var btn = document.getElementById(btnId);
      var lbl = document.getElementById(labelId);
      if (!btn || btn.disabled) return;
      btn.disabled = true; btn.classList.add('syncing');
      var spinSvg = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" style="animation:spin 0.8s linear infinite"><path d="M10 6A4 4 0 112 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      if (btnId === 'sync-all') {
        lbl.innerHTML = spinSvg + ' Syncing all…';
        ['sync-wix','sync-kisi','sync-fs','sync-ro'].forEach(function(id) {
          var b = document.getElementById(id);
          if (b && !b.disabled) syncNow(id, id + '-label');
        });
      } else {
        lbl.innerHTML = '<span style="display:flex;align-items:center;gap:5px;">' + spinSvg + ' Syncing…</span>';
      }
      setTimeout(function() {
        btn.disabled = false; btn.classList.remove('syncing');
        if (btnId === 'sync-all') {
          lbl.innerHTML = '<span style="display:flex;align-items:center;gap:5px;"><svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M10 6A4 4 0 112 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg> Sync all</span>';
        } else {
          var isShort = btnId === 'sync-wix' || btnId === 'sync-kisi';
          lbl.textContent = isShort ? 'Sync' : 'Sync now';
        }
        document.getElementById('sync-label').textContent = 'Just now';
      }, 2500);
    }
    // ══ OB-29: Live data loading ══════════════════════════════════
    (function loadLiveData() {
      var clientId = new URLSearchParams(window.location.search).get('clientId');
      if (!clientId) return; // keep mock data for demo

      function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

      // Fetch client overview
      fetch('/operator/' + clientId)
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.client) return;
          var c = d.client, s = d.stats;
          document.querySelector('.client-name').textContent = c.name || 'Unnamed';
          document.getElementById('client-sub-text').textContent =
            [s.location_count + ' location' + (s.location_count !== 1 ? 's' : ''),
             c.tier ? c.tier + ' tier' : ''].filter(Boolean).join(' · ');
          // Update stats
          document.getElementById('top-err-n').textContent = s.error_count;
          document.getElementById('top-err-n').className = s.error_count > 0 ? 'stat-n red' : 'stat-n sage';
          // Update platform detail
          var wixDetail = document.querySelector('.platform-chip:first-child .platform-detail');
          if (wixDetail && c.site_url) wixDetail.textContent = c.site_url.replace(/^https?:\/\//, '') + ' · Webhooks active';
          // Sync label
          var syncLabel = document.getElementById('sync-label');
          if (syncLabel && c.last_sync_at) {
            syncLabel.textContent = new Date(c.last_sync_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
          }
        }).catch(function(e) { console.error('Dashboard load error:', e); });

      // OB-26: Check API key status — show CTA banner if missing
      fetch('/operator/clients/' + clientId + '/api-key/status')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.hasKey) return; // key exists, no CTA needed
          var platformRow = document.querySelector('.platform-row');
          if (!platformRow) return;
          var cta = document.createElement('div');
          cta.className = 'key-cta';
          cta.innerHTML =
            '<div class="key-cta-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M7.5 10.5a3 3 0 113-3" stroke="#F5A623" stroke-width="1.3" stroke-linecap="round"/><path d="M10.5 7.5h4.5v3h-1.5v1.5h-1.5v-1.5h-1.5z" stroke="#F5A623" stroke-width="1.3" stroke-linejoin="round" fill="none"/></svg></div>' +
            '<div class="key-cta-text"><strong>Connect your Kisi API key</strong> to start syncing members. Without it, AccessSync cannot provision door access.</div>' +
            '<a class="key-cta-link" href="/locations?clientId=' + clientId + '">Add Key</a>';
          platformRow.parentNode.insertBefore(cta, platformRow.nextSibling);
          // Update Kisi platform chip to show disconnected state
          var kisiPill = document.querySelectorAll('.platform-chip')[1];
          if (kisiPill) {
            var pill = kisiPill.querySelector('.pill');
            if (pill) { pill.className = 'pill amber'; pill.innerHTML = '<span class="pdot"></span>No Key'; }
          }
        }).catch(function() {});

      // Fetch locations and build accordion
      fetch('/operator/' + clientId + '/locations')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.locations || !d.locations.length) return;
          var container = document.getElementById('location-section');
          if (!container) return;
          container.innerHTML = d.locations.map(function(loc, i) {
            var locId = 'loc-' + i;
            var hasErr = loc.error_count > 0;
            var statusPill = loc.subscription_status === 'active'
              ? '<span class="pill sage"><span class="pdot pulse"></span>Active</span>'
              : '<span class="pill amber"><span class="pdot"></span>' + esc(loc.subscription_status) + '</span>';
            return '<div class="card loc-card' + (hasErr ? ' err' : '') + '" id="card-' + locId + '">' +
              '<div class="loc-trigger" id="trig-' + locId + '" onclick="toggleLoc(\'' + locId + '\')">' +
                '<div class="loc-icon" style="background:' + (hasErr ? 'var(--red-dim)' : 'var(--sage-dim)') + '">' +
                  '<svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M9 1.5C6.5 1.5 4.5 3.5 4.5 6c0 3.75 4.5 10.5 4.5 10.5S13.5 9.75 13.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.3" fill="none"/><circle cx="9" cy="6" r="1.5" fill="currentColor"/></svg>' +
                '</div>' +
                '<div class="loc-info"><div class="loc-name">' + esc(loc.name) + '</div>' +
                  '<div class="loc-sub">' + [esc(loc.city), esc(loc.state)].filter(Boolean).join(', ') + '</div></div>' +
                statusPill +
                (hasErr ? '<span class="count red">' + loc.error_count + '</span>' : '') +
                '<svg class="loc-chev" id="chev-' + locId + '" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
              '</div>' +
              '<div class="loc-body" id="body-' + locId + '">' +
                '<div style="padding:16px;color:var(--muted);font-size:12px;">Loading details...</div>' +
              '</div>' +
            '</div>';
          }).join('');
        }).catch(function(e) { console.error('Locations load error:', e); });

      // Fetch errors
      fetch('/operator/' + clientId + '/errors')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          var errSection = document.getElementById('error-summary');
          if (errSection && d.errors) {
            var statCards = document.querySelectorAll('.stat-card');
            if (statCards[2]) {
              var n = statCards[2].querySelector('.stat-n');
              if (n) { n.textContent = d.total; n.className = d.total > 0 ? 'stat-n red' : 'stat-n sage'; }
            }
          }
        }).catch(function() {});
    })();
  </script>
</body>
</html>
