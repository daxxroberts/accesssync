<%#
  @file dashboard.ejs
  @layer admin/pages
  @route /dashboard
  @role operator-overview
  @data GET /operator/:clientId, /operator/:clientId/locations, /operator/:clientId/alerts
  @tab Overview
%>
<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <%- include('../partials/head', { title: 'Operator Dashboard: Overview' }) %>
  <style>
    /* ── Page layout ── */
    .page { padding: 18px 16px 60px; display: flex; flex-direction: column; gap: 16px; max-width: 900px; margin: 0 auto; }

    /* ── Section label ── */
    .section-label {
      font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
      text-transform: uppercase; color: var(--muted);
      display: flex; align-items: center; gap: 10px; margin-bottom: 10px;
    }
    .section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ── Card ── */
    .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); }
    .card-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px; background: var(--surface); border-bottom: 1px solid var(--border);
    }
    .card-title { font-size: 12px; font-weight: 600; color: var(--text2); display: flex; align-items: center; gap: 7px; }

    .link-btn {
      background: none; border: none; font-family: inherit;
      font-size: 11px; font-weight: 500; color: var(--brand);
      cursor: pointer; padding: 0; transition: opacity 0.15s;
    }
    .link-btn:hover { opacity: 0.75; }

    /* ── Pills ── */
    .pill { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; border: 1px solid transparent; flex-shrink: 0; }
    .pill.sage   { background: var(--sage-dim);  color: var(--sage-dark); border-color: var(--sage-border); }
    .pill.red    { background: var(--red-dim);   color: var(--red);        border-color: rgba(255,77,106,0.2); }
    .pill.amber  { background: var(--amber-dim); color: var(--amber);      border-color: rgba(245,166,35,0.2); }
    .pill.brand  { background: var(--brand-dim); color: var(--brand);      border-color: rgba(79,110,247,0.2); }
    .pdot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
    .pdot.pulse { animation: pulse 2s infinite; }

    /* ── Count badge ── */
    .count { font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 10px; }
    .count.red   { background: var(--red-dim);  color: var(--red); }
    .count.sage  { background: var(--sage-dim); color: var(--sage-dark); }
    .count.muted { background: var(--surface);  color: var(--muted); border: 1px solid var(--border); }

    /* ── Client header ── */
    .client-card {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 14px; padding: 16px; box-shadow: var(--shadow);
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .client-name { font-size: 17px; font-weight: 800; letter-spacing: -0.4px; color: var(--text); }
    .client-sub  { font-size: 11px; color: var(--muted); margin-top: 3px; }
    .add-btn {
      display: flex; align-items: center; gap: 6px;
      padding: 8px 14px; border-radius: 10px; border: none;
      font-family: inherit; font-size: 12px; font-weight: 600;
      background: var(--brand); color: #fff;
      box-shadow: 0 0 14px var(--brand-glow);
      cursor: pointer; transition: all 0.15s; white-space: nowrap; flex-shrink: 0;
    }
    .add-btn:hover { box-shadow: 0 0 22px var(--brand-glow); transform: translateY(-1px); }

    /* ── Platform connections ── */
    .platform-row { display: flex; flex-direction: column; gap: 8px; }
    .platform-chip {
      display: flex; align-items: center; gap: 12px;
      padding: 12px 14px; border-radius: 12px;
      background: var(--card); border: 1px solid var(--border);
      border-left: 3px solid var(--sage-dark); box-shadow: var(--shadow);
    }
    .platform-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .platform-icon.wix  { background: var(--sage-dim); }
    .platform-icon.kisi { background: var(--brand-dim); }
    .platform-name   { font-size: 13px; font-weight: 600; color: var(--text); }
    .platform-detail { font-size: 11px; color: var(--muted); margin-top: 1px; }

    /* ── Overview stats ── */
    .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; box-shadow: var(--shadow); }
    .stat-delta { display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 7px; border-radius: 4px; margin-bottom: 6px; }
    .stat-delta.up      { background: var(--sage-dim);  color: var(--sage-dark); }
    .stat-delta.neutral { background: var(--surface);   color: var(--muted); border: 1px solid var(--border); }
    .stat-delta.warn    { background: var(--red-dim);   color: var(--red); }
    .stat-n { font-size: 26px; font-weight: 800; letter-spacing: -0.8px; line-height: 1; margin-bottom: 4px; color: var(--text); }
    .stat-n.sage  { color: var(--sage-dark); }
    .stat-n.red   { color: var(--red); }
    .stat-n.brand { color: var(--brand); }
    .stat-n.sm    { font-size: 18px; }
    .stat-l { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.6px; color: var(--muted); }

    /* ── Location cards ── */
    .locations-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
    .locations-label  { display: flex; align-items: center; gap: 8px; font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted); }
    .locations-hint   { font-size: 11px; color: var(--muted); }
    .locations-stack  { display: flex; flex-direction: column; gap: 10px; }

    .loc-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); border-left: 3px solid var(--sage-dark); transition: box-shadow 0.15s; }
    .loc-card.err { border-left-color: var(--red); }
    .loc-card:hover { box-shadow: var(--shadow-md); }

    .loc-trigger { display: flex; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer; background: var(--surface); transition: background 0.15s; min-height: 66px; }
    .loc-trigger:hover { background: var(--bg); }
    .loc-trigger.open { border-bottom: 1px solid var(--border); }

    .loc-icon { width: 36px; height: 36px; border-radius: 9px; background: var(--sage-dim); border: 1px solid var(--sage-border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .loc-err .loc-icon { background: var(--red-dim); border-color: rgba(255,77,106,0.2); }
    .loc-info { flex: 1; min-width: 0; }
    .loc-name { font-size: 14px; font-weight: 700; color: var(--text); letter-spacing: -0.2px; }
    .loc-meta { font-size: 11px; color: var(--muted); margin-top: 3px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .loc-meta-sep { color: var(--border2); }
    .loc-trigger-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

    .chevron { color: var(--muted); transition: transform 0.22s; flex-shrink: 0; }
    .chevron.open { transform: rotate(180deg); }

    /* ── Tooltip ── */
    .tip-wrap { position: relative; display: inline-flex; align-items: center; }
    .tip-icon { width: 14px; height: 14px; border-radius: 50%; background: var(--surface); border: 1px solid var(--border2); display: inline-flex; align-items: center; justify-content: center; cursor: help; margin-left: 4px; flex-shrink: 0; }
    .tip-box { display: none; position: absolute; bottom: calc(100% + 8px); left: 0; background: #1a2130; color: #e8ecf2; font-size: 11px; line-height: 1.6; padding: 10px 13px; border-radius: 9px; width: 240px; z-index: 100; box-shadow: 0 4px 20px rgba(0,0,0,0.3); pointer-events: none; }
    .tip-box::after { content: ''; position: absolute; top: 100%; left: 16px; border: 5px solid transparent; border-top-color: #1a2130; }
    .tip-wrap:hover .tip-box { display: block; }

    /* ── Location body ── */
    .loc-body { display: none; }
    .loc-body.open { display: block; }

    /* ── Collapsible sub-sections ── */
    .loc-sub-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; cursor: pointer; border-bottom: 1px solid var(--border); transition: background 0.15s; }
    .loc-sub-header:hover { background: var(--surface); }
    .loc-sub-title { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text2); }
    .loc-sub-chevron { color: var(--muted); transition: transform 0.22s; flex-shrink: 0; }
    .loc-sub-header.open .loc-sub-chevron { transform: rotate(180deg); }
    .loc-sub-count { font-size: 10px; font-weight: 700; background: var(--surface); padding: 2px 6px; border-radius: 10px; color: var(--text2); }
    .loc-sub-right { display: flex; align-items: center; gap: 10px; }
    .loc-sub-body { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .loc-sub-body.open { max-height: 3000px; }

    /* ── Error section ── */
    .err-row { display: flex; align-items: flex-start; gap: 10px; padding: 13px 16px; border-bottom: 1px solid var(--border); transition: background 0.1s; }
    .err-row:hover { background: var(--surface); }
    .err-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 5px rgba(255,77,106,0.4); flex-shrink: 0; margin-top: 4px; }
    .err-info { flex: 1; min-width: 0; }
    .err-title { font-size: 12px; font-weight: 600; color: var(--text); margin-bottom: 3px; }
    .err-body  { font-size: 11px; color: var(--text2); line-height: 1.55; }
    .err-body.hide { display: none; }
    .err-tech  { font-size: 11px; color: var(--muted); line-height: 1.55; font-family: monospace; display: none; }
    .err-tech.show { display: block; }
    .err-tags  { display: flex; gap: 5px; margin-top: 7px; flex-wrap: wrap; }
    .err-tag   { font-size: 9px; font-weight: 500; padding: 2px 7px; border-radius: 4px; background: var(--surface); color: var(--muted); border: 1px solid var(--border); }
    .err-view-toggle { display: flex; gap: 4px; margin-top: 7px; }
    .ev-btn { padding: 3px 8px; border: 1px solid var(--border); border-radius: 5px; font-family: inherit; font-size: 10px; font-weight: 500; color: var(--muted); cursor: pointer; background: transparent; transition: all 0.15s; }
    .ev-btn.active { background: var(--surface); color: var(--text2); border-color: var(--border2); }
    .err-actions { display: flex; flex-direction: column; gap: 4px; flex-shrink: 0; }
    .btn-retry   { padding: 6px 11px; background: var(--surface); border: 1px solid var(--border); border-radius: 7px; font-family: inherit; font-size: 11px; font-weight: 500; color: var(--text2); cursor: pointer; transition: all 0.15s; white-space: nowrap; }
    .btn-retry:hover { border-color: var(--brand); color: var(--brand); }
    .btn-dismiss { padding: 6px 11px; background: transparent; border: 1px solid transparent; border-radius: 7px; font-family: inherit; font-size: 11px; color: var(--muted); cursor: pointer; transition: all 0.15s; }
    .btn-dismiss:hover { background: var(--red-dim); color: var(--red); }
    .no-err { display: flex; justify-content: center; padding: 16px; }
    .no-err-badge { display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; background: var(--sage-dim); border: 1px solid var(--sage-border); border-radius: 20px; font-size: 11px; font-weight: 500; color: var(--sage-dark); }

    /* ── Access log ── */
    .log-row { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border); transition: background 0.1s; }
    .log-row:last-child { border-bottom: none; }
    .log-row:hover { background: var(--surface); }
    .log-av { width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 700; flex-shrink: 0; }
    .log-av.grant  { background: var(--sage-dim);  color: var(--sage-dark); }
    .log-av.revoke { background: var(--red-dim);   color: var(--red); }
    .log-av.prov   { background: var(--brand-dim); color: var(--brand); }
    .log-info   { flex: 1; min-width: 0; }
    .log-name   { font-size: 12px; font-weight: 500; color: var(--text); }
    .log-detail { font-size: 10px; color: var(--muted); margin-top: 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .log-right  { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; flex-shrink: 0; }
    .log-badge  { font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 20px; white-space: nowrap; }
    .log-badge.grant  { background: var(--sage-dim);  color: var(--sage-dark); }
    .log-badge.revoke { background: var(--red-dim);   color: var(--red); }
    .log-badge.prov   { background: var(--brand-dim); color: var(--brand); }
    .log-time { font-size: 10px; color: var(--muted); }

    /* ── Access today bar ── */
    .access-today-bar { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--border); background: var(--surface); font-size: 11px; font-weight: 600; color: var(--text2); }

    /* ── Plan mapping ── */
    .map-row { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; border-bottom: 1px solid var(--border); transition: background 0.1s; }
    .map-row:hover { background: var(--surface); }
    .map-row:last-of-type { border-bottom: none; }
    .map-plan   { font-size: 12px; font-weight: 500; color: var(--text); }
    .map-detail { font-size: 10px; color: var(--muted); margin-top: 1px; }
    .map-right  { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .map-arrow  { font-size: 10px; color: var(--muted); }
    .map-door   { font-size: 11px; font-weight: 500; color: var(--text2); }
    .mbadge { font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 20px; }
    .mbadge.active { background: var(--sage-dim); color: var(--sage-dark); }
    .mbadge.excl   { background: var(--surface);  color: var(--muted); border: 1px solid var(--border); }

    /* ── Nudge bar ── */
    .nudge { display: flex; align-items: flex-start; gap: 9px; padding: 11px 16px; background: var(--amber-dim); border-top: 1px solid rgba(245,166,35,0.15); border-bottom: 1px solid var(--border); }
    .nudge-text { font-size: 11px; color: var(--amber); flex: 1; line-height: 1.55; }
    .nudge-text strong { font-weight: 600; }
    .btn-nudge { padding: 5px 10px; background: transparent; border: 1px solid rgba(245,166,35,0.35); border-radius: 6px; font-family: inherit; font-size: 10px; font-weight: 600; color: var(--amber); cursor: pointer; white-space: nowrap; flex-shrink: 0; transition: all 0.15s; }
    .btn-nudge:hover { background: var(--amber-dim); }

    /* ── Configured by ── */
    .configured-by { display: flex; align-items: center; gap: 6px; padding: 9px 16px; background: var(--surface); border-bottom: 1px solid var(--border); font-size: 10px; color: var(--muted); }
    .configured-by span { color: var(--text2); font-weight: 500; }

    /* ── Member sync visual ── */
    .member-sync-container { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--border); }
    .member-sync-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; font-size: 10px; color: var(--muted); }
    .sync-bar-row { display: flex; align-items: center; gap: 10px; }
    .sync-bar-platform { width: 36px; font-size: 10px; font-weight: 600; color: var(--text2); flex-shrink: 0; }
    .sync-bar-track { flex: 1; height: 7px; background: var(--border); border-radius: 4px; overflow: hidden; }
    .sync-bar-fill { height: 100%; border-radius: 4px; transition: width 0.6s ease; }
    .sync-bar-fill.wix  { background: var(--sage-dark); }
    .sync-bar-fill.kisi { background: var(--brand); }
    .sync-bar-count { width: 28px; text-align: right; font-size: 14px; font-weight: 700; flex-shrink: 0; }
    .sync-bar-count.sage  { color: var(--sage-dark); }
    .sync-bar-count.brand { color: var(--brand); }
    .sync-bar-label { width: 70px; font-size: 10px; color: var(--muted); flex-shrink: 0; }
    .member-sync-gap { display: flex; align-items: flex-start; gap: 7px; padding: 8px 10px; background: var(--amber-dim); border-radius: 8px; border: 1px solid rgba(245,166,35,0.15); }
    .member-sync-gap-text { font-size: 10px; color: var(--amber); line-height: 1.5; }
    .member-sync-gap-text strong { font-weight: 600; }

    /* ── Location footer ── */
    .loc-footer { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: var(--surface); border-top: 1px solid var(--border); gap: 8px; }
    .loc-footer-text { font-size: 11px; color: var(--muted); display: flex; align-items: center; gap: 5px; flex: 1; min-width: 0; }
    .sync-btn { padding: 6px 13px; background: transparent; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 11px; font-weight: 500; color: var(--text2); cursor: pointer; transition: all 0.15s; white-space: nowrap; flex-shrink: 0; }
    .sync-btn:hover { border-color: var(--brand); color: var(--brand); }
    .sync-btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .sync-btn.syncing { color: var(--brand); border-color: var(--brand); background: var(--brand-dim); }

    /* ── Member sync comparison (full-width) ── */
    .sync-compare { background: var(--card); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); }
    .sync-compare-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: var(--surface); border-bottom: 1px solid var(--border); }
    .sync-compare-title { font-size: 12px; font-weight: 600; color: var(--text2); display: flex; align-items: center; gap: 7px; }
    .sync-compare-ts    { font-size: 10px; color: var(--muted); }
    .sync-row { display: flex; align-items: center; gap: 0; padding: 14px 16px; border-bottom: 1px solid var(--border); }
    .sync-row:last-child { border-bottom: none; }
    .sync-platform { width: 90px; flex-shrink: 0; display: flex; align-items: center; gap: 7px; }
    .sync-platform-icon { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .sync-platform-icon.wix  { background: var(--sage-dim); }
    .sync-platform-icon.kisi { background: var(--brand-dim); }
    .sync-platform-name { font-size: 11px; font-weight: 600; color: var(--text2); }
    .sync-platform-sub  { font-size: 9px; color: var(--muted); margin-top: 1px; }
    .sync-bar-wrap { flex: 1; margin: 0 14px; }
    .sync-bar-track-full { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; position: relative; }
    .sync-bar-fill-full { height: 100%; border-radius: 4px; transition: width 0.6s ease; }
    .sync-bar-fill-full.wix { background: var(--sage-dark); }
    .sync-bar-fill-full.kisi-synced { background: var(--brand); }
    .sync-bar-label { font-size: 9px; color: var(--muted); margin-top: 4px; display: flex; justify-content: space-between; }
    .sync-count { width: 80px; flex-shrink: 0; text-align: right; }
    .sync-count-n { font-size: 18px; font-weight: 700; letter-spacing: -0.4px; line-height: 1; }
    .sync-count-n.sage  { color: var(--sage-dark); }
    .sync-count-n.brand { color: var(--brand); }
    .sync-count-n.muted { color: var(--muted); font-size: 14px; }
    .sync-count-l { font-size: 9px; color: var(--muted); margin-top: 2px; text-align: right; }
    .sync-status { display: flex; align-items: center; gap: 5px; padding: 10px 16px; background: var(--surface); border-top: 1px solid var(--border); font-size: 11px; }
    .sync-status.ok   { color: var(--sage-dark); }
    .sync-status.warn { color: var(--amber); }
    .sync-status.gap  { color: var(--muted); }
    .unmanaged-note { display: flex; align-items: center; gap: 8px; padding: 9px 16px; background: var(--surface); border-top: 1px solid var(--border); font-size: 11px; color: var(--muted); }
    .unmanaged-note strong { color: var(--text2); font-weight: 500; }

    /* OB-26: Kisi key CTA banner */
    .key-cta {
      display: flex; align-items: center; gap: 12px;
      padding: 14px 16px; border-radius: 12px;
      background: var(--amber-dim); border: 1px solid rgba(245,166,35,0.3);
      color: var(--text); font-size: 12px; line-height: 1.5;
    }
    .key-cta-icon { flex-shrink: 0; width: 32px; height: 32px; border-radius: 8px;
      background: rgba(245,166,35,0.15); display: flex; align-items: center; justify-content: center; }
    .key-cta-text { flex: 1; }
    .key-cta-text strong { font-weight: 600; }
    .key-cta-link {
      flex-shrink: 0; padding: 7px 14px; border-radius: 8px; border: none;
      font-family: inherit; font-size: 11px; font-weight: 600;
      background: var(--amber); color: #fff; cursor: pointer;
      text-decoration: none; white-space: nowrap;
    }
    .key-cta-link:hover { opacity: 0.85; }

    @keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }

    @media (min-width: 640px) {
      .page { padding: 24px 24px 60px; }
      .platform-row { flex-direction: row; }
      .platform-chip { flex: 1; }
      .stats-grid { grid-template-columns: repeat(4,1fr); }
    }
    @media (min-width: 900px) {
      .page { padding: 28px 32px 60px; }
    }
  </style>
</head>
<body data-session-role="<%= sessionRole %>"<% if (loginUrl) { %> data-login-url="<%= loginUrl %>"<% } %>>
  <%- include('../partials/topbar') %>
  <%- include('../partials/subnav', { activeTab: activeTab }) %>

  <div class="page">

    <!-- Client header -->
    <div class="client-card">
      <div>
        <div class="client-name" id="client-name-text">—</div>
        <div class="client-sub" id="client-sub-text">Loading…</div>
      </div>
    </div>

    <!-- Platform connections -->
    <div>
      <div class="section-label">Platform Connections
        <button class="sync-btn" id="sync-all" onclick="syncNow('sync-all','sync-all-label')" style="font-size:11px;padding:4px 11px;margin-left:auto;">
          <span id="sync-all-label" style="display:flex;align-items:center;gap:5px;">
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M10 6A4 4 0 112 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sync all
          </span>
        </button>
      </div>
      <div class="platform-row">
        <div class="platform-chip">
          <div class="platform-icon wix">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="2.5" stroke="var(--sage-dark)" stroke-width="1.3"/><path d="M5 8.5l2-4 1.5 3 1-2 1.5 3" stroke="var(--sage-dark)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <div style="flex:1;min-width:0;">
            <div class="platform-name">Wix</div>
            <div class="platform-detail" id="wix-platform-detail">—</div>
          </div>
          <span class="pill sage"><span class="pdot pulse"></span>Live</span>
          <button class="sync-btn" id="sync-wix" onclick="syncNow('sync-wix','sync-wix-label')" style="font-size:11px;padding:5px 11px;">
            <span id="sync-wix-label">Sync</span>
          </button>
        </div>
        <div class="platform-chip">
          <div class="platform-icon kisi">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="8" width="10" height="7" rx="1.5" stroke="var(--brand)" stroke-width="1.3"/><path d="M5.5 8V6a2.5 2.5 0 015 0v2" stroke="var(--brand)" stroke-width="1.3" stroke-linecap="round" fill="none"/><circle cx="8" cy="11.5" r="1" fill="var(--brand)"/></svg>
          </div>
          <div style="flex:1;min-width:0;">
            <div class="platform-name">Kisi</div>
            <div class="platform-detail" id="hardware-platform-detail">—</div>
          </div>
          <span class="pill sage"><span class="pdot pulse"></span>Live</span>
          <button class="sync-btn" id="sync-kisi" onclick="syncNow('sync-kisi','sync-kisi-label')" style="font-size:11px;padding:5px 11px;">
            <span id="sync-kisi-label">Sync</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Overview stats -->
    <div>
      <div class="section-label">Overview — All Locations</div>
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-delta neutral" id="stat-locations-delta">—</div>
          <div class="stat-n sage" id="stat-active-n">—</div>
          <div class="stat-l">Active Members</div>
        </div>
        <div class="stat-card">
          <div class="stat-delta neutral" title="Syncs automatically on every Wix event. Manual sync available above.">Auto-sync ⓘ</div>
          <div class="stat-n sm" id="stat-sync-n">—</div>
          <div class="stat-l">Last Sync</div>
        </div>
        <div class="stat-card" id="error-stat-card" style="cursor:pointer;" onclick="var cid=new URLSearchParams(window.location.search).get('clientId'); if(cid) window.location.href='/access?clientId='+cid+'&filter=error';">
          <div class="stat-delta warn" id="error-stat-delta">—</div>
          <div class="stat-n red" id="top-err-n">—</div>
          <div class="stat-l">Errors</div>
        </div>
        <div class="stat-card">
          <div class="stat-delta neutral" id="stat-synced-delta">—</div>
          <div class="stat-n brand" id="stat-synced-n">—</div>
          <div class="stat-l">Synced / Total</div>
        </div>
      </div>

      <!-- Provisioning latency card -->
      <div class="stat-card" id="latency-card" style="margin-top:10px;display:none;">
        <div class="stat-delta neutral" id="latency-delta">Last 30 days</div>
        <div style="display:flex;gap:16px;align-items:baseline;flex-wrap:wrap;">
          <div>
            <div class="stat-n sm" id="latency-median">—</div>
            <div class="stat-l">Median</div>
          </div>
          <div>
            <div class="stat-n sm" id="latency-p95" style="color:var(--muted);">—</div>
            <div class="stat-l">p95</div>
          </div>
          <div>
            <div class="stat-n sm" id="latency-max" style="color:var(--muted);">—</div>
            <div class="stat-l">Worst</div>
          </div>
        </div>
        <div class="stat-l" style="margin-top:6px;">Purchase → Door Open</div>
        <div style="margin-top:8px;font-size:11px;color:var(--muted);" id="latency-breakdown"></div>
      </div>

      <!-- Member sync comparison — rendered from live data by loadLiveData() -->
      <div class="sync-compare" style="margin-top:12px;" id="sync-compare-block">
        <div class="sync-compare-header">
          <span class="sync-compare-title">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M9 4l3 3-3 3M5 10L2 7l3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Member Sync — All Locations
          </span>
          <span class="sync-compare-ts" id="sync-compare-ts">—</span>
        </div>
        <div id="sync-compare-rows">
          <div style="padding:16px;color:var(--muted);font-size:12px;">Loading sync data…</div>
        </div>
      </div>
    </div>

    <!-- Location cards -->
    <div>
      <div class="locations-header">
        <div class="locations-label">Locations <span class="count muted">—</span></div>
        <span class="locations-hint">Tap to expand</span>
      </div>

      <div class="locations-stack" id="location-section">
        <!-- Populated dynamically from API -->
      </div>
    </div>

  </div>

  <script src="/operator-nav.js"></script>
  <script>
    // ── Shared helpers ──
    function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    // ── Error translation — code-first lookup, regex fallback for legacy rows ──
    var _clientId = new URLSearchParams(window.location.search).get('clientId') || '';
    var ERROR_MAP = {
      'HARDWARE_KEY_INVALID':        { message: "Your door system rejected the API key — it may have been rotated or revoked since you connected it.", action: 'Update API key', href: '/locations?clientId=' + _clientId },
      'HARDWARE_KEY_PERMISSIONS':    { message: "Your API key connected, but it doesn't have permission to manage users. This usually means the key needs a higher access level.", action: 'Check key permissions', href: '/locations?clientId=' + _clientId },
      'HARDWARE_KEY_MISSING':        { message: "There's no API key connected for this location yet, so AccessSync can't provision access.", action: 'Add your API key', href: '/locations?clientId=' + _clientId },
      'HARDWARE_RESOURCE_NOT_FOUND': { message: "The door group assigned to this plan no longer exists — it may have been deleted or renamed in your door system.", action: 'Re-map this plan', href: '/plan-mapping?clientId=' + _clientId },
      'HARDWARE_VALIDATION_ERROR':   { message: "The door system rejected this request — the member data or group assignment may be invalid.", action: 'Retry', href: null },
      'HARDWARE_API_ERROR':          { message: "The door system returned an unexpected error. This is usually temporary.", action: 'Retry or contact support', href: null },
      'WIX_KEY_INVALID':             { message: "Your Wix API key was rejected — it may have expired or been revoked. You'll need to generate a new one.", action: 'Update Wix API key', href: '/dashboard?clientId=' + _clientId + '#config' },
      'WIX_KEY_MISSING':             { message: "No Wix API key is connected yet, so AccessSync can't read your plans.", action: 'Add Wix API key', href: '/dashboard?clientId=' + _clientId + '#config' },
      'WIX_KEY_PERMISSIONS':         { message: "Your Wix API key is connected but is missing the Pricing Plans or Bookings read permissions.", action: 'Update Wix API key', href: '/dashboard?clientId=' + _clientId + '#config' },
      'PLAN_NOT_MAPPED':             { message: "This member purchased a plan that hasn't been linked to a door group yet.", action: 'Map this plan', href: '/plan-mapping?clientId=' + _clientId },
      'SUBSCRIPTION_LAPSED':         { message: "This location's AccessSync subscription is inactive, so access provisioning is paused.", action: 'Reactivate location', href: '/locations?clientId=' + _clientId },
    };
    function translateError(errorCode, rawReason) {
      // Code-first: use structured error code if available
      if (errorCode && ERROR_MAP[errorCode]) return ERROR_MAP[errorCode];
      // Regex fallback for legacy error_queue rows without error_code
      var r = String(rawReason || '');
      if (/401|api key.*reject|invalid.*key/i.test(r))     return ERROR_MAP['HARDWARE_KEY_INVALID'];
      if (/403|suspended|downgrad/i.test(r))               return ERROR_MAP['HARDWARE_KEY_PERMISSIONS'];
      if (/429|rate.?limit/i.test(r))                      return { message: "The door system is rate-limiting requests right now — too many in a short window.", action: 'Retry in a few minutes', href: null };
      if (/5\d\d|server error/i.test(r))                   return { message: "The door system is having an issue on their end. AccessSync will keep retrying.", action: 'Retry — AccessSync will keep trying', href: null };
      if (/timeout|timed?\s*out/i.test(r))                 return { message: "The door system didn't respond in time. This is usually temporary.", action: 'Retry', href: null };
      if (/no.*mapping|plan.*not.*mapped|mapping.*not.*found/i.test(r)) return ERROR_MAP['PLAN_NOT_MAPPED'];
      if (/pending.?hardware/i.test(r))                    return ERROR_MAP['HARDWARE_KEY_MISSING'];
      if (/subscription.*lapsed|subscription.*inactive/i.test(r)) return ERROR_MAP['SUBSCRIPTION_LAPSED'];
      return { message: "Something went wrong while provisioning this member's access.", action: 'Retry or contact support', href: null };
    }

    // ── Location accordion ──
    var _locDetailLoaded = {}; // track which locations have loaded details

    function toggleLoc(id) {
      var body = document.getElementById('body-' + id);
      var chev = document.getElementById('chev-' + id);
      var trig = document.getElementById('trig-' + id);
      if (!body) return;
      var isOpen = body.classList.contains('open');
      body.classList.toggle('open', !isOpen);
      if (chev) chev.classList.toggle('open', !isOpen);
      if (trig) trig.classList.toggle('open', !isOpen);
      try { localStorage.setItem('loc-' + id, !isOpen ? '1' : '0'); } catch(e) {}
      // Load details on first expand
      if (!isOpen && !_locDetailLoaded[id]) {
        var locUuid = body.getAttribute('data-loc-uuid');
        if (locUuid) loadLocDetails(id, locUuid);
      }
    }

    // ── Location sub-section toggle ──
    function toggleLocSub(locId, section) {
      var body   = document.getElementById('sub-' + section + '-' + locId);
      if (!body) return;
      var header = body.previousElementSibling;
      var isOpen = body.classList.contains('open');
      body.classList.toggle('open', !isOpen);
      if (header) header.classList.toggle('open', !isOpen);
    }

    // ── Sync now ──
    function syncNow(btnId, labelId) {
      var btn = document.getElementById(btnId);
      var lbl = document.getElementById(labelId);
      if (!btn || btn.disabled) return;
      btn.disabled = true; btn.classList.add('syncing');
      var spinSvg = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none" style="animation:spin 0.8s linear infinite"><path d="M10 6A4 4 0 112 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      if (btnId === 'sync-all') {
        lbl.innerHTML = spinSvg + ' Syncing…';
        fetch('/operator/sync/run', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clientId: _clientId }) })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            btn.disabled = false; btn.classList.remove('syncing');
            var syncIcon = '<svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M10 6A4 4 0 112 6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
            var resultText = (data.granted || data.revoked)
              ? (data.granted || 0) + ' granted · ' + (data.revoked || 0) + ' revoked'
              : 'Up to date';
            lbl.innerHTML = '<span style="display:flex;align-items:center;gap:5px;">' + syncIcon + ' ' + resultText + '</span>';
            var syncTs = document.getElementById('sync-compare-ts');
            if (syncTs) syncTs.textContent = 'As of last sync · just now';
            showToast('success', 'Sync complete — ' + resultText);
            loadLiveData();
          })
          .catch(function() {
            btn.disabled = false; btn.classList.remove('syncing');
            lbl.innerHTML = 'Sync failed';
            showToast('error', 'Sync failed — check logs');
          });
        return;
      } else {
        lbl.innerHTML = '<span style="display:flex;align-items:center;gap:5px;">' + spinSvg + ' Syncing…</span>';
        fetch('/operator/sync/run', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ clientId: _clientId }) })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            btn.disabled = false; btn.classList.remove('syncing');
            var isShort = btnId === 'sync-wix' || btnId === 'sync-kisi';
            lbl.textContent = isShort ? 'Sync' : 'Sync now';
            var resultText = (data.granted || data.revoked)
              ? (data.granted || 0) + ' granted · ' + (data.revoked || 0) + ' revoked'
              : 'Up to date';
            showToast('success', 'Sync complete — ' + resultText);
            var syncLabel = document.getElementById('sync-label');
            if (syncLabel) syncLabel.textContent = 'Just now';
            var syncTs = document.getElementById('sync-compare-ts');
            if (syncTs) syncTs.textContent = 'As of last sync · just now';
            loadLiveData();
          })
          .catch(function() {
            btn.disabled = false; btn.classList.remove('syncing');
            lbl.textContent = 'Sync failed';
            showToast('error', 'Sync failed — check logs');
          });
        return;
      }
    }

    // ── Load location detail sub-sections ──
    function loadLocDetails(locId, locationUuid) {
      var clientId = new URLSearchParams(window.location.search).get('clientId');
      if (!clientId) return;
      _locDetailLoaded[locId] = true;
      var body = document.getElementById('body-' + locId);
      if (!body) return;

      apiFetch('/operator/' + clientId + '/locations/' + locationUuid)
        .then(function(r) { return r.json(); })
        .then(function(d) {
          var statusMap = { active: 'sage', pending: 'amber', pending_hardware: 'amber', failed: 'red', suspended: 'muted' };
          var labelMap = { active: 'Active', pending: 'Processing', pending_hardware: 'Needs Setup', failed: 'Action Needed', suspended: 'Paused' };
          var html = '';

          // ── Active Members sub-section ──
          var members = d.active_members || [];
          html += '<div class="loc-sub-header" onclick="toggleLocSub(\'' + locId + '\', \'members\')">' +
            '<div class="loc-sub-title">' +
              '<svg class="loc-sub-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
              'Active Members <span class="loc-sub-count">' + members.length + '</span>' +
            '</div>' +
            '<div class="loc-sub-right">' +
              '<button class="link-btn" onclick="event.stopPropagation(); window.location.href=\'/members\'+window.location.search">View all &rarr;</button>' +
            '</div>' +
          '</div>';
          html += '<div class="loc-sub-body" id="sub-members-' + locId + '">';
          if (members.length) {
            html += members.map(function(m) {
              var dt = m.updated_at ? new Date(m.updated_at).toLocaleDateString('en-US', {month:'short',day:'numeric'}) : '';
              var color = statusMap[m.status] || 'muted';
              return '<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 16px;border-bottom:1px solid var(--border);">' +
                '<span style="font-size:12px;font-weight:500;color:var(--text);">' + esc(m.member_name || m.platform_member_id) + '</span>' +
                '<div style="display:flex;align-items:center;gap:8px;">' +
                  '<span style="font-size:11px;color:var(--' + color + ');">' + (labelMap[m.status] || m.status) + '</span>' +
                  '<span style="font-size:11px;color:var(--muted);">' + dt + '</span>' +
                '</div></div>';
            }).join('');
          } else {
            html += '<div style="padding:14px 16px;font-size:12px;color:var(--muted);">No members at this location yet.</div>';
          }
          html += '</div>';

          // ── Plan Mapping sub-section ──
          var mappings = d.plan_mappings || [];
          var activeMappings = mappings.filter(function(m) { return m.status === 'active'; });
          html += '<div class="loc-sub-header" onclick="toggleLocSub(\'' + locId + '\', \'mapping\')">' +
            '<div class="loc-sub-title">' +
              '<svg class="loc-sub-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
              'Plan Mapping <span class="loc-sub-count">' + activeMappings.length + '</span>' +
            '</div>' +
            '<div class="loc-sub-right">' +
              '<button class="link-btn" onclick="event.stopPropagation(); window.location.href=\'/plan-mapping\'+window.location.search">Edit &rarr;</button>' +
            '</div>' +
          '</div>';
          html += '<div class="loc-sub-body" id="sub-mapping-' + locId + '">';
          if (mappings.length) {
            html += mappings.map(function(pm) {
              var isExcluded = pm.status === 'excluded';
              return '<div class="map-row"' + (isExcluded ? ' style="opacity:0.5;"' : '') + '>' +
                '<div><div class="map-plan">' + esc(pm.plan_name || pm.source_plan_id) + '</div></div>' +
                '<div class="map-right">' +
                  (isExcluded
                    ? '<span class="mbadge excl">Not managed</span>'
                    : '<span class="map-arrow">&rarr;</span><span class="map-door">' + esc(pm.door_name || pm.hardware_group_id || 'Unassigned') + '</span><span class="mbadge active">Active</span>') +
                '</div></div>';
            }).join('');
          } else {
            html += '<div style="padding:14px 16px;font-size:12px;color:var(--muted);">No plan mappings configured.</div>';
          }
          html += '</div>';

          // ── Recent Access sub-section ──
          var logs = d.access_log || [];
          html += '<div class="loc-sub-header" onclick="toggleLocSub(\'' + locId + '\', \'access\')">' +
            '<div class="loc-sub-title">' +
              '<svg class="loc-sub-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
              'Recent Access' +
            '</div>' +
            '<div class="loc-sub-right">' +
              '<button class="link-btn" onclick="event.stopPropagation(); window.location.href=\'/access\'+window.location.search">See Details &rarr;</button>' +
            '</div>' +
          '</div>';
          html += '<div class="loc-sub-body" id="sub-access-' + locId + '">';
          if (logs.length) {
            var evtClass = { provisioned: 'prov', provisioning_started: 'prov', provisioning_failed: 'revoke', revoked: 'revoke', disabled: 'revoke', restored: 'grant' };
            var evtLabel = { provisioned: 'Provisioned', provisioning_started: 'Started', provisioning_failed: 'Failed', revoked: 'Revoked', disabled: 'Disabled', restored: 'Restored' };
            html += logs.map(function(l) {
              var cls = evtClass[l.event_type] || 'grant';
              var label = evtLabel[l.event_type] || l.event_type;
              var initials = (l.platform_member_id || '??').split('-').map(function(w) { return w.charAt(0).toUpperCase(); }).slice(0,2).join('');
              var ago = l.created_at ? timeAgo(new Date(l.created_at)) : '';
              return '<div class="log-row">' +
                '<div class="log-av ' + cls + '">' + initials + '</div>' +
                '<div class="log-info"><div class="log-name">' + esc(l.platform_member_id) + '</div>' +
                  '<div class="log-detail">' + esc(l.event_type) + (l.credential_type ? ' · ' + esc(l.credential_type) : '') + '</div></div>' +
                '<div class="log-right"><span class="log-badge ' + cls + '">' + label + '</span><span class="log-time">' + ago + '</span></div>' +
              '</div>';
            }).join('');
          } else {
            html += '<div style="padding:14px 16px;font-size:12px;color:var(--muted);">No access events yet.</div>';
          }
          html += '</div>';

          // ── Errors summary — links to /errors page ──
          var errors = d.errors || [];
          var errCount = errors.length;
          html += '<div style="display:flex;align-items:center;justify-content:space-between;' +
            'padding:12px 16px;border-top:1px solid var(--border);background:var(--surface);">' +
            '<div style="display:flex;align-items:center;gap:8px;">' +
              (errCount > 0
                ? '<span class="count" style="background:var(--red,#ef4444);color:#fff;">' + errCount + '</span>' +
                  '<span style="font-size:12px;color:var(--text2);">active error' + (errCount === 1 ? '' : 's') + '</span>'
                : '<span class="no-err-badge">' +
                    '<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="var(--sage-dark)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
                    'All clear' +
                  '</span>') +
            '</div>' +
            (errCount > 0
              ? '<a href="/errors' + window.location.search + '" ' +
                  'style="font-size:11px;font-weight:600;color:var(--brand);text-decoration:none;">' +
                  'View errors →</a>'
              : '') +
          '</div>';

          // ── Footer ──
          html += '<div class="loc-footer">' +
            '<div class="loc-footer-text">' +
              '<svg width="11" height="11" viewBox="0 0 12 12" fill="none"><path d="M10 6A4 4 0 112 6" stroke="var(--sage-dark)" stroke-width="1.2" stroke-linecap="round"/><path d="M10 3v3h-3" stroke="var(--sage-dark)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
              'Auto-sync 3:00 AM' +
            '</div>' +
            '<button class="sync-btn" id="sync-loc-' + locId + '" onclick="syncNow(\'sync-loc-' + locId + '\',\'sync-loc-' + locId + '-label\')">' +
              '<span id="sync-loc-' + locId + '-label">Sync now</span>' +
            '</button>' +
          '</div>';

          body.innerHTML = html;
        }).catch(function(e) {
          console.error('Location detail load error:', e);
          body.innerHTML = '<div style="padding:16px;color:var(--red);font-size:12px;">Failed to load details.</div>';
        });
    }

    // ── Time ago helper ──
    function timeAgo(date) {
      var secs = Math.floor((Date.now() - date.getTime()) / 1000);
      if (secs < 60) return 'just now';
      var mins = Math.floor(secs / 60);
      if (mins < 60) return mins + ' min ago';
      var hrs = Math.floor(mins / 60);
      if (hrs < 24) return hrs + ' hr' + (hrs > 1 ? 's' : '') + ' ago';
      var days = Math.floor(hrs / 24);
      return days + ' day' + (days > 1 ? 's' : '') + ' ago';
    }

    // ══ OB-29: Live data loading ══════════════════════════════════
    (function loadLiveData() {
      var clientId = new URLSearchParams(window.location.search).get('clientId');
      if (!clientId) {
        // No client selected — show empty state
        var nameEl = document.getElementById('client-name-text');
        var subEl  = document.getElementById('client-sub-text');
        if (nameEl) nameEl.textContent = 'No client selected';
        if (subEl)  subEl.textContent  = 'Select a client from the Admin Hub to view their dashboard.';
        ['stat-active-n','stat-sync-n','top-err-n','stat-synced-n'].forEach(function(id) {
          var el = document.getElementById(id); if (el) el.textContent = '—';
        });
        return;
      }

      // Fetch client overview
      apiFetch('/operator/' + clientId)
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.client) return;
          var c = d.client, s = d.stats;
          var nameEl = document.getElementById('client-name-text');
          if (nameEl) nameEl.textContent = c.name || 'Unnamed';
          document.getElementById('client-sub-text').textContent =
            [s.location_count + ' location' + (s.location_count !== 1 ? 's' : ''),
             c.tier ? c.tier + ' tier' : ''].filter(Boolean).join(' · ');
          // Update stats
          var errN = document.getElementById('top-err-n');
          if (errN) { errN.textContent = s.error_count; errN.className = s.error_count > 0 ? 'stat-n red' : 'stat-n sage'; }
          var errDelta = document.getElementById('error-stat-delta');
          if (errDelta) { errDelta.textContent = s.error_count > 0 ? 'Needs attention' : 'All clear'; errDelta.className = s.error_count > 0 ? 'stat-delta warn' : 'stat-delta up'; }
          // Active members
          var activeN = document.getElementById('stat-active-n');
          if (activeN) activeN.textContent = s.active_members || 0;
          var locationsDelta = document.getElementById('stat-locations-delta');
          if (locationsDelta) locationsDelta.textContent = s.location_count + ' location' + (s.location_count !== 1 ? 's' : '');
          // Synced / total
          var syncedN = document.getElementById('stat-synced-n');
          if (syncedN) syncedN.textContent = (s.active_members || 0) + ' / ' + (s.total_members || 0);
          var syncedDelta = document.getElementById('stat-synced-delta');
          var gap = (s.total_members || 0) - (s.active_members || 0);
          if (syncedDelta) { syncedDelta.textContent = gap > 0 ? gap + ' pending' : 'All synced'; syncedDelta.className = gap > 0 ? 'stat-delta warn' : 'stat-delta up'; }
          // Last sync
          var syncN = document.getElementById('stat-sync-n');
          if (syncN && c.last_sync_at) {
            syncN.textContent = new Date(c.last_sync_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
          } else if (syncN) { syncN.textContent = 'Never'; }
          // Update platform details from live client data
          var wixDetail = document.getElementById('wix-platform-detail');
          if (wixDetail) wixDetail.textContent = c.source_site_url ? c.source_site_url.replace(/^https?:\/\//, '') + ' · Webhooks active' : 'Webhooks active';
          var hwDetail = document.getElementById('hardware-platform-detail');
          if (hwDetail) {
            var hwParts = [];
            if (s.location_count) hwParts.push(s.location_count + ' location' + (s.location_count !== 1 ? 's' : ''));
            if (c.tier) hwParts.push(c.tier + ' tier');
            hwDetail.textContent = hwParts.length ? hwParts.join(' · ') : '—';
          }
          // Populate PLATFORM_CONFIG for operator-nav platform name display
          if (c.hardware_platform && typeof PLATFORM_CONFIG !== 'undefined') {
            PLATFORM_CONFIG.name = c.hardware_platform.charAt(0).toUpperCase() + c.hardware_platform.slice(1);
          }
          // Render sync-compare block from live data
          (function renderSyncCompare() {
            var tsEl = document.getElementById('sync-compare-ts');
            if (tsEl) tsEl.textContent = c.last_sync_at ? 'As of last sync · ' + fmt(c.last_sync_at) : 'Not yet synced';
            var rows = document.getElementById('sync-compare-rows');
            if (!rows) return;
            var hwName = c.hardware_platform ? (c.hardware_platform.charAt(0).toUpperCase() + c.hardware_platform.slice(1)) : 'Hardware';
            var wixTotal = s.total_members || 0;
            var synced   = s.active_members || 0;
            var unmanaged = s.unmanaged_count || 0;
            var pending  = s.pending_members || 0;
            var syncedPct = wixTotal > 0 ? Math.round((synced / wixTotal) * 100) : 0;
            var html = '';
            // Wix row
            html += '<div class="sync-row">' +
              '<div class="sync-platform"><div class="sync-platform-icon wix">' +
              '<svg width="13" height="13" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="12" height="12" rx="2.5" stroke="var(--sage-dark)" stroke-width="1.3"/><path d="M5 8.5l2-4 1.5 3 1-2 1.5 3" stroke="var(--sage-dark)" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
              '</div><div><div class="sync-platform-name">Wix</div><div class="sync-platform-sub">Source of truth</div></div></div>' +
              '<div class="sync-bar-wrap"><div class="sync-bar-track-full"><div class="sync-bar-fill-full wix" style="width:' + (wixTotal > 0 ? '100' : '0') + '%;"></div></div>' +
              '<div class="sync-bar-label"><span>Active plan members</span><span>' + wixTotal + ' total</span></div></div>' +
              '<div class="sync-count"><div class="sync-count-n sage">' + wixTotal + '</div><div class="sync-count-l">Active plans</div></div>' +
              '</div>';
            // Hardware row
            html += '<div class="sync-row">' +
              '<div class="sync-platform"><div class="sync-platform-icon kisi">' +
              '<svg width="13" height="13" viewBox="0 0 16 16" fill="none"><rect x="3" y="8" width="10" height="7" rx="1.5" stroke="var(--brand)" stroke-width="1.3"/><path d="M5.5 8V6a2.5 2.5 0 015 0v2" stroke="var(--brand)" stroke-width="1.3" stroke-linecap="round" fill="none"/><circle cx="8" cy="11.5" r="1" fill="var(--brand)"/></svg>' +
              '</div><div><div class="sync-platform-name">' + hwName + '</div><div class="sync-platform-sub">Destination</div></div></div>' +
              '<div class="sync-bar-wrap"><div class="sync-bar-track-full"><div class="sync-bar-fill-full kisi-synced" style="width:' + syncedPct + '%;"></div></div>' +
              '<div class="sync-bar-label"><span style="color:var(--brand);font-weight:600;">' + synced + ' AccessSync-managed</span>' +
              (unmanaged > 0 ? '<span>+ ' + unmanaged + ' not managed</span>' : '') + '</div></div>' +
              '<div class="sync-count"><div class="sync-count-n brand">' + synced + '</div><div class="sync-count-l">AccessSync</div></div>' +
              '</div>';
            // Pending warning
            if (pending > 0) {
              html += '<div class="sync-status warn">' +
                '<svg width="13" height="13" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.3"/><path d="M7 4v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="7" cy="9.5" r="0.7" fill="currentColor"/></svg>' +
                pending + ' member' + (pending !== 1 ? 's' : '') + ' pending — provisioning incomplete. <a href="/members?clientId=' + clientId + '&filter=pending" style="color:inherit;text-decoration:underline;">View in Members</a>' +
                '</div>';
            }
            // Unmanaged note
            if (unmanaged > 0) {
              html += '<div class="unmanaged-note">' +
                '<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="4.5" r="2" stroke="currentColor" stroke-width="1.2"/><path d="M1 10c0-2 2-3 5-3s5 1 5 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>' +
                '<span><strong>' + unmanaged + ' ' + hwName + ' user' + (unmanaged !== 1 ? 's' : '') + '</strong> are not managed by AccessSync (staff, contractors, or visitors) and are excluded from sync counts.</span>' +
                '</div>';
            }
            rows.innerHTML = html;
          })();
          // Sync label
          var syncLabel = document.getElementById('sync-label');
          if (syncLabel && c.last_sync_at) {
            syncLabel.textContent = new Date(c.last_sync_at).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
          }
          // Wix-first flow: show pending_hardware banner if members are waiting
          if (s.pending_hardware > 0) {
            var platformRow = document.querySelector('.platform-row');
            if (platformRow) {
              var pending = document.createElement('div');
              pending.className = 'key-cta';
              pending.style.borderLeftColor = '#F5A623';
              pending.innerHTML =
                '<div class="key-cta-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7" stroke="#F5A623" stroke-width="1.3" fill="none"/><path d="M9 5.5v4M9 12v.5" stroke="#F5A623" stroke-width="1.5" stroke-linecap="round"/></svg></div>' +
                '<div class="key-cta-text"><strong>' + s.pending_hardware + ' member' + (s.pending_hardware !== 1 ? 's are' : ' is') + ' waiting for door access.</strong> ' +
                (d.client.hardware_api_key ? 'Assign a door group to their plan so AccessSync can provision them.' : 'Add your API key so AccessSync can start provisioning.') + '</div>' +
                '<a class="key-cta-link" href="/' + (d.client.hardware_api_key ? 'plan-mapping' : 'locations') + '?clientId=' + clientId + '">' +
                (d.client.hardware_api_key ? 'Map Plans' : 'Add Key') + '</a>';
              platformRow.parentNode.insertBefore(pending, platformRow.nextSibling);
            }
          }
          // Phase 3A: Setup checklist when no data yet
          if (s.member_count === 0 && s.location_count === 0) {
            var statsGrid = document.querySelector('.stats-grid');
            if (statsGrid) {
              var checklist = document.createElement('div');
              checklist.className = 'card';
              checklist.style.cssText = 'margin-top:16px;padding:20px;';
              checklist.innerHTML =
                '<h3 style="margin:0 0 12px;font-size:15px;font-weight:600;">Finish your setup</h3>' +
                '<p style="margin:0 0 16px;font-size:13px;color:var(--muted);">Two things left before members get door access automatically.</p>' +
                '<div style="display:flex;flex-direction:column;gap:8px;">' +
                  '<a href="/locations?clientId=' + clientId + '" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:8px;background:var(--surface-alt,#f8f8f8);text-decoration:none;color:var(--text);font-size:13px;">' +
                    '<span style="width:22px;height:22px;border-radius:50%;border:2px solid var(--brand);display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;">1</span>' +
                    '<span><strong>Add your API key</strong> — so AccessSync can talk to your door system</span></a>' +
                  '<a href="/plan-mapping?clientId=' + clientId + '" style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:8px;background:var(--surface-alt,#f8f8f8);text-decoration:none;color:var(--text);font-size:13px;">' +
                    '<span style="width:22px;height:22px;border-radius:50%;border:2px solid var(--brand);display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;">2</span>' +
                    '<span><strong>Map your plans</strong> — tell AccessSync which plan unlocks which door</span></a>' +
                  '<div style="display:flex;align-items:center;gap:10px;padding:10px 14px;border-radius:8px;background:var(--surface-alt,#f8f8f8);font-size:13px;color:var(--muted);">' +
                    '<span style="width:22px;height:22px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;">3</span>' +
                    '<span><strong>Members auto-sync</strong> — purchases trigger access automatically</span></div>' +
                '</div>';
              statsGrid.parentNode.insertBefore(checklist, statsGrid.nextSibling);
            }
          }
        }).catch(function(e) { console.error('Dashboard load error:', e); });

      // OB-26: Check API key status — show CTA banner if missing
      apiFetch('/operator/clients/' + clientId + '/api-key/status')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (d.hasKey) return;
          var platformRow = document.querySelector('.platform-row');
          if (!platformRow) return;
          var cta = document.createElement('div');
          cta.className = 'key-cta';
          cta.innerHTML =
            '<div class="key-cta-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M7.5 10.5a3 3 0 113-3" stroke="#F5A623" stroke-width="1.3" stroke-linecap="round"/><path d="M10.5 7.5h4.5v3h-1.5v1.5h-1.5v-1.5h-1.5z" stroke="#F5A623" stroke-width="1.3" stroke-linejoin="round" fill="none"/></svg></div>' +
            '<div class="key-cta-text"><strong>Add your API key</strong> to start granting door access. Without it, AccessSync can\'t provision members when they sign up.</div>' +
            '<a class="key-cta-link" href="/locations?clientId=' + clientId + '">Add Key</a>';
          platformRow.parentNode.insertBefore(cta, platformRow.nextSibling);
          var kisiPill = document.querySelectorAll('.platform-chip')[1];
          if (kisiPill) {
            var pill = kisiPill.querySelector('.pill');
            if (pill) { pill.className = 'pill amber'; pill.innerHTML = '<span class="pdot"></span>No Key'; }
          }
        }).catch(function() {});

      // Fetch provisioning latency stats
      apiFetch('/operator/' + clientId + '/latency-stats')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.sample_count) return;
          function fmtSec(s) {
            if (s == null) return '—';
            if (s < 60)   return s + 's';
            return Math.round(s / 60) + 'm ' + (s % 60) + 's';
          }
          var card = document.getElementById('latency-card');
          if (card) card.style.display = '';
          var med = document.getElementById('latency-median');
          var p95 = document.getElementById('latency-p95');
          var max = document.getElementById('latency-max');
          var brk = document.getElementById('latency-breakdown');
          if (med) { med.textContent = fmtSec(d.total_median_s); med.className = d.total_median_s <= 10 ? 'stat-n sm sage' : d.total_median_s <= 30 ? 'stat-n sm brand' : 'stat-n sm red'; }
          if (p95) p95.textContent = fmtSec(d.total_p95_s);
          if (max) max.textContent = fmtSec(d.total_max_s);
          if (brk) brk.textContent = 'Ingest: ' + fmtSec(d.ingest_median_s) + ' median  ·  Processing: ' + fmtSec(d.processing_median_s) + ' median  ·  ' + d.sample_count + ' events';
        }).catch(function() {});

      // Fetch locations and build accordion cards
      apiFetch('/operator/' + clientId + '/locations')
        .then(function(r) { return r.json(); })
        .then(function(d) {
          if (!d.locations || !d.locations.length) return;
          var container = document.getElementById('location-section');
          if (!container) return;

          // Update locations header count
          var countBadge = document.querySelector('.locations-label .count');
          if (countBadge) countBadge.textContent = d.locations.length;

          container.innerHTML = d.locations.map(function(loc, i) {
            var locId = 'loc-' + i;
            var hasErr = loc.error_count > 0;
            var isLapsed = loc.subscription_status === 'lapsed';
            var iconColor = hasErr ? 'var(--red)' : (isLapsed ? 'var(--amber)' : 'var(--sage-dark)');
            var borderColor = hasErr ? 'var(--red)' : (isLapsed ? 'var(--amber)' : 'var(--sage-dark)');
            var statusPill;
            if (hasErr) {
              statusPill = '<span class="pill red"><span class="pdot"></span>' + loc.error_count + ' error' + (loc.error_count > 1 ? 's' : '') + '</span>';
            } else if (loc.subscription_status === 'active') {
              statusPill = '<span class="pill sage"><span class="pdot pulse"></span>Active</span>';
            } else {
              statusPill = '<span class="pill amber"><span class="pdot"></span>' + esc(loc.subscription_status) + '</span>';
            }
            var meta = [esc(loc.city), esc(loc.state)].filter(Boolean).join(', ');
            if (loc.door_count) meta += (meta ? ' · ' : '') + loc.door_count + ' door' + (loc.door_count > 1 ? 's' : '');
            if (loc.tier && loc.hardware_platform) meta += (meta ? ' · ' : '') + esc(loc.hardware_platform) + ' ' + esc(loc.tier);

            return '<div class="loc-card' + (hasErr ? ' err' : '') + '" id="card-' + locId + '" style="border-left-color:' + borderColor + ';">' +
              '<div class="loc-trigger" id="trig-' + locId + '" onclick="toggleLoc(\'' + locId + '\')">' +
                '<div class="loc-icon" style="background:' + (hasErr ? 'var(--red-dim)' : (isLapsed ? 'var(--amber-dim)' : 'var(--sage-dim)')) + ';border-color:' + (hasErr ? 'rgba(255,77,106,0.2)' : (isLapsed ? 'rgba(245,166,35,0.2)' : 'var(--sage-border)')) + ';">' +
                  '<svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M9 1.5C6.5 1.5 4.5 3.5 4.5 6c0 3.75 4.5 10.5 4.5 10.5S13.5 9.75 13.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="' + iconColor + '" stroke-width="1.3" fill="none"/><circle cx="9" cy="6" r="1.5" fill="' + iconColor + '"/></svg>' +
                '</div>' +
                '<div class="loc-info">' +
                  '<div class="loc-name">' + esc(loc.name) + '</div>' +
                  '<div class="loc-meta">' + meta + '</div>' +
                '</div>' +
                '<div class="loc-trigger-right">' +
                  statusPill +
                  '<svg class="chevron" id="chev-' + locId + '" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
                '</div>' +
              '</div>' +
              '<div class="loc-body" id="body-' + locId + '" data-loc-uuid="' + loc.id + '">' +
                '<div style="padding:16px;color:var(--muted);font-size:12px;">Expand to load details...</div>' +
              '</div>' +
            '</div>';
          }).join('');

          // Restore saved accordion state
          d.locations.forEach(function(loc, i) {
            var locId = 'loc-' + i;
            try {
              if (localStorage.getItem('loc-' + locId) === '1') {
                toggleLoc(locId);
              }
            } catch(e) {}
          });
        }).catch(function(e) { console.error('Locations load error:', e); });
    })();
  </script>
</body>
</html>
