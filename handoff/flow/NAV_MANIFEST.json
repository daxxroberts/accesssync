  "entry_flows": {
    "operator_first_run": {
      "description": "New operator accessing from Wix Dashboard sidebar for the first time",
      "path": ["Wix Dashboard sidebar click", "GET /operator-portal?instance=X", "JWT issued", "setup check: no API key AND no locations", "S01_portal_setup", "S02_onboard", "S03_dashboard"]
    },
    "operator_returning": {
      "description": "Existing operator accessing from Wix Dashboard sidebar",
      "path": ["Wix Dashboard sidebar click", "GET /operator-portal?instance=X", "JWT issued", "setup check: has API key OR locations", "S03_dashboard"]
    },
    "operator_first_run_gap": {
      "description": "FUNNEL-G-15: Operator has API key but no locations (or vice versa) — goes to dashboard directly, bypasses setup",
      "path": ["GET /operator-portal?instance=X", "JWT issued", "setup check fails edge case", "S03_dashboard (no setup completed)"]
    },
    "member_post_purchase": {
      "description": "Gym member after buying plan on Wix — Wix sends them to sync status page",
      "path": ["Wix purchase confirmation", "Redirect to /sync-status?memberId=X&clientId=Y", "S13 polls /member/access-status", "Active state when provisioned"]
    },
    "platform_admin": {
      "description": "Daxx accessing Admin Hub",
      "path": ["Direct browser URL", "S14_admin_login", "Google OAuth", "S15_admin_hub"]
    }
  },
  "auth_types": {
    "operator_jwt": {
      "issued_by": "admin/routes/portal.js",
      "duration": "8h",
      "cookie": "sameSite: none (iframe-safe)",
      "payload": ["clientId", "role: operator"]
    },
    "invite_token": {
      "issued_by": "admin/routes/operator.js",
      "use": "Onboarding link for new operators before portal auth is set up"
    },
    "admin_session_jwt": {
      "issued_by": "admin/auth/google endpoint",
      "audience": "platform admin only",
      "restriction": "allowed email list"
    },
    "member_jwt": {
      "issued_by": "Wix (RS256)",
      "verified_by": "core/member-sync-api.js via JWKS (cached 1h)",
      "payload_key": "uid = Wix member ID = platform_member_id"
    }
  }
}
