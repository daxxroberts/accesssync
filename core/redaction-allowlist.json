{
  "_comment": "DR-039 redaction allowlist — fields explicitly safe to log. Any field not on this list that contains a value matching SECRET_PATTERNS in log-redaction.js will be redacted by the runtime regex backstop.",
  "_version": "1.0.0",

  "always_safe": [
    "ts",
    "level",
    "event",
    "traceId",
    "actor_type",
    "actor_id",
    "clientId",
    "tenantId",
    "memberId",
    "platformMemberId",
    "hardwareUserId",
    "hardwarePlatform",
    "sourcePlatform",
    "mappingId",
    "hardwareGroupId",
    "roleAssignmentId",
    "priorRaId",
    "priorMappingId",
    "priorSourcePlanId",
    "priorSourceType",
    "sourcePlanId",
    "sourceType",
    "planId",
    "jobId",
    "eventType",
    "eventId",
    "stage",
    "result",
    "reason",
    "note",
    "field",
    "service",
    "status",
    "targetStatus",
    "lockStatus",
    "lastStep",
    "concurrency",
    "count",
    "remainingSources",
    "succeeded",
    "failed",
    "failedGroups",
    "newAccessType",
    "roleAssignmentCount",
    "missingFields",
    "recoveredVia",
    "memberFound",
    "httpStatus",
    "resolution",
    "ip",
    "path",
    "method",
    "ms",
    "port",
    "env",
    "error",
    "kedb",
    "userMessage",
    "stack",
    "action",
    "granted",
    "revoked",
    "repaired",
    "alerts",
    "clientHint",
    "toEmail",
    "clientName",
    "scheduledStartDate",
    "priorHardwareUserId",
    "newHardwareUserId",
    "code"
  ],

  "never_log": [
    "hardware_api_key",
    "api_key",
    "apiKey",
    "wix_api_key",
    "source_api_key",
    "password",
    "secret",
    "token",
    "access_token",
    "refresh_token",
    "id_token",
    "jwt",
    "bearer",
    "authorization",
    "x-api-key",
    "private_key",
    "signing_key",
    "encryption_key",
    "webhook_secret",
    "invite_token",
    "owner_pin",
    "ssn",
    "credit_card",
    "card_number",
    "cvv",
    "routing_number",
    "account_number"
  ],

  "redact_if_pattern_matches": [
    "email",
    "name",
    "first_name",
    "last_name",
    "display_name",
    "phone",
    "address",
    "dob",
    "date_of_birth"
  ]
}
